<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dictation: both the app-recorded paths (cloud / system recognizer pipe) and the system recognizer's own capture need the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice conversation: only the microphone foreground-service type is declared; the service keeps running if notifications are denied. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        CHANGE_WIFI_MULTICAST_STATE implies android.hardware.wifi, which would hide the app from
        devices without Wi-Fi hardware. It is only used for mDNS discovery of local model servers
        on the same network, so it is declared optional.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!--
        A portrait-locked activity implies android.hardware.screen.portrait. The app works fine in
        landscape, so requiring it would exclude landscape-first devices for no reason.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!--
        Photos are taken through ActivityResultContracts.TakePicture, which hands the request to
        whichever camera app the user has, so no CAMERA permission is needed. The feature is
        declared optional so the app still installs on devices without a camera.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        RECORD_AUDIO implies android.hardware.microphone as required on Google Play.
        Dictation is an optional entry in the input box and the app stays usable by typing on devices
        without a microphone, so the feature is marked optional.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Read aloud: Android 11+ package visibility is needed to bind the system TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- System dictation: package visibility is needed to discover and bind the system speech recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Read aloud: Android 11+ package visibility; required to bind the system TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
        usesCleartextTraffic is on because local model servers (llama.cpp, Ollama, LM Studio,
        vLLM) speak plain HTTP on the user's own machine or LAN and have no certificate. A
        network security config cannot express the permitted set: it matches by hostname only,
        has no syntax for address ranges, and the addresses come from the user's network at
        runtime. RelayEndpointPolicy is the real boundary, and a stricter one than a config
        could be — it resolves the host, requires every resolved address to be private, rejects
        a mix of public and private resolution, pins the address set against DNS rebinding,
        re-verifies it at send time, and refuses cleartext carrying any credential.
    -->
    <application
        android:name=".OriveoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Oriveo"
        tools:targetApi="36">
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Oriveo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            OAuth redirect for remote MCP servers (`oriveo://mcp/oauth/callback`).

            A trampoline activity with no UI of its own rather than a filter on MainActivity: the
            sign-in page opens in Custom Tabs on top of MainActivity, and delivering the redirect
            straight to the singleTop MainActivity would stack a second instance above the sign-in
            page. The trampoline takes the URL, brings the original MainActivity back with
            CLEAR_TOP, and the sign-in page leaves the stack with it.

            A redirect nobody is waiting for (its `state` does not match, or the process that
            started it is gone) just finishes the trampoline without bringing the app forward.
            The path is matched literally, not as a prefix.
        -->
        <activity
            android:name=".core.mcp.McpOAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oriveo" android:host="mcp" android:path="/oauth/callback" />
            </intent-filter>
        </activity>

        <!-- Voice conversation foreground service: started only while the activity is visible and RECORD_AUDIO is granted (VoiceConversationServiceStarter). -->
        <service
            android:name=".core.voice.conversation.VoiceConversationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            EmojiCompat downloads a font on first launch. The app bundles the glyphs it needs, so
            the automatic initializer is switched off to keep startup off the network.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
