<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        CHANGE_WIFI_MULTICAST_STATE implies android.hardware.wifi, which would hide the app from
        devices without Wi-Fi hardware. It is only used for mDNS discovery of local model servers
        on the same network, so it is declared optional.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!--
        A portrait-locked activity implies android.hardware.screen.portrait. The app works fine in
        landscape, so requiring it would exclude landscape-first devices for no reason.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!--
        Photos are taken through ActivityResultContracts.TakePicture, which hands the request to
        whichever camera app the user has, so no CAMERA permission is needed. The feature is
        declared optional so the app still installs on devices without a camera.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".OriveoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Oriveo"
        tools:targetApi="36">
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Oriveo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            EmojiCompat downloads a font on first launch. The app bundles the glyphs it needs, so
            the automatic initializer is switched off to keep startup off the network.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
