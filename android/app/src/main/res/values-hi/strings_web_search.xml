    <string name="web_search_consent_billing">खोजों का बिल %1$s आपके खाते में लगाता है। Oriveo कोई अतिरिक्त शुल्क नहीं लेता।</string>
    <string name="web_search_consent_billing_custom">अगर यह सेवा खोजों के लिए शुल्क लेती है, तो बिल सीधे वही आपसे लेती है। Oriveo कोई अतिरिक्त शुल्क नहीं लेता।</string>
