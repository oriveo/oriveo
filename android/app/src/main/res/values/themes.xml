<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Only the cold-start window is themed here: everything after the first frame is drawn by
        Compose (OriveoTheme), and MainActivity's enableEdgeToEdge() owns the system bars.

        The window background is fixed to the dark value in both light and dark configurations
        because the product's default theme is dark. A user who explicitly picked the light theme
        sees a dark background for the first frame, which is the cheaper of the two mistakes.
    -->
    <style name="Theme.Oriveo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
