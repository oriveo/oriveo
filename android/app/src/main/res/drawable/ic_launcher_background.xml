<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer for the adaptive icon: a radial gradient in the logo's base violet
  (#3B2A86 -> #231657 -> #120B33) sitting at roughly 18% lightness, so the icon still reads as a
  shape on a dark wallpaper instead of blending into it.

  The gradient is placed at cx=50% cy=40% r=72% of the 108dp adaptive canvas, i.e. cx=54, cy=43.2,
  r=77.76. Radial gradients in vector drawables need API 24; minSdk here is 26.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="43.2"
                android:gradientRadius="77.76">
                <item android:offset="0.0" android:color="#FF3B2A86" />
                <item android:offset="0.6" android:color="#FF231657" />
                <item android:offset="1.0" android:color="#FF120B33" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
