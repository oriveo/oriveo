<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer for the adaptive icon: the flat #040716 the logo artwork itself sits on.
  Measured off the master outside the ring, where it is constant in every direction (std about 1).

  This replaces the earlier "lift the background to ~18% lightness so the icon does not blend into
  a dark wallpaper" treatment. That was written for the previous mark, a thin-stroke atom on a
  mostly empty near-black field. The current ring, glow included, covers roughly 89% of the visible
  width in saturated color, so it carries itself without help from the background — and matching
  the other platforms pixel for pixel matters more, since the icons are seen side by side.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FF040716" />
</vector>
