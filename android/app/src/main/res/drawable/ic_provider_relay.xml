<?xml version="1.0" encoding="utf-8"?>
<!--
  Quad Petal Bloom: the custom relay endpoint logo
  Four rotationally symmetric oval petals + a center orange dot
  Matches iOS Assets.xcassets/ProviderRelay.imageset/relay.svg and Web /providers/relay.svg exactly:
    top oval cx=16 cy=8  rx=3   ry=5.5
    bottom oval cx=16 cy=24 rx=3   ry=5.5
    left oval cx=8  cy=16 rx=5.5 ry=3
    right oval cx=24 cy=16 rx=5.5 ry=3
    center circle cx=16 cy=16 r=2.6

  Standard oval path form: M (cx-rx),cy a rx,ry 0 1,0 2*rx,0 a rx,ry 0 1,0 -2*rx,0
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

    <!-- top petal cx=16 cy=8 rx=3 ry=5.5 -->
    <path android:pathData="M13,8 a3,5.5 0 1,0 6,0 a3,5.5 0 1,0 -6,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="6"
                android:endX="26" android:endY="26">
                <item android:offset="0" android:color="#A78BFA"/>
                <item android:offset="0.55" android:color="#7C3AED"/>
                <item android:offset="1" android:color="#5B21B6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- bottom petal cx=16 cy=24 rx=3 ry=5.5 -->
    <path android:pathData="M13,24 a3,5.5 0 1,0 6,0 a3,5.5 0 1,0 -6,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="6"
                android:endX="26" android:endY="26">
                <item android:offset="0" android:color="#A78BFA"/>
                <item android:offset="0.55" android:color="#7C3AED"/>
                <item android:offset="1" android:color="#5B21B6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- left petal cx=8 cy=16 rx=5.5 ry=3 -->
    <path android:pathData="M2.5,16 a5.5,3 0 1,0 11,0 a5.5,3 0 1,0 -11,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="6"
                android:endX="26" android:endY="26">
                <item android:offset="0" android:color="#A78BFA"/>
                <item android:offset="0.55" android:color="#7C3AED"/>
                <item android:offset="1" android:color="#5B21B6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- right petal cx=24 cy=16 rx=5.5 ry=3 -->
    <path android:pathData="M18.5,16 a5.5,3 0 1,0 11,0 a5.5,3 0 1,0 -11,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="6"
                android:endX="26" android:endY="26">
                <item android:offset="0" android:color="#A78BFA"/>
                <item android:offset="0.55" android:color="#7C3AED"/>
                <item android:offset="1" android:color="#5B21B6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- center orange dot cx=16 cy=16 r=2.6 -->
    <path android:pathData="M13.4,16 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"
        android:fillColor="#F97316"/>
</vector>
