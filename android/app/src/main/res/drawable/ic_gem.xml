<!--
    lucide Gem icon (https://lucide.dev/icons/gem)
    Uses the same path data as lucide-react's <Gem />, kept consistent everywhere it's used.
    24x24 viewport, stroke style; color comes from the tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- outer outline -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6 3h12l4 6-10 13L2 9Z" />
    <!-- inner triangular facets -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M11 3 8 9l4 13 4-13-3-6" />
    <!-- horizontal waistline -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2 9h20" />
</vector>
