         resource qualifiers); the tag has to match or the per-app language picker omits it. -->
    <locale android:name="in" />
    <locale android:name="vi" />
    <locale android:name="th" />
    <locale android:name="tr" />
    <locale android:name="ru" />
</locale-config>
