<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        These preference files are encrypted with a master key that lives in the Android Keystore
        and never leaves the device that generated it, so a restore elsewhere would only produce
        blobs nothing can decrypt. The user re-enters the affected credentials instead.
    -->
    <exclude domain="sharedpref" path="oriveo_secure_keys.xml" />
    <exclude domain="sharedpref" path="oriveo_provider_subscription_tokens.xml" />
    <exclude domain="sharedpref" path="oriveo_auto_backup_keys.xml" />
    <!-- Access and refresh tokens of remote MCP servers: each device signs in on its own. -->
    <exclude domain="sharedpref" path="oriveo_mcp_credentials.xml" />
    <!-- Relay upstream-rejection negative cache and web-probe records: observed on this device, not carried over by backup or device transfer. -->
    <exclude domain="sharedpref" path="relay_negative_cache.v1.xml" />
    <exclude domain="sharedpref" path="relay_web_fragments.v1.xml" />
    <exclude domain="sharedpref" path="relay_web_probe_records.v1.xml" />
    <exclude domain="sharedpref" path="relay_web_probe_auto_history.v1.xml" />
    <exclude domain="database" path="message_continuations.db" />
    <exclude domain="database" path="message_continuations.db-wal" />
    <exclude domain="database" path="message_continuations.db-shm" />
</full-backup-content>
