    "Pick one to start. You can always add more later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر واحدة للبدء. يمكنك دائمًا إضافة المزيد لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
