    "%d conversations will be permanently deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف %d محادثة نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Konversationen werden dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%d conversaciones se eliminarán permanentemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d conversations seront supprimées définitivement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d वार्तालाप स्थायी रूप से हटा दिए जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%d percakapan akan dihapus secara permanen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d件の会話が完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개의 대화가 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d conversas serão excluídas permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%d бесед будет удалено навсегда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนา %d จะถูกลบอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d konuşma kalıcı olarak silinecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc hội thoại %d sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 条对话将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 個對話將被永久刪除。"
          }
        }
      }
    },
    "Add a provider first to start chatting and switch models later.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإضافة مزوّد خدمة أولاً لبدء الدردشة وتبديل النماذج لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie zunächst einen Anbieter hinzu, um mit dem Chatten zu beginnen und später das Modell zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero agregue un proveedor para comenzar a chatear y cambiar de modelo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord un fournisseur pour commencer à discuter et changer de modèle plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैटिंग शुरू करने के लिए पहले एक प्रदाता जोड़ें और बाद में मॉडल बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan penyedia terlebih dahulu untuk mulai mengobrol dan berganti model nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずプロバイダーを追加して、チャットを開始しましょう。モデルは後から切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 시작하려면 먼저 제공업체를 추가하고 나중에 모델을 전환하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um provedor primeiro para começar a conversar e trocar de modelo mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте поставщика, чтобы начать общаться и переключать модели позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มผู้ให้บริการก่อนเพื่อเริ่มแชทและเปลี่ยนรุ่นในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbete başlamak ve daha sonra modelleri değiştirmek için önce bir sağlayıcı ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nhà cung cấp trước để bắt đầu trò chuyện và chuyển đổi mô hình sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先添加一个服务商，之后可以随时切换模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首先新增服務商以開始聊天，然後再切換模型。"
          }
        }
      }
    },
