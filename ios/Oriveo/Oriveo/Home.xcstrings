    "Oriveo tracks estimated usage, but your provider still bills API usage separately.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع Oriveo الاستخدام المقدر، ولكن لا يزال مزود الخدمة الخاص بك يحاسب استخدام واجهة برمجة التطبيقات (API) بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo verfolgt die geschätzte Nutzung, Ihr Anbieter rechnet die API-Nutzung jedoch weiterhin separat ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo tracks estimated usage, but your provider still bills API usage separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo realiza un seguimiento del uso estimado, pero su proveedor aún factura el uso de API por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo suit l'utilisation estimée, mais votre fournisseur facture toujours l'utilisation de l'API séparément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओरिवियो अनुमानित उपयोग को ट्रैक करता है, लेकिन आपका प्रदाता अभी भी एपीआई उपयोग का बिल अलग से देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo melacak perkiraan penggunaan, namun penyedia Anda masih menagih penggunaan API secara terpisah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo は推定使用量を追跡しますが、プロバイダーは依然として API 使用量を別途請求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo는 예상 사용량을 추적하지만 공급자는 여전히 API 사용량을 별도로 청구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Oriveo rastreia o uso estimado, mas seu provedor ainda cobra o uso da API separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo отслеживает предполагаемое использование, но ваш провайдер по-прежнему выставляет счета за использование API отдельно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo ติดตามการใช้งานโดยประมาณ แต่ผู้ให้บริการของคุณยังคงเรียกเก็บเงินการใช้งาน API แยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo tahmini kullanımı izler ancak sağlayıcınız API kullanımını yine de ayrı olarak faturalandırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo theo dõi mức sử dụng ước tính nhưng nhà cung cấp của bạn vẫn lập hóa đơn riêng cho việc sử dụng API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 会追踪估算用量，但你的供应商仍会单独收取 API 使用费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 會追蹤估算用量，但你的供應商仍會單獨收取 API 使用費用。"
          }
        }
      }
    },
