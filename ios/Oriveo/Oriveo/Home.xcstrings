            "value": "Wählen Sie eine aus, um zu beginnen. Sie können später jederzeit weitere hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one to start. You can always add more later."
          }
        },
