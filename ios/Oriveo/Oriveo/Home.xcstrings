    "Change the model for the next turn while preserving this conversation.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر النموذج للرد القادم مع الحفاظ على هذه المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle das Modell für die nächste Antwort, ohne die Konversation zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el modelo para el siguiente turno manteniendo esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez le modèle pour le prochain tour tout en conservant cette conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वार्तालाप को संरक्षित करते हुए अगले मोड़ के लिए मॉडल बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah model untuk giliran berikutnya sambil mempertahankan percakapan ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話を保持したまま、次のターンのモデルを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화를 유지하면서 다음 턴의 모델을 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o modelo para a próxima resposta mantendo esta conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените модель для следующего хода, сохранив этот разговор."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนรูปแบบสำหรับเทิร์นถัดไปโดยคงการสนทนานี้ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuşmayı korurken bir sonraki tur için modeli değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi mô hình cho lượt tiếp theo trong khi vẫn duy trì cuộc trò chuyện này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换下一轮使用的模型，同时保留当前对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換下一輪使用的模型，同時保留當前對話。"
          }
        }
      }
    },
