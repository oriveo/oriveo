    "Have a few chats first, then come back to generate a draft from them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجرِ بعض المحادثات أولاً، ثم عُد لإنشاء المسودة من خلالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe zuerst einige Gespräche, dann erstelle daraus den Entwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten algunas conversaciones primero y vuelve para generar el borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayez d'abord quelques conversations, puis revenez générer le brouillon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले कुछ बातचीत करें, फिर उनसे ड्राफ़्ट जनरेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakukan beberapa percakapan dulu, lalu kembali untuk menghasilkan draf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずいくつか会話してから、その内容を使ってドラフトを生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 몇 차례 대화를 나눈 뒤 그 내용으로 초안을 생성해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha algumas conversas primeiro e depois volte para gerar o rascunho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала проведите несколько диалогов, затем создайте черновик на их основе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองสนทนาสักครู่ก่อน แล้วกลับมาสร้างฉบับร่างจากการสนทนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce birkaç sohbet edin, ardından bunlardan taslak oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy trò chuyện vài câu trước, rồi quay lại tạo bản nháp từ chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先聊几句对话，再回来从对话中生成草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先聊幾句對話，再回來從對話中產生草稿。"
          }
        }
      }
    },
