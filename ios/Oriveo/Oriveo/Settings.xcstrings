    "Choose Oriveo's language in iOS Settings so system menus use the same language." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة Oriveo في إعدادات iOS حتى تستخدم قوائم النظام اللغة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Sprache von Oriveo in den iOS-Einstellungen aus, damit Systemmenüs dieselbe Sprache verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el idioma de Oriveo en Ajustes de iOS para que los menús del sistema usen el mismo idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la langue d’Oriveo dans les réglages iOS afin que les menus système utilisent la même langue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS सेटिंग्स में Oriveo की भाषा चुनें, ताकि सिस्टम मेनू भी उसी भाषा का उपयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bahasa Oriveo di Pengaturan iOS agar menu sistem menggunakan bahasa yang sama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムメニューも同じ言語になるよう、iOSの「設定」でOriveoの言語を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 메뉴도 같은 언어를 사용하도록 iOS 설정에서 Oriveo의 언어를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o idioma do Oriveo nos Ajustes do iOS para que os menus do sistema usem o mesmo idioma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите язык Oriveo в настройках iOS, чтобы системные меню использовали тот же язык."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกภาษาของ Oriveo ในการตั้งค่า iOS เพื่อให้เมนูระบบใช้ภาษาเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
