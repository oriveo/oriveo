    "Add a provider with an API key first, then come back to generate a draft.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أولاً مزوّدًا مع مفتاح API، ثم عُد لإنشاء المسودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst einen Anbieter mit API-Schlüssel hinzu und erstelle dann den Entwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega primero un proveedor con clave API y luego vuelve a generar un borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord un fournisseur avec une clé API, puis revenez générer un brouillon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले API कुंजी वाला प्रदाता जोड़ें, फिर ड्राफ़्ट जनरेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan dulu penyedia dengan kunci API, lalu kembali untuk menghasilkan draf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーを設定したプロバイダーを追加してから、ドラフトを生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 설정된 제공업체를 먼저 추가한 후 초안을 생성해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro um provedor com chave de API e volte para gerar um rascunho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте провайдера с ключом API, затем создайте черновик."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มผู้ให้บริการที่มีคีย์ API ก่อน แล้วค่อยกลับมาสร้างฉบับร่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce API anahtarına sahip bir sağlayıcı ekleyin, ardından taslak oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm nhà cung cấp có API Key trước, rồi quay lại để tạo bản nháp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加并配置带 API Key 的服务商，再回来生成草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先新增並配置帶 API Key 的服務商，再回來產生草稿。"
          }
        }
      }
    },
    "After 10 rounds of conversation, automatically append a summary reminder at the end of messages.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد 10 جولات من المحادثة، يُضاف تلقائيًا ملخص تذكيري في نهاية الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach 10 Gesprächsrunden wird am Ende der Nachrichten automatisch eine Zusammenfassung angehängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 10 rounds of conversation, automatically append a summary reminder at the end of messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de 10 rondas de conversación, agrega automáticamente un resumen al final de los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 10 échanges, ajoute automatiquement un résumé à la fin des messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत के 10 दौर के बाद, संदेशों के अंत में स्वचालित रूप से एक सारांश अनुस्मारक जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah 10 putaran percakapan, secara otomatis menambahkan ringkasan pengingat di akhir pesan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が10往復を超えると、メッセージの末尾に要約リマインダーを自動的に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 10회를 넘으면 메시지 끝에 요약 알림을 자동으로 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após 10 rodadas de conversa, adiciona automaticamente um resumo ao final das mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После 10 раундов разговора автоматически добавляйте сводное напоминание в конце сообщений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากสนทนาครบ 10 รอบ จะเพิ่มการเตือนสรุปต่อท้ายข้อความโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 turluk konuşmanın ardından mesajların sonuna otomatik olarak bir özet hatırlatıcı ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau 10 vòng trò chuyện, tự động thêm lời nhắc tóm tắt vào cuối tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话超过 10 轮后，自动在消息末尾追加摘要提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話超過 10 輪後，自動在訊息末尾追加摘要提醒。"
          }
        }
      }
    },
