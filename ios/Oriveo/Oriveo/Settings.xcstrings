        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらの方法も、モデルに送信する内容が変わるだけです。この端末のメッセージはすべてそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 방식 모두 모델에 보내는 내용만 바뀌어요. 이 기기에 있는 메시지는 항상 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As duas opções só mudam o que é enviado ao modelo. Suas mensagens neste dispositivo continuam completas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба варианта меняют только то, что отправляется модели. Ваши сообщения на этом устройстве всегда сохраняются полностью."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทั้งสองแบบเปลี่ยนเฉพาะสิ่งที่ส่งให้โมเดล ข้อความในอุปกรณ์นี้ยังอยู่ครบเสมอ"
