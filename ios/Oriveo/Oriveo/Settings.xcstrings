    "settings_context_mode_ai_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب النموذج الحالي ملخّصًا للمحادثة السابقة، فيُحفَظ قدر أكبر منها. كل اختصار يضيف استدعاءً إضافيًا للنموذج بتكلفة إضافية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Modell fasst den früheren Verlauf zusammen, so bleibt mehr im Gedächtnis. Jedes Verdichten kostet einen zusätzlichen Modellaufruf und damit extra."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current model writes a summary of the earlier conversation, so more is remembered. Each time adds one extra model call, which costs extra."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo actual escribe un resumen de la conversación anterior, así se recuerda más. Cada vez se suma una llamada extra al modelo, con costo adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle actuel rédige un résumé de la conversation antérieure, pour en retenir davantage. Chaque condensation ajoute un appel au modèle, facturé en plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा मॉडल पहले की बातचीत का सारांश लिखता है, जिससे ज़्यादा बातें याद रहती हैं। हर बार संक्षिप्त करने पर मॉडल को एक बार और कॉल किया जाता है, जिसका खर्च अलग से लगता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model saat ini menulis ringkasan percakapan sebelumnya, jadi lebih banyak yang diingat. Setiap pemadatan menambah satu panggilan model dan dikenai biaya tambahan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のモデルが以前の会話の要約を作成するため、より多くの内容を覚えておけます。整理のたびにモデルの呼び出しが 1 回増え、追加料金がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 모델이 이전 대화를 요약해서 더 많은 내용을 기억해요. 정리할 때마다 모델을 한 번 더 호출해서 추가 비용이 들어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo atual escreve um resumo da conversa anterior, então mais coisas são lembradas. Cada vez adiciona uma chamada extra ao modelo, com custo adicional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая модель составляет сводку более раннего разговора, поэтому запоминается больше. Каждое сжатие — это ещё один вызов модели и дополнительные расходы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลปัจจุบันจะเขียนสรุปบทสนทนาก่อนหน้า จึงจำได้ครบกว่า การย่อแต่ละครั้งจะเรียกโมเดลเพิ่มอีกหนึ่งครั้งและมีค่าใช้จ่ายเพิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli model önceki konuşmanın özetini yazar, böylece daha fazlası hatırlanır. Her sıkıştırma modele bir çağrı daha ekler ve ek ücrete yol açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình hiện tại viết bản tóm tắt phần trò chuyện trước đó nên ghi nhớ được nhiều hơn. Mỗi lần rút gọn sẽ gọi mô hình thêm một lần và tốn thêm phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用当前模型把较早的对话写成摘要，记得更全；每次整理会多调用一次模型，有额外费用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用目前的模型把較早的對話寫成摘要，記得更完整；每次整理會多呼叫一次模型，會產生額外費用。"
          }
        }
      }
    },
