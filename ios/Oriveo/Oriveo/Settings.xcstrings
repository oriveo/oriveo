    "This provider has no models configured. Add at least one model first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تكوين أي نماذج لهذا المزوّد. أضف نموذجًا واحدًا على الأقل أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter hat keine Modelle konfiguriert. Füge zuerst mindestens ein Modell hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor no tiene modelos configurados. Agrega al menos uno primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur n'a pas de modèles configurés. Ajoutez-en au moins un d'abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रदाता पर कोई मॉडल कॉन्फ़िगर नहीं है। पहले कम से कम एक मॉडल जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia ini belum memiliki model. Tambahkan setidaknya satu model dulu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーにはモデルが設定されていません。少なくとも 1 つのモデルを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공업체에는 모델이 구성되어 있지 않습니다. 먼저 모델을 하나 이상 추가해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não tem modelos configurados. Adicione pelo menos um primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого провайдера нет моделей. Сначала добавьте хотя бы одну."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการนี้ยังไม่มีโมเดล โปรดเพิ่มอย่างน้อยหนึ่งโมเดลก่อน"
          }
        },
        "tr": {
