    "Memory content is sent with every AI request to your chosen provider. Do not enter passwords or other sensitive information." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إرسال محتوى الذاكرة مع كل طلب ذكاء اصطناعي إلى المزود المختار. لا تدخل كلمات المرور أو معلومات حساسة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gedächtnisinhalt wird mit jeder KI-Anfrage an den gewählten Anbieter gesendet. Gib keine Passwörter oder sensiblen Informationen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory content is sent with every AI request to your chosen provider. Do not enter passwords or other sensitive information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido de la memoria se envía con cada solicitud de IA al proveedor elegido. No ingreses contraseñas ni otra información sensible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu de la mémoire est envoyé avec chaque requête IA au fournisseur choisi. N'entrez pas de mots de passe ou d'informations sensibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक AI अनुरोध के साथ मेमोरी सामग्री आपके चुने हुए प्रोवाइडर को भेजी जाती है। पासवर्ड या अन्य संवेदनशील जानकारी दर्ज न करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten memori dikirim dengan setiap permintaan AI ke penyedia pilihan Anda. Jangan masukkan kata sandi atau informasi sensitif lainnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリーの内容はAIリクエストごとに選択したプロバイダーに送信されます。パスワードやその他の機密情報を入力しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 내용은 모든 AI 요청과 함께 선택한 제공업체에 전송됩니다. 비밀번호 등 민감한 정보는 입력하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo da memória é enviado com cada solicitação de IA ao provedor escolhido. Não insira senhas ou outras informações sensíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Содержимое памяти отправляется с каждым запросом ИИ выбранному вами провайдеру. Не вводите пароли или другую конфиденциальную информацию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อหาความจำจะถูกส่งพร้อมกับทุกคำขอ AI ไปยังผู้ให้บริการที่คุณเลือก อย่าป้อนรหัสผ่านหรือข้อมูลที่ละเอียดอ่อนอื่น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellek içeriği, her yapay zeka isteğiyle birlikte seçtiğiniz sağlayıcıya gönderilir. Şifreleri veya diğer hassas bilgileri girmeyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung bộ nhớ được gửi cùng với mọi yêu cầu AI đến nhà cung cấp mà bạn đã chọn. Không nhập mật khẩu hoặc thông tin nhạy cảm khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆内容会随每次 AI 请求发送至你选择的供应商。请勿输入密码或其他敏感信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶內容會隨每次 AI 請求傳送至你選擇的供應商。請勿輸入密碼或其他敏感資訊。"
          }
        }
      }
    },
