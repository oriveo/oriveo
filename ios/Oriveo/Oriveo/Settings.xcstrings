    "Tell AI about yourself. It will automatically know this at the start of every conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر الذكاء الاصطناعي عن نفسك. سيعرف ذلك تلقائيًا في بداية كل محادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl der KI von dir. Sie wird es automatisch am Anfang jedes Gesprächs wissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell AI about yourself. It will automatically know this at the start of every conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntale a la IA sobre ti. Lo sabrá automáticamente al inicio de cada conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez de vous à l'IA. Elle le saura automatiquement au début de chaque conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई को अपने बारे में बताएं. इसे हर बातचीत की शुरुआत में अपने आप इसका पता चल जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan pada AI tentang diri Anda. Secara otomatis akan mengetahui hal ini di awal setiap percakapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIにあなた自身のことを伝えてください。毎回の会話の最初に自動的に認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI에게 자신에 대해 알려주세요. 모든 대화 시작 시 자동으로 인식합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte à IA sobre você. Ela saberá automaticamente no início de cada conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите ИИ о себе. Он будет автоматически знать это в начале каждого разговора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก AI เกี่ยวกับตัวคุณ มันจะรู้สิ่งนี้โดยอัตโนมัติเมื่อเริ่มการสนทนาทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'ye kendinizden bahsedin. Her konuşmanın başında bunu otomatik olarak bilecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói với AI về bản thân bạn. Nó sẽ tự động biết điều này khi bắt đầu mỗi cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 AI 关于你自己。它会在每次对话开始时自动了解这些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 AI 關於你自己。它會在每次對話開始時自動了解這些。"
          }
        }
      }
    },
