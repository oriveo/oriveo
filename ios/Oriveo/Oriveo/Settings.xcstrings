        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki seçenek de yalnızca modele gönderilenleri değiştirir. Bu cihazdaki mesajlarınız her zaman eksiksiz kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai cách chỉ thay đổi nội dung gửi cho mô hình. Tin nhắn trên thiết bị này luôn được giữ đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两种方式都只影响发给模型的内容，本地消息始终完整保留。"
