    "settings_context_mode_fallback_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون تكلفة إضافية. لم تعد ردود الذكاء الاصطناعي السابقة تُرسَل، وتبقى رسائلك محفوظة، وإذا لزم الاقتطاع فإنه يتوقف عند نهاية جملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Zusatzkosten. Frühere KI-Antworten werden nicht mehr gesendet; deine eigenen Nachrichten bleiben erhalten, und gekürzt wird nur am Satzende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No extra cost. Earlier AI replies are no longer sent; your own messages are kept, and any cut ends at a sentence boundary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin costo adicional. Las respuestas anteriores de la IA ya no se envían; tus propios mensajes se conservan y, si hay que recortar, el corte se hace al final de una oración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans coût supplémentaire. Les réponses antérieures de l’IA ne sont plus envoyées ; vos propres messages sont conservés, et toute coupure se fait en fin de phrase."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अतिरिक्त खर्च नहीं। AI के पहले के जवाब अब नहीं भेजे जाते; आपके अपने मैसेज रखे जाते हैं, और काटना पड़े तो वाक्य के अंत पर ही काटा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa biaya tambahan. Balasan AI sebelumnya tidak lagi dikirim; pesan Anda sendiri tetap disimpan, dan jika perlu dipotong, potongannya berhenti di akhir kalimat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加料金はかかりません。以前の AI の回答は送信せず、あなたのメッセージはそのまま残します。切り詰める場合も文の終わりで区切ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 비용이 없어요. 이전 AI 답변은 보내지 않고, 직접 보낸 메시지는 그대로 유지해요. 잘라낼 때는 문장이 끝나는 곳에서 잘라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem custo extra. As respostas anteriores da IA não são mais enviadas; suas próprias mensagens são mantidas, e qualquer corte termina no fim de uma frase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без дополнительных затрат. Предыдущие ответы ИИ больше не отправляются; ваши собственные сообщения сохраняются, а если текст приходится сокращать, он обрезается по концу предложения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีค่าใช้จ่ายเพิ่ม คำตอบของ AI ก่อนหน้าจะไม่ถูกส่งอีก ส่วนข้อความของคุณยังเก็บไว้ตามปกติ และถ้าต้องตัดทอนจะตัดที่ท้ายประโยค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek ücret yok. Önceki yapay zekâ yanıtları artık gönderilmez; kendi mesajlarınız korunur ve kesme gerekirse cümle sonunda yapılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tốn thêm phí. Các câu trả lời AI trước đó không còn được gửi; tin nhắn của bạn vẫn được giữ, và nếu phải cắt bớt thì sẽ dừng ở cuối câu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不额外花钱。较早的 AI 回答不再发送，你说过的话照常保留，截断处停在句子结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不額外花費。較早的 AI 回覆不再傳送，你說過的話照常保留，截斷處停在句子結尾。"
          }
        }
      }
    },
    "settings_context_overflow_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقتصر أثر الخيارين على ما يُرسَل إلى النموذج، وتبقى رسائلك على هذا الجهاز كاملة دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides ändert nur, was an das Modell gesendet wird. Deine Nachrichten auf diesem Gerät bleiben vollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both only change what’s sent to the model. Your messages on this device stay complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas opciones solo cambian lo que se envía al modelo. Tus mensajes en este dispositivo se conservan completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux options ne modifient que ce qui est envoyé au modèle. Vos messages sur cet appareil restent complets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों तरीके सिर्फ़ यह बदलते हैं कि मॉडल को क्या भेजा जाता है। इस डिवाइस पर आपके मैसेज हमेशा पूरे रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua opsi hanya mengubah apa yang dikirim ke model. Pesan Anda di perangkat ini tetap lengkap."
