    "settings_context_price_line_reminder_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلب تأكيدك مع تقدير للتكلفة قبل أن تتجاوز المحادثة عتبة سعر السياق الطويل للنموذج لأول مرة. أما تجاوز الحد المحدد فيستلزم التأكيد دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ein Chat zum ersten Mal die Langkontext-Preisschwelle eines Modells überschreitet, wirst du mit einer Kostenschätzung gefragt. Bei einem selbst festgelegten Limit wirst du vor dem Überschreiten immer gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks before a chat first goes past a model's long-context price threshold, with a cost estimate. Going over a limit you set always asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que un chat supere por primera vez el umbral de precio de contexto largo de un modelo, te pregunta y estima el costo. Superar un límite que hayas fijado siempre requiere confirmación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande confirmation, avec une estimation du coût, avant qu’une conversation ne dépasse pour la première fois le seuil tarifaire de contexte long d’un modèle. Le dépassement d’une limite que vous avez définie demande toujours confirmation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी चैट के पहली बार मॉडल की लॉन्ग कॉन्टेक्स्ट वाली ऊँची दर की रेखा पार करने से पहले आपसे पूछा जाएगा, साथ में खर्च का अनुमान भी दिखेगा। आपकी तय की गई सीमा से ऊपर जाने पर हर बार पूछा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan ditanya dulu, disertai perkiraan biaya, sebelum percakapan pertama kali melewati ambang harga konteks panjang model. Jika melebihi batas yang Anda tetapkan, Anda selalu ditanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話が初めてモデルのロングコンテキスト割増ラインを超える前に、今回の料金の概算とあわせて確認します。設定した上限を超える場合は毎回確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 모델의 긴 컨텍스트 할증 기준선을 처음 넘기 전에 이번 비용을 추정해서 먼저 물어봐요. 직접 정한 한도를 넘을 때는 항상 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta antes de uma conversa passar pela primeira vez do patamar de preço de contexto longo de um modelo, com uma estimativa do custo. Passar de um limite que você definiu sempre exige confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед тем как чат впервые превысит ценовой порог длинного контекста модели, вас спросят и покажут оценку стоимости. При превышении заданного вами лимита спрашивают всегда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะถามคุณพร้อมประมาณค่าใช้จ่ายก่อนที่แชทจะเกินเกณฑ์ขึ้นราคาบริบทยาวของโมเดลเป็นครั้งแรก ส่วนการเกินขีดจำกัดที่คุณตั้งไว้จะถามทุกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sohbet, modelin uzun bağlam fiyat eşiğini ilk kez aşmadan önce size sorulur ve maliyet tahmini gösterilir. Belirlediğiniz sınır aşılacaksa her zaman sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi bạn trước khi cuộc trò chuyện lần đầu vượt ngưỡng tăng giá ngữ cảnh dài của mô hình, kèm chi phí ước tính. Khi vượt giới hạn bạn đặt thì luôn hỏi trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话第一次越过模型的长上下文加价线前先问你，并估算这次的费用。超过你设的上限时总会先问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話第一次越過模型的長上下文加價門檻前，會先問你並估算這次的費用。超過你設定的上限時一律會先問。"
          }
        }
      }
    },
