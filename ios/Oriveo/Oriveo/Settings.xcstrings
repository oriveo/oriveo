    "Write your background and preferences. AI will automatically know this in every conversation — no need to repeat yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب خلفيتك وتفضيلاتك. سيعرف الذكاء الاصطناعي ذلك تلقائيًا في كل محادثة — لا حاجة لتكرار نفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe deinen Hintergrund und deine Vorlieben. Die KI wird dies in jedem Gespräch automatisch wissen — kein Wiederholen nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write your background and preferences. AI will automatically know this in every conversation — no need to repeat yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu perfil y preferencias. La IA lo sabrá automáticamente en cada conversación, sin necesidad de repetirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez votre profil et vos préférences. L'IA le saura automatiquement à chaque conversation — inutile de vous répéter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पृष्ठभूमि और प्राथमिकताएँ लिखें. एआई को हर बातचीत में यह स्वचालित रूप से पता चल जाएगा - खुद को दोहराने की आवश्यकता नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis latar belakang dan preferensi Anda. AI akan secara otomatis mengetahui hal ini dalam setiap percakapan — tidak perlu mengulanginya lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの背景や好みを書いてください。AIは毎回の会話で自動的にこれを知ります——繰り返す必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 배경과 선호도를 작성하세요. AI가 모든 대화에서 자동으로 이를 알게 됩니다 — 반복할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva seu perfil e preferências. A IA saberá automaticamente em cada conversa — sem precisar se repetir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите свой опыт и предпочтения. ИИ будет автоматически знать это в каждом разговоре — не нужно повторяться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนพื้นหลังและความชอบของคุณ AI จะรู้สิ่งนี้โดยอัตโนมัติในทุกการสนทนา ไม่จำเป็นต้องพูดซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişinizi ve tercihlerinizi yazın. Yapay zeka bunu her konuşmada otomatik olarak bilecek; kendinizi tekrarlamanıza gerek yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết lý lịch và sở thích của bạn. AI sẽ tự động biết điều này trong mọi cuộc trò chuyện - bạn không cần phải lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下你的背景和偏好，AI 会在每次对话中自动了解这些——无需重复自我介绍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下你的背景和偏好，AI 會在每次對話中自動了解這些——無需重複自我介紹。"
          }
        }
      }
    },
    "You've edited the current text. Apply the generated draft and replace current content?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد عدّلت النص الحالي. هل تريد تطبيق المسودة المولّدة واستبدال المحتوى الحالي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den aktuellen Text bearbeitet. Generierten Entwurf anwenden und den aktuellen Inhalt ersetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've edited the current text. Apply the generated draft and replace current content?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has editado el texto actual. ¿Aplicar el borrador generado y reemplazar el contenido actual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez modifié le texte actuel. Appliquer le brouillon généré et remplacer le contenu actuel ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने वर्तमान पाठ संपादित कर दिया है. जनरेट किया गया ड्राफ्ट लागू करें और वर्तमान सामग्री बदलें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mengedit teks saat ini. Terapkan draf yang dihasilkan dan ganti konten saat ini?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のテキストを編集しました。生成された下書きを適用して現在の内容を置き換えますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 텍스트를 편집했습니다. 생성된 초안을 적용하여 현재 내용을 대체하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você editou o texto atual. Aplicar o rascunho gerado e substituir o conteúdo atual?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отредактировали текущий текст. Применить созданный черновик и заменить текущий контент?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้แก้ไขข้อความปัจจุบันแล้ว ใช้แบบร่างที่สร้างขึ้นและแทนที่เนื้อหาปัจจุบันหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli metni düzenlediniz. Oluşturulan taslak uygulansın ve mevcut içerik değiştirilsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chỉnh sửa văn bản hiện tại. Áp dụng bản nháp đã tạo và thay thế nội dung hiện tại?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已编辑了当前文本。是否应用生成的草稿并替换当前内容？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已編輯了目前的文字。是否套用生成的草稿並取代目前的內容？"
          }
        }
      }
    },
