            "value": "لم يتم حفظ التغييرات التي أجريتها على هذا النموذج اللغوي المخصص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen an diesem benutzerdefinierten LLM wurden nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes to this custom LLM have not been saved."
          }
        },
        "es": {
