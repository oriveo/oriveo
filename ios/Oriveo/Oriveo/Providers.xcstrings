    "For addresses on this device or your LAN. Not encrypted, so no credentials are sent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للحصول على العناوين الموجودة على هذا الجهاز أو شبكة LAN الخاصة بك. غير مشفرة، لذلك لا يتم إرسال أي بيانات اعتماد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Adressen auf diesem Gerät oder Ihrem LAN. Nicht verschlüsselt, daher werden keine Anmeldeinformationen gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For addresses on this device or your LAN. Not encrypted, so no credentials are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para direcciones en este dispositivo o su LAN. No está cifrado, por lo que no se envían credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les adresses sur cet appareil ou sur votre réseau local. Non crypté, donc aucune information d'identification n'est envoyée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस या आपके LAN के पतों के लिए। एन्क्रिप्टेड नहीं है, इसलिए कोई क्रेडेंशियल नहीं भेजा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk alamat pada perangkat ini atau LAN Anda. Tidak dienkripsi, jadi tidak ada kredensial yang dikirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスまたは LAN 上のアドレス。暗号化されていないため、資格情報は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치 또는 LAN의 주소입니다. 암호화되지 않았으므로 자격 증명이 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para endereços neste dispositivo ou na sua LAN. Não criptografado, portanto nenhuma credencial é enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для адресов на этом устройстве или в вашей локальной сети. Не зашифрован, поэтому учетные данные не отправляются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับที่อยู่ในอุปกรณ์นี้หรือ LAN ของคุณ ไม่ได้เข้ารหัส ดังนั้นจึงไม่มีการส่งข้อมูลรับรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki veya LAN'ınızdaki adresler için. Şifrelenmediğinden kimlik bilgileri gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để biết địa chỉ trên thiết bị này hoặc mạng LAN của bạn. Không được mã hóa nên không có thông tin xác thực nào được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于本机或局域网地址；连接不加密，因此不会发送任何凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於本機或區域網路位址；連線未加密，因此不會傳送任何憑證。"
          }
        }
      }
    },
