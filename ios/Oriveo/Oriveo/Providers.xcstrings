            "state": "translated",
            "value": "Kimi-API-Schlüssel sind an die Kontoregion gebunden. Wähle die Request-URL, die zu deinem Kimi-Konto passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API keys are region-specific. Choose the Request URL that matches your Kimi account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API de Kimi dependen de la región de la cuenta. Elige la URL de solicitud correspondiente a tu cuenta de Kimi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API Kimi dépendent de la région du compte. Choisissez l’URL de requête correspondant à votre compte Kimi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API कुंजियां खाते के क्षेत्र से जुड़ी होती हैं। अपने Kimi खाते से मेल खाता अनुरोध URL चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API Kimi terikat pada wilayah akun. Pilih URL permintaan yang sesuai dengan akun Kimi Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API キーはアカウントの地域に紐づいています。Kimi アカウントに合うリクエスト URL を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API 키는 계정 지역에 연결됩니다. Kimi 계정에 맞는 요청 URL을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de API da Kimi dependem da região da conta. Escolha a URL de solicitação correspondente à sua conta Kimi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи API Kimi привязаны к региону аккаунта. Выберите URL запроса, соответствующий вашему аккаунту Kimi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API ของ Kimi ผูกกับภูมิภาคของบัญชี เลือก URL คำขอที่ตรงกับบัญชี Kimi ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API anahtarları hesap bölgesine bağlıdır. Kimi hesabınızla eşleşen istek URL'sini seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API Kimi gắn với khu vực tài khoản. Chọn URL yêu cầu khớp với tài khoản Kimi của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API Key 区分账号区域，请选择与你的 Kimi 账号一致的请求 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi API Key 依帳號區域區分，請選擇與你的 Kimi 帳號一致的請求 URL。"
          }
        }
      }
    },
