    "Higher is more creative, lower is more consistent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأعلى أكثر إبداعًا والأدنى أكثر اتساقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höher ist kreativer, niedriger ist konsistenter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher is more creative, lower is more consistent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más alto es más creativo; más bajo, más consistente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus haut : plus créatif ; plus bas : plus régulier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिक = अधिक रचनात्मक, कम = अधिक स्थिर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makin tinggi makin kreatif, makin rendah makin konsisten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いほど独創的に、低いほど安定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높을수록 창의적, 낮을수록 일관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais alto é mais criativo; mais baixo, mais consistente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выше — креативнее, ниже — стабильнее."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งสูงยิ่งสร้างสรรค์ ยิ่งต่ำยิ่งคงเส้นคงวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek daha yaratıcı, düşük daha tutarlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cao hơn thì sáng tạo hơn, thấp hơn thì ổn định hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越高越有创意，越低越稳定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越高越有創意，越低越穩定。"
          }
        }
      }
    },
