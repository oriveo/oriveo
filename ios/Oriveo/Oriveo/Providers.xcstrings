    "Sends a probe via the same path as chat. Failures don't block save.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل اختبارًا عبر نفس مسار الدردشة. لا تمنع الإخفاقات الحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Anfrage über denselben Pfad wie der Chat. Fehler blockieren das Speichern nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a probe via the same path as chat. Failures don't block save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una sonda por la misma ruta que el chat. Los fallos no bloquean guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une sonde par le même chemin que le chat. Les échecs ne bloquent pas l'enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट के समान पथ से जांच भेजता है। विफलताएं सहेजने को नहीं रोकतीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim probe via jalur yang sama dengan chat. Kegagalan tidak memblokir penyimpanan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットと同じ経路でプローブを送ります。失敗しても保存はブロックされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅과 동일한 경로로 프로브를 보냅니다. 실패해도 저장은 막지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia uma sonda pelo mesmo caminho do chat. Falhas não bloqueiam o salvamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет проверку по тому же пути, что и чат. Сбой не блокирует сохранение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำขอตรวจสอบผ่านเส้นทางเดียวกับแชต ความล้มเหลวจะไม่ขัดขวางการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetle aynı yoldan bir prob gönderir. Başarısızlık kaydı engellemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi probe theo cùng đường với chat. Thất bại không chặn việc lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走和聊天同一条路径发起一次探活,失败不影响保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走和聊天同一條路徑發起一次探活,失敗不影響儲存。"
          }
        }
      }
    },
