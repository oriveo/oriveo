    "An unencrypted connection can't carry a key." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لاتصال غير مشفّر أن يحمل مفتاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine unverschlüsselte Verbindung darf keinen Schlüssel enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unencrypted connection can't carry a key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conexión sin cifrar no puede llevar una clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion non chiffrée ne peut pas transporter de clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनएन्क्रिप्टेड कनेक्शन में कुंजी नहीं रखी जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi tanpa enkripsi tidak boleh membawa kunci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていない接続にキーを設定することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화되지 않은 연결에는 키를 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conexão não criptografada não pode conter uma chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незашифрованное подключение не может содержать ключ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อที่ไม่เข้ารหัสไม่สามารถใช้คีย์ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifrelenmemiş bir bağlantı anahtar taşıyamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối không mã hóa không thể mang khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不加密的连接不能携带密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密的連線不能攜帶金鑰。"
          }
        }
      }
    },
    "An unencrypted connection can't carry a key. Change the address and connection type to Public HTTPS." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن يحمل الاتصال غير المشفر مفتاحًا. قم بتغيير العنوان ونوع الاتصال إلى HTTPS العام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine unverschlüsselte Verbindung kann keinen Schlüssel enthalten. Ändern Sie die Adresse und den Verbindungstyp in „Öffentliches HTTPS“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unencrypted connection can't carry a key. Change the address and connection type to Public HTTPS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conexión no cifrada no puede transportar una clave. Cambia la dirección y el tipo de conexión a HTTPS público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion non chiffrée ne peut pas contenir de clé. Modifiez l'adresse et le type de connexion en HTTPS public."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक अनएन्क्रिप्टेड कनेक्शन कुंजी नहीं ले जा सकता। पता और कनेक्शन प्रकार को सार्वजनिक HTTPS में बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi yang tidak terenkripsi tidak dapat membawa kunci. Ubah alamat dan jenis koneksi menjadi HTTPS Publik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていない接続ではキーを運ぶことができません。アドレスと接続タイプをパブリック HTTPS に変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화되지 않은 연결은 키를 전달할 수 없습니다. 주소와 연결 유형을 공용 HTTPS로 변경합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conexão não criptografada não pode conter uma chave. Altere o endereço e o tipo de conexão para HTTPS público."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незашифрованное соединение не может передавать ключ. Измените адрес и тип подключения на Public HTTPS."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อที่ไม่เข้ารหัสส่งคีย์ไม่ได้ เปลี่ยนที่อยู่และประเภทการเชื่อมต่อเป็น Public HTTPS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifrelenmemiş bir bağlantı anahtar taşıyamaz. Adresi ve bağlantı türünü Genel HTTPS olarak değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối không được mã hóa không thể mang theo khóa. Thay đổi địa chỉ và loại kết nối thành HTTPS công khai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不加密的连接不能携带密钥。请将地址和连接安全改为公网 HTTPS。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密的連線不能攜帶金鑰。請將位址和連線方式改為公開網路 HTTPS。"
          }
        }
      }
    },
