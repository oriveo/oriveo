    "Tap a model in the catalog to view Advanced first. No request is sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على نموذج في الكتالوج لعرض «متقدم» أولًا، ولن يُرسَل أي طلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe im Katalog auf ein Modell, um zuerst „Erweitert“ anzusehen – dabei wird keine Anfrage gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a model in the catalog to view Advanced first. No request is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un modelo del catálogo para ver primero «Avanzado»; no se envía ninguna solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un modèle du catalogue pour consulter d’abord « Avancé » : aucune requête n’est envoyée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले “उन्नत” देखने के लिए कैटलॉग में किसी मॉडल पर टैप करें, इससे कोई अनुरोध नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk model di katalog untuk melihat “Lanjutan” terlebih dahulu tanpa mengirim permintaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログのモデルをタップすると、リクエストを送らずに先に「詳細」を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카탈로그에서 모델을 탭하면 요청 없이 “고급”을 먼저 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um modelo do catálogo para ver “Avançado” antes; nenhuma solicitação é enviada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на модель в каталоге, чтобы сначала открыть «Дополнительно», — запрос при этом не отправляется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะโมเดลในแคตตาล็อกเพื่อดู “ขั้นสูง” ก่อนได้โดยไม่ส่งคำขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce “Gelişmiş” bölümüne bakmak için katalogdaki bir modele dokunun; bu sırada istek gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một mô hình trong danh mục để xem “Nâng cao” trước mà không gửi yêu cầu nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点目录里的模型可先看「高级」，不发请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點目錄裡的模型可先查看「進階」，不會發送請求。"
          }
        }
      }
    },
