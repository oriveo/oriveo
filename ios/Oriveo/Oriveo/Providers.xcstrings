    "MiniMax offers multiple official endpoints. Choose the one that matches your account region.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax offers multiple official Request URLs. Choose the one that matches your account region."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفّر MiniMax عدة عناوين طلب رسمية. اختر العنوان المطابق لمنطقة حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax bietet mehrere offizielle Request-URLs. Wähle die URL, die zu deiner Kontoregion passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax ofrece varias URL de solicitud oficiales. Elige la que corresponda a la región de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax propose plusieurs URL de requête officielles. Choisissez celle qui correspond à la région de votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax कई आधिकारिक अनुरोध URL प्रदान करता है। अपने खाता क्षेत्र से मेल खाता URL चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax menyediakan beberapa URL permintaan resmi. Pilih yang sesuai dengan wilayah akun Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax には複数の公式リクエスト URL があります。アカウントのリージョンに合うものを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax는 여러 공식 요청 URL을 제공합니다. 계정 지역에 맞는 URL을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A MiniMax oferece várias URLs de solicitação oficiais. Escolha a que corresponde à região da sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax предлагает несколько официальных URL запросов. Выберите URL, соответствующий региону вашего аккаунта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax มี URL คำขออย่างเป็นทางการหลายรายการ เลือกรายการที่ตรงกับภูมิภาคของบัญชีคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax birden fazla resmî istek URL’si sunar. Hesap bölgenize uygun olanı seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax cung cấp nhiều URL yêu cầu chính thức. Chọn URL phù hợp với khu vực tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax 提供多个官方请求 URL，请选择与你的账号区域一致的 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MiniMax 提供多個官方請求 URL，請選擇與你的帳號區域相符的 URL。"
          }
        }
      }
    },
