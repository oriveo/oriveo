    "Results are saved to this model’s capabilities. You can override them in Advanced." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظت النتائج في قدرات هذا النموذج. يمكن تغييرها من «متقدم»."
