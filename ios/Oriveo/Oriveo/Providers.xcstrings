    "SiliconFlow API keys are region-specific. Choose the endpoint that matches your account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف مفاتيح API الخاصة بـ SiliconFlow حسب منطقة الحساب. اختر عنوان الطلب المطابق لحسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow-API-Schlüssel sind an die Kontoregion gebunden. Wähle die Request-URL, die zu deinem Konto passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API keys are region-specific. Choose the Request URL that matches your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API de SiliconFlow dependen de la región de la cuenta. Elige la URL de solicitud correspondiente a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API SiliconFlow dépendent de la région du compte. Choisissez l’URL de requête correspondant à votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API कुंजियां खाते के क्षेत्र से जुड़ी होती हैं। अपने खाते से मेल खाता अनुरोध URL चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API SiliconFlow terikat pada wilayah akun. Pilih URL permintaan yang sesuai dengan akun Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API キーはアカウントの地域に紐づいています。アカウントに合うリクエスト URL を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API 키는 계정 지역에 연결됩니다. 계정에 맞는 요청 URL을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de API da SiliconFlow dependem da região da conta. Escolha a URL de solicitação correspondente à sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи API SiliconFlow привязаны к региону аккаунта. Выберите URL запроса, соответствующий вашему аккаунту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API ของ SiliconFlow ผูกกับภูมิภาคของบัญชี เลือก URL คำขอที่ตรงกับบัญชีของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API anahtarları hesap bölgesine bağlıdır. Hesabınızla eşleşen istek URL'sini seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API SiliconFlow gắn với khu vực tài khoản. Chọn URL yêu cầu khớp với tài khoản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API Key 与账号区域绑定，请选择对应的请求 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SiliconFlow API Key 與帳號區域綁定，請選擇對應的請求 URL。"
          }
        }
      }
    },
