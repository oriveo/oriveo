        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่นี้ไม่ตรงกับวิธีการเชื่อมต่อ เปลี่ยนวิธีการเชื่อมต่อเพื่อดำเนินการต่อ"
