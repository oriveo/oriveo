    "Deleting this provider also removes its related chats and default model configuration.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي حذف هذا المزوّد أيضًا إلى إزالة الدردشات ذات الصلة وتكوين النموذج الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Löschen dieses Anbieters werden auch die zugehörigen Chats und die Standardmodellkonfiguration entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar este proveedor también se eliminan sus chats relacionados y la configuración del modelo predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de ce fournisseur supprime également ses discussions associées et la configuration du modèle par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रदाता को हटाने से इसकी संबंधित चैट और डिफ़ॉल्ट मॉडल कॉन्फ़िगरेशन भी हट जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus penyedia ini juga menghapus obrolan terkait dan konfigurasi model defaultnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーを削除すると、関連するチャットとデフォルトのモデル設定も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공업체를 삭제하면 관련 채팅 및 기본 모델 구성도 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão deste provedor também remove os chats relacionados e a configuração do modelo padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление этого поставщика также удаляет связанные с ним чаты и конфигурацию модели по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลบผู้ให้บริการรายนี้จะลบการแชทที่เกี่ยวข้องและการกำหนดค่าโมเดลเริ่มต้นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sağlayıcının silinmesi aynı zamanda ilgili sohbetleri ve varsayılan model yapılandırmasını da kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xóa nhà cung cấp này cũng sẽ xóa các cuộc trò chuyện liên quan và cấu hình mô hình mặc định của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此服务商同时会移除相关的对话和默认模型配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此服務商也會刪除其相關的聊天和預設模型配置。"
          }
        }
      }
    },
    "Depends on the current thinking level; it can change when you switch levels.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتمد على مستوى التفكير الحالي؛ وقد يتغيّر عند تبديل المستوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt von der aktuellen Denkstufe ab; kann sich beim Wechsel ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Depende del nivel de pensamiento actual; puede cambiar al cambiar de nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépend du niveau de réflexion actuel ; peut changer si vous changez de niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान थिंकिंग स्तर पर निर्भर; स्तर बदलने पर यह बदल सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergantung pada tingkat berpikir saat ini; bisa berubah saat Anda mengganti tingkat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の思考レベルによって変わります。レベルを切り替えると変化することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사고 단계에 따라 달라지며, 단계를 바꾸면 변할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depende do nível de raciocínio atual; pode mudar ao trocar de nível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зависит от текущего уровня размышления; может измениться при смене уровня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้นกับระดับการคิดปัจจุบัน อาจเปลี่ยนเมื่อสลับระดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli düşünme düzeyine bağlıdır; düzeyi değiştirince değişebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ thuộc vào mức suy nghĩ hiện tại; có thể thay đổi khi bạn đổi mức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取决于当前思考档位，切换档位后可能变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取決於目前思考檔位，切換檔位後可能變化"
          }
        }
      }
    },
