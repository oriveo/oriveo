    "Fill in the address, key, model and protocol yourself. One tiny request is sent before saving to confirm it works." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل العنوان والمفتاح والنموذج والبروتوكول يدويًا. قبل الحفظ يُرسَل طلب صغير جدًا للتأكد من أن كل شيء يعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Adresse, Schlüssel, Modell und Protokoll selbst ein. Vor dem Speichern wird eine winzige Anfrage gesendet, um zu prüfen, ob alles funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill in the address, key, model and protocol yourself. One tiny request is sent before saving to confirm it works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce a mano la dirección, la clave, el modelo y el protocolo. Antes de guardar se envía una solicitud mínima para comprobar que todo funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez vous-même l’adresse, la clé, le modèle et le protocole. Avant l’enregistrement, une toute petite requête est envoyée pour vérifier que tout fonctionne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पता, कुंजी, मॉडल और प्रोटोकॉल खुद भरें। सहेजने से पहले एक बहुत छोटा अनुरोध भेजकर जाँचा जाता है कि सब ठीक काम कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi sendiri alamat, kunci, model, dan protokolnya. Sebelum disimpan, satu permintaan kecil dikirim untuk memastikan semuanya berfungsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレス、キー、モデル、プロトコルを自分で入力します。保存の前に、ごく小さなリクエストを 1 回送って使えることを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소, 키, 모델, 프로토콜을 직접 입력합니다. 저장하기 전에 아주 작은 요청을 한 번 보내 작동하는지 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe manualmente o endereço, a chave, o modelo e o protocolo. Antes de salvar, uma solicitação mínima é enviada para confirmar que tudo funciona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите адрес, ключ, модель и протокол вручную. Перед сохранением отправляется один крошечный запрос, чтобы убедиться, что всё работает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอกที่อยู่ คีย์ โมเดล และโปรโตคอลด้วยตนเอง ก่อนบันทึก ระบบจะส่งคำขอขนาดเล็กมากหนึ่งครั้งเพื่อยืนยันว่าใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresi, anahtarı, modeli ve protokolü kendiniz girin. Kaydetmeden önce her şeyin çalıştığını doğrulamak için çok küçük bir istek gönderilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự nhập địa chỉ, khóa, mô hình và giao thức. Trước khi lưu, một yêu cầu rất nhỏ sẽ được gửi để xác nhận mọi thứ hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己填地址、密钥、模型和协议。保存前会发一次极小的请求确认能用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己填寫位址、金鑰、模型和協議。儲存前會傳送一次極小的請求，確認可以使用。"
          }
        }
      }
    },
    "Fixed by the model; changing it has no effect." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّده النموذج؛ تغييره لن يؤثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Modell festgelegt; Änderungen haben keine Auswirkung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijado por el modelo; cambiarlo no tiene efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixé par le modèle ; le modifier n’a aucun effet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडल द्वारा तय; बदलने से कोई असर नहीं होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditetapkan oleh model; mengubahnya tidak berpengaruh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル側で固定されており、変更しても反映されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델이 고정한 값이라 바꿔도 적용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixado pelo modelo; alterá-lo não tem efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задано моделью; изменение ничего не даст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลกำหนดไว้ตายตัว แก้แล้วไม่มีผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model tarafından sabitlenmiştir; değiştirmenin etkisi olmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do mô hình cố định; thay đổi sẽ không có tác dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由模型固定，改了不会生效"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由模型固定，改了不會生效"
          }
        }
      }
    },
    "Follows the chat template. Set it in Model Options in chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع قالب المحادثة. اضبطه من «خيارات النموذج» في المحادثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt dem Chat-Template. Einstellbar im Chat unter „Modelloptionen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follows the chat template. Set it in Model Options in chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue la plantilla de chat. Ajústalo en «Opciones del modelo» dentro del chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit le template de chat. Réglez-le dans « Options du modèle » dans le chat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट टेम्पलेट के अनुसार चालू या बंद होता है। इसे चैट में “मॉडल विकल्प” से सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengikuti templat chat. Atur di “Opsi Model” pada chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットテンプレートに従って切り替わります。チャットの「モデルオプション」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 템플릿에 따라 켜고 꺼집니다. 채팅의 ‘모델 옵션’에서 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue o template de chat. Ajuste em “Opções do modelo” no chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зависит от шаблона чата. Настройте в разделе «Параметры модели» в чате."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดปิดตามเทมเพลตแชต ตั้งค่าได้ที่ “ตัวเลือกโมเดล” ในแชต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet şablonuna göre açılıp kapanır. Sohbette “Model Seçenekleri” bölümünden ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật tắt theo mẫu chat. Chỉnh trong “Tùy chọn mô hình” khi chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按对话模板开关，在聊天「模型选项」里设。"
          }
        },
        "zh-Hant" : {
