    "Applies to new messages on this connection with this model, until you override them in a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على الرسائل الجديدة في هذا الاتصال مع هذا النموذج، إلى أن تتجاوزه في محادثة ما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Nachrichten über diese Verbindung mit diesem Modell, bis du sie in einer Unterhaltung überschreibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new messages on this connection with this model, until you override them in a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a los mensajes nuevos de esta conexión con este modelo, hasta que los sustituyas en una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux nouveaux messages sur cette connexion avec ce modèle, jusqu’à ce que vous les remplaciez dans une conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन पर इस मॉडल के साथ भेजे जाने वाले नए संदेशों पर लागू होता है, जब तक आप किसी बातचीत में इसे बदल न दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk pesan baru pada koneksi ini dengan model ini, sampai Anda menimpanya di sebuah percakapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続でこのモデルを使う新しいメッセージに適用されます（会話ごとに上書きするまで）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서 이 모델을 사용하는 새 메시지에 적용됩니다. 대화에서 따로 재정의하기 전까지 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a novas mensagens nesta conexão com este modelo, até você substituí-las em uma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к новым сообщениям в этом подключении с этой моделью, пока вы не переопределите их в диалоге."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับข้อความใหม่บนการเชื่อมต่อนี้ที่ใช้โมเดลนี้ จนกว่าคุณจะกำหนดค่าทับในบทสนทนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıda bu modelle gönderilen yeni mesajlar için geçerlidir; bir sohbette geçersiz kılana kadar sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho tin nhắn mới trên kết nối này với mô hình này, cho đến khi bạn ghi đè trong một cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对这条连接上使用该模型的新消息生效，直到你在某个对话里单独覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對這條連線上使用此模型的新訊息生效，直到你在某個對話中另行覆寫。"
          }
        }
      }
    },
