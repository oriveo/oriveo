    "Key saved, but fetching its model list was interrupted by another change. Use Detect again to fetch it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ المفتاح، لكن جلب قائمة نماذجه توقّف بسبب تغيير آخر. اضغط على «إعادة الاكتشاف» لجلبها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel gespeichert, aber das Abrufen seiner Modellliste wurde durch eine andere Änderung unterbrochen. Tippe auf „Erneut erkennen“, um sie abzurufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key saved, but fetching its model list was interrupted by another change. Use Detect again to fetch it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se guardó, pero otro cambio interrumpió la obtención de su lista de modelos. Toca «Volver a detectar» para obtenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé enregistrée, mais la récupération de sa liste de modèles a été interrompue par une autre modification. Touchez « Détecter à nouveau » pour la récupérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुंजी सेव हो गई, लेकिन किसी दूसरे बदलाव की वजह से इसकी मॉडल सूची लाना बीच में रुक गया। इसे लाने के लिए “फिर से पता लगाएँ” पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci tersimpan, tetapi pengambilan daftar modelnya terputus oleh perubahan lain. Ketuk “Deteksi ulang” untuk mengambilnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは保存しましたが、別の変更によりモデル一覧の取得が中断されました。「再検出」で取得し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 저장했지만 다른 변경으로 모델 목록 가져오기가 중단되었습니다. “다시 감지”를 눌러 다시 가져오세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave foi salva, mas outra alteração interrompeu a busca da lista de modelos dela. Toque em “Detectar novamente” para buscá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ сохранён, но получение его списка моделей прервало другое изменение. Нажмите «Определить заново», чтобы получить его."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกคีย์แล้ว แต่การดึงรายการโมเดลของคีย์นี้ถูกการเปลี่ยนแปลงอื่นขัดจังหวะ แตะ “ตรวจจับอีกครั้ง” เพื่อดึงใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar kaydedildi ancak model listesinin alınması başka bir değişiklik nedeniyle yarıda kesildi. Almak için “Yeniden algıla”ya dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu khóa nhưng việc lấy danh sách mô hình của khóa này bị một thay đổi khác làm gián đoạn. Nhấn “Phát hiện lại” để lấy lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥已保存，但拉取它的模型列表时被另一项改动打断了。点「重新检测」再拉取一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金鑰已儲存，但取得它的模型列表時被另一項變更中斷了。點「重新偵測」再取得一次。"
          }
        }
      }
    },
