            "value": "Ayarlar’da yerel ağ erişimine izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập mạng cục bộ trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许本地网络访问。"
          }
