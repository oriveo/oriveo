    "Models will be re-synced automatically after replacing the key.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة مزامنة النماذج تلقائيًا بعد استبدال المفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Ersetzen des Schlüssels werden die Modelle automatisch neu synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se resincronizarán automáticamente después de reemplazar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles seront resynchronisés automatiquement après le remplacement de la clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी बदलने के बाद मॉडल स्वचालित रूप से पुन: समन्वयित हो जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model akan disinkronkan ulang secara otomatis setelah mengganti kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを交換すると、モデルは自動的に再同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 교체하면 모델이 자동으로 다시 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos serão sincronizados novamente automaticamente após a substituição da chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели будут повторно синхронизированы автоматически после замены ключа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลจะซิงค์ใหม่โดยอัตโนมัติหลังจากเปลี่ยนคีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar değiştirildikten sonra modeller otomatik olarak yeniden senkronize edilecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mô hình sẽ được tự động đồng bộ lại sau khi thay thế khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换密钥后将自动重新同步模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換密鑰後模型將自動重新同步。"
          }
        }
      }
    },
