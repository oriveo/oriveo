    "Keys stay on this device and aren’t uploaded by cloud sync." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المفاتيح على هذا الجهاز فقط ولا تُرفع عبر المزامنة السحابية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
