        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 카탈로그를 새로고침할 수 없습니다. 현재 모델은 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o catálogo de modelos. Os modelos atuais continuam disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить каталог моделей. Текущие модели по-прежнему доступны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
