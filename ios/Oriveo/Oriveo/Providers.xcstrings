    "Neither a model catalog nor a known generation endpoint answered at this address. Check the address, or choose the protocol manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب كتالوج النماذج ولا أي عنوان طلب معروف لتوليد المحتوى على هذا العنوان. تحقق من العنوان أو اختر البروتوكول يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse hat weder ein Modellkatalog noch eine bekannte Anfrage-URL zur Generierung geantwortet. Prüfe die Adresse oder wähle das Protokoll manuell aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither a model catalog nor a known generation endpoint answered at this address. Check the address, or choose the protocol manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta dirección no respondió ni un catálogo de modelos ni una URL de solicitud de generación conocida. Comprueba la dirección o elige el protocolo manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À cette adresse, ni le catalogue de modèles ni une URL de requête de génération connue n’ont répondu. Vérifiez l’adresse ou choisissez le protocole manuellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पते पर न तो मॉडल कैटलॉग और न ही कोई ज्ञात जनरेशन अनुरोध URL ने जवाब दिया। पता जाँचें, या प्रोटोकॉल मैन्युअल रूप से चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada alamat ini, tidak ada katalog model maupun URL permintaan generasi yang dikenal yang merespons. Periksa alamatnya atau pilih protokol secara manual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスでは、モデルカタログも既知の生成用リクエスト URL も応答しませんでした。アドレスを確認するか、プロトコルを手動で選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소에서는 모델 카탈로그도 알려진 생성 요청 URL도 응답하지 않았습니다. 주소를 확인하거나 프로토콜을 직접 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste endereço, nem um catálogo de modelos nem uma URL de solicitação de geração conhecida respondeu. Verifique o endereço ou escolha o protocolo manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По этому адресу не ответил ни каталог моделей, ни известный URL генерации. Проверьте адрес или выберите протокол вручную."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่นี้ไม่มีทั้งแค็ตตาล็อกโมเดลและ URL คำขอสำหรับการสร้างที่รู้จักตอบกลับ ตรวจสอบที่อยู่ หรือเลือกโปรโตคอลด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adreste ne model kataloğu ne de bilinen bir üretim istek URL’si yanıt verdi. Adresi kontrol edin veya protokolü elle seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tại địa chỉ này, cả danh mục mô hình lẫn URL yêu cầu tạo sinh đã biết đều không phản hồi. Hãy kiểm tra địa chỉ hoặc chọn giao thức thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个地址上既没有模型目录，也没有任何已知的生成请求 URL 响应。请检查地址，或手动选择协议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個位址上既沒有模型目錄，也沒有任何已知的生成請求 URL 回應。請檢查位址，或手動選擇協議。"
          }
        }
      }
    },
