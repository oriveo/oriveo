    "Start with safe defaults, then adjust transport, auth, headers, and query parameters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالإعدادات الافتراضية الآمنة، ثم عدّل البروتوكول والمصادقة والرؤوس ومعلمات الاستعلام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit sicheren Standardwerten und passe dann Protokoll, Authentifizierung, Header und Abfrageparameter an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with safe defaults, then adjust the protocol, authentication, headers, and query parameters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con valores seguros y luego ajusta el protocolo, la autenticación, las cabeceras y los parámetros de consulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec des valeurs sûres, puis ajustez le protocole, l’authentification, les en-têtes et les paramètres de requête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित डिफ़ॉल्ट से शुरू करें, फिर प्रोटोकॉल, प्रमाणीकरण, हेडर और क्वेरी पैरामीटर समायोजित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan nilai default yang aman, lalu sesuaikan protokol, autentikasi, header, dan parameter kueri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な既定値から始めて、プロトコル、認証、ヘッダー、クエリパラメータを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 기본값으로 시작한 뒤 프로토콜, 인증, 헤더 및 쿼리 매개변수를 조정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com padrões seguros e depois ajuste o protocolo, a autenticação, os cabeçalhos e os parâmetros de consulta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с безопасных значений по умолчанию, затем настройте протокол, аутентификацию, заголовки и параметры запроса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากค่าเริ่มต้นที่ปลอดภัย แล้วปรับโปรโตคอล การยืนยันตัวตน ส่วนหัว และพารามิเตอร์คำขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli varsayılanlarla başlayın; ardından protokolü, kimlik doğrulamayı, başlıkları ve sorgu parametrelerini ayarlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với các giá trị mặc định an toàn, rồi điều chỉnh giao thức, xác thực, tiêu đề và tham số truy vấn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从安全默认值开始，再调整协议、认证方式、Header 和 Query 参数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從安全預設值開始，再調整協議、驗證方式、Header 和 Query 參數。"
          }
        }
      }
    },
