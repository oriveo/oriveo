            "value" : "Der aktuelle Tarif deines xAI-Kontos erlaubt die Nutzung des Grok-Abos in Drittanbieter-Apps nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your xAI account's current plan doesn't allow using the Grok subscription in third-party apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan actual de tu cuenta de xAI no permite usar la suscripción de Grok en aplicaciones de terceros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'offre actuelle de votre compte xAI n'autorise pas l'utilisation de l'abonnement Grok dans des applications tierces."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके xAI खाते का मौजूदा प्लान थर्ड-पार्टी ऐप्स में Grok सब्सक्रिप्शन के उपयोग की अनुमति नहीं देता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket akun xAI Anda saat ini tidak mengizinkan penggunaan langganan Grok di aplikasi pihak ketiga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの xAI アカウントの現在のプランでは、サードパーティアプリでの Grok サブスクリプション利用が許可されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 xAI 계정의 요금제로는 서드파티 앱에서 Grok 구독을 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano atual da sua conta xAI não permite usar a assinatura do Grok em aplicativos de terceiros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий тариф вашего аккаунта xAI не позволяет использовать подписку Grok в сторонних приложениях."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพ็กเกจปัจจุบันของบัญชี xAI ของคุณไม่อนุญาตให้ใช้การสมัครสมาชิก Grok ในแอปของบุคคลที่สาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xAI hesabının mevcut planı, Grok aboneliğinin üçüncü taraf uygulamalarda kullanılmasına izin vermiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói hiện tại của tài khoản xAI của bạn không cho phép dùng gói đăng ký Grok trong ứng dụng bên thứ ba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 xAI 账号当前订阅档位不支持在第三方应用中使用 Grok 订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 xAI 帳號目前訂閱方案不支援在第三方應用中使用 Grok 訂閱。"
          }
        }
      }
