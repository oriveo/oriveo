    "Parameters you leave unset aren’t sent; the provider uses the model’s defaults." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعاملات غير المحددة لا تُرسل؛ يستخدم المزوّد الإعدادات الافتراضية للنموذج."
          }
        },
        "de" : {
