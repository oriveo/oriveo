    },
    "This connection's upstream does not offer this model. Open Providers → this connection → Model Library and enable a model it actually offers. You can ask its administrator for the exact list of available model IDs." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخادم المصدر لهذا الاتصال لا يوفّر هذا النموذج. انتقل إلى: مزودو الخدمة ← هذا الاتصال ← مكتبة النماذج، وفعّل نموذجًا يوفّره فعلًا. يمكنك أن تطلب من الجهة المشغّلة له القائمة الدقيقة لمعرّفات النماذج المتاحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Upstream dieser Verbindung bietet dieses Modell nicht an. Öffne Anbieter → diese Verbindung → Modellbibliothek und aktiviere ein Modell, das dort tatsächlich angeboten wird. Die genaue Liste der verfügbaren Modell-IDs kannst du bei ihrem Administrator erfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection's upstream does not offer this model. Open Providers → this connection → Model Library and enable a model it actually offers. You can ask its administrator for the exact list of available model IDs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
