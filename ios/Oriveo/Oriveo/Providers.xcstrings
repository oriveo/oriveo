        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse ne correspond pas au mode de connexion. Modifiez le mode de connexion pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पता कनेक्शन विधि से मेल नहीं खाता। जारी रखने के लिए कनेक्शन विधि बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat ini tidak cocok dengan metode koneksi. Ubah metode koneksi untuk melanjutkan."
