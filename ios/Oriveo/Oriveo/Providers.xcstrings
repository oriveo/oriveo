        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ब्राउज़र में अपने ChatGPT खाते से साइन इन करेंगे, फिर यहाँ वापस आएँगे। आपके संदेश OpenAI Codex द्वारा प्रोसेस किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan masuk dengan akun ChatGPT di browser, lalu kembali ke sini. Pesan Anda diproses oleh OpenAI Codex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで ChatGPT アカウントにログインしたあと、この画面に戻ってください。メッセージは OpenAI Codex で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 ChatGPT 계정으로 로그인한 뒤 이 화면으로 돌아오세요. 메시지는 OpenAI Codex에서 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
