    "Each model's protocol is detected on its own. Models that can't be detected use Chat Completions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُكتشَف بروتوكول كل نموذج على حدة. النماذج التي يتعذّر اكتشاف بروتوكولها تستخدم Chat Completions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll wird für jedes Modell einzeln erkannt. Modelle, bei denen das nicht gelingt, verwenden Chat Completions."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each model's protocol is detected on its own. Models that can't be detected use Chat Completions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El protocolo se detecta por separado para cada modelo. Los modelos cuyo protocolo no se pueda detectar usan Chat Completions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le protocole est détecté séparément pour chaque modèle. Les modèles dont le protocole n’a pas pu être détecté utilisent Chat Completions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर मॉडल का प्रोटोकॉल अलग से पहचाना जाता है। जिन मॉडलों का प्रोटोकॉल पहचाना नहीं जा सका, वे Chat Completions का उपयोग करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokol dideteksi sendiri-sendiri untuk tiap model. Model yang protokolnya tidak terdeteksi memakai Chat Completions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロトコルはモデルごとに検出されます。検出できない場合は Chat Completions を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로토콜은 모델마다 따로 감지합니다. 감지되지 않으면 Chat Completions를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O protocolo é detectado separadamente para cada modelo. Os modelos cujo protocolo não puder ser detectado usam Chat Completions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протокол определяется отдельно для каждой модели. Модели, для которых определить его не удалось, используют Chat Completions."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบบจะตรวจจับโปรโตคอลแยกกันทีละโมเดล โมเดลที่ตรวจจับโปรโตคอลไม่ได้จะใช้ Chat Completions"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokol her model için ayrı ayrı algılanır. Protokolü algılanamayan modeller Chat Completions kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao thức được phát hiện riêng cho từng mô hình. Mô hình không phát hiện được giao thức sẽ dùng Chat Completions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐个模型识别协议；识别不出的按 Chat Completions 发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐一偵測每個模型的協議；偵測不出的模型使用 Chat Completions。"
          }
        }
      }
    },
