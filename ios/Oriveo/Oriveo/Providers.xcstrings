    "Detect again refreshes the catalog and each model’s protocol. Enabled models are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحدِّث «إعادة الاكتشاف» الكتالوج وبروتوكول كل نموذج، مع الإبقاء على النماذج المفعّلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Erneut erkennen“ aktualisiert den Katalog und das Protokoll jedes Modells. Aktivierte Modelle bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detect again refreshes the catalog and each model’s protocol. Enabled models are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Volver a detectar» actualiza el catálogo y el protocolo de cada modelo. Los modelos activados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Détecter à nouveau » actualise le catalogue et le protocole de chaque modèle. Les modèles activés sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“फिर से पता लगाएँ” कैटलॉग और हर मॉडल का प्रोटोकॉल रीफ़्रेश करता है। चालू मॉडल बने रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deteksi ulang” memperbarui katalog dan protokol tiap model. Model yang aktif tetap dipertahankan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再検出で更新されるのは、カタログと各モデルのプロトコルだけです。有効なモデルは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 감지하면 카탈로그와 모델별 프로토콜만 새로 고칩니다. 활성화된 모델은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Detectar novamente” atualiza o catálogo e o protocolo de cada modelo. Os modelos ativados são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Определить заново» обновляет каталог и протокол каждой модели. Включённые модели сохранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ตรวจจับอีกครั้ง” จะรีเฟรชแค็ตตาล็อกและโปรโตคอลของแต่ละโมเดล โมเดลที่เปิดใช้อยู่จะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Yeniden algıla” kataloğu ve her modelin protokolünü yeniler. Etkin modeller korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Phát hiện lại” sẽ làm mới danh mục và giao thức của từng mô hình. Các mô hình đã bật vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新检测只刷新目录与每个模型的协议，不删除已启用的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新偵測只會更新目錄與每個模型的協議，不會刪除已啟用的模型。"
          }
        }
      }
    },
