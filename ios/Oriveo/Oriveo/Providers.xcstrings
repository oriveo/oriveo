    "Please add a chat model to this relay before using image generation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى إضافة نموذج محادثة إلى هذا النموذج اللغوي الكبير المخصص قبل استخدام إنشاء الصور."
          }
        },
        "de": {
