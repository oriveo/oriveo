    "Use an HTTPS request URL. Local-network and VPN addresses are supported when they use a valid TLS certificate.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم عنوان URL للطلب يعمل عبر HTTPS. تُدعَم عناوين الشبكة المحلية وVPN عندما تستخدم شهادة TLS صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine HTTPS-Anfrage-URL. Adressen im lokalen Netzwerk und über VPN werden unterstützt, wenn sie ein gültiges TLS-Zertifikat verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS request URL. Local-network and VPN addresses are supported when they use a valid TLS certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una URL de solicitud HTTPS. Se admiten direcciones de red local y VPN cuando utilizan un certificado TLS válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une URL de requête HTTPS. Les adresses du réseau local et du VPN sont prises en charge avec un certificat TLS valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS अनुरोध URL का उपयोग करें। मान्य TLS प्रमाणपत्र वाले स्थानीय नेटवर्क और VPN पते समर्थित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan URL permintaan HTTPS. Alamat jaringan lokal dan VPN didukung jika menggunakan sertifikat TLS yang valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS のリクエスト URL を使用してください。有効な TLS 証明書を使用するローカルネットワークと VPN のアドレスに対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 요청 URL을 사용하세요. 유효한 TLS 인증서를 사용하는 로컬 네트워크 및 VPN 주소가 지원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma URL de solicitação HTTPS. Endereços de rede local e VPN são compatíveis quando usam um certificado TLS válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте URL-адрес запроса HTTPS. Адреса локальной сети и VPN поддерживаются при наличии действительного TLS-сертификата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ URL คำขอแบบ HTTPS รองรับที่อยู่เครือข่ายภายในและ VPN เมื่อใช้ใบรับรอง TLS ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS istek URL'si kullanın. Geçerli bir TLS sertifikası kullanan yerel ağ ve VPN adresleri desteklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng URL yêu cầu HTTPS. Địa chỉ mạng cục bộ và VPN được hỗ trợ khi sử dụng chứng chỉ TLS hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 请求地址。本地网络和 VPN 地址使用有效 TLS 证书时也受支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 HTTPS 請求網址。本機網路和 VPN 網址使用有效 TLS 憑證時也受支援。"
          }
        }
      }
    },
    "Use only if automatic detection fails.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا فقط عند فشل الاكتشاف التلقائي."
          }
        },
        "de": {
