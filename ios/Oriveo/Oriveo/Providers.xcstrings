    "If auto-sync fails or model listing isn't supported, you can still continue.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فشلت المزامنة التلقائية أو لم تكن قائمة النماذج مدعومة، فلا يزال بإمكانك المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die automatische Synchronisierung fehlschlägt oder die Modellauflistung nicht unterstützt wird, können Sie trotzdem fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la sincronización automática falla o la lista de modelos no es compatible, aún puedes continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la synchronisation automatique échoue ou si la liste des modèles n'est pas prise en charge, vous pouvez toujours continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि ऑटो-सिंक विफल हो जाता है या मॉडल सूची समर्थित नहीं है, तो भी आप जारी रख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sinkronisasi otomatis gagal atau daftar model tidak didukung, Anda masih dapat melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期が失敗する場合、またはモデルのリストがサポートされていない場合でも、続行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 동기화가 실패하거나 모델 목록이 지원되지 않는 경우에도 계속할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a sincronização automática falhar ou a listagem de modelos não for compatível, você ainda poderá continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если автосинхронизация не удалась или список моделей не поддерживается, вы все равно можете продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากการซิงค์อัตโนมัติล้มเหลวหรือไม่รองรับการลงรายการรุ่น คุณยังคงสามารถดำเนินการต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik senkronizasyon başarısız olursa veya model listeleme desteklenmiyorsa yine de devam edebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu tự động đồng bộ hóa không thành công hoặc danh sách mẫu máy không được hỗ trợ, bạn vẫn có thể tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自动同步失败或不支持模型列表，你仍然可以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自動同步失敗或不支援模型列表，你仍然可以繼續。"
          }
        }
      }
    },
    "Image Gen": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توليد صور"
          }
        },
        "de": {
