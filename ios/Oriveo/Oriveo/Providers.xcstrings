    "Just enter one usable model ID. You don't need to understand the protocol details." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط أدخل معرف نموذج واحد قابل للاستخدام. لا تحتاج إلى فهم تفاصيل البروتوكول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einfach eine verwendbare Modell-ID ein. Du musst die Protokolldetails nicht verstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ingresa un ID de modelo que funcione. No necesitas entender los detalles del protocolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez simplement un ID de modèle utilisable. Vous n'avez pas besoin de comprendre les détails du protocole."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस एक प्रयोग करने योग्य मॉडल आईडी दर्ज करें। आपको प्रोटोकॉल विवरण समझने की आवश्यकता नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup masukkan satu ID model yang dapat digunakan. Anda tidak perlu memahami detail protokolnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用可能なモデル ID を 1 つ入力するだけです。プロトコルの詳細を理解する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 모델 ID를 하나만 입력하세요. 프로토콜 세부 사항을 이해할 필요는 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta inserir um ID de modelo utilizável. Você não precisa entender os detalhes do protocolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто введите один рабочий ID модели. Разбираться в деталях протокола не нужно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพียงป้อนรหัสรุ่นที่ใช้งานได้เพียงรหัสเดียว คุณไม่จำเป็นต้องเข้าใจรายละเอียดโปรโตคอล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir bir model kimliği girmeniz yeterlidir. Protokol ayrıntılarını anlamanıza gerek yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần nhập một ID mẫu có thể sử dụng được. Bạn không cần phải hiểu chi tiết giao thức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需输入一个可用的模型 ID，不需要了解协议细节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需輸入可用的模型 ID。你不需要了解協議細節。"
          }
        }
      }
    },
    "Just the address and key. Protocol and capabilities are detected per model." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل العنوان والمفتاح فقط. يُكتشف البروتوكول والقدرات تلقائيًا لكل نموذج على حدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Adresse und Schlüssel eingeben. Protokoll und Fähigkeiten werden für jedes Modell automatisch erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just the address and key. Protocol and capabilities are detected per model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la dirección y la clave. El protocolo y las capacidades se detectan automáticamente para cada modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez simplement l’adresse et la clé. Le protocole et les capacités sont détectés pour chaque modèle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस पता और कुंजी डालें। हर मॉडल का प्रोटोकॉल और क्षमताएँ अपने-आप पहचानी जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup alamat dan kunci. Protokol dan kemampuan dideteksi otomatis untuk setiap model."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスとキーを入れるだけ。プロトコルと機能は、モデルごとに自動で検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소와 키만 입력하면 됩니다. 프로토콜과 기능은 모델별로 자동 감지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o endereço e a chave. O protocolo e os recursos são detectados automaticamente para cada modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только адрес и ключ. Протокол и возможности определяются автоматически для каждой модели."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่ใส่ที่อยู่และคีย์ ระบบจะตรวจหาโปรโตคอลและความสามารถของแต่ละโมเดลให้เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca adres ve anahtar yeterli. Protokol ve yetenekler her model için ayrı ayrı algılanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần địa chỉ và khóa. Giao thức và khả năng được tự động phát hiện cho từng mô hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只填地址和密钥。每个模型用哪种协议、有什么能力，由自动检测逐个确定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要填位址和金鑰。每個模型用哪種協議、有哪些能力，都由自動偵測逐一確定。"
          }
        }
      }
    },
    "Just the address. Engine, channel and models are detected for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل العنوان فقط. يُكتشف المحرك والقناة والنماذج تلقائيًا."
