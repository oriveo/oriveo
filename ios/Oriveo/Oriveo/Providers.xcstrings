        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses benutzerdefinierte LLM erfordert das OpenAI Responses-Protokoll. Öffne Anbieter → dieses benutzerdefinierte LLM → Verbindungseinstellungen → Protokolltyp und wechsle zu „Codex style (Responses)“, dann versuche es erneut."
          }
        },
        "es": {
