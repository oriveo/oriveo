    "This engine requires an encrypted connection for its access token.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا المحرك اتصالاً مشفّرًا لرمز الوصول الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine benötigt für ihr Zugriffstoken eine verschlüsselte Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine requires an encrypted connection for its access token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor requiere una conexión cifrada para su token de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur nécessite une connexion chiffrée pour son jeton d’accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इंजन के ऐक्सेस टोकन के लिए एन्क्रिप्टेड कनेक्शन आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin ini memerlukan koneksi terenkripsi untuk token aksesnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンのアクセストークンには暗号化された接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔진의 액세스 토큰을 사용하려면 암호화된 연결이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo exige uma conexão criptografada para o token de acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для токена доступа этого движка требуется зашифрованное соединение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินนี้ต้องใช้การเชื่อมต่อที่เข้ารหัสสำหรับโทเค็นการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu motorun erişim belirteci için şifreli bağlantı gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ này yêu cầu kết nối được mã hóa để dùng mã truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎的访问令牌需要加密连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎的存取權杖需要加密連線。"
          }
        }
      }
    },
    "This image model does not accept the response_format parameter. Rename the model to start with gpt-image- or chatgpt-image-, or try a different image model ID.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقبل نموذج الصور هذا معامل response_format. سمّ النموذج بادئة gpt-image- أو chatgpt-image-، أو جرّب معرّف نموذج آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bildmodell akzeptiert den Parameter response_format nicht. Benenne das Modell mit dem Präfix gpt-image- oder chatgpt-image- um, oder versuche eine andere Modell-ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image model does not accept the response_format parameter. Rename the model to start with gpt-image- or chatgpt-image-, or try a different image model ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo de imagen no acepta el parámetro response_format. Renombra el modelo con el prefijo gpt-image- o chatgpt-image-, o prueba con otro ID de modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle d'image n'accepte pas le paramètre response_format. Renommez le modèle avec le préfixe gpt-image- ou chatgpt-image-, ou essayez un autre identifiant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इमेज मॉडल response_format पैरामीटर स्वीकार नहीं करता। मॉडल को gpt-image- या chatgpt-image- से शुरू होने वाला नाम दें, या कोई दूसरा मॉडल ID आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gambar ini tidak menerima parameter response_format. Ganti nama model dengan prefiks gpt-image- atau chatgpt-image-, atau coba ID model lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像モデルは response_format パラメータを受け付けません。モデル ID を gpt-image- または chatgpt-image- で始まるように変更するか、別のモデル ID を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지 모델은 response_format 매개변수를 받지 않습니다. 모델 ID를 gpt-image- 또는 chatgpt-image- 로 시작하도록 변경하거나, 다른 모델 ID를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo de imagem não aceita o parâmetro response_format. Renomeie o modelo com o prefixo gpt-image- ou chatgpt-image-, ou tente outro ID de modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель изображений не принимает параметр response_format. Переименуйте модель, начиная с gpt-image- или chatgpt-image-, либо попробуйте другой идентификатор модели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลรูปภาพนี้ไม่รองรับพารามิเตอร์ response_format เปลี่ยนชื่อโมเดลให้ขึ้นต้นด้วย gpt-image- หรือ chatgpt-image- หรือลองใช้ ID โมเดลอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüntü modeli response_format parametresini kabul etmiyor. Model adını gpt-image- veya chatgpt-image- ile başlayacak şekilde yeniden adlandırın veya başka bir model ID deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình ảnh này không chấp nhận tham số response_format. Đổi tên mô hình bắt đầu bằng gpt-image- hoặc chatgpt-image-, hoặc thử một ID mô hình khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片模型不接受 response_format 参数。请把模型 ID 改为以 gpt-image- 或 chatgpt-image- 开头，或换一个图片模型 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片模型不接受 response_format 參數。請把模型 ID 改為以 gpt-image- 或 chatgpt-image- 開頭，或換一個圖片模型 ID。"
          }
        }
      }
    },
    "This image model is missing a valid image generation route in its server profile. Please update the app or contact support.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتقد ملف تعريف الخادم لنموذج الصور هذا مسارًا صالحًا لتوليد الصور. حدّث التطبيق أو تواصل مع الدعم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Serverprofil dieses Bildmodells fehlt eine gültige Route für die Bilderzeugung. Aktualisiere die App oder kontaktiere den Support."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image model is missing a valid image generation route in its server profile. Please update the app or contact support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al perfil del servidor de este modelo de imagen le falta una ruta válida de generación de imágenes. Actualiza la app o contacta con soporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil serveur de ce modèle d’image ne contient pas de route valide de génération d’images. Mettez l’app à jour ou contactez l’assistance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इमेज मॉडल की सर्वर प्रोफ़ाइल में इमेज जनरेशन का मान्य रूट नहीं है। ऐप अपडेट करें या सहायता से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil server model gambar ini tidak memiliki rute pembuatan gambar yang valid. Perbarui aplikasi atau hubungi dukungan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像モデルのサーバープロファイルに有効な画像生成ルートがありません。アプリを更新するか、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지 모델의 서버 프로필에 유효한 이미지 생성 경로가 없습니다. 앱을 업데이트하거나 지원팀에 문의하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil de servidor deste modelo de imagem não tem uma rota válida de geração de imagens. Atualize o app ou entre em contato com o suporte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В серверном профиле этой модели изображений отсутствует корректный маршрут генерации изображений. Обновите приложение или обратитесь в поддержку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์เซิร์ฟเวอร์ของโมเดลรูปภาพนี้ไม่มีเส้นทางการสร้างรูปภาพที่ถูกต้อง โปรดอัปเดตแอปหรือติดต่อฝ่ายสนับสนุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüntü modelinin sunucu profilinde geçerli bir görüntü oluşturma rotası yok. Uygulamayı güncelleyin veya destek ekibiyle iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình máy chủ của mô hình hình ảnh này thiếu tuyến tạo hình ảnh hợp lệ. Hãy cập nhật ứng dụng hoặc liên hệ bộ phận hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图像模型的服务器配置中缺少有效的图像生成路由。请更新 App 或联系支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影像模型的伺服器設定檔缺少有效的影像生成路由。請更新 App 或聯絡支援。"
          }
        }
      }
    },
    "This looks like a local or LAN address. Over plain LAN HTTP, Oriveo won't send any credentials.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو هذا كعنوان محلي أو عنوان LAN. عبر LAN HTTP العادي، لن يرسل Oriveo أي بيانات اعتماد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sieht aus wie eine lokale oder LAN-Adresse. Über einfaches LAN-HTTP sendet Oriveo keine Anmeldeinformationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This looks like a local or LAN address. Over plain LAN HTTP, Oriveo won't send any credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto parece una dirección local o LAN. A través de LAN HTTP simple, Oriveo no enviará ninguna credencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ressemble à une adresse locale ou LAN. Sur un simple réseau HTTP LAN, Oriveo n'enverra aucune information d'identification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक स्थानीय या LAN पते जैसा दिखता है। सादे LAN HTTP पर, Oriveo कोई क्रेडेंशियल नहीं भेजेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini terlihat seperti alamat lokal atau LAN. Melalui HTTP LAN biasa, Oriveo tidak akan mengirimkan kredensial apa pun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはローカルまたは LAN アドレスのように見えます。プレーン LAN HTTP 経由では、Oriveo は認証情報を送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 또는 LAN 주소처럼 보입니다. 일반 LAN HTTP를 통해 Oriveo는 자격 증명을 보내지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece um endereço local ou LAN. Através de LAN HTTP simples, o Oriveo não enviará nenhuma credencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это похоже на локальный адрес или адрес локальной сети. По обычному протоколу HTTP в локальной сети Oriveo не отправляет никаких учетных данных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่าอยู่ในเครื่องหรือที่อยู่ LAN Oriveo จะไม่ส่งข้อมูลประจำตัวใดๆ บน LAN HTTP ธรรมดา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir yerel veya LAN adresine benziyor. Düz LAN HTTP üzerinden Oriveo herhangi bir kimlik bilgisi göndermez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ này trông giống như địa chỉ cục bộ hoặc mạng LAN. Qua HTTP LAN đơn giản, Oriveo sẽ không gửi bất kỳ thông tin xác thực nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来是本机或局域网地址。按局域网明文 HTTP 连接时，Oriveo 不会发送任何凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來是本機或區域網路位址。使用區域網路明文 HTTP 連線時，Oriveo 不會傳送任何憑證。"
          }
        }
      }
    },
    "This model does not accept this parameter; sending it will be rejected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقبل هذا النموذج هذه المَعلمة؛ سيُرفض إرسالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell akzeptiert diesen Parameter nicht; das Senden wird abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no acepta este parámetro; enviarlo será rechazado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n'accepte pas ce paramètre ; l'envoyer sera rejeté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल इस पैरामीटर को स्वीकार नहीं करता; भेजने पर अस्वीकार हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak menerima parameter ini; pengiriman akan ditolak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルはこのパラメータを受け付けません。送信すると拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 이 매개변수를 받지 않으며, 보내면 거부됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não aceita este parâmetro; o envio será rejeitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель не принимает данный параметр; отправка будет отклонена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลนี้ไม่รับพารามิเตอร์นี้ ส่งไปจะถูกปฏิเสธ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model bu parametreyi kabul etmez; göndermek reddedilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này không chấp nhận tham số này; gửi đi sẽ bị từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型不接受这个参数，发送会被拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型不接受這個參數，傳送會被拒絕"
          }
        }
      }
    },
    "This model doesn't accept adjustable parameters on this connection.": {
      "extractionState": "manual",
      "localizations": {
