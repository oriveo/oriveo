    },
    "You've used up this period's Codex quota. It will resume after the next reset.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استنفدت حصة Codex لهذه الفترة. ستُستأنف بعد إعادة التعيين التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das Codex-Kontingent dieses Zeitraums aufgebraucht. Es steht nach dem nächsten Zurücksetzen wieder zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used up this period's Codex quota. It will resume after the next reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has agotado la cuota de Codex de este periodo. Se restablecerá tras el próximo reinicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez épuisé le quota Codex de cette période. Il sera rétabli après la prochaine réinitialisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अवधि का Codex कोटा समाप्त हो गया है। अगली रीसेट के बाद फिर से उपलब्ध होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuota Codex untuk periode ini sudah habis. Akan tersedia lagi setelah reset berikutnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今期の Codex 利用枠を使い切りました。次回リセット後に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 기간의 Codex 할당량을 모두 사용했습니다. 다음 초기화 후 다시 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você esgotou a cota do Codex deste período. Ela será retomada após a próxima redefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота Codex за этот период исчерпана. Она восстановится после следующего сброса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้โควตา Codex ของรอบนี้หมดแล้ว จะกลับมาใช้ได้หลังการรีเซ็ตครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemin Codex kotasını tükettin. Bir sonraki sıfırlamadan sonra yeniden kullanılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết hạn mức Codex của kỳ này. Hạn mức sẽ khôi phục sau lần đặt lại tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周期的 Codex 额度已用完，下次重置后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週期的 Codex 額度已用完，下次重置後恢復。"
          }
        }
      }
    },
    "You've used up this period's Grok subscription quota. It will resume after the next reset.": {
