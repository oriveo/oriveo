    "Enter what your relay gave you. Oriveo will detect the API root, authentication style, and compatible protocol.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل ما قدمه لك التتابع الخاص بك. سيكتشف Oriveo جذر واجهة برمجة التطبيقات (API) ونمط المصادقة والبروتوكول المتوافق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Angaben zu diesem benutzerdefinierten LLM ein. Oriveo erkennt die Request-URL, die Authentifizierungsart und das kompatible Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the details for this custom LLM. Oriveo will detect the Request URL, authentication style, and compatible protocol."
          }
