    "These settings are automatically configured for each provider. Custom endpoint support will be available in a future update." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضبط هذه الإعدادات تلقائيًا لكل مزود. سيتوفر دعم عناوين الطلب المخصصة في تحديث لاحق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen werden für jeden Anbieter automatisch konfiguriert. Unterstützung für benutzerdefinierte Request-URLs folgt in einem späteren Update."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These settings are configured automatically for each provider. Custom Request URL support will be available in a future update."
