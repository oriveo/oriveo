    "Fixed by the model; changing it has no effect.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبَّت من قِبل النموذج؛ تغييره لا يُحدث أثرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Modell festgelegt; Änderungen haben keine Wirkung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado por el modelo; cambiarlo no tiene efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixé par le modèle ; le modifier n'a aucun effet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल द्वारा तय; बदलने का कोई असर नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditetapkan oleh model; mengubahnya tidak berpengaruh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル側で固定されており、変更しても反映されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델에서 고정되어 있어 변경해도 반영되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixado pelo modelo; alterá-lo não tem efeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задано моделью; изменение не даст эффекта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกกำหนดตายตัวโดยโมเดล เปลี่ยนแล้วไม่มีผล"
