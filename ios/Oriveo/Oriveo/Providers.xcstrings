{
  "sourceLanguage": "en",
  "strings": {
    "%d compatible protocol(s) will be tested automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم اختبار البروتوكول (البروتوكولات) المتوافقة مع %d تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d-kompatible Protokolle werden automatisch getestet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d compatible protocol(s) will be tested automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los protocolos compatibles con %d se probarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protocoles compatibles %d seront testés automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d संगत प्रोटोकॉल का परीक्षण स्वचालित रूप से किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokol yang kompatibel dengan %d akan diuji secara otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 互換プロトコルは自動的にテストされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 호환 프로토콜이 자동으로 테스트됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os protocolos compatíveis com %d serão testados automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Протоколы, совместимые с %d, будут протестированы автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรโตคอลที่เข้ากันได้กับ %d จะถูกทดสอบโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d uyumlu protokol(ler) otomatik olarak test edilecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "(Các) giao thức tương thích %d sẽ được kiểm tra tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将自动测试 %d 种兼容协议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將自動測試 %d 種相容協議。"
          }
        }
      }
    },
    "%d parameters you set are kept and won't be sent right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بـ %d من المعاملات التي ضبطتها، ولن يتم إرسالها حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d von dir gesetzte Parameter bleiben gespeichert und werden derzeit nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d parameters you set are kept and won't be sent right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan %d parámetros que configuraste y ahora mismo no se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d paramètres que vous aviez définis sont conservés et ne sont pas envoyés pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा सेट किए गए %d पैरामीटर सहेजे गए हैं और अभी नहीं भेजे जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%d parameter yang Anda atur tetap tersimpan dan saat ini tidak dikirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に設定した %d 件のパラメータは保持されていますが、現在は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 설정한 매개변수 %d개가 보관되어 있으며 지금은 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d parâmetros que você definiu foram mantidos e não serão enviados agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заданные вами параметры (%d) сохранены и сейчас не отправляются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พารามิเตอร์ %d รายการที่คุณตั้งไว้ถูกเก็บไว้ และตอนนี้จะไม่ถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarladığınız %d parametre saklandı ve şu anda gönderilmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d tham số bạn đã đặt được giữ lại và hiện không được gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你此前设置的 %d 项参数已保留，当前不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你先前設定的 %d 項參數已保留，目前不會傳送。"
          }
        }
      }
    },
