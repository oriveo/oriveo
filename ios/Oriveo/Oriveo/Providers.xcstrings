    "Your API key is stored securely on this device and is sent only to your relay.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين مفتاح API الخاص بك بشكل آمن على هذا الجهاز ويتم إرساله فقط إلى جهاز النموذج اللغوي المخصص الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr API-Schlüssel wird sicher auf diesem Gerät gespeichert und nur an Ihr benutzerdefiniertes LLM gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API key is stored securely on this device and is sent only to your custom LLM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su clave API se almacena de forma segura en este dispositivo y se envía únicamente a su retransmisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé API est stockée de manière sécurisée sur cet appareil et est envoyée uniquement à votre LLM personnalisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी एपीआई कुंजी इस डिवाइस पर सुरक्षित रूप से संग्रहीत है और केवल आपके कस्टम LLM पर भेजी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API Anda disimpan dengan aman di perangkat ini dan hanya dikirim ke LLM kustom Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーはこのデバイスに安全に保存され、カスタム LLM にのみ送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 이 기기에 안전하게 저장되며 선택한 사용자 지정 LLM에만 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de API é armazenada com segurança neste dispositivo e é enviada somente para sua retransmissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ API надежно хранится на этом устройстве и отправляется только на ваш пользовательская LLM."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API ของคุณจะถูกเก็บไว้อย่างปลอดภัยบนอุปกรณ์นี้ และส่งไปยังLLM แบบกำหนดเองของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarınız bu cihazda güvenli bir şekilde saklanır ve yalnızca aktarıcınıza gönderilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API của bạn được lưu trữ an toàn trên thiết bị này và chỉ được gửi tới LLM tùy chỉnh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥会安全存储在此设备上，仅会发送到你的自定义 LLM。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰會安全儲存在此裝置上，且只會傳送至你的自訂 LLM。"
          }
        }
      }
    },
    "Your ChatGPT account's current plan doesn't allow using Codex in third-party apps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة الحالية لحساب ChatGPT لديك لا تسمح باستخدام Codex في التطبيقات الخارجية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Tarif deines ChatGPT-Kontos erlaubt die Nutzung von Codex in Drittanbieter-Apps nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
