    "Saved, but the key looks invalid. You can verify it later in provider settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ، لكن المفتاح يبدو غير صالح. يمكنك التحقق منه لاحقًا في إعدادات المزوّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert, aber der Schlüssel scheint ungültig zu sein. Sie können ihn später in den Anbietereinstellungen überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado, pero la clave parece no válida. Puedes verificarla más tarde en los ajustes del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré, mais la clé semble invalide. Vous pouvez la vérifier plus tard dans les paramètres du fournisseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया, लेकिन कुंजी अमान्य लगती है। आप इसे बाद में प्रदाता सेटिंग्स में सत्यापित कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan, tetapi kunci tampaknya tidak valid. Anda dapat memverifikasinya nanti di pengaturan penyedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しましたが、キーが無効のようです。後でプロバイダー設定で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했지만 키가 유효하지 않은 것 같습니다. 나중에 공급자 설정에서 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo, mas a chave parece inválida. Você pode verificá-la mais tarde nas configurações do provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено, но ключ выглядит недействительным. Вы можете проверить его позже в настройках поставщика."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว แต่คีย์ดูเหมือนจะไม่ถูกต้อง คุณสามารถตรวจสอบได้ภายหลังในการตั้งค่าผู้ให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi, ancak anahtar geçersiz görünüyor. Daha sonra sağlayıcı ayarlarında doğrulayabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu, nhưng khóa có vẻ không hợp lệ. Bạn có thể xác minh lại sau trong cài đặt nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，但密钥似乎无效。可稍后在供应商设置中验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存，但金鑰似乎無效。可稍後在供應商設定中驗證。"
          }
        }
      }
    },
    "Saving sends one tiny test request to confirm the new key works.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي الحفظ إلى إرسال طلب اختبار صغير واحد للتأكد من عمل المفتاح الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wird eine minimale Testanfrage gesendet, um zu bestätigen, dass der neue Schlüssel funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving sends one tiny test request to confirm the new key works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se envía una pequeña solicitud de prueba para confirmar que la nueva clave funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement envoie une petite requête de test pour confirmer que la nouvelle clé fonctionne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने पर नई कुंजी के काम करने की पुष्टि के लिए एक छोटा परीक्षण अनुरोध भेजा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan mengirim satu permintaan uji kecil untuk memastikan kunci baru berfungsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、新しいキーが機能することを確認するために小さなテストリクエストを 1 回送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 새 키가 작동하는지 확인하기 위해 작은 테스트 요청을 한 번 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, uma pequena solicitação de teste confirma que a nova chave funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении будет отправлен небольшой тестовый запрос, чтобы подтвердить работу нового ключа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะส่งคำขอทดสอบขนาดเล็กหนึ่งครั้งเพื่อยืนยันว่าคีย์ใหม่ใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildiğinde yeni anahtarın çalıştığını doğrulamak için küçük bir test isteği gönderilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lưu, một yêu cầu kiểm tra nhỏ sẽ được gửi để xác nhận khóa mới hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会发送一次极小的测试请求，以确认新密钥可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後會傳送一次極小的測試請求，以確認新金鑰可用。"
          }
        }
      }
    },
