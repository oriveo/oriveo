          }
        }
      }
    },
    "This address doesn't match the connection method. Change the connection method to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العنوان لا يتوافق مع طريقة الاتصال. غيّر طريقة الاتصال للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse passt nicht zur Verbindungsart. Ändere die Verbindungsart, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This address doesn't match the connection method. Change the connection method to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección no coincide con el método de conexión. Cambia el método de conexión para continuar."
