          }
        }
      }
    },
    "The server rejected the API key. Check the key or choose the documented protocol manually.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم مفتاح API. تحقق من المفتاح أو اختر البروتوكول الموثق يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den API-Schlüssel abgelehnt. Überprüfen Sie den Schlüssel oder wählen Sie das dokumentierte Protokoll manuell aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the API key. Check the key or choose the documented protocol manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la clave API. Verifique la clave o elija el protocolo documentado manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rejeté la clé API. Vérifiez la clé ou choisissez manuellement le protocole documenté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने एपीआई कुंजी को अस्वीकार कर दिया। कुंजी की जाँच करें या दस्तावेज़ीकृत प्रोटोकॉल को मैन्युअल रूप से चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server menolak kunci API. Periksa kuncinya atau pilih protokol yang terdokumentasi secara manual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが API キーを拒否しました。キーを確認するか、文書化されたプロトコルを手動で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 API 키를 거부했습니다. 키를 확인하거나 문서화된 프로토콜을 수동으로 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor rejeitou a chave API. Verifique a chave ou escolha o protocolo documentado manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отклонил ключ API. Проверьте ключ или выберите документированный протокол вручную."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
