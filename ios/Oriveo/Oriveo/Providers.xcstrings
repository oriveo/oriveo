    "The actual chat path is verified. You can save this relay now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من مسار الدردشة الفعلي. يمكنك حفظ هذا التتابع الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der tatsächliche Chatpfad wird überprüft. Sie können dieses Relais jetzt speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The actual chat path is verified. You can save this relay now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se verifica la ruta de chat real. Puedes guardar este relevo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin de discussion réel est vérifié. Vous pouvez sauvegarder ce relais maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक चैट पथ सत्यापित है. अब आप इस रिले को सहेज सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur obrolan sebenarnya telah diverifikasi. Anda dapat menyimpan relai ini sekarang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のチャット パスが検証されます。このリレーを保存できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 채팅 경로가 확인됩니다. 이제 이 릴레이를 저장할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho real do chat é verificado. Você pode salvar este relé agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фактический путь чата проверен. Вы можете сохранить это реле сейчас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางการแชทจริงได้รับการตรวจสอบแล้ว คุณสามารถบันทึกรีเลย์นี้ได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek sohbet yolu doğrulandı. Bu röleyi şimdi kaydedebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường dẫn trò chuyện thực tế đã được xác minh. Bạn có thể lưu rơle này ngay bây giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证真实聊天路径，现在可以保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已驗證真實聊天路徑，現在可以儲存。"
          }
        }
      }
    },
