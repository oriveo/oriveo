    "Custom request fields are only available on models whose provider officially declares a field schema.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom request fields are only available on models whose provider officially declares a field schema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义请求字段仅在供应商官方声明了字段结构的模型上可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂請求欄位僅在供應商官方聲明了欄位結構的模型上可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムリクエストフィールドは、プロバイダが公式にフィールド構造を宣言したモデルでのみ利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 요청 필드는 제공업체가 필드 구조를 공식 선언한 모델에서만 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos de solicitud personalizados solo están disponibles en modelos cuyo proveedor declara oficialmente un esquema de campos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs de requête personnalisés ne sont disponibles que sur les modèles dont le fournisseur déclare officiellement un schéma de champs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Anfragefelder sind nur bei Modellen verfügbar, deren Anbieter ein Feldschema offiziell deklariert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos de solicitação personalizados só estão disponíveis em modelos cujo provedor declara oficialmente um esquema de campos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقول الطلب المخصصة متاحة فقط للنماذج التي يعلن مزوّدها رسميًا عن بنية الحقول."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम अनुरोध फ़ील्ड केवल उन मॉडलों पर उपलब्ध हैं जिनके प्रदाता ने फ़ील्ड संरचना आधिकारिक रूप से घोषित की है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom permintaan kustom hanya tersedia pada model yang penyedianya mendeklarasikan skema kolom secara resmi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường yêu cầu tùy chỉnh chỉ khả dụng trên các mô hình mà nhà cung cấp khai báo chính thức cấu trúc trường."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟิลด์คำขอที่กำหนดเองใช้ได้เฉพาะกับโมเดลที่ผู้ให้บริการประกาศโครงสร้างฟิลด์อย่างเป็นทางการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel istek alanları yalnızca sağlayıcısının alan şemasını resmi olarak bildirdiği modellerde kullanılabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские поля запроса доступны только для моделей, чей провайдер официально объявил схему полей."
          }
        }
      }
    },
