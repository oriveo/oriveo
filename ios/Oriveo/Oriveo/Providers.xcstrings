        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスは接続方法と一致しません。続けるには接続方法を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 연결 방식과 일치하지 않습니다. 계속하려면 연결 방식을 변경하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este endereço não corresponde ao método de conexão. Altere o método de conexão para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот адрес не соответствует способу подключения. Измени способ подключения, чтобы продолжить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่นี้ไม่ตรงกับวิธีการเชื่อมต่อ เปลี่ยนวิธีการเชื่อมต่อเพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adres bağlantı yöntemiyle eşleşmiyor. Devam etmek için bağlantı yöntemini değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ này không khớp với phương thức kết nối. Hãy đổi phương thức kết nối để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个地址与连接安全不相符。请调整后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個位址與連線方式不相符。請改用相符的連線方式後繼續。"
          }
        }
      }
    },
    "This clears every value you set for this model. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى مسح كل قيمة ضبطتها لهذا النموذج. لا يمكن التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle für dieses Modell gesetzten Werte gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra todos los valores que definiste para este modelo. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface toutes les valeurs définies pour ce modèle. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इस मॉडल के लिए सेट किए गए सभी मान मिटा देगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus semua nilai yang Anda atur untuk model ini. Tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルに設定したすべての値を消去します。取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델에 설정한 모든 값을 지웁니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apaga todos os valores definidos para este modelo. Não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все значения, заданные для этой модели. Отменить нельзя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การทำเช่นนี้จะล้างค่าทั้งหมดที่คุณตั้งไว้สำหรับโมเดลนี้ ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bu model için ayarladığın tüm değerleri siler. Geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa mọi giá trị bạn đã đặt cho mô hình này. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清空你为这个模型设置的所有值，且无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清空你為這個模型設定的所有值，且無法復原。"
          }
        }
      }
    },
    "This connection could not reach its upstream provider. This is not your configuration — its administrator's upstream account may be invalid, out of credits, or rate-limited. Switch to another connection or contact its administrator." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على هذا الاتصال الوصول إلى مزوّده المصدر. المشكلة ليست في إعداداتك؛ فقد يكون حساب الجهة المشغّلة لدى المزوّد المصدر غير صالح أو نفد رصيده أو بلغ حدّ الطلبات. بدّل إلى اتصال آخر أو تواصل مع الجهة المشغّلة له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verbindung konnte ihren Upstream-Anbieter nicht erreichen. Das liegt nicht an deiner Konfiguration – das Upstream-Konto ihres Administrators ist möglicherweise ungültig, hat kein Guthaben mehr oder wird gedrosselt. Wechsle zu einer anderen Verbindung oder wende dich an ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection could not reach its upstream provider. This is not your configuration — its administrator's upstream account may be invalid, out of credits, or rate-limited. Switch to another connection or contact its administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión no pudo comunicarse con su proveedor de origen. No es un problema de tu configuración: la cuenta de su administrador con ese proveedor puede no ser válida, haberse quedado sin créditos o haber alcanzado el límite de solicitudes. Cambia a otra conexión o contacta a su administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion n’a pas pu joindre son fournisseur en amont. Votre configuration n’est pas en cause : le compte de son administrateur auprès de ce fournisseur est peut-être invalide, à court de crédits ou limité en débit. Passez à une autre connexion ou contactez son administrateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कनेक्शन अपने अपस्ट्रीम प्रोवाइडर तक नहीं पहुँच सका। यह आपकी कॉन्फ़िगरेशन की समस्या नहीं है — इसके एडमिन का अपस्ट्रीम खाता अमान्य हो सकता है, उसका क्रेडिट खत्म हो सकता है या उस पर रेट लिमिट लगी हो सकती है। कोई दूसरा कनेक्शन चुनें या इसके एडमिन से संपर्क करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ini tidak dapat menghubungi penyedia upstream-nya. Ini bukan masalah konfigurasi Anda — akun upstream milik adminnya mungkin tidak valid, kehabisan saldo, atau terkena batas laju permintaan. Beralihlah ke koneksi lain atau hubungi adminnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続から上流のプロバイダーにつながりませんでした。お使いの設定の問題ではありません。管理者の上流アカウントが無効、残高不足、またはレート制限中の可能性があります。別の接続に切り替えるか、この接続の管理者にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결이 상위 제공업체에 접속하지 못했습니다. 설정 문제가 아닙니다. 이 연결 관리자의 상위 제공업체 계정이 유효하지 않거나, 잔액이 부족하거나, 속도 제한에 걸렸을 수 있습니다. 다른 연결로 전환하거나 이 연결의 관리자에게 문의하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexão não conseguiu alcançar o provedor upstream. O problema não está na sua configuração: a conta upstream do administrador pode estar inválida, sem créditos ou ter atingido o limite de requisições. Troque para outra conexão ou fale com o administrador dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этому подключению не удалось связаться с вышестоящим провайдером. Дело не в ваших настройках: аккаунт администратора у вышестоящего провайдера может быть недействителен, остаться без средств или превысить лимит запросов. Переключитесь на другое подключение или свяжитесь с его администратором."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อนี้ติดต่อผู้ให้บริการต้นทางไม่ได้ ปัญหานี้ไม่ได้เกิดจากการตั้งค่าของคุณ บัญชีต้นทางของผู้ดูแลอาจใช้ไม่ได้ เครดิตหมด หรือถูกจำกัดอัตราการใช้งาน โปรดเปลี่ยนไปใช้การเชื่อมต่ออื่นหรือติดต่อผู้ดูแลของการเชื่อมต่อนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı üst sağlayıcısına ulaşamadı. Sorun sizin yapılandırmanızda değil; yöneticisinin üst sağlayıcıdaki hesabı geçersiz, bakiyesi tükenmiş veya hız sınırına takılmış olabilir. Başka bir bağlantıya geçin veya bağlantının yöneticisiyle iletişim kurun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối này không liên lạc được với nhà cung cấp thượng nguồn. Đây không phải lỗi cấu hình của bạn — tài khoản thượng nguồn của quản trị viên có thể không hợp lệ, hết số dư hoặc bị giới hạn tốc độ. Hãy chuyển sang kết nối khác hoặc liên hệ quản trị viên của kết nối này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条连接连不上它的上游供应商。这不是你的配置问题：这条连接的管理员在上游的账号可能已失效、欠费或被限流。请改用另一条连接，或联系它的管理员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這條連線連不上它的上游供應商。這不是你的設定問題：這條連線的管理員在上游的帳號可能已失效、欠費或被限流。請改用另一條連線，或聯絡它的管理員。"
          }
        }
      }
    },
    "This connection does not accept the current service tier value. Open Providers → this connection → Edit connection → Compatibility and clear “Service Tier”, then retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقبل هذا الاتصال قيمة مستوى الخدمة الحالية. انتقل إلى: مزودو الخدمة ← هذا الاتصال ← تعديل الاتصال ← التوافق، وامسح «مستوى الخدمة»، ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verbindung akzeptiert die aktuelle Servicestufe nicht. Öffne Anbieter → diese Verbindung → Verbindung bearbeiten → Kompatibilität, leere das Feld „Servicestufe“ und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection does not accept the current service tier value. Open Providers → this connection → Edit connection → Compatibility and clear “Service Tier”, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión no acepta el nivel de servicio actual. Abre Proveedores → esta conexión → Editar conexión → Compatibilidad, vacía el campo «Nivel de servicio» y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion n’accepte pas le niveau de service actuel. Ouvrez Fournisseurs → cette connexion → Modifier la connexion → Compatibilité, videz le champ « Niveau de service », puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कनेक्शन मौजूदा सेवा स्तर स्वीकार नहीं करता। प्रोवाइडर → यह कनेक्शन → कनेक्शन संपादित करें → संगतता खोलें, “सेवा स्तर” खाली करें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi ini tidak menerima nilai Tingkat Layanan saat ini. Buka Penyedia → koneksi ini → Edit koneksi → Kompatibilitas, kosongkan “Tingkat Layanan”, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続は現在のサービスティアの値を受け付けません。プロバイダー → この接続 → 接続を編集 → 互換性を開き、「サービスティア」を空にしてから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결은 현재 서비스 등급 값을 받아들이지 않습니다. 제공업체 → 이 연결 → 연결 편집 → 호환성에서 “서비스 등급”을 비운 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexão não aceita o nível de serviço atual. Abra Provedores → esta conexão → Editar conexão → Compatibilidade, limpe o campo “Nível de serviço” e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это подключение не принимает текущий уровень обслуживания. Откройте Провайдеры → это подключение → Изменить подключение → Совместимость, очистите поле «Уровень обслуживания» и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อนี้ไม่รับค่าระดับการบริการที่ตั้งไว้ เปิดผู้ให้บริการ → การเชื่อมต่อนี้ → แก้ไขการเชื่อมต่อ → ความเข้ากันได้ แล้วล้างค่า “ระดับการบริการ” จากนั้นลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı, geçerli Hizmet Kademesi değerini kabul etmiyor. Sağlayıcılar → bu bağlantı → Bağlantıyı düzenle → Uyumluluk bölümünü açın, “Hizmet Kademesi” alanını boşaltın ve tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối này không chấp nhận giá trị Cấp dịch vụ hiện tại. Mở Nhà cung cấp → kết nối này → Sửa kết nối → Khả năng tương thích, xóa “Cấp dịch vụ” rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
