    "Models using it switch to the primary key. They’re listed before deleting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل النماذج التي تستخدمه إلى المفتاح الأساسي. تُعرض قائمتها قبل الحذف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle, die ihn nutzen, wechseln zum Hauptschlüssel. Vor dem Löschen werden sie aufgelistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models using it switch to the primary key. They’re listed before deleting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos que la usan pasan a la clave principal. Se muestran antes de eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles qui l’utilisent passent à la clé principale. Ils sont listés avant la suppression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे इस्तेमाल करने वाले मॉडल मुख्य कुंजी पर चले जाते हैं। हटाने से पहले उनकी सूची दिखाई जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model yang memakainya akan beralih ke kunci utama. Model tersebut ditampilkan sebelum dihapus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中のモデルはメインキーに切り替わります。削除前に一覧で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키를 쓰는 모델은 기본 키로 바뀝니다. 삭제 전에 하나씩 보여 드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos que a usam passam para a chave principal. Eles são listados antes da exclusão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели, которые его используют, перейдут на основной ключ. Перед удалением они будут перечислены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลที่ใช้คีย์นี้จะเปลี่ยนไปใช้คีย์หลัก และจะแสดงรายการให้ดูก่อนลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu kullanan modeller birincil anahtara geçer. Silmeden önce tek tek listelenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mô hình đang dùng khóa này sẽ chuyển sang khóa chính. Danh sách sẽ hiện trước khi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在用它的模型改用主密钥，删除前逐个列出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在用它的模型會改用主金鑰，刪除前會逐一列出"
          }
        }
      }
    },
    "Models will be re-synced automatically after replacing the key." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إعادة مزامنة النماذج تلقائيًا بعد استبدال المفتاح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Ersetzen des Schlüssels werden die Modelle automatisch neu synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos se resincronizarán automáticamente después de reemplazar la clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles seront resynchronisés automatiquement après le remplacement de la clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुंजी बदलने के बाद मॉडल स्वचालित रूप से पुन: समन्वयित हो जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model akan disinkronkan ulang secara otomatis setelah mengganti kunci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーを交換すると、モデルは自動的に再同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 교체하면 모델이 자동으로 다시 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos serão sincronizados novamente automaticamente após a substituição da chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели будут повторно синхронизированы автоматически после замены ключа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
