    },
    "Changes apply right away and are saved only on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق التغييرات فورًا وتُحفَظ على هذا الجهاز فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen gelten sofort und werden nur auf diesem Gerät gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes apply right away and are saved only on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se aplican al instante y solo se guardan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications s’appliquent immédiatement et sont enregistrées uniquement sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव तुरंत लागू होते हैं और सिर्फ़ इसी डिवाइस पर सेव होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan langsung berlaku dan hanya disimpan di perangkat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はすぐに反映され、このデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경하면 바로 적용되며 이 기기에만 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações são aplicadas na hora e ficam salvas só neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения применяются сразу и сохраняются только на этом устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนแปลงมีผลทันที และบันทึกไว้ในอุปกรณ์นี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklikler hemen uygulanır ve yalnızca bu cihazda saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi có hiệu lực ngay và chỉ được lưu trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改后立即生效，且只保存在这台设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更後立即生效，且只儲存在這台裝置。"
          }
        }
      }
    },
    "Changes apply right away and the connection is verified again." : {
      "extractionState" : "manual",
      "localizations" : {
