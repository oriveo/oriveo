    "Use a key from console.x.ai, billed by usage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مفتاحًا من console.x.ai، مع الفوترة حسب الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Schlüssel von console.x.ai verwenden, Abrechnung nach Verbrauch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a key from console.x.ai, billed by usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una clave de console.x.ai, con cobro por uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une clé de console.x.ai, facturée à l'usage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "console.x.ai से की का उपयोग करें, उपयोग के अनुसार बिलिंग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kunci dari console.x.ai, ditagih sesuai pemakaian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "console.x.ai のキーを使用し、従量課金で利用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "console.x.ai의 키를 사용하며 사용량만큼 청구됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma chave do console.x.ai, cobrada por uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ с console.x.ai, оплата по использованию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้คีย์จาก console.x.ai คิดค่าบริการตามการใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "console.x.ai'den bir anahtar kullan, kullanıma göre ücretlendirilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng khóa từ console.x.ai, tính phí theo mức sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 console.x.ai 的密钥，按用量计费。"
          }
        },
