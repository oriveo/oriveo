    "Default web_search matches OpenAI and main Codex relays. Switch to web_search_preview for legacy relays." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوافق web_search الافتراضي مع OpenAI واتصالات Codex الرئيسية. بدّل إلى web_search_preview للاتصالات القديمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig passt web_search zu OpenAI und den gängigen Codex-Verbindungen. Für ältere Verbindungen auf web_search_preview umstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default web_search matches OpenAI and main Codex connections. Switch to web_search_preview for legacy connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El web_search predeterminado funciona con OpenAI y con las principales conexiones de Codex. Para conexiones antiguas, cambia a web_search_preview."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le web_search par défaut convient à OpenAI et aux principales connexions Codex. Passez à web_search_preview pour les connexions plus anciennes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट web_search OpenAI और मुख्य Codex कनेक्शन के साथ काम करता है। पुराने कनेक्शन के लिए web_search_preview पर स्विच करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "web_search default cocok untuk OpenAI dan koneksi Codex utama. Untuk koneksi lama, ganti ke web_search_preview."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトの web_search は OpenAI と主要な Codex 接続に対応しています。古い接続では web_search_preview に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 web_search는 OpenAI 및 주요 Codex 연결과 호환됩니다. 구형 연결에서는 web_search_preview로 전환하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O web_search padrão funciona com a OpenAI e com as principais conexões Codex. Para conexões antigas, use web_search_preview."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию web_search подходит для OpenAI и основных подключений Codex. Для устаревших подключений переключитесь на web_search_preview."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "web_search ค่าเริ่มต้นใช้ได้กับ OpenAI และการเชื่อมต่อ Codex หลัก ๆ ส่วนการเชื่อมต่อรุ่นเก่าให้เปลี่ยนเป็น web_search_preview"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan web_search, OpenAI ve başlıca Codex bağlantılarıyla uyumludur. Eski bağlantılarda web_search_preview seçeneğine geçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "web_search mặc định phù hợp với OpenAI và các kết nối Codex chính. Với kết nối cũ, hãy chuyển sang web_search_preview."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
