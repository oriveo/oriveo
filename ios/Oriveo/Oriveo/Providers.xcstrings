          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano atual da sua conta ChatGPT não permite usar o Codex em aplicativos de terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий тариф вашего аккаунта ChatGPT не позволяет использовать Codex в сторонних приложениях."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจปัจจุบันของบัญชี ChatGPT ของคุณไม่อนุญาตให้ใช้ Codex ในแอปของบุคคลที่สาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT hesabının mevcut planı, Codex'in üçüncü taraf uygulamalarda kullanılmasına izin vermiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói hiện tại của tài khoản ChatGPT của bạn không cho phép dùng Codex trong ứng dụng bên thứ ba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 ChatGPT 账号当前套餐不支持在第三方应用中使用 Codex。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 ChatGPT 帳號目前方案不支援在第三方應用中使用 Codex。"
          }
        }
      }
    },
    "Your ChatGPT sign-in has expired. Please authorize again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل دخولك إلى ChatGPT. يرجى منح الإذن مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ChatGPT-Anmeldung ist abgelaufen. Bitte autorisiere erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ChatGPT sign-in has expired. Please authorize again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de ChatGPT ha caducado. Vuelve a autorizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion ChatGPT a expiré. Veuillez autoriser à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ChatGPT साइन-इन समाप्त हो गया है। कृपया फिर से अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi masuk ChatGPT Anda telah kedaluwarsa. Silakan beri otorisasi lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT のログインの有効期限が切れました。再度承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 로그인이 만료되었습니다. 다시 승인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login do ChatGPT expirou. Autorize novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия ChatGPT истекла. Авторизуйтесь снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ ChatGPT ของคุณหมดอายุแล้ว โปรดอนุญาตอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT oturumunun süresi doldu. Lütfen tekrar yetkilendir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập ChatGPT đã hết hạn. Vui lòng ủy quyền lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录已过期，请重新授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登入已過期，請重新授權。"
          }
        }
      }
    },
