    "Saved, but the key looks invalid. You can verify it later in provider settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ، لكن المفتاح يبدو غير صالح. يمكنك التحقق منه لاحقًا في إعدادات المزوّد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert, aber der Schlüssel scheint ungültig zu sein. Sie können ihn später in den Anbietereinstellungen überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado, pero la clave parece no válida. Puedes verificarla más tarde en los ajustes del proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré, mais la clé semble invalide. Vous pouvez la vérifier plus tard dans les paramètres du fournisseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया, लेकिन कुंजी अमान्य लगती है। आप इसे बाद में प्रोवाइडर सेटिंग्स में सत्यापित कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersimpan, tetapi kunci tampaknya tidak valid. Anda dapat memverifikasinya nanti di pengaturan penyedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しましたが、キーが無効のようです。後でプロバイダー設定で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장했지만 키가 유효하지 않은 것 같습니다. 나중에 제공업체 설정에서 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo, mas a chave parece inválida. Você pode verificá-la mais tarde nas configurações do provedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено, но ключ выглядит недействительным. Вы можете проверить его позже в настройках провайдера."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกแล้ว แต่คีย์ดูเหมือนจะไม่ถูกต้อง คุณสามารถตรวจสอบได้ภายหลังในการตั้งค่าผู้ให้บริการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedildi, ancak anahtar geçersiz görünüyor. Daha sonra sağlayıcı ayarlarında doğrulayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu, nhưng khóa có vẻ không hợp lệ. Bạn có thể xác minh lại sau trong cài đặt nhà cung cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存，但密钥似乎无效。可稍后在供应商设置中验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存，但金鑰似乎無效。可稍後在供應商設定中驗證。"
          }
        }
      }
    },
    "Saving sends one tiny test request to confirm the new key works." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي الحفظ إلى إرسال طلب اختبار صغير واحد للتأكد من عمل المفتاح الجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
