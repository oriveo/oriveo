    "Connect a provider first. Model switching, chat, and cost transparency all start here.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل المزود أولاً. يبدأ تبديل النماذج والدردشة وشفافية التكلفة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde zunächst einen Anbieter. Hier beginnen Modellwechsel, Chat und Kostentransparenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero conecte un proveedor. El cambio de modelo, el chat y la transparencia de costos comienzan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez d’abord un fournisseur. Le changement de modèle, le chat et la transparence des coûts commencent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक प्रदाता कनेक्ट करें. मॉडल स्विचिंग, चैट और लागत पारदर्शिता सभी यहीं से शुरू होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan penyedia terlebih dahulu. Peralihan model, obrolan, dan transparansi biaya semuanya dimulai di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずプロバイダーに接続します。モデルの切り替え、チャット、コストの透明性はすべてここから始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 제공업체를 연결하세요. 모델 전환, 채팅, 비용 투명성이 모두 여기에서 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um provedor primeiro. A troca de modelos, o chat e a transparência de custos começam aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала подключите провайдера. Переключение моделей, чат и прозрачность затрат — все начинается здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อผู้ให้บริการก่อน การสลับโมเดล การแชท และความโปร่งใสด้านต้นทุนทั้งหมดเริ่มต้นที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir sağlayıcıya bağlanın. Model değiştirme, sohbet ve maliyet şeffaflığının tamamı burada başlıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối một nhà cung cấp đầu tiên. Chuyển đổi mô hình, trò chuyện và minh bạch chi phí đều bắt đầu từ đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先连接一个服务商。模型切换、聊天和费用透明都从这里开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首先連接服務商。模型切換、聊天和成本透明度都從這裡開始。"
          }
        }
      }
    },
