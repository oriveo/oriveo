    "Switching the relay type resets transport, auth, and Codex identity to the new defaults. Your model ID and capability picks are kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير نوع البروتوكول إلى إعادة البروتوكول والمصادقة وهوية Codex إلى الإعدادات الافتراضية الجديدة. سيُحتفظ بمعرّف النموذج والقدرات التي اخترتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern des Protokolltyps werden Protokoll, Authentifizierung und Codex-Identität auf die neuen Standardwerte zurückgesetzt. Modell-ID und ausgewählte Fähigkeiten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching the protocol type resets the protocol, authentication, and Codex identity to the new defaults. Your model ID and capability selections are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar el tipo de protocolo se restablecen el protocolo, la autenticación y la identidad de Codex a los nuevos valores predeterminados. Se conservan el ID del modelo y las capacidades seleccionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le type de protocole réinitialise le protocole, l’authentification et l’identité Codex selon les nouvelles valeurs par défaut. L’ID du modèle et les capacités sélectionnées sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटोकॉल प्रकार बदलने पर प्रोटोकॉल, प्रमाणीकरण और Codex पहचान नए डिफ़ॉल्ट पर रीसेट हो जाएंगे। मॉडल ID और चुनी गई क्षमताएं बनी रहेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti jenis protokol akan mengatur ulang protokol, autentikasi, dan identitas Codex ke nilai default baru. ID model dan kemampuan yang dipilih tetap dipertahankan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロトコルの種類を切り替えると、プロトコル、認証、Codex クライアント識別が新しい既定値に戻ります。モデル ID と選択した機能は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로토콜 유형을 바꾸면 프로토콜, 인증 및 Codex 식별 정보가 새 기본값으로 재설정됩니다. 모델 ID와 선택한 기능은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar o tipo de protocolo redefine o protocolo, a autenticação e a identidade Codex para os novos padrões. O ID do modelo e as capacidades selecionadas são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена типа протокола сбросит протокол, аутентификацию и идентификатор Codex к новым значениям по умолчанию. ID модели и выбранные возможности сохранятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนประเภทโปรโตคอลจะรีเซ็ตโปรโตคอล การยืนยันตัวตน และข้อมูลระบุ Codex เป็นค่าเริ่มต้นใหม่ โดยจะคง ID โมเดลและความสามารถที่เลือกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokol türünü değiştirmek protokolü, kimlik doğrulamayı ve Codex kimliğini yeni varsayılanlara sıfırlar. Model kimliği ve seçilen özellikler korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi loại giao thức sẽ đặt lại giao thức, xác thực và danh tính Codex về các giá trị mặc định mới. ID mô hình và các khả năng đã chọn vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换协议类型会把协议、认证方式和 Codex 身份重置为新类型的默认值，但模型 ID 与已选择的能力会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換協議類型會把協議、驗證方式和 Codex 身分重設為新類型的預設值，但模型 ID 與已選擇的能力會保留。"
          }
        }
      }
    },
    "Switching the relay type will reset transport, auth, and Codex identity to the recommended defaults.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير نوع البروتوكول إلى إعادة البروتوكول والمصادقة وهوية Codex إلى الإعدادات الافتراضية الموصى بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ändern des Protokolltyps werden Protokoll, Authentifizierung und Codex-Identität auf die empfohlenen Standardwerte zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching the protocol type resets the protocol, authentication, and Codex identity to the recommended defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tipo de protocolo restablece el protocolo, la autenticación y la identidad de Codex a los valores recomendados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le type de protocole réinitialise le protocole, l’authentification et l’identité Codex selon les valeurs recommandées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटोकॉल प्रकार बदलने पर प्रोटोकॉल, प्रमाणीकरण और Codex पहचान अनुशंसित डिफ़ॉल्ट पर रीसेट हो जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti jenis protokol akan mengatur ulang protokol, autentikasi, dan identitas Codex ke nilai default yang direkomendasikan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロトコルの種類を切り替えると、プロトコル、認証、Codex クライアント識別が推奨の既定値に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로토콜 유형을 바꾸면 프로토콜, 인증 및 Codex 식별 정보가 권장 기본값으로 재설정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar o tipo de protocolo redefine o protocolo, a autenticação e a identidade Codex para os padrões recomendados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена типа протокола сбросит протокол, аутентификацию и идентификатор Codex к рекомендуемым значениям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนประเภทโปรโตคอลจะรีเซ็ตโปรโตคอล การยืนยันตัวตน และข้อมูลระบุ Codex เป็นค่าเริ่มต้นที่แนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokol türünü değiştirmek protokolü, kimlik doğrulamayı ve Codex kimliğini önerilen varsayılanlara sıfırlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi loại giao thức sẽ đặt lại giao thức, xác thực và danh tính Codex về các giá trị mặc định được đề xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换协议类型会把协议、认证方式和 Codex 身份重置为推荐的默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換協議類型會把協議、驗證方式和 Codex 身分重設為建議的預設值。"
          }
        }
      }
    },
    "Switching to an unencrypted connection also deletes: this connection's key, custom headers, and custom query parameters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي التبديل إلى اتصال غير مشفر أيضًا إلى حذف: مفتاح هذا الاتصال، والرؤوس المخصصة، ومعلمات الاستعلام المخصصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel zu einer unverschlüsselten Verbindung werden außerdem Folgendes gelöscht: der Schlüssel dieser Verbindung, benutzerdefinierte Header und benutzerdefinierte Abfrageparameter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to an unencrypted connection also deletes: this connection's key, custom headers, and custom query parameters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a una conexión no cifrada también elimina: la clave de esta conexión, los encabezados personalizados y los parámetros de consulta personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le passage à une connexion non chiffrée supprime également : la clé de cette connexion, les en-têtes personnalisés et les paramètres de requête personnalisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनएन्क्रिप्टेड कनेक्शन पर स्विच करने से यह भी हट जाता है: इस कनेक्शन की कुंजी, कस्टम हेडर और कस्टम क्वेरी पैरामीटर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih ke koneksi tidak terenkripsi juga menghapus: kunci koneksi ini, header khusus, dan parameter kueri khusus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されていない接続に切り替えると、この接続のキー、カスタム ヘッダー、カスタム クエリ パラメータも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않은 연결로 전환하면 이 연결의 키, 사용자 정의 헤더 및 사용자 정의 쿼리 매개변수도 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar para uma conexão não criptografada também exclui: a chave desta conexão, cabeçalhos personalizados e parâmetros de consulta personalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переключении на незашифрованное соединение также удаляются: ключ этого соединения, пользовательские заголовки и пользовательские параметры запроса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับไปใช้การเชื่อมต่อที่ไม่ได้เข้ารหัสจะลบ: คีย์ของการเชื่อมต่อนี้ ส่วนหัวที่กำหนดเอง และพารามิเตอร์การค้นหาที่กำหนดเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenmemiş bir bağlantıya geçiş aynı zamanda şunları da siler: bu bağlantının anahtarı, özel başlıklar ve özel sorgu parametreleri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chuyển sang kết nối không được mã hóa cũng sẽ xóa: khóa, tiêu đề tùy chỉnh và tham số truy vấn tùy chỉnh của kết nối này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为不加密的连接会同时删除：这条连接的密钥、自定义 Header、自定义 Query 参数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為未加密的連線會同時刪除：這條連線的金鑰、自訂 Header、自訂 Query 參數。"
          }
        }
      }
    },
