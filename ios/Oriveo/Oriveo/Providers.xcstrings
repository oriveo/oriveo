    "You'll authorize with your x.ai account in the browser, then come back here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستمنح الإذن عبر حساب x.ai في المتصفح، ثم تعود إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du autorisierst im Browser mit deinem x.ai-Konto und kommst dann hierher zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll authorize with your x.ai account in the browser, then come back here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizarás con tu cuenta de x.ai en el navegador y luego volverás aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous autoriserez avec votre compte x.ai dans le navigateur, puis reviendrez ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ब्राउज़र में अपने x.ai खाते से अनुमति देंगे, फिर यहाँ वापस आएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan memberi otorisasi dengan akun x.ai di browser, lalu kembali ke sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで x.ai アカウントを承認したあと、この画面に戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 x.ai 계정으로 승인한 뒤 이 화면으로 돌아오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai autorizar com sua conta x.ai no navegador e depois voltar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы авторизуетесь через аккаунт x.ai в браузере и вернётесь сюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะอนุญาตด้วยบัญชี x.ai ในเบราว์เซอร์ แล้วกลับมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıda x.ai hesabınla yetkilendirip buraya döneceksin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ ủy quyền bằng tài khoản x.ai trong trình duyệt, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在浏览器中用 x.ai 账号完成授权，然后回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將在瀏覽器中用 x.ai 帳號完成授權，然後回到這裡。"
          }
        }
      }
    },
    "You'll sign in with your ChatGPT account in the browser, then come back here. Your messages are processed by OpenAI Codex.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستسجّل الدخول عبر حساب ChatGPT في المتصفح، ثم تعود إلى هنا. تُعالَج رسائلك بواسطة OpenAI Codex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich im Browser mit deinem ChatGPT-Konto an und kommst dann hierher zurück. Deine Nachrichten werden von OpenAI Codex verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll sign in with your ChatGPT account in the browser, then come back here. Your messages are processed by OpenAI Codex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciarás sesión con tu cuenta de ChatGPT en el navegador y luego volverás aquí. Tus mensajes se procesan con OpenAI Codex."
          }
