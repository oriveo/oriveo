    "Remove query parameters from the Endpoint. Query-based API keys are never tried automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإزالة معلمات الاستعلام من نقطة النهاية. لا يتم مطلقًا تجربة مفاتيح واجهة برمجة التطبيقات (API) المستندة إلى الاستعلام تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie Abfrageparameter vom Endpunkt. Abfragebasierte API-Schlüssel werden nie automatisch ausprobiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove query parameters from the Endpoint. Query-based API keys are never tried automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine los parámetros de consulta del Endpoint. Las claves API basadas en consultas nunca se prueban automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les paramètres de requête du point de terminaison. Les clés API basées sur des requêtes ne sont jamais essayées automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समापन बिंदु से क्वेरी पैरामीटर हटाएँ। क्वेरी-आधारित API कुंजियाँ कभी भी स्वचालित रूप से आज़माई नहीं जातीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus parameter kueri dari Titik Akhir. Kunci API berbasis kueri tidak pernah dicoba secara otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントからクエリ パラメーターを削除します。クエリベースの API キーが自動的に試行されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트에서 쿼리 매개변수를 제거합니다. 쿼리 기반 API 키는 자동으로 시도되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova os parâmetros de consulta do endpoint. As chaves de API baseadas em consulta nunca são testadas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите параметры запроса из конечной точки. Ключи API на основе запроса никогда не проверяются автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบพารามิเตอร์แบบสอบถามออกจากจุดสิ้นสุด คีย์ API ที่ยึดตามคำสืบค้นจะไม่พยายามโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgu parametrelerini Uç Noktadan kaldırın. Sorgu tabanlı API anahtarları hiçbir zaman otomatik olarak denenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tham số truy vấn khỏi Điểm cuối. Khóa API dựa trên truy vấn không bao giờ được thử tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请移除 Endpoint 中的查询参数。Oriveo 不会自动尝试 Query API Key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
