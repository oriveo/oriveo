        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में लोकल नेटवर्क एक्सेस की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses jaringan lokal di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でローカルネットワークへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 로컬 네트워크 접근을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à rede local nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к локальной сети в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงเครือข่ายภายในในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
