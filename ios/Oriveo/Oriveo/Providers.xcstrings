        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa lo que te dio tu relevo. Oriveo detectará la raíz de la API, el estilo de autenticación y el protocolo compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les informations de ce LLM personnalisé. Oriveo détectera l’URL de requête, l’authentification et le protocole compatible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कस्टम LLM की जानकारी दर्ज करें। Oriveo अनुरोध URL, प्रमाणीकरण शैली और संगत प्रोटोकॉल का पता लगाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan detail untuk LLM kustom ini. Oriveo akan mendeteksi URL permintaan, metode autentikasi, dan protokol yang kompatibel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカスタム LLM の情報を入力してください。Oriveo がリクエスト URL、認証方式、対応プロトコルを検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자 지정 LLM의 정보를 입력하세요. Oriveo가 요청 URL, 인증 방식 및 호환 프로토콜을 감지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
