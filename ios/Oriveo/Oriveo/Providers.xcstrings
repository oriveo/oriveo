    "Use the option named by your relay provider. Oriveo fills the default connection settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الخيار الذي يطابق الاسم لدى مزود الـ custom LLM. سيملأ Oriveo إعدادات الاتصال الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Option, die dein benutzerdefiniertes LLM-Anbieter nennt. Oriveo füllt die Standard-Verbindungseinstellungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the option named by your custom LLM provider. Oriveo fills the default connection settings."
          }
        },
        "es": {
          "stringUnit": {
