    "Default web_search matches OpenAI and main Codex relays. Switch to web_search_preview for legacy relays.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوافق web_search الافتراضي مع OpenAI واتصالات Codex الرئيسية. بدّل إلى web_search_preview للاتصالات القديمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "web_search passt standardmäßig zu OpenAI und den wichtigsten Codex-benutzerdefinierte LLMs. Für ältere benutzerdefinierte LLMs auf web_search_preview umstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default web_search matches OpenAI and main Codex connections. Switch to web_search_preview for legacy connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El web_search predeterminado coincide con OpenAI y los relevos Codex principales. Cambia a web_search_preview para relevos antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "web_search par défaut correspond à OpenAI et aux principaux LLM personnalisé Codex. Passez à web_search_preview pour les anciens LLM personnalisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट web_search OpenAI और मुख्य Codex कस्टम LLM से मेल खाता है। पुराने कस्टम LLM के लिए web_search_preview पर स्विच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "web_search default cocok dengan OpenAI dan LLM kustom Codex utama. Ganti ke web_search_preview untuk LLM kustom lama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの web_search は OpenAI と主要 Codex カスタム LLM に対応します。旧来のカスタム LLM は web_search_preview に切替。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 web_search는 OpenAI 및 주요 Codex 사용자 지정 LLM과 호환됩니다. 레거시 사용자 지정 LLM는 web_search_preview로 전환하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão web_search corresponde à OpenAI e aos principais LLM personalizados Codex. Use web_search_preview para LLM personalizados antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию web_search подходит для OpenAI и основных Codex пользовательская LLM. Для устаревших пользовательская LLM переключитесь на web_search_preview."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "web_search ค่าเริ่มต้นเข้ากันได้กับ OpenAI และLLM แบบกำหนดเอง Codex หลัก เปลี่ยนเป็น web_search_preview สำหรับ LLM แบบกำหนดเองรุ่นเก่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan web_search, OpenAI ve ana Codex aktarımlarıyla uyumludur. Eski aktarımlar için web_search_preview'a geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "web_search mặc định phù hợp với OpenAI và các LLM tùy chỉnh Codex chính. Chuyển sang web_search_preview cho LLM tùy chỉnh cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 web_search 适配 OpenAI 和主线 Codex 连接；旧版连接请切换为 web_search_preview。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 web_search 適配 OpenAI 與主線 Codex 自訂 LLM；舊版自訂 LLM 請切換為 web_search_preview。"
          }
        }
      }
    },
