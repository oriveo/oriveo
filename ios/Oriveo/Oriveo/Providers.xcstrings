    "Remove query parameters from the request URL. Oriveo never tries API keys from query parameters automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزِل معاملات الاستعلام من عنوان URL للطلب. لا يحاول Oriveo أبدًا استخدام مفاتيح API من معاملات الاستعلام تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne Abfrageparameter aus der Anfrage-URL. Oriveo probiert API-Schlüssel aus Abfrageparametern niemals automatisch aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove query parameters from the request URL. Oriveo never tries API keys from query parameters automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los parámetros de consulta de la URL de solicitud. Oriveo nunca prueba automáticamente las claves API de los parámetros de consulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez les paramètres de requête de l'URL de la requête. Oriveo n'essaie jamais automatiquement les clés API à partir des paramètres de requête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुरोध URL से क्वेरी पैरामीटर हटाएँ। Oriveo कभी भी क्वेरी पैरामीटर से एपीआई कुंजियों को स्वचालित रूप से आज़माता नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus parameter kueri dari URL permintaan. Oriveo tidak pernah mencoba API key dari parameter kueri secara otomatis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエスト URL からクエリ パラメータを削除します。 Oriveo はクエリ パラメーターから API キーを自動的に試行することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청 URL에서 쿼리 매개변수를 제거합니다. Oriveo는 쿼리 매개변수에서 API 키를 자동으로 시도하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remova os parâmetros de consulta do URL de solicitação. Oriveo nunca tenta chaves de API a partir de parâmetros de consulta automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уберите параметры запроса из URL запроса. Oriveo никогда не пробует автоматически API-ключи из параметров запроса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบพารามิเตอร์การค้นหาออกจาก URL คำขอ Oriveo ไม่เคยลองใช้คีย์ API จากพารามิเตอร์การสืบค้นโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgu parametrelerini istek URL'sinden kaldırın. Oriveo hiçbir zaman sorgu parametrelerinden API anahtarlarını otomatik olarak denemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tham số truy vấn khỏi URL yêu cầu. Oriveo không bao giờ tự động thử khóa API từ các tham số truy vấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请移除请求地址中的查询参数。Oriveo 绝不会自动尝试查询参数中的 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請移除請求網址中的查詢參數。Oriveo 絕不會自動嘗試查詢參數中的 API 金鑰。"
          }
        }
      }
    },
