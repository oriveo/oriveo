          "stringUnit" : {
            "state" : "translated",
            "value" : "個別にプロトコルを設定したモデルを除き、すべてのモデルが %@ を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로토콜을 따로 지정한 모델을 제외하고 모든 모델이 %@ 프로토콜을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os modelos usam %@, exceto os que tiverem um protocolo próprio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все модели используют %@, кроме тех, для которых задан свой протокол."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกโมเดลจะใช้ %@ ยกเว้นโมเดลที่กำหนดโปรโตคอลเองไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi protokolü ayarlanmış modeller dışında tüm modeller %@ kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi mô hình đều dùng %@, trừ những mô hình đã được đặt giao thức riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
