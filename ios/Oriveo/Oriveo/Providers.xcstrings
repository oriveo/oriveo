    "Could not refresh model catalog. Current models are still available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not refresh model catalog. Current models are still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法刷新模型目录，当前模型仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法重新整理模型目錄，目前模型仍可使用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديث كتالوج النماذج. النماذج الحالية لا تزال متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellkatalog konnte nicht aktualisiert werden. Die aktuellen Modelle sind weiterhin verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el catálogo de modelos. Los modelos actuales siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
