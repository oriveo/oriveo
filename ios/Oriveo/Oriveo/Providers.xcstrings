    "Confirmed the %@ protocol, but this relay does not publish a model catalog. Enter a model ID above to continue.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد بروتوكول %@، لكن هذا النموذج اللغوي الكبير المخصص لا ينشر كتالوج نماذج. أدخل معرّف نموذج بالأعلى للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll %@ wurde bestätigt, aber dieses benutzerdefinierte LLM veröffentlicht keinen Modellkatalog. Geben Sie oben eine Modell-ID ein, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed the %@ protocol, but this custom LLM does not publish a model catalog. Enter a model ID above to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se confirmó el protocolo %@, pero este LLM personalizado no publica un catálogo de modelos. Introduce un ID de modelo arriba para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le protocole %@ est confirmé, mais ce LLM personnalisé ne publie pas de catalogue de modèles. Saisissez un ID de modèle ci-dessus pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ प्रोटोकॉल की पुष्टि हो गई, लेकिन यह कस्टम LLM मॉडल कैटलॉग प्रकाशित नहीं करता। जारी रखने के लिए ऊपर एक मॉडल ID दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokol %@ dikonfirmasi, tetapi LLM kustom ini tidak menerbitkan katalog model. Masukkan ID model di atas untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ プロトコルを確認しました。ただしこのカスタム LLM はモデルカタログを公開していません。続けるには上でモデル ID を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프로토콜을 확인했습니다. 다만 이 사용자 지정 LLM은 모델 카탈로그를 제공하지 않습니다. 계속하려면 위에 모델 ID를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocoloo %@ confirmado, mas este LLM personalizado não publica um catálogo de modelos. Informe um ID de modelo acima para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Протокол %@ подтверждён, но эта пользовательская LLM не публикует каталог моделей. Введите ID модели выше, чтобы продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันโปรโตคอล %@ แล้ว แต่ LLM แบบกำหนดเองนี้ไม่เผยแพร่แค็ตตาล็อกโมเดล กรอก ID โมเดลด้านบนเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ protokolü doğrulandı, ancak bu aktarıcı bir model kataloğu yayınlamıyor. Devam etmek için yukarıya bir model kimliği girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác nhận giao thức %@, nhưng LLM tùy chỉnh này không công bố danh mục mô hình. Nhập ID mô hình ở trên để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认协议为 %@，但这个自定义 LLM 不提供模型目录。请在上方填入模型 ID 后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認協議為 %@，但這個自訂 LLM 不提供模型目錄。請在上方填入模型 ID 後繼續。"
          }
        }
      }
    },
