    "Qwen API keys are region-locked. Select the region matching your API key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح Qwen API مقيدة بالمنطقة. اختر المنطقة المطابقة لمفتاح API الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen API-Schlüssel sind regionengebunden. Wählen Sie die Region aus, die zu Ihrem API-Schlüssel passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API de Qwen están bloqueadas por región. Selecciona la región que corresponda a tu clave API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API Qwen sont liées à une région. Sélectionnez la région correspondant à votre clé API."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen क्षेत्र-बंद हैं। अपने API से मेल खाने वाला क्षेत्र चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen dikunci wilayahnya. Pilih wilayah yang cocok dengan API Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen APIキーはリージョンに紐づいています。APIキーに対応するリージョンを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen API 키는 리전에 고정되어 있습니다. API 키와 일치하는 리전을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves API do Qwen são vinculadas a uma região. Selecione a região correspondente à sua chave API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen привязаны к региону. Выберите регион, соответствующий вашему API."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen ถูกล็อคภูมิภาค เลือกภูมิภาคที่ตรงกับ API ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen bölge kilitlidir. API'nizle eşleşen bölgeyi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API Qwen bị khóa khu vực. Chọn vùng phù hợp với API của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen API 密钥与区域绑定，请选择与你的 API 密钥匹配的区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen API 金鑰與區域綁定，請選擇與你的 API 金鑰匹配的區域。"
          }
        }
      }
    },
