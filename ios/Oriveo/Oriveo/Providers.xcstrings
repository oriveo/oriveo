        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल कैटलॉग अपडेट नहीं किया जा सका। मौजूदा मॉडल अभी भी उपलब्ध हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memperbarui katalog model. Model saat ini masih tersedia."
