    "After saving, Oriveo sends one tiny request to the first selected model to confirm it works." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الحفظ، يرسل Oriveo طلبًا صغيرًا جدًا واحدًا إلى أول نموذج محدد للتأكد من أنه يعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Speichern sendet Oriveo eine winzige Anfrage an das erste ausgewählte Modell, um zu prüfen, ob es funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After saving, Oriveo sends one tiny request to the first selected model to confirm it works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar, Oriveo envía una solicitud mínima al primer modelo seleccionado para confirmar que funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’enregistrement, Oriveo envoie une toute petite requête au premier modèle sélectionné pour vérifier qu’il fonctionne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजने के बाद Oriveo, चुने गए पहले मॉडल को एक बहुत छोटा अनुरोध भेजकर पक्का करता है कि वह काम कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah disimpan, Oriveo mengirim 1 permintaan sangat kecil ke model pertama yang dipilih untuk memastikan model itu berfungsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後、Oriveo は選択した最初のモデルにごく小さなリクエストを 1 回送り、使えるか確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 Oriveo가 선택한 첫 번째 모델에 아주 작은 요청을 1회 보내 사용할 수 있는지 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de salvar, o Oriveo envia uma solicitação mínima ao primeiro modelo selecionado para confirmar que ele funciona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сохранения Oriveo отправит один крошечный запрос первой выбранной модели, чтобы убедиться, что она работает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังบันทึก Oriveo จะส่งคำขอเล็กๆ 1 ครั้งไปยังโมเดลแรกที่เลือก เพื่อยืนยันว่าใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydettikten sonra Oriveo, çalıştığını doğrulamak için seçilen ilk modele çok küçük bir istek gönderir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi lưu, Oriveo sẽ gửi 1 yêu cầu rất nhỏ tới mô hình đầu tiên được chọn để xác nhận mô hình dùng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
