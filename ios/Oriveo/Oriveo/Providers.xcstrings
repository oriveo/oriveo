        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes se configuran automáticamente para cada proveedor. La compatibilidad con URL de solicitud personalizadas llegará en una actualización futura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces paramètres sont configurés automatiquement pour chaque fournisseur. La prise en charge des URL de requête personnalisées arrivera dans une prochaine mise à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये सेटिंग्स प्रत्येक प्रोवाइडर के लिए स्वचालित रूप से कॉन्फ़िगर होती हैं। कस्टम अनुरोध URL का समर्थन भविष्य के अपडेट में उपलब्ध होगा।"
          }
