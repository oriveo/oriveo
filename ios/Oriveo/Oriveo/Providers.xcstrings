        }
      }
    },
    "This relay requires the OpenAI Responses protocol. Open Providers → this Relay → Edit → Relay type and switch to “Codex style (Responses)”, then retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This custom LLM requires the OpenAI Responses protocol. Open Providers → this connection → Connection settings → protocol type and switch to “Codex style (Responses)”, then retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا النموذج اللغوي الكبير المخصص بروتوكول OpenAI Responses. افتح المزوّدون ← هذه الاتصالات ← إعدادات الاتصال ← نوع البروتوكول، ثم اختر «Codex style (Responses)» وأعد المحاولة."
          }
