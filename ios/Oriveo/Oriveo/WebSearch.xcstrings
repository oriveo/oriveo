    "webSearch.custom.addressHintMobile" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناوين العامة تتطلب https. يمكن لعناوين الشبكة المحلية استخدام http، لكن حركة البيانات لا تكون مشفّرة؛ لذا يقتصر استخدامها على الشبكات الموثوقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffentliche Adressen brauchen https. Adressen im lokalen Netzwerk können http nutzen, die Daten werden dann aber unverschlüsselt übertragen – nutze sie nur in Netzwerken, denen du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public addresses need https. Local network addresses can use http, but traffic isn't encrypted—use them only on networks you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones públicas necesitan https. Las de la red local pueden usar http, pero el tráfico no va cifrado: úsalas solo en redes de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adresses publiques doivent utiliser https. Les adresses du réseau local peuvent utiliser http, mais le trafic n’est alors pas chiffré : utilisez-les uniquement sur des réseaux de confiance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सार्वजनिक पतों के लिए https ज़रूरी है। लोकल नेटवर्क के पते http इस्तेमाल कर सकते हैं, पर ट्रैफ़िक एन्क्रिप्ट नहीं होता—इन्हें सिर्फ़ भरोसेमंद नेटवर्क पर इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat publik wajib memakai https. Alamat jaringan lokal boleh memakai http, tetapi lalu lintasnya tidak dienkripsi—pakai hanya di jaringan yang Anda percayai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開アドレスには https が必要です。ローカルネットワークのアドレスは http も使えますが、通信は暗号化されません。信頼できるネットワークでのみ使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 주소는 https를 사용해야 해요. 로컬 네트워크 주소는 http도 쓸 수 있지만 암호화되지 않으니 신뢰할 수 있는 네트워크에서만 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereços públicos precisam de https. Endereços da rede local podem usar http, mas o tráfego não é criptografado — use-os só em redes confiáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для публичных адресов нужен https. Адреса в локальной сети могут работать по http, но трафик не шифруется — используйте их только в доверенных сетях."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่สาธารณะต้องใช้ https ที่อยู่ในเครือข่ายท้องถิ่นใช้ http ได้ แต่ข้อมูลจะไม่ถูกเข้ารหัส ควรใช้เฉพาะในเครือข่ายที่คุณไว้ใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel adresler https gerektirir. Yerel ağ adresleri http kullanabilir ama trafik şifrelenmez; bunları yalnızca güvendiğiniz ağlarda kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ công khai phải dùng https. Địa chỉ mạng nội bộ có thể dùng http nhưng không được mã hóa, chỉ nên dùng trên mạng bạn tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公网地址需要 https。局域网地址可以用 http，但不加密，只在可信网络里使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開網路位址需要使用 https。區域網路位址可以用 http，但不會加密，請只在可信任的網路中使用。"
          }
        }
      }
    },
