    "webSearch.consent.sendsQuery" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإجابة عن أسئلتك، يرسل Oriveo عمليات البحث إلى %@. يكتب النموذج عبارات البحث استنادًا إلى المحادثة، وقد تتضمن تفاصيل منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine Fragen zu beantworten, sendet Oriveo Suchanfragen an %@. Das Modell formuliert diese Suchanfragen anhand deines Chats, sie können also Details daraus enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To answer your questions, Oriveo sends searches to %@. Searches are written by the model from your chat and may include details from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para responder a tus preguntas, Oriveo envía búsquedas a %@. El modelo redacta esas búsquedas a partir de tu chat, así que pueden incluir detalles de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour répondre à vos questions, Oriveo envoie des recherches à %@. Ces recherches sont rédigées par le modèle à partir de votre conversation et peuvent en reprendre certains détails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सवालों का जवाब देने के लिए Oriveo खोजें %@ को भेजता है। खोज के शब्द मॉडल आपकी चैट के आधार पर लिखता है, इसलिए उनमें चैट की जानकारी हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menjawab pertanyaan Anda, Oriveo mengirim pencarian ke %@. Kata kunci pencarian disusun oleh model berdasarkan percakapan Anda dan bisa memuat detail dari percakapan itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問に答えるため、Oriveo は検索内容を %@ に送信します。検索内容はチャットをもとにモデルが作成するため、チャットの内容が含まれることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문에 답하기 위해 Oriveo는 검색 내용을 %@에 보내요. 검색 내용은 모델이 채팅을 바탕으로 작성하므로 채팅 속 정보가 포함될 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para responder às suas perguntas, o Oriveo envia buscas para %@. As buscas são escritas pelo modelo a partir da sua conversa e podem incluir detalhes dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы ответить на ваши вопросы, Oriveo отправляет поисковые запросы в %@. Запросы составляет модель на основе чата, поэтому в них могут попасть сведения из него."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อตอบคำถามของคุณ Oriveo จะส่งคำค้นหาไปยัง %@ โมเดลจะสร้างคำค้นหาจากแชตของคุณ จึงอาจมีรายละเอียดจากแชตติดไปด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorularınızı yanıtlamak için Oriveo aramaları %@ hizmetine gönderir. Arama ifadelerini model sohbetinize bakarak yazar; bu ifadeler sohbetten ayrıntılar içerebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trả lời câu hỏi của bạn, Oriveo gửi nội dung tìm kiếm tới %@. Nội dung tìm kiếm do mô hình viết dựa trên cuộc trò chuyện và có thể chứa thông tin từ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了回答你的问题，Oriveo 会把搜索内容发给 %@。搜索内容由模型根据对话生成，可能包含对话里的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了回答你的問題，Oriveo 會把搜尋內容傳送給 %@。搜尋內容由模型根據對話產生，可能包含對話中的資訊。"
          }
        }
      }
    },
