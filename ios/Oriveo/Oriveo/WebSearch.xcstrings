    "webSearch.add.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تضم القائمة المدمجة إلا مزوّدين معروفين. يحدد كل مزوّد أسعاره، ويُرجى مراجعة موقعه للاطلاع على أحدثها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integriert sind nur bekannte Anbieter. Die Preise legt jeder Anbieter selbst fest – die aktuellen findest du auf seiner Website."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only well-known providers are built in. Prices are set by each provider; check their site for the latest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se incluyen proveedores conocidos. Cada proveedor fija sus precios; consulta su sitio para ver los vigentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls des fournisseurs reconnus sont intégrés. Chaque fournisseur fixe ses prix ; consultez son site pour les tarifs à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्ट-इन सूची में सिर्फ़ जाने-माने प्रोवाइडर शामिल हैं। कीमतें हर प्रोवाइडर खुद तय करता है; ताज़ा जानकारी के लिए उनकी साइट देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar siap pakai hanya berisi penyedia ternama. Harga ditentukan oleh masing-masing penyedia; cek situs mereka untuk info terbaru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットには有名なプロバイダーのみを収録しています。料金は各プロバイダーが定めているため、最新の料金は公式サイトで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 서비스에는 잘 알려진 제공업체만 포함돼요. 요금은 각 제공업체가 정하므로 최신 요금은 해당 사이트에서 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só provedores conhecidos estão integrados. Cada provedor define os próprios preços; confira o site dele para ver os valores atuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроены только известные провайдеры. Цены устанавливает каждый провайдер — актуальные смотрите на его сайте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการในตัวมีเฉพาะผู้ให้บริการที่เป็นที่รู้จัก ราคากำหนดโดยผู้ให้บริการแต่ละราย โปรดดูราคาล่าสุดที่เว็บไซต์ของผู้ให้บริการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır listede yalnızca tanınmış sağlayıcılar yer alır. Fiyatları her sağlayıcı kendisi belirler; güncel bilgi için sitelerine bakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách có sẵn chỉ gồm các nhà cung cấp nổi tiếng. Giá do từng nhà cung cấp quy định; hãy xem trang web của họ để biết giá mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预置只收录知名的搜索服务，价格以各家官网为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建清單只收錄知名供應商，價格以各家官網為準。"
          }
        }
      }
    },
    "webSearch.add.presetsUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر تحميل الخدمات المدمجة حاليًا. الخدمات المخصصة لا تزال تعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Dienste können gerade nicht geladen werden. Benutzerdefinierte Dienste funktionieren weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in services can't be loaded right now. Custom services still work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no se pueden cargar los servicios integrados. Los servicios personalizados siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les services intégrés pour le moment. Les services personnalisés fonctionnent toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्ट-इन सेवाएँ अभी लोड नहीं हो पा रहीं। कस्टम सेवाएँ पहले की तरह काम करती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan siap pakai sedang tidak bisa dimuat. Layanan kustom tetap bisa dipakai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットのサービスを現在読み込めません。カスタムサービスは引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 내장 서비스를 불러올 수 없어요. 사용자 지정 서비스는 계속 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível carregar os serviços integrados agora. Os serviços personalizados continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенные сервисы сейчас не загружаются. Пользовательские сервисы работают как обычно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดบริการในตัวไม่ได้ในขณะนี้ บริการแบบกำหนดเองยังใช้งานได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır hizmetler şu anda yüklenemiyor. Özel hizmetler çalışmaya devam ediyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện không tải được các dịch vụ có sẵn. Dịch vụ tùy chỉnh vẫn dùng bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预置服务暂时无法加载，自定义服务不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建服務暫時無法載入，自訂服務不受影響。"
          }
        }
      }
    },
