    "webSearch.consent.billing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب رسوم عمليات البحث على حسابك لدى %@. لا يفرض Oriveo أي رسوم إضافية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechnet die Suchen über dein Konto ab. Oriveo berechnet nichts zusätzlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bills searches to your account. Oriveo doesn't charge anything extra."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cobra las búsquedas en tu cuenta. Oriveo no cobra nada adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ facture les recherches sur votre compte. Oriveo ne prélève rien en plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोजों का बिल %@ आपके खाते में लगाता है। Oriveo कोई अतिरिक्त शुल्क नहीं लेता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menagihkan biaya pencarian ke akun Anda. Oriveo tidak memungut biaya tambahan apa pun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索の料金は、お使いの %@ アカウントに請求されます。Oriveo から追加の請求はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 요금은 %@ 계정으로 청구돼요. Oriveo는 추가 요금을 받지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cobra as buscas na sua conta. O Oriveo não cobra nada a mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ списывает плату за поиск с вашего аккаунта. Oriveo не берёт дополнительной платы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จะเรียกเก็บค่าค้นหาจากบัญชีของคุณ Oriveo ไม่เก็บค่าบริการเพิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, aramaların ücretini hesabınızdan alır. Oriveo ek ücret almaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tính phí tìm kiếm vào tài khoản của bạn. Oriveo không thu thêm khoản phí nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索费用由 %@ 从你的账户扣，Oriveo 不另收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋費用由 %@ 從你的帳戶扣款，Oriveo 不另外收費。"
          }
        }
      }
    },
    "webSearch.consent.billingCustom" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كانت هذه الخدمة تفرض رسومًا على عمليات البحث، فهي تحصّلها منك مباشرة. لا يفرض Oriveo أي رسوم إضافية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls dieser Dienst Suchen berechnet, rechnet er direkt mit dir ab. Oriveo berechnet nichts zusätzlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this service charges for searches, it bills you directly. Oriveo doesn't charge anything extra."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este servicio cobra por las búsquedas, te las cobra directamente. Oriveo no cobra nada adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce service facture les recherches, il vous les facture directement. Oriveo ne prélève rien en plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर यह सेवा खोजों के लिए शुल्क लेती है, तो बिल सीधे वही आपसे लेती है। Oriveo कोई अतिरिक्त शुल्क नहीं लेता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika layanan ini memungut biaya pencarian, layanan itu akan menagih Anda secara langsung. Oriveo tidak memungut biaya tambahan apa pun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスが有料の場合、料金はサービスから直接請求されます。Oriveo から追加の請求はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서비스가 유료라면 요금은 서비스에서 직접 청구해요. Oriveo는 추가 요금을 받지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se este serviço cobrar pelas buscas, a cobrança é feita diretamente a você. O Oriveo não cobra nada a mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот сервис берёт плату за поиск, он выставляет счёт вам напрямую. Oriveo не берёт дополнительной платы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากบริการนี้คิดค่าค้นหา บริการจะเรียกเก็บจากคุณโดยตรง Oriveo ไม่เก็บค่าบริการเพิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hizmet aramalar için ücret alıyorsa ücreti doğrudan sizden alır. Oriveo ek ücret almaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu dịch vụ này tính phí tìm kiếm, họ sẽ thu trực tiếp từ bạn. Oriveo không thu thêm khoản phí nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这个服务收费，费用由它向你收取，Oriveo 不另收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果這個服務會收費，費用由它直接向你收取，Oriveo 不另外收費。"
          }
        }
      }
    },
    "webSearch.consent.customUnverified" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الخدمة من إضافتك، لذا لا يمكن لـ Oriveo التحقق منها. لا يُرسَل مفتاحك إلا إلى %@."
