    "webSearch.picker.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق على هذا النموذج في هذه المحادثة. تُحتسب رسوم الخدمات الخارجية على حسابك الخاص وفق أسعارها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für dieses Modell in diesem Chat. Externe Dienste rechnen zu ihren Preisen über dein eigenes Konto ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to this model in this chat. External services bill your own account at their prices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a este modelo en este chat. Los servicios externos cobran en tu cuenta según sus precios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à ce modèle dans cette conversation. Les services externes facturent votre compte à leurs tarifs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस चैट में इस मॉडल पर लागू होता है। बाहरी सेवाओं का बिल आपके अपने खाते से उनकी कीमतों पर कटता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk model ini di percakapan ini. Layanan eksternal menagih ke akun Anda sesuai tarif mereka."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットの現在のモデルにのみ適用されます。外部サービスは各サービスの料金で、ご自身のアカウントに課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅의 현재 모델에만 적용돼요. 외부 서비스는 해당 요금으로 내 계정에 청구돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para este modelo nesta conversa. Serviços externos cobram na sua própria conta, pelos preços deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для этой модели в этом чате. Внешние сервисы списывают оплату с вашего аккаунта по своим тарифам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับโมเดลนี้ในแชตนี้ บริการภายนอกจะเรียกเก็บจากบัญชีของคุณตามราคาของบริการนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbetteki bu model için geçerlidir. Harici hizmetler, kendi fiyatlarıyla kendi hesabınızdan ücret alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng cho mô hình này trong cuộc trò chuyện này. Dịch vụ ngoài tính phí vào tài khoản của bạn theo giá của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只对这个会话里的当前模型生效。外部服务按它的价格从你的账户计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅適用於這個聊天中的目前模型。外部服務會依其價格向你自己的帳戶計費。"
          }
        }
      }
    },
