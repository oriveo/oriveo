    "webSearch.manual.pathHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُربط أسماء الحقول بنقاط، مثل data.items. لا تُدعم الأقواس المربعة ولا أحرف البدل ولا القوالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Feldnamen mit Punkten, z. B. data.items. Eckige Klammern, Wildcards und Vorlagen werden nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use field names joined by dots, like data.items. Brackets, wildcards, and templates aren't supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une los nombres de campo con puntos, como data.items. No se admiten corchetes, comodines ni plantillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reliez les noms de champs par des points, par exemple data.items. Les crochets, les caractères génériques et les templates ne sont pas pris en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ील्ड के नाम बिंदु से जोड़ें, जैसे data.items। ब्रैकेट, वाइल्डकार्ड और टेम्पलेट समर्थित नहीं हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabungkan nama kolom dengan titik, misalnya data.items. Kurung siku, wildcard, dan template tidak didukung."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィールド名をドットでつないで入力します（例: data.items）。角かっこ、ワイルドカード、テンプレートには対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필드 이름을 점으로 연결해 입력하세요(예: data.items). 대괄호, 와일드카드, 템플릿은 지원하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue os nomes dos campos com pontos, como data.items. Colchetes, curingas e templates não são suportados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединяйте имена полей точками, например data.items. Квадратные скобки, подстановочные знаки и шаблоны не поддерживаются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ชื่อฟิลด์คั่นด้วยจุด เช่น data.items ไม่รองรับวงเล็บเหลี่ยม ไวลด์การ์ด และเทมเพลต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alan adlarını noktayla birleştirin, ör. data.items. Köşeli parantez, joker karakter ve şablon desteklenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nối tên trường bằng dấu chấm, ví dụ data.items. Không hỗ trợ dấu ngoặc vuông, ký tự đại diện và mẫu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字段名用点号连接，如 data.items；不支持方括号、通配符和模板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欄位名稱用句點連接，例如 data.items；不支援方括號、萬用字元和範本。"
          }
        }
      }
    },
