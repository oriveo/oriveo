    "webSearch.consent.webForwarded" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في نسخة الويب، تمر عمليات البحث عبر خدمة الويب من Oriveo، وهي لا تحتفظ بمفتاحك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Web-Version laufen Suchanfragen über den Webdienst von Oriveo, der deinen Schlüssel nicht speichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the web, searches are relayed through Oriveo's web service, which doesn't store your key."
          }
        },
        "es" : {
          "stringUnit" : {
