    "webSearch.detail.hostChangedNotice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم %1$@ الآن العنوان %2$@. يلزم التأكيد لمواصلة استخدامها بالمفتاح المحفوظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nutzt jetzt %2$@. Bestätige, um den Dienst mit deinem gespeicherten Schlüssel weiter zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ now uses %2$@. Confirm to keep using it with your saved key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora usa %2$@. Confirma para seguir usándolo con tu clave guardada."
