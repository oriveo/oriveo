        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More results give the model more to draw on, but use more of its context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con más resultados el modelo tiene más en qué basarse, pero ocupan más de su contexto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de résultats donnent davantage de matière au modèle, mais occupent une plus grande part de son contexte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा नतीजों से मॉडल के पास संदर्भ के लिए ज़्यादा सामग्री होती है, पर उसका कॉन्टेक्स्ट भी ज़्यादा भरता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makin banyak hasil, makin banyak bahan rujukan untuk model, tetapi makin banyak pula konteks yang terpakai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "件数を増やすとモデルが参照できる情報が増えますが、そのぶんコンテキストを多く使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과가 많을수록 모델이 참고할 내용이 늘지만, 컨텍스트도 더 많이 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais resultados dão ao modelo mais material, mas ocupam mais do contexto dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем больше результатов, тем больше у модели материала, но тем больше места они занимают в её контексте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผลลัพธ์ยิ่งมาก โมเดลยิ่งมีข้อมูลให้อ้างอิงมาก แต่ก็ใช้บริบทมากขึ้นด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha fazla sonuç modele yararlanacağı daha çok bilgi sunar ama bağlamında daha fazla yer kaplar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhiều kết quả hơn giúp mô hình có thêm thông tin để tham khảo, nhưng cũng chiếm nhiều ngữ cảnh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条数越多，模型可参考的越多，也会占用更多上下文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "筆數越多，模型可參考的資料越多，但也會占用更多上下文。"
          }
        }
      }
    },
