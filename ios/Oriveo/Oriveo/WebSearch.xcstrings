        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilise désormais %2$@. Confirmez pour continuer à l’utiliser avec votre clé enregistrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ अब %2$@ इस्तेमाल करती है। सेव की गई key के साथ इस्तेमाल जारी रखने के लिए पुष्टि करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kini memakai %2$@. Konfirmasi untuk tetap memakainya dengan API key yang tersimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のアドレスが %2$@ に変わりました。確認すると、保存済みのキーで引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 서비스 주소가 %2$@(으)로 바뀌었어요. 확인하면 저장된 키로 계속 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ agora usa %2$@. Confirme para continuar usando com sua chave salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ теперь работает через %2$@. Подтвердите, чтобы и дальше пользоваться сервисом с сохранённым ключом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ %1$@ ใช้ %2$@ ยืนยันเพื่อใช้งานต่อด้วยคีย์ที่บันทึกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ artık %2$@ adresini kullanıyor. Kayıtlı anahtarınızla kullanmaya devam etmek için onaylayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hiện dùng %2$@. Hãy xác nhận để tiếp tục dùng với khóa đã lưu."
