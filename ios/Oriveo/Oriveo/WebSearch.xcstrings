    "webSearch.custom.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الخدمة من إضافتك، لذا لا يمكن لـ Oriveo التحقق منها. لا يُرسَل مفتاحك إلا إلى العنوان أعلاه، وتغيير العنوان يتطلب إدخال المفتاح من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diesen Dienst selbst hinzugefügt, daher kann Oriveo ihn nicht prüfen. Dein Schlüssel wird nur an die Adresse oben gesendet. Änderst du die Adresse, musst du den Schlüssel neu eingeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You added this service yourself, so Oriveo can't verify it. Your key is sent only to the address above; changing the address means entering the key again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servicio lo agregaste tú, así que Oriveo no puede verificarlo. Tu clave solo se envía a la dirección de arriba; si cambias la dirección, tendrás que volver a escribir la clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez ajouté ce service vous-même : Oriveo ne peut donc pas le vérifier. Votre clé n’est envoyée qu’à l’adresse ci-dessus ; si vous changez l’adresse, vous devrez saisir la clé à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सेवा आपने खुद जोड़ी है, इसलिए Oriveo इसकी पुष्टि नहीं कर सकता। आपकी key सिर्फ़ ऊपर दिए पते पर भेजी जाती है; पता बदलने पर key दोबारा डालनी होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan ini Anda tambahkan sendiri, jadi Oriveo tidak bisa memverifikasinya. API key Anda hanya dikirim ke alamat di atas; jika alamatnya diganti, API key harus dimasukkan lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスはご自身で追加したものなので、Oriveo では確認できません。キーは上のアドレスにのみ送信されます。アドレスを変更した場合は、キーを入力し直す必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 추가한 서비스라서 Oriveo가 확인할 수 없어요. 키는 위 주소에만 전송되며, 주소를 바꾸면 키를 다시 입력해야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este serviço foi adicionado por você, então o Oriveo não consegue verificá-lo. Sua chave é enviada apenas para o endereço acima; se você mudar o endereço, vai precisar digitar a chave de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервис добавлен вами, поэтому Oriveo не может его проверить. Ключ отправляется только на указанный выше адрес; если сменить адрес, ключ придётся ввести заново."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเพิ่มบริการนี้เอง Oriveo จึงตรวจสอบไม่ได้ คีย์ของคุณจะส่งไปยังที่อยู่ด้านบนเท่านั้น หากเปลี่ยนที่อยู่ต้องกรอกคีย์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hizmeti kendiniz eklediniz, bu yüzden Oriveo onu doğrulayamaz. Anahtarınız yalnızca yukarıdaki adrese gönderilir; adresi değiştirirseniz anahtarı yeniden girmeniz gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tự thêm dịch vụ này nên Oriveo không thể xác minh nó. Khóa của bạn chỉ được gửi tới địa chỉ ở trên; nếu đổi địa chỉ, bạn cần nhập lại khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你自己添加的服务，Oriveo 无法核实它。Key 只会发往上面这个地址；改了地址需要重新填 Key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是你自行新增的服務，Oriveo 無法核實。金鑰只會傳送到上面這個位址；變更位址後需要重新填寫金鑰。"
          }
        }
      }
    },
