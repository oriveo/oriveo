    "No account. Your keys stay on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون حساب. تبقى مفاتيحك على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto. Deine Schlüssel bleiben auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. Your keys stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Tus claves se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte. Vos clés restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अकाउंट नहीं। आपकी कुंजियाँ इसी डिवाइस पर रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun. Kunci Anda tetap di perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要。キーはこの端末に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이. 키는 이 기기에만 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. Suas chaves ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта. Ваши ключи остаются на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี คีย์ของคุณอยู่บนเครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok. Anahtarlarınız bu cihazda kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Khóa của bạn ở lại trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，密钥只留在这台设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需帳號，金鑰只留在這台裝置上。"
          }
        }
      }
    },
