    "Your API keys never leave this device, and every call's cost is visible in real time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح API لا تغادر هذا الجهاز، وتكلفة كل استدعاء ظاهرة لحظيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine API-Keys verlassen dieses Gerät nie – und die Kosten jedes Aufrufs siehst du in Echtzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API keys never leave this device, and every call's cost is visible in real time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves de API nunca salen de este dispositivo y ves el coste de cada llamada en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clés API ne quittent jamais cet appareil, et le coût de chaque appel s'affiche en temps réel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी API keys इस डिवाइस से बाहर नहीं जातीं, और हर कॉल की लागत रीयल टाइम में दिखती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API Anda tidak pernah meninggalkan perangkat ini, dan biaya setiap panggilan terlihat secara real-time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーはこの端末から出ません。呼び出しごとのコストもリアルタイムで見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 이 기기를 벗어나지 않고, 호출마다 드는 비용은 실시간으로 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chaves de API nunca saem deste dispositivo, e o custo de cada chamada aparece em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи API не покидают это устройство, а стоимость каждого запроса видна в реальном времени."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API key ของคุณไม่ออกจากเครื่องนี้ และเห็นค่าใช้จ่ายของทุกครั้งที่เรียกใช้แบบเรียลไทม์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarlarınız bu cihazdan çıkmaz; her çağrının maliyetini anlık görürsünüz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API của bạn không bao giờ rời khỏi thiết bị này, và chi phí mỗi lượt gọi hiện ngay theo thời gian thực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 只存在你的设备里；每一次调用花了多少，实时看得见"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 只存在你的裝置裡；每一次呼叫花了多少，即時看得見"
          }
        }
      }
    },
