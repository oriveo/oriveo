    "By continuing, you agree to our [Terms of Service](oriveo://terms) and [Privacy Policy](oriveo://privacy).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمتابعة، فإنك توافق على [شروط الخدمة](oriveo://terms) و[سياسة الخصوصية](oriveo://privacy)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Fortfahren stimmst du unseren [Nutzungsbedingungen](oriveo://terms) und der [Datenschutzrichtlinie](oriveo://privacy) zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree to our [Terms of Service](oriveo://terms) and [Privacy Policy](oriveo://privacy)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los [Términos de servicio](oriveo://terms) y la [Política de privacidad](oriveo://privacy)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les [Conditions d'utilisation](oriveo://terms) et la [Politique de confidentialité](oriveo://privacy)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने पर आप [सेवा की शर्तें](oriveo://terms) और [गोपनीयता नीति](oriveo://privacy) से सहमत होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan melanjutkan, Anda menyetujui [Ketentuan Layanan](oriveo://terms) dan [Kebijakan Privasi](oriveo://privacy)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、[利用規約](oriveo://terms)と[プライバシーポリシー](oriveo://privacy)に同意したものとみなされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 [서비스 약관](oriveo://terms) 및 [개인정보 처리방침](oriveo://privacy)에 동의하게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, você concorda com os [Termos de Serviço](oriveo://terms) e a [Política de privacidade](oriveo://privacy)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы соглашаетесь с [Условия использования](oriveo://terms) и [политика конфиденциальности](oriveo://privacy)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อดำเนินการต่อ ถือว่าคุณยอมรับ[ข้อกำหนดในการให้บริการ](oriveo://terms)และ[นโยบายความเป็นส่วนตัว](oriveo://privacy)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam ederek [Hizmet Şartları](oriveo://terms) ve [Gizlilik Politikası](oriveo://privacy) belgelerini kabul edersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tiếp tục, bạn đồng ý với [Điều khoản dịch vụ](oriveo://terms) và [Chính sách bảo mật](oriveo://privacy)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即代表同意 [服务条款](oriveo://terms) 与 [隐私政策](oriveo://privacy)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即代表同意 [服務條款](oriveo://terms) 與 [隱私權政策](oriveo://privacy)"
          }
        }
      }
    },
