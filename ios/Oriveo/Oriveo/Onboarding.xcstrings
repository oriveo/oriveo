    "15 official providers and custom LLMs, in one conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏15 مزوّدًا رسميًا ونماذج لغوية مخصّصة، في محادثة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "15 offizielle Anbieter und benutzerdefinierte LLMs – in einem Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 official providers and custom LLMs, in one conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "15 proveedores oficiales y LLM personalizados, en una sola conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 fournisseurs officiels et LLM personnalisés, dans une seule conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "15 आधिकारिक प्रोवाइडर और कस्टम LLM, एक ही बातचीत में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "15 penyedia resmi dan LLM kustom dalam satu percakapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 の公式プロバイダーとカスタム LLM を、ひとつの会話に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15개 공식 제공사와 맞춤형 LLM을 하나의 대화에서."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "15 provedores oficiais e LLMs personalizados, em uma só conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "15 официальных провайдеров и пользовательские LLM — в одном диалоге."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการทางการ 15 ราย และ LLM แบบกำหนดเอง ในบทสนทนาเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 resmi sağlayıcı ve özel LLM, tek bir sohbette."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "15 nhà cung cấp chính thức và LLM tùy chỉnh trong cùng một cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 家官方供应商与自定义 LLM，装进同一场对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 家官方供應商與自訂 LLM，裝進同一場對話"
          }
        }
      }
    },
