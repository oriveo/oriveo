    "GPT, Claude, Gemini, DeepSeek — switch in a tap, without losing the thread.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏GPT وClaude وGemini وDeepSeek — بدّل بلمسة واحدة دون فقدان سياق المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek – mit einem Tipp wechseln, ohne den Faden zu verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — switch in a tap, without losing the thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek: cambia con un toque sin perder el hilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek : changez d'un geste sans perdre le fil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — एक टैप में बदलें, बातचीत टूटे बिना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — ganti dengan sekali ketuk tanpa kehilangan alur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT、Claude、Gemini、DeepSeek——ワンタップで切り替えても、会話は途切れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — 한 번의 탭으로 바꿔도 대화는 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — troque com um toque sem perder o fio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — переключайтесь одним касанием, не теряя нить разговора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — สลับได้ในแตะเดียว โดยบทสนทนาไม่ขาดตอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — tek dokunuşla geçin, sohbetin akışı bozulmasın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT, Claude, Gemini, DeepSeek — đổi chỉ với một chạm mà không đứt mạch trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT、Claude、Gemini、DeepSeek……一次轻点即可切换，对话不断线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT、Claude、Gemini、DeepSeek……一次輕點即可切換，對話不斷線"
          }
        }
      }
    },
