        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовые модели реального времени не поддерживают размышление."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลเสียงเรียลไทม์ไม่รองรับการคิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı ses modelleri düşünmeyi desteklemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình giọng nói thời gian thực không hỗ trợ suy nghĩ."
          }
