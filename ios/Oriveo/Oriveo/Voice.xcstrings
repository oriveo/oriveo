    "This realtime call reached its length limit. Tap to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلغت هذه المكالمة الفورية أقصى مدة لها. اضغط للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Echtzeitgespräch hat die maximale Länge erreicht. Tippe, um weiterzumachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This realtime call reached its length limit. Tap to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta llamada en tiempo real llegó a su duración máxima. Toca para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel en temps réel a atteint sa durée maximale. Touchez pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह रियलटाइम कॉल अपनी समय-सीमा तक पहुँच गई है। जारी रखने के लिए टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan real-time ini sudah mencapai batas durasi. Ketuk untuk melanjutkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム通話の時間が上限に達しました。タップで続けられます。"
