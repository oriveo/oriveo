        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 실시간 통화가 최대 시간에 도달했습니다. 탭하여 계속하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
