    "The %1$@ key is invalid or doesn't have realtime voice access." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API الخاص بـ %1$@ غير صالح أو لا يملك صلاحية الصوت الفوري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Key für %1$@ ist ungültig oder hat keinen Zugriff auf Echtzeit-Audio."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %1$@ key is invalid or doesn't have realtime voice access."
          }
        },
        "es" : {
          "stringUnit" : {
