    "I didn’t catch that. Could you say it again?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمعك جيدًا. هل يمكن الإعادة مرة أخرى؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das habe ich nicht verstanden. Sag es bitte noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I didn’t catch that. Could you say it again?"
          }
        },
