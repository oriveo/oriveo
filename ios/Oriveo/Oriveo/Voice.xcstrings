    "The recognition language is %1$@. If you spoke another language, change it and try again. Your recording is saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغة التعرّف الحالية هي %1$@. إذا كان الكلام بلغة أخرى، فيمكن تغيير اللغة وإعادة المحاولة. التسجيل محفوظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkennungssprache ist %1$@. Wenn du eine andere Sprache gesprochen hast, ändere sie und versuch es noch einmal. Die Aufnahme ist gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recognition language is %1$@. If you spoke another language, change it and try again. Your recording is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de reconocimiento es %1$@. Si hablaste en otro idioma, cámbialo y vuelve a intentarlo. La grabación está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue de reconnaissance actuelle : %1$@. Si vous avez parlé une autre langue, changez-la et réessayez. L’enregistrement est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहचान की भाषा अभी %1$@ है। अगर आपने कोई दूसरी भाषा बोली थी, तो उसे बदलकर फिर से कोशिश करें। रिकॉर्डिंग सेव है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa pengenalan saat ini %1$@. Jika berbicara dalam bahasa lain, ganti lalu coba lagi. Rekaman sudah disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認識する言語は「%1$@」です。別の言語で話した場合は、変更してもう一度お試しください。録音は保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 인식 언어는 ‘%1$@’입니다. 다른 언어로 말씀하셨다면 언어를 바꿔 다시 시도해 주세요. 녹음은 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma de reconhecimento é %1$@. Se você falou em outro idioma, troque e tente de novo. A gravação foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык распознавания: %1$@. Если вы говорили на другом языке, смените его и попробуйте ещё раз. Запись сохранена."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาษาที่ใช้รู้จำตอนนี้คือ %1$@ ถ้าพูดภาษาอื่น ให้เปลี่ยนแล้วลองใหม่ บันทึกเสียงไว้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanıma dili şu anda %1$@. Başka bir dilde konuştuysanız dili değiştirip tekrar deneyin. Kayıt saklandı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngôn ngữ nhận dạng hiện là %1$@. Nếu bạn nói ngôn ngữ khác, hãy đổi rồi thử lại. Bản ghi âm đã được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前识别语言是「%1$@」。说的是别的语言就换一下再试。录音已保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的辨識語言是「%1$@」。如果說的是其他語言，請換一下再試。錄音已儲存。"
          }
        }
      }
    },
    "The selected dictation engine is unavailable. Using system dictation." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرك الإملاء المحدد غير متاح. يُستخدم إملاء النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählte Diktier-Engine ist nicht verfügbar. Es wird die Diktierfunktion des Systems verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected dictation engine is unavailable. Using system dictation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor de dictado elegido no está disponible. Se usa el dictado del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur de dictée choisi est indisponible. La dictée du système est utilisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलकर लिखने के लिए चुना गया इंजन उपलब्ध नहीं है, इसलिए सिस्टम का इंजन इस्तेमाल हो रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesin dikte yang dipilih tidak tersedia. Menggunakan dikte sistem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した音声入力エンジンを使えないため、システムの音声入力に切り替えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 받아쓰기 엔진을 사용할 수 없어 시스템 받아쓰기로 전환했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mecanismo de ditado escolhido está indisponível. Usando o ditado do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный движок диктовки недоступен. Используется системная диктовка."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เครื่องมือพิมพ์ด้วยเสียงที่เลือกไม่ได้ จึงเปลี่ยนไปใช้ของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen dikte motoru kullanılamıyor. Sistem diktesi kullanılıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không dùng được công cụ đọc chính tả đã chọn. Đang dùng đọc chính tả của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
