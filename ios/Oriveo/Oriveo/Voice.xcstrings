    "Hi, this is how I'll sound when I read your replies." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا، هكذا سيبدو صوتي عندما أقرأ لك الردود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo, so klinge ich, wenn ich dir Antworten vorlese."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, this is how I'll sound when I read your replies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, así sonaré cuando te lea las respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour, voici la voix avec laquelle je vous lirai mes réponses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते, जवाब पढ़कर सुनाते समय मेरी आवाज़ ऐसी होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo, beginilah suara saya saat membacakan balasan untuk Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは。返信を読み上げるときは、この声でお届けします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, 답변을 읽어 드릴 때 이런 목소리로 들려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, é assim que vou soar quando ler as respostas para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте! Вот так я буду звучать, читая вам ответы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวัสดี นี่คือเสียงที่ฉันจะใช้อ่านคำตอบให้คุณฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba, yanıtları size okurken sesim böyle olacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xin chào, đây là giọng mình sẽ dùng khi đọc câu trả lời cho bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
