    "For a more natural voice, download an Enhanced or Premium voice in Settings > Accessibility > Spoken Content > Voices." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للحصول على صوت أكثر طبيعية، نزّل صوتًا محسّنًا أو مميزًا من الإعدادات > تسهيلات الاستخدام > المحتوى المنطوق > الأصوات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine natürlichere Stimme lade unter Einstellungen > Bedienungshilfen > Gesprochene Inhalte > Stimmen eine erweiterte oder Premium-Stimme herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a more natural voice, download an Enhanced or Premium voice in Settings > Accessibility > Spoken Content > Voices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una voz más natural, descarga una voz mejorada o premium en Ajustes > Accesibilidad > Contenido leído > Voces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une voix plus naturelle, téléchargez une voix améliorée ou premium dans Réglages > Accessibilité > Contenu énoncé > Voix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा स्वाभाविक आवाज़ के लिए सेटिंग्स > ऐक्सेसिबिलिटी > स्पोकन कॉन्टेंट > आवाज़ें में जाकर Enhanced या Premium आवाज़ डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
