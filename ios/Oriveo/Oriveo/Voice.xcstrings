          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model suara real-time tidak mendukung mode berpikir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム音声モデルは思考に対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 음성 모델은 사고 기능을 지원하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
