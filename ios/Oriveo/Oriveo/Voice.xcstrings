    "%1$@ quota is used up, or there were too many requests." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفدت حصة %1$@، أو أُرسلت طلبات كثيرة جدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kontingent bei %1$@ ist aufgebraucht, oder es gab zu viele Anfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quota is used up, or there were too many requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó la cuota de %1$@ o hubo demasiadas solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le quota %1$@ est épuisé, ou il y a eu trop de requêtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का कोटा खत्म हो गया है या बहुत ज़्यादा अनुरोध भेजे गए हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuota %1$@ sudah habis, atau terlalu banyak permintaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の利用枠を使い切ったか、リクエストが多すぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 사용 한도를 모두 썼거나 요청이 너무 많습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cota de %1$@ acabou ou houve solicitações demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимит %1$@ исчерпан, или запросов было слишком много."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โควตา %1$@ หมดแล้ว หรือมีคำขอมากเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kotası doldu ya da çok fazla istek gönderildi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã hết hạn mức %1$@ hoặc có quá nhiều yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 额度已用完，或请求过于频繁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 額度已用完，或請求太頻繁"
          }
        }
