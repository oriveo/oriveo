    "%@ is unavailable right now. Switched to the system voice." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ غير متاح حاليًا. تم التبديل إلى صوت النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade nicht verfügbar. Zur Systemstimme gewechselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unavailable right now. Switched to the system voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible ahora. Se cambió a la voz del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas disponible pour le moment. Passage à la voix du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अभी उपलब्ध नहीं है। सिस्टम की आवाज़ पर स्विच कर दिया गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sedang tidak tersedia. Beralih ke suara sistem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は現在利用できません。システムの声に切り替えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 %@을(를) 사용할 수 없어 시스템 음성으로 바꿨습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está disponível agora. Mudamos para a voz do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сейчас недоступен. Включён системный голос."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ใช้ %@ ไม่ได้ เปลี่ยนไปใช้เสียงของระบบแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ şu anda kullanılamıyor. Sistem sesine geçildi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hiện không dùng được. Đã chuyển sang giọng hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时用不了，已改用系统音色"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暫時無法使用，已改用系統音色"
          }
        }
      }
    },
