    "%@ is unavailable right now. Switched to the system voice." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ غير متاح حاليًا. تم التبديل إلى صوت النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gerade nicht verfügbar. Zur Systemstimme gewechselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unavailable right now. Switched to the system voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible ahora. Se cambió a la voz del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas disponible pour le moment. Passage à la voix du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अभी उपलब्ध नहीं है। सिस्टम की आवाज़ पर स्विच कर दिया गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sedang tidak tersedia. Beralih ke suara sistem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は現在利用できません。システムの声に切り替えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 %@을(를) 사용할 수 없어 시스템 음성으로 바꿨습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está disponível agora. Mudamos para a voz do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сейчас недоступен. Включён системный голос."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ใช้ %@ ไม่ได้ เปลี่ยนไปใช้เสียงของระบบแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ şu anda kullanılamıyor. Sistem sesine geçildi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hiện không dùng được. Đã chuyển sang giọng hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时用不了，已改用系统音色"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暫時無法使用，已改用系統音色"
          }
        }
      }
    },
    "A realtime model hears you and answers directly, so replies come faster, but this chat's model isn't used." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمع إليك النموذج الفوري ويرد مباشرة، فتصل الردود أسرع، لكن لا يُستخدم نموذج هذه المحادثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Echtzeitmodell hört dir zu und antwortet direkt. Antworten kommen so schneller, aber das Modell dieses Chats wird nicht verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A realtime model hears you and answers directly, so replies come faster, but this chat's model isn't used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modelo en tiempo real te escucha y responde directamente, así que las respuestas llegan antes, pero no se usa el modelo de este chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle en temps réel vous écoute et répond directement : les réponses arrivent plus vite, mais le modèle de cette conversation n’est pas utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रियलटाइम मॉडल आपकी बात सुनकर सीधे जवाब देता है, इसलिए जवाब जल्दी आते हैं, लेकिन इस चैट का मॉडल इस्तेमाल नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model real-time mendengarkan Anda dan langsung menjawab, jadi balasan datang lebih cepat, tetapi model percakapan ini tidak dipakai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムモデルは声を聞いて直接答えるため返答が速くなりますが、この会話のモデルは使われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 모델이 직접 듣고 답하므로 답변이 더 빠르지만, 이 대화의 모델은 사용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um modelo em tempo real ouve você e responde direto, então as respostas chegam mais rápido, mas o modelo desta conversa não é usado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель реального времени слышит вас и отвечает сама, поэтому ответы приходят быстрее, но модель этого чата не используется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลเรียลไทม์จะฟังคุณและตอบโดยตรง จึงตอบได้เร็วขึ้น แต่จะไม่ใช้โมเดลของแชทนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek zamanlı model sizi dinler ve doğrudan yanıt verir; yanıtlar daha hızlı gelir ama bu sohbetin modeli kullanılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình thời gian thực nghe bạn và trả lời trực tiếp nên phản hồi nhanh hơn, nhưng sẽ không dùng mô hình của cuộc trò chuyện này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时模型直接听你说话并回答，回复更快，但不会用这个对话的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時模型直接聽你說話並回答，回覆更快，但不會用這個對話的模型。"
          }
        }
      }
    },
