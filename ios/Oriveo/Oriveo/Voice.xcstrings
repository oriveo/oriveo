    "Download the %1$@ speech pack for faster recognition that also works offline." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنزيل حزمة التعرّف للغة %1$@ يجعل التعرّف أسرع ويتيحه دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade das Sprachpaket für %1$@ herunter – dann geht die Erkennung schneller und auch offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download the %1$@ speech pack for faster recognition that also works offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el paquete de voz de %1$@ para un reconocimiento más rápido que también funciona sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez le pack vocal %1$@ pour une reconnaissance plus rapide, même hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का स्पीच पैक डाउनलोड करें, ताकि पहचान तेज़ हो और ऑफ़लाइन भी काम करे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduh paket bahasa %1$@ agar pengenalan lebih cepat dan bisa offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の音声認識パックをダウンロードすると、認識が速くなり、オフラインでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 음성 인식 팩을 다운로드하면 인식이 더 빨라지고 오프라인에서도 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe o pacote de voz de %1$@ para um reconhecimento mais rápido, que funciona até sem internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачайте языковой пакет «%1$@»: распознавание станет быстрее и будет работать без интернета."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลดแพ็กภาษา %1$@ เพื่อให้รู้จำได้เร็วขึ้นและใช้แบบออฟไลน์ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha hızlı ve çevrimdışı da çalışan tanıma için %1$@ konuşma paketini indirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải gói nhận dạng %1$@ để nhận dạng nhanh hơn và dùng được khi ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载「%1$@」识别包后，识别更快，也能离线用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載「%1$@」辨識套件後，辨識更快，也能離線使用。"
          }
        }
      }
    },
    "Downloading the %1$@ speech pack. Until it finishes, recognition uses the internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تنزيل حزمة التعرّف للغة %1$@. حتى يكتمل التنزيل، يتم التعرّف عبر الإنترنت."
