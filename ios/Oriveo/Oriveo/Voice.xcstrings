    "Didn’t catch that — say it again" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمعك جيدًا، يُرجى الإعادة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verstanden – sag es noch mal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didn’t catch that — say it again"
          }
        },
        "es" : {
