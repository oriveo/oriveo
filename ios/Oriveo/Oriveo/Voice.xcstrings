    },
    "Add an official API key from a provider with realtime voice to use it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مفتاح API رسميًا من مزوّد يدعم الصوت الفوري لتستخدمه هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den offiziellen API-Key eines Anbieters mit Echtzeit-Audio hinzu, um hier ein Modell auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an official API key from a provider with realtime voice to use it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la clave de API oficial de un proveedor con voz en tiempo real para usarla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez la clé API officielle d’un fournisseur proposant la voix en temps réel pour l’utiliser ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ इस्तेमाल करने के लिए रियलटाइम वॉइस वाले प्रोवाइडर की आधिकारिक API key जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan API key resmi dari penyedia yang mendukung suara real-time agar bisa dipilih di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム音声に対応したプロバイダーの公式APIキーを追加すると、ここで選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 음성을 지원하는 제공업체의 공식 API 키를 추가하면 여기서 고를 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a chave de API oficial de um provedor com voz em tempo real para usar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте официальный API-ключ провайдера с голосом в реальном времени, чтобы выбрать модель здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่ม API key ทางการของผู้ให้บริการที่รองรับเสียงเรียลไทม์ เพื่อเลือกใช้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada kullanmak için gerçek zamanlı ses sunan bir sağlayıcının resmi API anahtarını ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm API key chính thức của nhà cung cấp hỗ trợ giọng nói thời gian thực để dùng tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加支持实时语音的供应商官方 API Key 后，就能在这里选用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增支援即時語音的供應商官方 API 金鑰後，就能在這裡選用。"
          }
        }
      }
    },
