    "You can switch to the dictation engine of a provider you’ve connected. Your recording is saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن التبديل إلى محرك إملاء من مزوّد متصل. التسجيل محفوظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst zur Diktier-Engine eines verbundenen Anbieters wechseln. Die Aufnahme ist gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can switch to the dictation engine of a provider you’ve connected. Your recording is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar al motor de dictado de un proveedor que hayas conectado. La grabación está guardada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez passer au moteur de dictée d’un fournisseur que vous avez connecté. L’enregistrement est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जोड़े गए किसी प्रोवाइडर का बोलकर लिखने वाला इंजन चुन सकते हैं। रिकॉर्डिंग सेव है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa beralih ke mesin dikte dari penyedia yang sudah terhubung. Rekaman sudah disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済みのプロバイダーの音声入力エンジンに切り替えられます。録音は保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결한 제공업체의 받아쓰기 엔진으로 바꿀 수 있습니다. 녹음은 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode trocar para o mecanismo de ditado de um provedor que você conectou. A gravação foi salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно переключиться на движок диктовки подключённого провайдера. Запись сохранена."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนไปใช้เครื่องมือพิมพ์ด้วยเสียงของผู้ให้บริการที่เชื่อมต่อไว้ได้ บันทึกเสียงไว้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağladığınız bir sağlayıcının dikte motoruna geçebilirsiniz. Kayıt saklandı."
