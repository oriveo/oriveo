{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "manual",
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقاط صور لإرفاقها برسائل المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos aufnehmen, um sie an deine Chatnachrichten anzuhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos to attach to your chat messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar fotos para adjuntarlas a tus mensajes de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre des photos pour les joindre à vos messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने चैट संदेशों में जोड़ने के लिए फ़ोटो लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto untuk dilampirkan ke pesan obrolan Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのメッセージに添付する写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 메시지에 첨부할 사진을 촬영합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar fotos para anexar às suas mensagens de conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съёмка фотографий для вложения в сообщения чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพเพื่อแนบไปกับข้อความแชทของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet mesajlarınıza eklemek için fotoğraf çekin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh để đính kèm vào tin nhắn trò chuyện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照并附加到聊天消息中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照並附加到聊天訊息中。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال مباشرة بخدمات الذكاء الاصطناعي على شبكتك المحلية أو شبكة VPN الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt mit KI-Diensten in deinem lokalen Netzwerk oder privaten VPN verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect directly to AI services on your local network or private VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarse directamente a servicios de IA en tu red local o VPN privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter directement aux services d’IA de votre réseau local ou VPN privé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लोकल नेटवर्क या निजी VPN पर AI सेवाओं से सीधे कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung langsung ke layanan AI di jaringan lokal atau VPN pribadi Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークまたはプライベートVPN上のAIサービスに直接接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 또는 비공개 VPN의 AI 서비스에 직접 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar diretamente a serviços de IA na sua rede local ou VPN privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямое подключение к сервисам ИИ в локальной сети или частной VPN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อโดยตรงกับบริการ AI บนเครือข่ายภายในหรือ VPN ส่วนตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ağınızdaki veya özel VPN’inizdeki yapay zeka hizmetlerine doğrudan bağlanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối trực tiếp với các dịch vụ AI trên mạng cục bộ hoặc VPN riêng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接连接局域网或专用 VPN 中的 AI 服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線區域網路或私人 VPN 中的 AI 服務。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ الصور المُولَّدة بالذكاء الاصطناعي في مكتبة الصور"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-generierte Bilder in deiner Fotobibliothek speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save AI-generated images to your photo library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar imágenes generadas por IA en tu biblioteca de fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les images générées par IA dans votre photothèque"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI से बनी इमेज को अपनी फ़ोटो लाइब्रेरी में सेव करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan gambar hasil AI ke pustaka foto Anda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI が生成した画像を写真ライブラリに保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 생성한 이미지를 사진 라이브러리에 저장합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar imagens geradas por IA na sua biblioteca de fotos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение созданных ИИ изображений в медиатеку"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกภาพที่ AI สร้างขึ้นไปยังคลังภาพของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ ile oluşturulan görüntüleri fotoğraf kitaplığınıza kaydedin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh do AI tạo vào thư viện ảnh của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 AI 生成的图片保存到照片图库"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 AI 產生的圖片儲存到照片圖庫"
          }
        }
      }
    },
    "Oriveo Backup": {
      "comment": "Exported backup document type name",
      "extractionState": "manual",
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo Backup"
          }
        }
      }
    }
  },
  "version": "1.0"
}
