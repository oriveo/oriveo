    "This backup contains encrypted API keys. Enter the password to restore them, or skip to import without keys.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي هذه النسخة الاحتياطية على مفاتيح API مشفرة. أدخل كلمة المرور لاستعادتها، أو قم بالتخطي للاستيراد بدون مفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup enthält verschlüsselte API-Schlüssel. Geben Sie das Passwort ein, um sie wiederherzustellen, oder fahren Sie mit dem Importieren ohne Schlüssel fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad contiene claves API cifradas. Ingrese la contraseña para restaurarlos u omita para importar sin claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde contient des clés API cryptées. Entrez le mot de passe pour les restaurer ou passez à l'importation sans clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बैकअप में एन्क्रिप्टेड API शामिल है। उन्हें पुनर्स्थापित करने के लिए पासवर्ड दर्ज करें, या बिना कुंजियों के आयात करना छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini berisi API terenkripsi. Masukkan kata sandi untuk memulihkannya, atau lewati untuk mengimpor tanpa kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップには暗号化された API キーが含まれています。パスワードを入力して復元するか、キーなしでインポートをスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업에는 암호화된 API 키가 포함되어 있습니다. 복원하려면 비밀번호를 입력하거나 키 없이 가져오기로 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup contém chaves de API criptografadas. Digite a senha para restaurá-los ou pule para importar sem chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия содержит зашифрованный API. Введите пароль, чтобы восстановить их, или пропустите импорт без ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองนี้มี API ที่เข้ารหัส ป้อนรหัสผ่านเพื่อกู้คืน หรือข้ามเพื่อนำเข้าโดยไม่ต้องใช้คีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedekleme şifrelenmiş API içeriyor. Bunları geri yüklemek için şifreyi girin veya anahtarsız içe aktarma işlemini atlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này chứa API được mã hóa. Nhập mật khẩu để khôi phục chúng hoặc bỏ qua để nhập không cần khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份包含加密的 API 密钥。输入密码可恢复密钥，或跳过以不含密钥的方式导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
