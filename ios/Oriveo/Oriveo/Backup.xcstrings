    "API keys will be encrypted with this password. Keep it safe — you'll need it to restore keys.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تشفير مفاتيح API بكلمة المرور هذه. احتفظ بها آمنة — ستحتاج إليها لاستعادة المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden mit diesem Passwort verschlüsselt. Bewahren Sie es sicher auf – Sie benötigen es zum Wiederherstellen von Schlüsseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API se cifrarán con esta contraseña. Mantenlo seguro: lo necesitarás para restaurar las claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API seront chiffrées avec ce mot de passe. Gardez-le en sécurité : vous en aurez besoin pour restaurer les clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API को इस पासवर्ड से एन्क्रिप्ट किया जाएगा। इसे सुरक्षित रखें - कुंजियाँ पुनर्स्थापित करने के लिए आपको इसकी आवश्यकता होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "API akan dienkripsi dengan kata sandi ini. Simpan dengan aman — Anda memerlukannya untuk memulihkan kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーはこのパスワードで暗号化されます。キーを復元するために必要になりますので、安全に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 이 비밀번호로 암호화됩니다. 안전하게 보관하세요. 키를 복원하려면 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de API serão criptografadas com esta senha. Mantenha-o seguro – você precisará dele para restaurar as chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API будет зашифрован этим паролем. Сохраните его — он понадобится вам для восстановления ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API จะถูกเข้ารหัสด้วยรหัสผ่านนี้ เก็บไว้อย่างปลอดภัย คุณจะต้องใช้มันเพื่อกู้คืนกุญแจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API bu şifre ile şifrelenecektir. Onu güvende tutun; anahtarları geri yüklemek için ona ihtiyacınız olacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API sẽ được mã hóa bằng mật khẩu này. Giữ nó an toàn — bạn sẽ cần nó để khôi phục chìa khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥将使用此密码加密。请妥善保管——恢复密钥时需要此密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰將使用此密碼進行加密。確保其安全 - 您將需要它來恢復金鑰。"
          }
        }
      }
    },
