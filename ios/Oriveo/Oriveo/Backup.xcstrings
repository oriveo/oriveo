    "The backup file is corrupted or in an unsupported format.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف النسخة الاحتياطية تالف أو بتنسيق غير مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
