    "Knowledge base files need to be re-uploaded before they can be used again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب إعادة رفع ملفات قاعدة المعرفة قبل استخدامها مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowledge-Base-Dateien müssen neu hochgeladen werden, bevor sie wieder verwendet werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de la base de conocimientos deben volver a subirse antes de poder usarse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de la base de connaissances doivent être re-téléchargés avant de pouvoir être utilisés à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉलेज बेस फ़ाइलें फिर से उपयोग करने से पहले पुनः अपलोड करनी होंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
