    },
    "This will clear all local data and replace it with the backup contents. A temporary backup will be created automatically.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى مسح جميع البيانات المحلية واستبدالها بمحتويات النسخة الاحتياطية. سيتم إنشاء نسخة احتياطية مؤقتة تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle lokalen Daten gelöscht und durch die Sicherungsinhalte ersetzt. Es wird automatisch ein temporäres Backup erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará todos los datos locales y los reemplazará con el contenido de la copia de seguridad. Se creará una copia de seguridad temporal automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera toutes les données locales et les remplacera par le contenu de la sauvegarde. Une sauvegarde temporaire sera créée automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सभी स्थानीय डेटा को साफ़ कर देगा और इसे बैकअप सामग्री से बदल देगा। एक अस्थायी बैकअप स्वचालित रूप से बनाया जाएगा."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus semua data lokal dan menggantinya dengan konten cadangan. Cadangan sementara akan dibuat secara otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのローカル データが消去され、バックアップの内容に置き換えられます。一時バックアップが自動的に作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 모든 로컬 데이터가 지워지고 백업 내용으로 대체됩니다. 임시 백업이 자동으로 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso limpará todos os dados locais e os substituirá pelo conteúdo do backup. Um backup temporário será criado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очистит все локальные данные и заменит их содержимым резервной копии. Временная резервная копия будет создана автоматически."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะล้างข้อมูลในเครื่องทั้งหมดและแทนที่ด้วยเนื้อหาสำรอง การสำรองข้อมูลชั่วคราวจะถูกสร้างขึ้นโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tüm yerel verileri temizleyecek ve bunları yedek içeriklerle değiştirecektir. Otomatik olarak geçici bir yedekleme oluşturulacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa tất cả dữ liệu cục bộ và thay thế bằng nội dung sao lưu. Một bản sao lưu tạm thời sẽ được tạo tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清空所有本地数据并用备份内容替换。系统会自动创建临时备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將清除所有本機資料並將其替換為備份內容。將自動建立臨時備份。"
          }
        }
      }
    },
