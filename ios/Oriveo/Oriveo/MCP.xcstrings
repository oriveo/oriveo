    "The sign-in page was closed, or the service didn't approve the request. Nothing has changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُغلقت صفحة تسجيل الدخول، أو لم توافق الخدمة على الطلب. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldeseite wurde geschlossen oder der Dienst hat die Anfrage nicht freigegeben. Es wurde nichts geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in page was closed, or the service didn't approve the request. Nothing has changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró la página de inicio de sesión o el servicio no aprobó la solicitud. No cambió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page d’identification a été fermée, ou le service n’a pas approuvé la demande. Rien n’a été modifié."
