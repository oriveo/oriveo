    "MCP servers turn services like Linear and Notion, or tools you host yourself, into things the model can do in a chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوادم MCP تجعل خدمات مثل Linear و Notion، أو أدوات تستضيفها بنفسك، أعمالًا يستطيع النموذج تنفيذها داخل المحادثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit MCP-Servern kann das Modell im Chat Dienste wie Linear und Notion oder Tools nutzen, die du selbst betreibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP servers turn services like Linear and Notion, or tools you host yourself, into things the model can do in a chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores MCP convierten servicios como Linear y Notion, o herramientas que alojes tú, en cosas que el modelo puede hacer dentro de un chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec les serveurs MCP, des services comme Linear et Notion, ou des outils que vous hébergez vous-même, deviennent des actions que le modèle peut accomplir dans une conversation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP सर्वर की मदद से Linear और Notion जैसी सेवाएँ, या आपके अपने होस्ट किए टूल, ऐसे काम बन जाते हैं जिन्हें मॉडल चैट में कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server MCP membuat layanan seperti Linear dan Notion, atau alat yang Anda kelola sendiri, bisa dipakai model langsung di dalam chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP サーバーを接続すると、Linear や Notion などのサービスや自分で用意したツールを、モデルがチャットの中で使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서버를 연결하면 Linear, Notion 같은 서비스나 직접 운영하는 도구를 모델이 대화 중에 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores MCP transformam serviços como Linear e Notion, ou ferramentas que você mesmo hospeda, em ações que o modelo pode executar em um chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С MCP-серверами модель может прямо в чате работать с такими сервисами, как Linear и Notion, или с инструментами, которые вы развернули сами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซิร์ฟเวอร์ MCP ช่วยให้โมเดลใช้บริการอย่าง Linear และ Notion หรือเครื่องมือที่คุณโฮสต์เอง ได้จากในแชท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP sunucuları; Linear ve Notion gibi hizmetleri veya kendi barındırdığınız araçları, modelin sohbet içinde yapabildiği işlere dönüştürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ MCP biến các dịch vụ như Linear, Notion hay công cụ do bạn tự vận hành thành những việc mô hình có thể làm ngay trong cuộc trò chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 服务器把 Linear、Notion 这类服务，或者你自己搭建的工具，变成模型可以在聊天里调用的能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 伺服器把 Linear、Notion 這類服務，或是你自己架設的工具，變成模型在對話裡可以使用的能力。"
          }
        }
      }
    },
    "More than %1$d tools are on. Only the first %2$d will be sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الأدوات المفعّلة يتجاوز %1$d. لن يُرسل سوى أول %2$d منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind mehr als %1$d Tools aktiv. Gesendet werden nur die ersten %2$d."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than %1$d tools are on. Only the first %2$d will be sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
