    "Check that this device can reach it right now, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكّد من قدرة هذا الجهاز على الوصول إليه الآن ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob dieses Gerät den Server gerade erreichen kann, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that this device can reach it right now, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que este dispositivo pueda acceder a él ahora mismo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que cet appareil peut y accéder en ce moment, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि यह डिवाइस अभी उस तक पहुँच सकता है, फिर दोबारा कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan perangkat ini bisa menjangkaunya sekarang, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから今アクセスできるか確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 이 기기에서 접속할 수 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja se este dispositivo consegue acessá-lo agora e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что сервер сейчас доступен с этого устройства, и попробуйте ещё раз."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบว่าอุปกรณ์นี้เข้าถึงเซิร์ฟเวอร์ได้ในตอนนี้ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazın şu anda sunucuya erişebildiğinden emin olup yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chắc chắn rằng thiết bị này hiện truy cập được máy chủ rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认这台设备现在能访问它，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認這台裝置現在能連到它，然後再試一次。"
          }
        }
      }
    },
    "Check the address, and whether this device can reach it right now. Servers on a home or office network usually can't be reached from elsewhere." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من العنوان ومن قدرة هذا الجهاز على الوصول إليه الآن. الخوادم الموجودة على شبكة المنزل أو العمل لا يمكن الوصول إليها من خارجها في الغالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Adresse und ob dieses Gerät den Server gerade erreichen kann. Server im Heim- oder Firmennetz sind von außerhalb meist nicht erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the address, and whether this device can reach it right now. Servers on a home or office network usually can't be reached from elsewhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la dirección y comprueba que este dispositivo pueda acceder a ella ahora mismo. Los servidores de una red doméstica o de oficina no suelen ser accesibles desde fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’adresse et assurez-vous que cet appareil peut y accéder en ce moment. Les serveurs d’un réseau domestique ou d’entreprise sont en général inaccessibles depuis l’extérieur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पता जाँचें और देखें कि यह डिवाइस अभी उस तक पहुँच सकता है या नहीं। घर या दफ़्तर के नेटवर्क पर चलने वाले सर्वर आम तौर पर बाहर से नहीं खुलते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa alamatnya, dan pastikan perangkat ini bisa menjangkaunya sekarang. Server di jaringan rumah atau kantor biasanya tidak bisa dijangkau dari luar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスが正しいか、このデバイスから今アクセスできるかを確認してください。自宅や社内ネットワークにあるサーバーは、通常そのネットワークの外からは接続できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소가 맞는지, 지금 이 기기에서 접속할 수 있는지 확인하세요. 집이나 회사 내부 네트워크에 있는 서버는 대개 그 네트워크 밖에서는 연결되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira o endereço e veja se este dispositivo consegue acessá-lo agora. Servidores em redes domésticas ou corporativas geralmente não podem ser acessados de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте адрес и убедитесь, что сервер сейчас доступен с этого устройства. Серверы в домашней или рабочей сети обычно недоступны извне."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบที่อยู่ และดูว่าอุปกรณ์นี้เข้าถึงเซิร์ฟเวอร์ได้ในตอนนี้หรือไม่ เซิร์ฟเวอร์ในเครือข่ายที่บ้านหรือที่ทำงานมักเข้าถึงจากภายนอกไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresi ve bu cihazın şu anda sunucuya erişip erişemediğini kontrol edin. Ev veya iş yeri ağındaki sunuculara genellikle dışarıdan ulaşılamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra địa chỉ và xem thiết bị này hiện có truy cập được máy chủ không. Máy chủ nằm trong mạng gia đình hoặc mạng công ty thường không truy cập được từ bên ngoài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查地址是否正确，以及这台设备现在能不能访问它。家里或公司内网的服务器，离开那个网络后通常连不上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查位址是否正確，以及這台裝置現在能不能連到它。家裡或公司內部網路的伺服器，離開那個網路後通常連不上。"
          }
        }
      }
    },
