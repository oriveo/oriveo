    "Results come from a third-party server. Only the first 2 KB is shown. Oriveo hasn't checked the content." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النتائج واردة من خادم تابع لجهة خارجية، ويُعرض منها أول 2 كيلوبايت فقط. لم يتحقق Oriveo من المحتوى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ergebnisse stammen von einem Server eines Drittanbieters. Angezeigt werden nur die ersten 2 KB. Oriveo hat den Inhalt nicht geprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Results come from a third-party server. Only the first 2 KB is shown. Oriveo hasn't checked the content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados vienen de un servidor de terceros. Solo se muestran los primeros 2 KB. Oriveo no ha revisado el contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats proviennent d’un serveur tiers. Seuls les 2 premiers Ko sont affichés. Oriveo n’a pas vérifié le contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नतीजे किसी तीसरे पक्ष के सर्वर से आए हैं। सिर्फ़ पहले 2 KB दिखाए गए हैं। Oriveo ने इस सामग्री की जाँच नहीं की है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil berasal dari server pihak ketiga. Hanya 2 KB pertama yang ditampilkan. Isinya belum diperiksa Oriveo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果は第三者のサーバーから返されたもので、先頭の 2 KB のみ表示しています。内容は Oriveo による確認を受けていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과는 제3자 서버에서 받은 것이며 앞부분 2KB만 표시됩니다. Oriveo가 내용을 검증하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados vêm de um servidor de terceiros. Só os primeiros 2 KB são exibidos. O Oriveo não verificou o conteúdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты получены от стороннего сервера. Показаны только первые 2 КБ. Oriveo не проверял содержимое."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผลลัพธ์มาจากเซิร์ฟเวอร์ของบุคคลที่สาม และแสดงเพียง 2 KB แรก Oriveo ไม่ได้ตรวจสอบเนื้อหานี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonuçlar üçüncü taraf bir sunucudan gelir. Yalnızca ilk 2 KB gösterilir. Oriveo içeriği denetlemedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả do máy chủ của bên thứ ba trả về. Chỉ hiển thị 2 KB đầu tiên. Oriveo chưa kiểm tra nội dung này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果由第三方服务器返回，只显示前 2 KB。内容未经 Oriveo 校验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果由第三方伺服器傳回，只顯示前 2 KB。內容未經 Oriveo 檢查。"
          }
        }
      }
    },
