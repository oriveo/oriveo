    "If the server asks you to sign in, its own sign-in page opens. Oriveo never sees your password." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا طلب الخادم تسجيل الدخول، تُفتح صفحة تسجيل الدخول الخاصة به. لا يطّلع Oriveo على كلمة مرورك أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlangt der Server eine Anmeldung, öffnet sich dessen eigene Anmeldeseite. Oriveo bekommt dein Passwort nie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the server asks you to sign in, its own sign-in page opens. Oriveo never sees your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el servidor te pide iniciar sesión, se abrirá su propia página de inicio de sesión. Oriveo nunca ve tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le serveur vous demande de vous identifier, sa propre page d’identification s’ouvre. Oriveo ne voit jamais votre mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर सर्वर साइन इन माँगे, तो उसका अपना साइन इन पेज खुलेगा। Oriveo को आपका पासवर्ड कभी नहीं दिखता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika server meminta Anda masuk, halaman masuk milik server itu akan terbuka. Oriveo tidak pernah melihat kata sandi Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがログインを求めた場合は、そのサービスのログインページが開きます。Oriveo にパスワードが渡ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 로그인을 요구하면 해당 서비스의 로그인 페이지가 열립니다. Oriveo는 비밀번호를 볼 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o servidor pedir login, a página de login dele é aberta. O Oriveo nunca vê a sua senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сервер попросит войти, откроется его собственная страница входа. Oriveo не видит ваш пароль."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเซิร์ฟเวอร์ขอให้ลงชื่อเข้าใช้ หน้าลงชื่อเข้าใช้ของเซิร์ฟเวอร์นั้นเองจะเปิดขึ้น Oriveo จะไม่เห็นรหัสผ่านของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu oturum açmanızı isterse kendi oturum açma sayfası açılır. Oriveo şifrenizi hiçbir zaman görmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu máy chủ yêu cầu đăng nhập, trang đăng nhập của chính máy chủ đó sẽ mở ra. Oriveo không bao giờ thấy mật khẩu của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器要求登录时，会打开它自己的登录页面。Oriveo 不会看到你的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器要求登入時，會開啟它自己的登入頁面。Oriveo 不會看到你的密碼。"
          }
        }
      }
    },
