    "For safety, changed tools aren't offered to the model until you confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرصًا على الأمان، لا تُعرض الأدوات التي تغيّرت على النموذج قبل تأكيدك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Sicherheit werden geänderte Tools dem Modell erst nach deiner Bestätigung wieder angeboten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For safety, changed tools aren't offered to the model until you confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por seguridad, las herramientas que cambiaron no se le ofrecen al modelo hasta que lo confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par sécurité, les outils modifiés ne sont pas proposés au modèle tant que vous ne les avez pas confirmés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षा के लिए, बदले हुए टूल आपकी पुष्टि से पहले मॉडल को नहीं दिए जाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi keamanan, alat yang berubah tidak ditawarkan ke model sampai Anda mengonfirmasinya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全のため、変更のあったツールは、確認が済むまでモデルに渡されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전을 위해 변경된 도구는 확인하기 전까지 모델에 제공되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por segurança, as ferramentas alteradas só são oferecidas ao modelo depois que você confirmar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ради безопасности изменившиеся инструменты не передаются модели, пока вы их не подтвердите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อความปลอดภัย เครื่องมือที่เปลี่ยนแปลงจะไม่ถูกเสนอให้โมเดลจนกว่าคุณจะยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenlik için, değişen araçlar siz onaylayana kadar modele sunulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để an toàn, những công cụ có thay đổi sẽ không được cung cấp cho mô hình cho đến khi bạn xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了安全，有变化的工具在你确认前不会提供给模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了安全，有變動的工具在你確認前不會提供給模型。"
          }
        }
      }
    },
