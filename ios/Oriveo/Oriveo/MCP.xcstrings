    "The address can't include a username or password. Use an access token instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يجوز أن يتضمن العنوان اسم مستخدم أو كلمة مرور. يُرجى حذفهما وتسجيل الدخول برمز وصول بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse darf weder Benutzernamen noch Passwort enthalten. Entferne beides und melde dich stattdessen mit einem Zugriffstoken an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address can't include a username or password. Use an access token instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección no puede incluir usuario ni contraseña. Quítalos e inicia sesión con un token de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse ne peut pas contenir de nom d’utilisateur ni de mot de passe. Retirez-les et identifiez-vous plutôt avec un jeton d’accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पते में यूज़रनेम या पासवर्ड नहीं हो सकता। इन्हें हटाएँ और ऐक्सेस टोकन से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat tidak boleh memuat nama pengguna atau kata sandi. Hapus keduanya, lalu masuk dengan token akses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスにユーザー名やパスワードは含められません。取り除いたうえで、アクセストークンでログインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소에 사용자 이름이나 비밀번호를 넣을 수 없습니다. 해당 부분을 지우고 액세스 토큰으로 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço não pode conter nome de usuário nem senha. Remova-os e faça login com um token de acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В адресе не должно быть имени пользователя и пароля. Уберите их и войдите с помощью токена доступа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่อยู่ต้องไม่มีชื่อผู้ใช้หรือรหัสผ่าน โปรดลบออกแล้วลงชื่อเข้าใช้ด้วยโทเค็นการเข้าถึงแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adreste kullanıcı adı veya şifre bulunamaz. Bunları çıkarıp erişim belirteciyle oturum açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ không được chứa tên người dùng hay mật khẩu. Hãy bỏ chúng đi và đăng nhập bằng mã truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地址里不能带用户名或密码，请改用访问令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位址裡不能帶使用者名稱或密碼。請移除後改用存取權杖登入。"
          }
        }
      }
    },
