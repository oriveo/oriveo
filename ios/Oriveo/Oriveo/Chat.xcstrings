          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อหรือโมเดลยังไม่พร้อม การตั้งค่าเหล่านี้จึงเป็นแบบอ่านอย่างเดียว เลือกการเชื่อมต่อและโมเดลเพื่อดำเนินการต่อ"
