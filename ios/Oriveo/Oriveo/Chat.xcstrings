    "Pasting replaces the current content with what’s on the clipboard." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل اللصق المحتوى الحالي بما في الحافظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen wird der aktuelle Inhalt durch den Inhalt der Zwischenablage ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting replaces the current content with what’s on the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pegar, el contenido actual se reemplaza por el del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller remplace le contenu actuel par celui du presse-papiers."
