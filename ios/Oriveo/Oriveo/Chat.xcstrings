    "This must be greater than %@. This setting won’t be sent until it’s fixed; your other settings aren’t affected." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن تكون القيمة أكبر من %@. لن يُرسل هذا الإعداد حتى يُصحَّح، ولا تتأثر الإعدادات الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert muss größer als %@ sein. Bis zur Korrektur wird diese Einstellung nicht gesendet; Ihre übrigen Einstellungen sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This must be greater than %@. This setting won’t be sent until it’s fixed; your other settings aren’t affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe ser mayor que %@. Este ajuste no se enviará hasta que lo corrijas; tus otros ajustes no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur doit être supérieure à %@. Ce réglage ne sera pas envoyé tant qu’il n’est pas corrigé ; vos autres réglages ne sont pas concernés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ से बड़ा होना चाहिए। ठीक होने तक यह सेटिंग नहीं भेजी जाएगी; आपकी बाकी सेटिंग्स पर कोई असर नहीं पड़ेगा।"
