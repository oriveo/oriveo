    "Only sent when %@ is set as well." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُرسل إلا عند تحديد %@ أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur gesendet, wenn auch %@ festgelegt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only sent when %@ is set as well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se envía si también defines %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé uniquement si %@ est aussi défini."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तब भेजी जाती है जब %@ भी सेट हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dikirim jika %@ juga diatur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ も設定した場合のみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목도 설정해야 보내져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é enviado se %@ também estiver definido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляется, только если задан и параметр «%@»."
