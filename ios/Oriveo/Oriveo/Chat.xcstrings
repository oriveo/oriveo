    "file_extraction_send_blocked_text_budget" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُرسل الرسالة: بإضافة ⁦%@⁩ يتجاوز النص المرفق الحد الأقصى لهذا النموذج. يُرجى إزالة ملف أو تغيير النموذج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gesendet: Mit %@ überschreitet der angehängte Text das Limit dieses Modells. Entferne eine Datei oder wechsle das Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not sent: with %@, the attached text is over this model's limit. Remove a file or switch models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envió: con %@, el texto adjunto supera el límite de este modelo. Quita un archivo o cambia de modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Message non envoyé : avec %@, le texte joint dépasse la limite de ce modèle. Retirez un fichier ou changez de modèle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश नहीं भेजा गया: %@ को मिलाकर, जुड़ी फ़ाइलों का टेक्स्ट इस मॉडल की सीमा से ज़्यादा हो जाता है। कोई फ़ाइल हटाएँ या मॉडल बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak terkirim: dengan %@, teks lampiran melebihi batas model ini. Hapus salah satu file atau ganti model."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信できませんでした。%@ を含めると、添付テキストがこのモデルの上限を超えます。ファイルを減らすか、モデルを切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내지 못했습니다. %@까지 포함하면 첨부 텍스트가 이 모델의 한도를 넘습니다. 파일을 줄이거나 모델을 바꿔 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não enviado: com %@, o texto anexado passa do limite deste modelo. Remova um arquivo ou troque de modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не отправлено: вместе с %@ прикреплённый текст превышает лимит этой модели. Уберите файл или выберите другую модель."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ส่ง: เมื่อรวม %@ แล้ว เนื้อหาของไฟล์แนบเกินขีดจำกัดของโมเดลนี้ ลองนำไฟล์ออกหรือเปลี่ยนโมเดล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderilmedi: %@ ile birlikte ekli metin bu modelin sınırını aşıyor. Bir dosyayı kaldırın veya modeli değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa gửi: khi tính cả %@, phần văn bản đính kèm vượt giới hạn của mô hình này. Hãy bỏ bớt tệp hoặc đổi mô hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
