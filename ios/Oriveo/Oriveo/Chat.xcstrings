        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोवाइडर ने इस मॉडल के लिए यह सेटिंग अस्वीकार कर दी। इसके बिना फिर से भेजें या कोई दूसरा मॉडल चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia menolak pengaturan ini untuk model tersebut. Kirim lagi tanpanya atau pilih model lain."
