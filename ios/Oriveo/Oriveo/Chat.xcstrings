    "context_cap_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقتصر الأثر على ما يُرسَل إلى النموذج، وتبقى رسائلك على هذا الجهاز كاملة دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert nur, was an das Modell gesendet wird. Deine Nachrichten auf diesem Gerät bleiben vollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only changes what’s sent to the model. Your messages on this device stay complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia lo que se envía al modelo. Tus mensajes en este dispositivo se conservan completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne modifie que ce qui est envoyé au modèle. Vos messages sur cet appareil restent complets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ यह बदलता है कि मॉडल को क्या भेजा जाता है। इस डिवाइस पर आपके मैसेज हमेशा पूरे रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mengubah apa yang dikirim ke model. Pesan Anda di perangkat ini tetap lengkap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルに送信する内容が変わるだけです。この端末のメッセージはすべてそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델에 보내는 내용만 바뀌어요. 이 기기에 있는 메시지는 항상 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só muda o que é enviado ao modelo. Suas mensagens neste dispositivo continuam completas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет только то, что отправляется модели. Ваши сообщения на этом устройстве всегда сохраняются полностью."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเฉพาะสิ่งที่ส่งให้โมเดล ข้อความในอุปกรณ์นี้ยังอยู่ครบเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca modele gönderilenleri değiştirir. Bu cihazdaki mesajlarınız her zaman eksiksiz kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ thay đổi nội dung gửi cho mô hình. Tin nhắn trên thiết bị này luôn được giữ đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只影响发给模型的内容，本地消息始终完整保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只影響傳送給模型的內容，本機訊息始終完整保留。"
          }
        }
      }
    },
