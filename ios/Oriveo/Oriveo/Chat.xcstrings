          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिक्रिया उत्पन्न करने के लिए आपका संदेश %@ पर भेजा जाएगा। Oriveo आपके संदेशों या एपीआई कुंजियों को हमारे सर्वर पर संग्रहीत नहीं करता है।"
