          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ให้บริการปฏิเสธการตั้งค่านี้สำหรับโมเดลนี้ โปรดส่งอีกครั้งโดยไม่ใช้การตั้งค่านี้ หรือเลือกโมเดลอื่น"
