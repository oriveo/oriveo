    "The model stops as soon as it writes any one of these. A sequence can contain commas, spaces and line breaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف النموذج فور كتابة أي من هذه التسلسلات. يمكن أن يحتوي التسلسل على فواصل ومسافات وأسطر جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell stoppt, sobald es eine dieser Sequenzen schreibt. Eine Sequenz darf Kommas, Leerzeichen und Zeilenumbrüche enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model stops as soon as it writes any one of these. A sequence can contain commas, spaces and line breaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo se detiene en cuanto escribe cualquiera de estas. Una secuencia puede tener comas, espacios y saltos de línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle s’arrête dès qu’il écrit l’une de ces séquences. Une séquence peut contenir des virgules, des espaces et des retours à la ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से कोई भी लिखते ही मॉडल रुक जाता है। किसी सीक्वेंस में कॉमा, स्पेस और लाइन ब्रेक भी हो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model berhenti begitu menulis salah satunya. Satu teks penghenti boleh berisi koma, spasi, dan baris baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このいずれかを書いた時点でモデルは停止します。シーケンスにはカンマ、スペース、改行も含められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델은 이 중 하나라도 쓰면 바로 멈춰요. 시퀀스에는 쉼표, 공백, 줄바꿈을 넣을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo para assim que escrever qualquer uma delas. Uma sequência pode conter vírgulas, espaços e quebras de linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель останавливается, как только напишет любую из них. В последовательности могут быть запятые, пробелы и переносы строк."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลจะหยุดทันทีที่เขียนข้อความใดข้อความหนึ่งในนี้ ข้อความแต่ละรายการมีจุลภาค ช่องว่าง และการขึ้นบรรทัดใหม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model bunlardan herhangi birini yazdığı anda durur. Bir dizi virgül, boşluk ve satır sonu içerebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình dừng ngay khi viết ra bất kỳ chuỗi nào trong số này. Một chuỗi có thể chứa dấu phẩy, khoảng trắng và dấu xuống dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型写到其中任意一条就停。序列里可以有逗号、空格和换行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型一寫出其中任一條就會停止。序列中可以包含逗號、空格和換行。"
          }
        }
      }
    },
