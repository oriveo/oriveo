    "The provider rejected this setting for this model. Send again without it, or pick another model." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض المزوّد هذا الإعداد لهذا النموذج. أعد الإرسال بدونه أو اختر نموذجًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter hat diese Einstellung für dieses Modell abgelehnt. Sende die Anfrage ohne sie erneut oder wähle ein anderes Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider rejected this setting for this model. Send again without it, or pick another model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor rechazó este ajuste para este modelo. Vuelve a enviar sin él o elige otro modelo."
