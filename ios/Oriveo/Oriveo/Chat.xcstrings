    "Ask anything, or just start typing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل أي شيء، أو ابدأ بالكتابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie etwas oder fangen Sie einfach an zu tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything, or just start typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta cualquier cosa o simplemente empieza a escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez n'importe quoi ou commencez simplement à taper."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी पूछें, या बस टाइप करना शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan apa saja, atau mulailah mengetik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何か質問するか、単に入力を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 물어보거나 입력을 시작해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa ou simplesmente comece a digitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите что-нибудь или просто начните печатать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามอะไรก็ได้หรือเพียงแค่เริ่มพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz şeyi sorun veya yazmaya başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi bất cứ điều gì, hoặc chỉ cần bắt đầu gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问点什么，或者直接开始输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問點什麼，或者直接開始輸入。"
          }
        }
      }
    },
    "Automatic configuration is not ready for this connection yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر التكوين التلقائي لمسار الطلب هذا بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Anforderungsroute ist die automatische Konfiguration noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic configuration is not ready for this connection yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración automática aún no está disponible para esta ruta de solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration automatique n’est pas encore disponible pour cette route de requête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अनुरोध मार्ग के लिए स्वचालित कॉन्फ़िगरेशन अभी उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi otomatis belum tersedia untuk rute permintaan ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエスト経路では、まだ自動設定を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청 경로에는 아직 자동 구성을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração automática ainda não está disponível para esta rota de solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая настройка пока недоступна для этого маршрута запроса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกำหนดค่าอัตโนมัติยังใช้ไม่ได้สำหรับเส้นทางคำขอนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek yolu için otomatik yapılandırma henüz kullanılamıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình tự động chưa có cho tuyến yêu cầu này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求路由暂未提供自动配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求路由暫未提供自動設定。"
          }
        }
      }
    },
    "Automatic configuration is unavailable for the current model route.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الطراز أو النقل التكوين التلقائي لهذا الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell oder dieser Transport unterstützt für diese Anfrage keine automatische Konfiguration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic configuration is unavailable for the current model route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo o transporte no admite configuración automática para esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle ou ce transport ne prend pas en charge la configuration automatique pour cette requête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल या ट्रांसपोर्ट इस अनुरोध के लिए स्वचालित कॉन्फ़िगरेशन समर्थित नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model atau transport ini tidak mendukung konfigurasi otomatis untuk permintaan ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルまたは転送方式は、このリクエストの自動設定に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델 또는 전송 방식은 이 요청의 자동 구성을 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo ou transporte não oferece configuração automática para esta solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель или транспорт не поддерживает автоматическую настройку для этого запроса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รุ่นหรือการรับส่งนี้ไม่รองรับการกำหนดค่าอัตโนมัติสำหรับคำขอนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model veya aktarım bu istek için otomatik yapılandırmayı desteklemiyor."
          }
