          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение должно быть больше %@. Пока значение не исправлено, эта настройка не отправляется; на остальные настройки это не влияет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่านี้ต้องมากกว่า %@ การตั้งค่านี้จะไม่ถูกส่งจนกว่าจะแก้ไข และไม่กระทบการตั้งค่าอื่นของคุณ"
