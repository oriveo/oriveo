    "Custom fields need an official field schema for this exact model and transport." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب الحقول المخصصة مخطط حقول رسميًا لهذا النموذج وطريقة النقل تحديدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Felder erfordern ein offizielles Feldschema für genau dieses Modell und diesen Transport."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom fields need an official field schema for this exact model and transport."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos personalizados requieren un esquema oficial para este modelo y transporte exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les champs personnalisés nécessitent un schéma officiel pour ce modèle et ce transport précis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम फ़ील्ड के लिए इसी मॉडल और ट्रांसपोर्ट का आधिकारिक फ़ील्ड स्कीमा चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidang kustom memerlukan skema bidang resmi untuk model dan transport ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムフィールドには、この正確なモデルとトランスポート向けの公式フィールドスキーマが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 필드에는 이 모델과 전송 방식에 대한 공식 필드 스키마가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campos personalizados exigem um esquema oficial para este modelo e transporte exatos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательские поля требуют официальной схемы для этой модели и транспорта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟิลด์ที่กำหนดเองต้องมีสคีมาฟิลด์อย่างเป็นทางการสำหรับโมเดลและทรานสปอร์ตนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel alanlar, tam olarak bu model ve taşıma için resmi bir alan şeması gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trường tùy chỉnh cần lược đồ trường chính thức cho đúng mô hình và phương thức truyền này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
