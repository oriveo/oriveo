    "Keeps the randomness of the output steady around a target, in place of Top K and Top P." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي عشوائية المخرجات ثابتة حول قيمة مستهدفة، بدلًا من Top K وTop P."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Zufälligkeit der Ausgabe stabil um einen Zielwert – anstelle von Top K und Top P."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the randomness of the output steady around a target, in place of Top K and Top P."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene estable la aleatoriedad de la salida en torno a un objetivo, en lugar de Top K y Top P."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient le caractère aléatoire de la sortie autour d’une valeur cible, à la place de Top K et Top P."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आउटपुट की रैंडमनेस को एक लक्ष्य के आसपास स्थिर रखता है; Top K और Top P की जगह इस्तेमाल होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaga tingkat keacakan output tetap stabil di sekitar target, sebagai pengganti Top K dan Top P."
          }
        },
        "ja" : {
