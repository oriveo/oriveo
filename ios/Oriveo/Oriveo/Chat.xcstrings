        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek istek gövdesinde bir sorun olduğu için bu anahtar onu değiştiremiyor. Önce orada düzeltin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
