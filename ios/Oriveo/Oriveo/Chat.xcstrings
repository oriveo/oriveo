        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanmak üzeresiniz"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sắp sử dụng %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您即将使用 %@"
          }
