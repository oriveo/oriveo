        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोटोकॉल अभी भी “ऑटो” पर है, इसलिए Oriveo तय नहीं कर पा रहा कि वेब खोज और सोच की सेटिंग्स कैसे भेजे।"
