    "Smaller than the reasoning budget, so the default is sent instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصغر من ميزانية الاستدلال، لذا تُرسل القيمة الافتراضية بدلًا منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleiner als das Denkbudget, daher wird stattdessen der Standardwert gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaller than the reasoning budget, so the default is sent instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es menor que el presupuesto de razonamiento, así que se envía el valor predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inférieur au budget de raisonnement : la valeur par défaut est envoyée à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीज़निंग बजट से छोटा है, इसलिए इसकी जगह डिफ़ॉल्ट भेजा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih kecil dari anggaran penalaran, jadi nilai bawaan yang dikirim."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推論予算より小さいため、代わりにデフォルト値を送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추론 예산보다 작아서 대신 기본값을 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menor que o orçamento de raciocínio, então o padrão é enviado no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше бюджета рассуждения, поэтому вместо него отправляется значение по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้อยกว่างบการใช้เหตุผล จึงส่งค่าเริ่มต้นแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıl yürütme bütçesinden küçük olduğu için bunun yerine varsayılan değer gönderilir."
          }
        },
        "vi" : {
