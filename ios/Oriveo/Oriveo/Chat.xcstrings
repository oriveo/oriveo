    "This removes the custom fields for %@ on this conversation, connection, model and transport. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة الحقول المخصصة لـ %@ في هذه المحادثة والاتصال والنموذج وطريقة النقل. لا يمكن التراجع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden die eigenen Felder für %@ in dieser Unterhaltung, Verbindung, Modell und Transport entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina los campos personalizados de %@ en esta conversación, conexión, modelo y transporte. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les champs personnalisés de %@ pour cette conversation, connexion, modèle et transport. Action irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस बातचीत, कनेक्शन, मॉडल और ट्रांसपोर्ट पर %@ के कस्टम फ़ील्ड हटा देगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus bidang kustom untuk %@ pada percakapan, koneksi, model, dan transport ini. Tidak dapat dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話・接続・モデル・トランスポートにおける %@ のカスタムフィールドを削除します。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화•연결•모델•전송 방식의 %@ 사용자 지정 필드를 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove os campos personalizados de %@ nesta conversa, conexão, modelo e transporte. Não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит пользовательские поля %@ для текущего чата, подключения, модели и транспорта. Отменить нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำเช่นนี้จะลบฟิลด์ที่กำหนดเองของ %@ สำหรับการสนทนา การเชื่อมต่อ โมเดล และทรานสปอร์ตนี้ ย้อนกลับไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu sohbet, bağlantı, model ve taşıma için %@ özel alanlarını siler. Geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa các trường tùy chỉnh của %@ cho cuộc trò chuyện, kết nối, mô hình và phương thức truyền này. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除本对话 / 连接 / 模型 / 传输方式下「%@」的自定义字段，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除本對話 / 連線 / 模型 / 傳輸方式下「%@」的自訂欄位，且無法復原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the custom fields for %@ on this conversation, connection, model and transport. This cannot be undone."
          }
        }
      }
