{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” can’t be used as a field name in the additional request body." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام «%@» اسمًا لحقل في نص الطلب الإضافي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann in den zusätzlichen Anfragedaten nicht als Feldname verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” can’t be used as a field name in the additional request body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no se puede usar como nombre de campo en el cuerpo de solicitud adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas servir de nom de champ dans le corps de requête supplémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” को अतिरिक्त अनुरोध बॉडी में फ़ील्ड के नाम के रूप में इस्तेमाल नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tidak bisa dipakai sebagai nama kolom di isi permintaan tambahan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は追加リクエストボディのフィールド名に使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 필드 이름은 추가 요청 본문에서 쓸 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pode ser usado como nome de campo no corpo adicional da requisição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» нельзя использовать как имя поля в дополнительном теле запроса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ “%@” เป็นชื่อฟิลด์ในเนื้อหาคำขอเพิ่มเติมไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ek istek gövdesinde alan adı olarak kullanılamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể dùng “%@” làm tên trường trong nội dung yêu cầu bổ sung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不能用作附加请求体里的字段名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不能用作附加請求主體中的欄位名稱。"
          }
        }
      }
    },
    "“%@” is filled in by Oriveo and can’t be set in the additional request body." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتولى Oriveo تعبئة «%@»، ولا يمكن تحديده في نص الطلب الإضافي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ füllt Oriveo selbst aus und lässt sich nicht in den zusätzlichen Anfragedaten festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is filled in by Oriveo and can’t be set in the additional request body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» lo completa Oriveo y no se puede definir en el cuerpo de solicitud adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est renseigné par Oriveo et ne peut pas être défini dans le corps de requête supplémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” Oriveo भरता है, इसलिए इसे अतिरिक्त अनुरोध बॉडी में सेट नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” diisi oleh Oriveo dan tidak bisa diatur di isi permintaan tambahan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は Oriveo が入力するため、追加リクエストボディでは設定できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 필드는 Oriveo가 채우므로 추가 요청 본문에서 설정할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é preenchido pelo Oriveo e não pode ser definido no corpo adicional da requisição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» подставляет Oriveo, его нельзя задать в дополнительном теле запроса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo เป็นผู้กรอก “%@” จึงตั้งค่าไว้ในเนื้อหาคำขอเพิ่มเติมไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” alanını Oriveo doldurur; ek istek gövdesinde ayarlanamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” do Oriveo tự điền nên không thể đặt trong nội dung yêu cầu bổ sung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」由 Oriveo 填写，不能写在附加请求体里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」由 Oriveo 填入，不能寫在附加請求主體中。"
          }
        }
      }
    },
