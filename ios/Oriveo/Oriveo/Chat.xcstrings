    "Model settings haven't loaded yet, so these are read-only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تحميل إعدادات النموذج بعد، لذا فهذه للقراءة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modelleinstellungen wurden noch nicht geladen, daher sind sie schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del modelo aún no se han cargado, así que son de solo lectura."
