    "context_compaction_detail_fallback_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد ردود الذكاء الاصطناعي السابقة تُرسَل إلى النموذج، أما رسائلك أنت فتبقى مُرسَلة كالمعتاد. كل ما سبق باقٍ في هذه المحادثة ويمكن قراءته ونسخه كالمعتاد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frühere KI-Antworten werden nicht mehr an das Modell gesendet; deine eigenen Nachrichten bleiben enthalten. Alles oben bleibt in diesem Chat, du kannst es weiterhin lesen und kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earlier AI replies are no longer sent to the model; your own messages are still included. Everything above stays in this chat for you to read and copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas anteriores de la IA ya no se envían al modelo; tus propios mensajes se siguen incluyendo. Todo lo de arriba sigue en este chat para que lo leas y lo copies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses antérieures de l’IA ne sont plus envoyées au modèle ; vos propres messages restent inclus. Tout ce qui figure ci-dessus reste dans cette conversation : vous pouvez toujours le lire et le copier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI के पहले के जवाब अब मॉडल को नहीं भेजे जाते; आपके अपने मैसेज पहले की तरह शामिल रहते हैं। ऊपर के सभी मैसेज इसी चैट में मौजूद हैं, आप उन्हें पहले की तरह पढ़ और कॉपी कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balasan AI sebelumnya tidak lagi dikirim ke model; pesan Anda sendiri tetap disertakan. Semua pesan di atas tetap ada di percakapan ini dan tetap bisa dibaca serta disalin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の AI の回答はモデルに送信されなくなりますが、あなたのメッセージはこれまでどおり送信されます。上のメッセージはすべて残っているので、いつもどおり閲覧やコピーができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 AI 답변은 더 이상 모델에 보내지 않고, 직접 보낸 메시지는 그대로 포함돼요. 위의 메시지는 모두 남아 있어서 평소처럼 보고 복사할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas anteriores da IA não são mais enviadas ao modelo; suas próprias mensagens continuam incluídas. Tudo o que está acima continua nesta conversa para você ler e copiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущие ответы ИИ больше не отправляются модели; ваши собственные сообщения по-прежнему включаются. Всё, что выше, остаётся в этом чате — это можно читать и копировать как обычно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบของ AI ก่อนหน้าจะไม่ถูกส่งให้โมเดลอีก ส่วนข้อความของคุณยังส่งตามปกติ ข้อความด้านบนยังอยู่ครบ ดูและคัดลอกได้ตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki yapay zekâ yanıtları artık modele gönderilmez; kendi mesajlarınız gönderilmeye devam eder. Yukarıdaki her şey bu sohbette kalır, okumaya ve kopyalamaya devam edebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các câu trả lời AI trước đó không còn được gửi cho mô hình; tin nhắn của chính bạn vẫn được gửi như thường. Mọi tin nhắn phía trên vẫn còn trong cuộc trò chuyện này, bạn vẫn xem và sao chép được như bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较早的 AI 回答不再发给模型，你说过的话照常保留。上面的消息都还在，可以照常查看和复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較早的 AI 回覆不再傳送給模型，你說過的話照常保留。上方的訊息都還在，可以照常查看和複製。"
          }
        }
      }
    },
