    "Or just ask something in the box on the left — the new conversation opens right here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اكتب سؤالك في الحقل على اليمين، وستفتح المحادثة الجديدة هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder stell links einfach eine Frage — die neue Unterhaltung öffnet sich hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or just ask something in the box on the left — the new conversation opens right here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escribe lo que quieras en el campo de la izquierda: la nueva conversación se abrirá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou posez simplement une question dans le champ à gauche : la nouvelle conversation s’ouvrira ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या बाईं ओर के बॉक्स में कुछ भी पूछ लें — नई बातचीत यहीं खुलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau tanyakan apa saja di kotak sebelah kiri — percakapan baru terbuka di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の入力欄に何か聞いてみても大丈夫です。新しい会話はここに開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 입력창에 무엇이든 물어보세요. 새 대화가 여기에 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pergunte algo no campo à esquerda — a nova conversa abre aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или просто спросите что-нибудь в поле слева — новый разговор откроется здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือพิมพ์ถามอะไรก็ได้ในช่องด้านซ้าย บทสนทนาใหม่จะเปิดขึ้นที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da soldaki alana bir şey sor — yeni sohbet burada açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc cứ hỏi gì đó ở khung bên trái — cuộc trò chuyện mới sẽ mở ra ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者直接在左边的输入框里问点什么，新会话会在这里展开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者直接在左邊的輸入框問點什麼，新對話就會在這裡展開。"
          }
        }
      }
    },
