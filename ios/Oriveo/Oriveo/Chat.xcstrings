    "context_usage_breaker_paused" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاختصار بالذكاء الاصطناعي عدة مرات متتالية فتم إيقافه مؤقتًا. يجري حاليًا إغفال الردود الأقدم فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das KI-Verdichten ist wiederholt fehlgeschlagen und wurde pausiert. Ältere Antworten werden vorerst weggelassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI condensing failed repeatedly and is paused. Older replies are left out for now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condensación con IA falló varias veces y se pausó. Por ahora se omiten las respuestas más antiguas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condensation par l’IA a échoué à plusieurs reprises et a été suspendue. Les réponses plus anciennes sont omises pour l’instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI से संक्षिप्त करना बार-बार विफल रहा, इसलिए इसे रोक दिया गया है। फ़िलहाल सिर्फ़ पुराने जवाब छोड़े जा रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemadatan dengan AI berulang kali gagal dan dijeda. Untuk sementara, balasan yang lebih lama hanya dilewati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI による整理が続けて失敗したため一時停止しました。当面は以前の回答を省略するだけにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 정리가 계속 실패해서 일시 중지했어요. 당분간 이전 답변만 생략해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A condensação por IA falhou várias vezes e foi pausada. Por enquanto, as respostas mais antigas são omitidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сжатие с помощью ИИ несколько раз завершилось ошибкой и приостановлено. Пока более ранние ответы просто пропускаются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การย่อด้วย AI ล้มเหลวติดต่อกันหลายครั้ง จึงหยุดไว้ชั่วคราว ตอนนี้จะละคำตอบที่เก่ากว่าไว้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ ile sıkıştırma art arda başarısız oldu ve duraklatıldı. Şimdilik yalnızca eski yanıtlar atlanıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút gọn bằng AI thất bại nhiều lần liên tiếp nên đã tạm dừng. Hiện chỉ bỏ qua các câu trả lời cũ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 整理连续失败，已暂停，暂时只省略较早的回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 整理連續失敗，已暫停，目前只省略較早的回覆。"
          }
        }
      }
    },
