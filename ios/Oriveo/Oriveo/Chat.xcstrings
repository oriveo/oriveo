    "context_cap_above_line" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد المحدد أعلى من عتبة السعر، وسيُطلب تأكيدك قبل تجاوز %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Limit liegt über der Preisschwelle. Bevor %@ überschritten wird, wirst du gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your limit is above the price line. You’ll be asked before passing %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu límite está por encima del umbral de precio. Te preguntaremos antes de superar %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre limite dépasse le seuil tarifaire. Une confirmation vous sera demandée avant de dépasser %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सीमा ऊँची दर की रेखा से ऊपर है। %@ पार करने से पहले आपसे पूछा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas Anda di atas ambang harga. Anda akan ditanya dulu sebelum melewati %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限が割増ラインを上回っています。%@ を超える前に確認します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도가 할증 기준선보다 높아요. %@ 초과 전에 먼저 물어볼게요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu limite está acima do patamar de preço. Vamos perguntar antes de passar de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш лимит выше ценового порога. Перед превышением %@ вас спросят."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขีดจำกัดของคุณสูงกว่าเกณฑ์ขึ้นราคา จะถามคุณก่อนเกิน %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırınız fiyat eşiğinin üzerinde. %@ aşılmadan önce size sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn của bạn cao hơn ngưỡng tăng giá. Bạn sẽ được hỏi trước khi vượt %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限高于加价线：越过 %@ 之前会先问你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限高於加價門檻：越過 %@ 之前會先問你"
          }
        }
      }
    },
