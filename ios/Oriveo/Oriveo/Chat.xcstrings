    "This model runs at a fixed thinking level and can’t be adjusted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model runs at a fixed thinking level and can’t be adjusted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型的思考深度是固定的，无法调节。"
