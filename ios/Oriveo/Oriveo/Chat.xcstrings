        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーがこのモデルの設定を拒否しました。この設定を外して再送信するか、別のモデルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
