    "context_reject_instructions_too_long" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المهارة والتعليمات أطول من أن يستوعبها سياق هذا النموذج. جرّب نموذجًا بسياق أكبر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fähigkeit und Anweisungen sind zu lang für den Kontext dieses Modells. Probiere ein Modell mit größerem Kontext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Skill and instructions are too long for this model's context. Try a model with a larger context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La habilidad y las instrucciones son demasiado largas para el contexto de este modelo. Prueba con un modelo de contexto más amplio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compétence et les instructions sont trop longues pour le contexte de ce modèle. Essayez un modèle doté d'un contexte plus grand."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कौशल और निर्देश इस मॉडल के कॉन्टेक्स्ट के हिसाब से बहुत लंबे हैं। बड़े कॉन्टेक्स्ट वाला मॉडल आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keterampilan dan instruksi terlalu panjang untuk konteks model ini. Coba model dengan konteks yang lebih besar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill と指示が長すぎて、このモデルのコンテキストに収まりません。コンテキストの大きいモデルでお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스킬과 지침이 너무 길어 이 모델의 컨텍스트에 담을 수 없어요. 컨텍스트가 더 큰 모델로 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A habilidade e as instruções são longas demais para o contexto deste modelo. Tente um modelo com contexto maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навык и инструкции слишком длинные для контекста этой модели. Попробуйте модель с более длинным контекстом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทักษะและคำสั่งยาวเกินกว่าบริบทของโมเดลนี้จะรองรับได้ ลองใช้โมเดลที่มีบริบทใหญ่กว่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beceri ve talimatlar bu modelin bağlamına sığmayacak kadar uzun. Daha geniş bağlamlı bir modelle deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kỹ năng và hướng dẫn quá dài so với ngữ cảnh của mô hình này. Hãy thử một mô hình có ngữ cảnh lớn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skill 和指令太长，超出了这个模型的上下文。换一个上下文更大的模型再试试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技能和指令太長，超出了這個模型的上下文。換一個上下文更大的模型再試試。"
