    "Turns thinking on or off through the chat template. Whether it works depends on your server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل التفكير أو يوقفه عبر قالب المحادثة. يتوقف نجاح ذلك على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Nachdenken über das Chat-Template ein oder aus. Ob das funktioniert, hängt von Ihrem Server ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns thinking on or off through the chat template. Whether it works depends on your server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el razonamiento mediante la plantilla de chat. Que funcione depende de tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive la réflexion via le template de chat. Le résultat dépend de votre serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट टेम्पलेट के ज़रिए सोच चालू या बंद करता है। यह काम करेगा या नहीं, यह आपके सर्वर पर निर्भर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyalakan atau mematikan berpikir lewat template chat. Berhasil atau tidaknya tergantung server Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットテンプレートを通じて思考のオン／オフを切り替えます。実際に効くかどうかはサーバー次第です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 템플릿으로 사고를 켜거나 꺼요. 실제로 적용되는지는 서버에 따라 달라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga ou desliga o raciocínio pelo template de chat. Se funciona ou não depende do seu servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает и выключает размышление через шаблон чата. Сработает ли это, зависит от вашего сервера."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดหรือปิดการคิดผ่านเทมเพลตแชต จะได้ผลหรือไม่ขึ้นอยู่กับเซิร์ฟเวอร์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşünmeyi sohbet şablonu üzerinden açar veya kapatır. Çalışıp çalışmayacağı sunucunuza bağlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hoặc tắt suy nghĩ qua mẫu trò chuyện. Có hiệu lực hay không tùy vào máy chủ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按对话模板开关，是否生效看你的服务"
          }
        },
        "zh-Hant" : {
