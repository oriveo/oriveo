    "memory_extraction_scope_draft" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يُرسَل: رسائلك إلى هذا المزوّد من 5 محادثات حديثة كحدٍّ أقصى، بأول 500 حرف من كل محادثة. لا تُرسَل ردود الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gesendet wird: deine eigenen Nachrichten an diesen Anbieter aus bis zu 5 der letzten Chats, jeweils die ersten 500 Zeichen. Antworten der KI sind nicht dabei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's sent: your own messages to this provider from up to 5 recent chats, the first 500 characters of each chat. AI replies aren't included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué se envía: tus propios mensajes a este proveedor de hasta 5 chats recientes, los primeros 500 caracteres de cada uno. No se incluyen las respuestas de la IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenu envoyé : vos propres messages à ce fournisseur dans 5 conversations récentes au maximum, limités aux 500 premiers caractères de chacune. Les réponses de l'IA ne sont pas incluses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या भेजा जाएगा: हाल की ज़्यादा से ज़्यादा 5 चैट में इस प्रोवाइडर को भेजे गए आपके अपने मैसेज, हर चैट के पहले 500 अक्षर। AI के जवाब शामिल नहीं होते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang dikirim: pesan Anda sendiri ke penyedia ini dari maksimal 5 percakapan terbaru, 500 karakter pertama dari tiap percakapan. Balasan AI tidak disertakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信内容：最近の会話（最大5件）であなたがこのプロバイダーに送ったメッセージ（各会話の先頭500文字まで）。AIの返信は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내는 내용: 최근 대화 최대 5개에서 이 제공업체에 보낸 내 메시지(대화당 앞 500자)예요. AI의 답변은 포함되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que é enviado: suas próprias mensagens para este provedor em até 5 conversas recentes, os primeiros 500 caracteres de cada uma. As respostas da IA não são incluídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что отправляется: ваши сообщения этому провайдеру максимум из 5 последних чатов — первые 500 символов каждого. Ответы ИИ не отправляются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ส่ง: ข้อความที่คุณส่งถึงผู้ให้บริการนี้จากแชทล่าสุดไม่เกิน 5 แชท แชทละ 500 อักขระแรก ไม่รวมคำตอบของ AI"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderilen: En fazla son 5 sohbette bu sağlayıcıya gönderdiğiniz mesajlar, her sohbetten ilk 500 karakter. Yapay zekânın yanıtları dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung gửi đi: tin nhắn bạn đã gửi cho nhà cung cấp này trong tối đa 5 cuộc trò chuyện gần đây, mỗi cuộc lấy 500 ký tự đầu. Không bao gồm câu trả lời của AI."
          }
        },
        "zh-Hans" : {
