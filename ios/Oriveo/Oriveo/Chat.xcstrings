    "context_compaction_third_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اختصار هذه المحادثة 3 مرات، لذا تقلّ التفاصيل المبكرة التي يراها النموذج في كل مرة. يمكن بدء محادثة جديدة ونقل الملخّص إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat wurde 3-mal verdichtet, daher sieht das Modell jedes Mal weniger frühe Details. Du kannst einen neuen Chat starten und die Zusammenfassung mitnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chat has been condensed 3 times, so the model sees fewer early details each time. You can start a new chat and bring the summary along."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat ya se condensó 3 veces, así que el modelo ve cada vez menos detalles del principio. Puedes iniciar un chat nuevo y llevarte el resumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette conversation a été condensée 3 fois : le modèle voit donc de moins en moins de détails du début. Vous pouvez démarrer une nouvelle conversation en reprenant le résumé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह चैट 3 बार संक्षिप्त हो चुकी है, इसलिए मॉडल को शुरुआती बातें हर बार और कम दिखती हैं। आप नई चैट शुरू करके सारांश साथ ले जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan ini sudah dipadatkan 3 kali, jadi detail awal yang terlihat oleh model makin sedikit. Anda bisa memulai percakapan baru dan membawa ringkasannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは 3 回整理されたため、モデルが把握できる初期の詳細は回を追うごとに少なくなります。要約を引き継いで新しいチャットを始めることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅은 3번 정리되어서 모델이 볼 수 있는 초반 내용이 점점 줄어들어요. 요약을 가지고 새 채팅을 시작할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversa já foi condensada 3 vezes, então o modelo vê cada vez menos detalhes do início. Você pode começar uma nova conversa e levar o resumo junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат сжат уже 3 раза, и с каждым разом модель видит всё меньше ранних подробностей. Можно начать новый чат и перенести в него сводку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทนี้ถูกย่อมาแล้ว 3 ครั้ง โมเดลจะเห็นรายละเอียดช่วงแรกน้อยลงเรื่อย ๆ คุณเริ่มแชทใหม่และนำสรุปไปด้วยได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet 3 kez sıkıştırıldı; model her seferinde baştaki ayrıntıları daha az görür. Yeni bir sohbet başlatıp özeti oraya taşıyabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc trò chuyện này đã được rút gọn 3 lần, mô hình sẽ thấy ngày càng ít chi tiết ban đầu. Bạn có thể bắt đầu cuộc trò chuyện mới và mang theo bản tóm tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个对话已经整理了 3 次，模型能看到的早期细节会越来越少。可以开一个新对话，并带上摘要继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個對話已經整理了 3 次，模型能看到的早期細節會越來越少。可以開新對話，並帶上摘要繼續。"
          }
        }
      }
    },
