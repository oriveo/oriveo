    "The connection or model is not ready, so these settings are read-only. Choose a connection and model to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتصال أو النموذج غير جاهز، لذلك هذه الإعدادات للقراءة فقط. اختر اتصالًا ونموذجًا للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung oder Modell ist noch nicht bereit. Diese Einstellungen sind daher schreibgeschützt. Wähle eine Verbindung und ein Modell aus."
