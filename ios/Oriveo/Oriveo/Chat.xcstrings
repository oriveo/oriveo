    "The protocol is still set to Auto, so Oriveo can’t tell how to send web search and thinking settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال البروتوكول مضبوطًا على «تلقائي»، لذا لا يستطيع Oriveo تحديد طريقة إرسال إعدادات بحث الويب والتفكير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Protokoll steht noch auf „Automatisch“, daher weiß Oriveo nicht, wie Einstellungen für Websuche und Nachdenken gesendet werden sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The protocol is still set to Auto, so Oriveo can’t tell how to send web search and thinking settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El protocolo sigue en «Automático», así que Oriveo no sabe cómo enviar los ajustes de búsqueda web y razonamiento."
