    "Grey numbers are %@’s own defaults. They aren’t sent unless you change them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأرقام الرمادية هي القيم الافتراضية الخاصة بـ %@، ولا تُرسل ما لم تُغيَّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graue Werte sind die eigenen Standardwerte von %@. Sie werden nur gesendet, wenn Sie sie ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grey numbers are %@’s own defaults. They aren’t sent unless you change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números en gris son los valores predeterminados de %@. No se envían a menos que los cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs en gris sont les valeurs par défaut propres à %@. Elles ne sont envoyées que si vous les modifiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रे संख्याएँ %@ के अपने डिफ़ॉल्ट हैं। जब तक आप इन्हें न बदलें, ये नहीं भेजी जातीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angka abu-abu adalah nilai bawaan %@ sendiri. Angka ini tidak dikirim kecuali Anda mengubahnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グレーの数値は %@ 本来のデフォルトです。変更しない限り送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회색 숫자는 %@ 자체 기본값이에요. 바꾸지 않으면 보내지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números em cinza são os padrões do próprio %@. Eles só são enviados se você os alterar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серые значения — собственные значения %@ по умолчанию. Они не отправляются, пока вы их не измените."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเลขสีเทาคือค่าเริ่มต้นของ %@ เอง จะไม่ถูกส่งเว้นแต่คุณจะเปลี่ยน"
