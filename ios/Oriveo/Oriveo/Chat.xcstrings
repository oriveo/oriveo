        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कनेक्शन या मॉडल तैयार नहीं है, इसलिए ये सेटिंग केवल पढ़ने योग्य हैं। आगे बढ़ने के लिए कनेक्शन और मॉडल चुनें।"
