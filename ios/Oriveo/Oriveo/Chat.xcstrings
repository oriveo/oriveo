    "context_usage_hint_compacted" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اختصار السياق للتو. سيتم تحديث الاستخدام بعد رسالتك التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontext wurde gerade verdichtet. Die Nutzung wird nach deiner nächsten Nachricht aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context was just condensed. Usage updates after your next message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contexto se acaba de condensar. El uso se actualizará después de tu próximo mensaje."
