    "The request did not finish cleanly. Retry it now or edit the last user message before sending again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل الطلب بشكل سليم. أعد المحاولة الآن أو عدّل آخر رسالة قبل الإرسال مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
