    "The model stops as soon as it writes any one of these. A sequence can contain commas, spaces and line breaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف النموذج فور كتابة أي من هذه التسلسلات. يمكن أن يحتوي التسلسل على فواصل ومسافات وأسطر جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell stoppt, sobald es eine dieser Sequenzen schreibt. Eine Sequenz darf Kommas, Leerzeichen und Zeilenumbrüche enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model stops as soon as it writes any one of these. A sequence can contain commas, spaces and line breaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo se detiene en cuanto escribe cualquiera de estas. Una secuencia puede tener comas, espacios y saltos de línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle s’arrête dès qu’il écrit l’une de ces séquences. Une séquence peut contenir des virgules, des espaces et des retours à la ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से कोई भी लिखते ही मॉडल रुक जाता है। किसी सीक्वेंस में कॉमा, स्पेस और लाइन ब्रेक भी हो सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
