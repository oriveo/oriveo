          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınır tam fiyat eşiğinde; sohbet eşik aşılmadan önce sıkıştırılır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn đặt đúng ngưỡng tăng giá: cuộc trò chuyện sẽ được rút gọn trước khi vượt ngưỡng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限就设在加价线：对话会在越线前先整理"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限就設在加價門檻：對話會在越過前先整理"
          }
        }
      }
    },
    "context_cap_custom_over" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد تجاوز %1$@ يُحتسب الطلب كاملًا بسعر السياق الطويل (%2$@). وسيُطلب تأكيدك قبل التجاوز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab %1$@ wird die gesamte Anfrage zum Langkontext-Preis abgerechnet (%2$@). Vorher wirst du gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past %1$@, the whole request is billed at long-context prices (%2$@). You’ll be asked before crossing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de %1$@, toda la solicitud se cobra al precio de contexto largo (%2$@). Te preguntaremos antes de superarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de %1$@, toute la requête est facturée au tarif de contexte long (%2$@). Une confirmation vous sera demandée avant de le franchir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से ऊपर जाने पर पूरे अनुरोध का बिल लॉन्ग कॉन्टेक्स्ट की दर (%2$@) से बनेगा। इसे पार करने से पहले आपसे पूछा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di atas %1$@, seluruh permintaan dikenai harga konteks panjang (%2$@). Anda akan ditanya dulu sebelum melewatinya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を超えると、リクエスト全体がロングコンテキスト料金（%2$@）になります。超える前に確認します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 초과 시 요청 전체에 긴 컨텍스트 요금(%2$@)이 적용돼요. 넘기 전에 먼저 물어볼게요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima de %1$@, a solicitação inteira é cobrada pelo preço de contexto longo (%2$@). Vamos perguntar antes de passar desse ponto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После %1$@ весь запрос оплачивается по тарифу для длинного контекста (%2$@). Перед превышением вас спросят."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเกิน %1$@ จะคิดราคาบริบทยาว (%2$@) กับทั้งคำขอ และจะถามคุณก่อนเกิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aşılınca isteğin tamamı uzun bağlam fiyatından ücretlendirilir (%2$@). Aşmadan önce size sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vượt %1$@ thì cả yêu cầu bị tính theo giá ngữ cảnh dài (%2$@). Bạn sẽ được hỏi trước khi vượt ngưỡng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过 %1$@ 后整单按长上下文价（%2$@），越线前会先问你"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過 %1$@ 後整筆請求按長上下文價格計費（%2$@），越過前會先問你"
          }
        }
      }
    },
