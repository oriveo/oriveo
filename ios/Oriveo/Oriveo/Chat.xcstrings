    "This model has no official web search configuration. Oriveo doesn’t guess, to avoid failed requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model has no official web search configuration. Oriveo doesn’t guess, to avoid failed requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型没有官方的联网搜索配置。Oriveo 不做猜测，避免请求出错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個模型沒有官方的聯網搜尋配置。Oriveo 不做猜測，避免請求出錯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルには公式のウェブ検索設定がありません。リクエスト失敗を避けるため、Oriveo は推測しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델에는 공식 웹 검색 구성이 없습니다. 요청 실패를 피하기 위해 Oriveo는 추측하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no tiene configuración oficial de búsqueda web. Oriveo no adivina, para evitar errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’a pas de configuration officielle de recherche web. Oriveo ne devine pas, pour éviter les erreurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell hat keine offizielle Websuche-Konfiguration. Oriveo rät nicht, um Fehler zu vermeiden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não tem configuração oficial de busca na web. O Oriveo não adivinha, para evitar falhas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك هذا النموذج إعدادًا رسميًا لبحث الويب. لا يخمّن Oriveo لتجنّب فشل الطلبات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल में आधिकारिक वेब खोज कॉन्फ़िगरेशन नहीं है। अनुरोध विफलता से बचने के लिए Oriveo अनुमान नहीं लगाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak punya konfigurasi pencarian web resmi. Oriveo tidak menebak, demi menghindari kegagalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này chưa có cấu hình tìm kiếm web chính thức. Oriveo không đoán để tránh lỗi yêu cầu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลนี้ไม่มีการตั้งค่าค้นเว็บอย่างเป็นทางการ Oriveo จะไม่เดาเพื่อเลี่ยงคำขอที่ล้มเหลว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modelin resmi web arama yapılandırması yok. Oriveo, hatalı istekleri önlemek için tahmin yürütmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой модели нет официальной конфигурации веб-поиска. Oriveo не гадает, чтобы избежать ошибок."
          }
        }
      }
    },
