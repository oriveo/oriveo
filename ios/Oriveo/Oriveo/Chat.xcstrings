    "This capability is provided by a separate external service, outside this connection's chat request.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توفير هذه الإمكانية عبر خدمة خارجية منفصلة، خارج طلب المحادثة الخاص بهذا الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion wird von einem separaten externen Dienst bereitgestellt und gehört nicht zur Chat-Anfrage dieser Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This capability is provided by a separate external service, outside this connection's chat request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función la proporciona un servicio externo independiente y no forma parte de la solicitud de chat de esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité est fournie par un service externe distinct, en dehors de la requête de conversation de cette connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्षमता एक अलग बाहरी सेवा द्वारा दी जाती है और इस कनेक्शन के चैट अनुरोध का हिस्सा नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemampuan ini disediakan oleh layanan eksternal terpisah, di luar permintaan chat koneksi ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能は独立した外部サービスで提供され、この接続のチャットリクエストには含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능은 별도의 외부 서비스에서 제공되며 이 연결의 채팅 요청에는 포함되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recurso é fornecido por um serviço externo separado, fora da solicitação de chat desta conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта возможность предоставляется отдельным внешним сервисом и не входит в чат-запрос этого подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสามารถนี้ให้บริการโดยบริการภายนอกแยกต่างหาก ซึ่งไม่อยู่ในคำขอแชทของการเชื่อมต่อนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yetenek ayrı bir harici hizmet tarafından sağlanır ve bu bağlantının sohbet isteğine dahil değildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khả năng này do một dịch vụ bên ngoài riêng biệt cung cấp, không nằm trong yêu cầu trò chuyện của kết nối này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该能力由独立的外部服务提供，不在此连接的聊天请求中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此能力由獨立的外部服務提供，不在此連線的聊天請求中。"
          }
        }
      }
    },
