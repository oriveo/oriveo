        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您即將使用 %@"
          }
        }
      }
    },
    "Your message will be sent to %@ to generate a response. Oriveo does not store your messages or API keys on our servers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إرسال رسالتك إلى %@ لإنشاء الرد. لا تقوم Oriveo بتخزين رسائلك أو مفاتيح واجهة برمجة التطبيقات (API) على خوادمنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachricht wird an %@ gesendet, um eine Antwort zu generieren. Oriveo speichert Ihre Nachrichten oder API-Schlüssel nicht auf unseren Servern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message will be sent to %@ to generate a response. Oriveo does not store your messages or API keys on our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su mensaje será enviado a %@ para generar una respuesta. Oriveo no almacena sus mensajes ni claves API en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message sera envoyé à %@ pour générer une réponse. Oriveo ne stocke pas vos messages ni clés API sur nos serveurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिक्रिया उत्पन्न करने के लिए आपका संदेश %@ पर भेजा जाएगा। ओरिवियो आपके संदेशों या एपीआई कुंजियों को हमारे सर्वर पर संग्रहीत नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan Anda akan dikirim ke %@ untuk menghasilkan respons. Oriveo tidak menyimpan pesan atau kunci API Anda di server kami."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは %@ に送信され、応答が生成されます。 Oriveo は、メッセージや API キーをサーバーに保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답을 생성하기 위해 귀하의 메시지가 %@(으)로 전송됩니다. Oriveo는 귀하의 메시지나 API 키를 당사 서버에 저장하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem será enviada para %@ para gerar uma resposta. A Oriveo não armazena suas mensagens ou chaves de API em nossos servidores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение будет отправлено на адрес %@ для получения ответа. Oriveo не хранит ваши сообщения или ключи API на наших серверах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณจะถูกส่งไปยัง %@ เพื่อสร้างการตอบกลับ Oriveo จะไม่จัดเก็บข้อความหรือคีย์ API ของคุณบนเซิร์ฟเวอร์ของเรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınız yanıt oluşturmak için %@ adresine gönderilecek. Oriveo mesajlarınızı veya API anahtarlarınızı sunucularımızda saklamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của bạn sẽ được gửi tới %@ để tạo phản hồi. Oriveo không lưu trữ tin nhắn hoặc khóa API của bạn trên máy chủ của chúng tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的消息将发送至 %@ 以生成回复。 Oriveo 不会在我们的服务器上存储您的消息或 API 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的訊息將發送至 %@ 以產生回應。 Oriveo 不會在我們的伺服器上儲存您的訊息或 API 金鑰。"
          }
        }
      }
    },
    "Your message will be sent to the custom endpoint you've configured. Oriveo cannot verify the privacy practices of third-party endpoints.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إرسال رسالتك إلى نقطة النهاية المخصصة التي قمت بتكوينها. لا تستطيع Oriveo التحقق من ممارسات الخصوصية الخاصة بنقاط نهاية الطرف الثالث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachricht wird an den benutzerdefinierten Endpunkt gesendet, den Sie konfiguriert haben. Oriveo kann die Datenschutzpraktiken von Endpunkten Dritter nicht überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message will be sent to the custom endpoint you've configured. Oriveo cannot verify the privacy practices of third-party endpoints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su mensaje se enviará al punto final personalizado que haya configurado. Oriveo no puede verificar las prácticas de privacidad de puntos finales de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message sera envoyé au point de terminaison personnalisé que vous avez configuré. Oriveo ne peut pas vérifier les pratiques de confidentialité des points de terminaison tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका संदेश आपके द्वारा कॉन्फ़िगर किए गए कस्टम एंडपॉइंट पर भेजा जाएगा। ओरिवियो तीसरे पक्ष के एंडपॉइंट की गोपनीयता प्रथाओं को सत्यापित नहीं कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan Anda akan dikirim ke titik akhir kustom yang telah Anda konfigurasi. Oriveo tidak dapat memverifikasi praktik privasi titik akhir pihak ketiga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは、構成したカスタム エンドポイントに送信されます。 Oriveo は、サードパーティのエンドポイントのプライバシー慣行を検証できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하가 구성한 사용자 정의 엔드포인트로 메시지가 전송됩니다. Oriveo는 제3자 엔드포인트의 개인정보 보호 관행을 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem será enviada para o endpoint personalizado que você configurou. A Oriveo não pode verificar as práticas de privacidade de endpoints de terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение будет отправлено на настроенную вами пользовательскую конечную точку. Oriveo не может проверять политику конфиденциальности сторонних конечных точек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณจะถูกส่งไปยังปลายทางที่กำหนดเองที่คุณได้กำหนดค่าไว้ Oriveo ไม่สามารถตรวจสอบหลักปฏิบัติด้านความเป็นส่วนตัวของอุปกรณ์ปลายทางของบุคคลที่สามได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınız yapılandırdığınız özel uç noktaya gönderilecektir. Oriveo, üçüncü taraf uç noktalarının gizlilik uygulamalarını doğrulayamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn của bạn sẽ được gửi đến điểm cuối tùy chỉnh mà bạn đã định cấu hình. Oriveo không thể xác minh các biện pháp bảo mật của thiết bị đầu cuối bên thứ ba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message will be sent to the custom endpoint you've configured. Oriveo cannot verify the privacy practices of third-party endpoints."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的訊息將傳送到您配置的自訂端點。 Oriveo 無法驗證第三方端點的隱私實務。"
          }
        }
      }
    },
