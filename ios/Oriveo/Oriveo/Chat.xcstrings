        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos cargar el historial de esta conversación. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger l'historique de cette conversation. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बातचीत का इतिहास लोड नहीं हो सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat memuat riwayat percakapan ini. Periksa koneksi Anda dan coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話の履歴を読み込めませんでした。接続を確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화의 기록을 불러오지 못했습니다. 연결을 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar o histórico desta conversa. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить историю этого разговора. Проверьте подключение и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถโหลดประวัติของการสนทนานี้ได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
