        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường tùy chỉnh cần lược đồ trường chính thức cho đúng mô hình và phương thức truyền này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义字段需要该模型与传输方式的官方字段 schema。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂欄位需要該模型與傳輸方式的官方欄位 schema。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom fields need an official field schema for this exact model and transport."
          }
        }
      }
    },
    "Custom is selected but empty, so messages using this control will fail to send.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار «مخصص» لكنه فارغ، لذا ستفشل الرسائل التي تستخدم هذا العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Benutzerdefiniert“ ist gewählt, aber leer – Nachrichten mit diesem Steuerelement schlagen fehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está seleccionado «Personalizado» pero vacío, así que los mensajes que usen este control fallarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Personnalisé » est sélectionné mais vide : les messages utilisant ce contrôle échoueront."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम चुना गया है पर खाली है, इसलिए इस नियंत्रण वाले संदेश नहीं भेजे जा सकेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustom dipilih tetapi kosong, sehingga pesan yang memakai kontrol ini akan gagal terkirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムが選択されていますが空のため、このコントロールを使うメッセージは送信に失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정이 선택됐지만 비어 있어, 이 컨트롤을 쓰는 메시지는 전송에 실패합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizado está selecionado, mas vazio: mensagens que usarem este controle falharão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбран пользовательский режим, но поле пустое — сообщения с этим элементом не отправятся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกกำหนดเองแต่ยังว่าง ข้อความที่ใช้ตัวควบคุมนี้จะส่งไม่สำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel seçili ama boş; bu denetimi kullanan mesajlar gönderilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn tùy chỉnh nhưng để trống, nên tin nhắn dùng điều khiển này sẽ gửi thất bại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选自定义但内容为空，用到该控件的消息将发送失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
