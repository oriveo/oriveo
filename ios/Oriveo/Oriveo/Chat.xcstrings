    "This provider has no standard switch for thinking. Add its fields in the additional request body." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر هذا المزوّد مفتاحًا قياسيًا للتفكير. يلزم إضافة حقوله في نص الطلب الإضافي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anbieter hat keinen einheitlichen Schalter für Nachdenken. Tragen Sie seine Felder in den zusätzlichen Anfragedaten ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This provider has no standard switch for thinking. Add its fields in the additional request body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proveedor no tiene un interruptor estándar para el razonamiento. Agrega sus campos en el cuerpo de solicitud adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fournisseur n’a pas d’interrupteur standard pour la réflexion. Ajoutez ses champs dans le corps de requête supplémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोवाइडर के पास सोच का कोई मानक स्विच नहीं है। इसके फ़ील्ड अतिरिक्त अनुरोध बॉडी में जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia ini tidak punya sakelar standar untuk berpikir. Tambahkan kolomnya di isi permintaan tambahan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロバイダーには思考の共通スイッチがありません。追加リクエストボディにプロバイダー独自のフィールドを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 제공업체에는 사고용 표준 스위치가 없어요. 추가 요청 본문에 해당 제공업체의 필드를 넣어 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este provedor não tem um controle padrão para raciocínio. Adicione os campos dele no corpo adicional da requisição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого провайдера нет стандартного переключателя размышления. Добавьте его поля в дополнительное тело запроса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ให้บริการรายนี้ไม่มีสวิตช์มาตรฐานสำหรับการคิด โปรดเพิ่มฟิลด์ของผู้ให้บริการรายนี้ในเนื้อหาคำขอเพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sağlayıcının düşünme için standart bir anahtarı yok. Gerekli alanları ek istek gövdesine ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp này không có công tắc chuẩn cho suy nghĩ. Hãy thêm các trường riêng của nhà cung cấp vào nội dung yêu cầu bổ sung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
