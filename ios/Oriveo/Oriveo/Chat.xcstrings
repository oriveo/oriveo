        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ được gửi khi %@ cũng được đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
