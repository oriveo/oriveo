    "memory_inbox_auto_suggest_footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، تتحول التفضيلات الدائمة مثل «أجب دائمًا بالعربية» إلى اقتراحات، ولا يُحفظ شيء قبل مراجعتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Option an, werden dauerhafte Vorgaben wie „Antworte ab jetzt immer auf Deutsch“ zu Vorschlägen, die du vor dem Speichern prüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, lasting preferences like “Always reply in English” become suggestions you review before anything is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las indicaciones duraderas como «Respóndeme siempre en español» se convierten en sugerencias que revisas antes de guardar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l'option est activée, les consignes durables comme « Réponds toujours en français » deviennent des suggestions, enregistrées seulement après votre validation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर, “हमेशा हिंदी में जवाब देना” जैसी स्थायी पसंद सुझाव के रूप में दिखेगी, और आपकी पुष्टि के बाद ही सहेजी जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aktif, preferensi jangka panjang seperti “Mulai sekarang selalu jawab dalam bahasa Indonesia” akan menjadi saran yang Anda tinjau sebelum disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、「これからは日本語で答えて」のような継続的な指示が提案として表示され、確認したものだけが保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 “앞으로는 한국어로 답해 줘” 같은 장기적인 요청이 제안으로 표시되고, 확인한 뒤에만 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, pedidos duradouros como “Responda sempre em português” viram sugestões que você revisa antes de serem salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, долгосрочные просьбы вроде «Всегда отвечай на русском» становятся предложениями — сохраняется только то, что вы подтвердите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด คำขอระยะยาวอย่าง “ต่อไปนี้ตอบเป็นภาษาไทยเสมอ” จะแสดงเป็นรายการแนะนำ และจะบันทึกก็ต่อเมื่อคุณยืนยันแล้วเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken “Bundan sonra hep Türkçe cevap ver” gibi kalıcı istekler öneri olarak gelir; siz onaylamadan hiçbir şey kaydedilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các yêu cầu lâu dài như “Từ giờ luôn trả lời bằng tiếng Việt” sẽ thành gợi ý, và chỉ được lưu khi bạn xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，像“以后都用中文回答”这样的长期约定会生成建议，你确认后才会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，像「以後都用中文回答」這樣的長期約定會產生建議，你確認後才會儲存。"
          }
        }
      }
    },
