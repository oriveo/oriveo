    "When on, the model searches the web when it helps before answering.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the model searches the web when it helps before answering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，模型会在需要时搜索网页再回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，模型會在需要時搜尋網頁再回答。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、モデルは必要に応じてウェブを検索してから回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 모델이 필요할 때 웹을 검색한 뒤 답변합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, el modelo busca en la web cuando lo necesita antes de responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, le modèle cherche sur le web si besoin avant de répondre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, sucht das Modell bei Bedarf im Web, bevor es antwortet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o modelo busca na web quando necessário antes de responder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، يبحث النموذج في الويب عند الحاجة قبل الإجابة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करने पर, मॉडल ज़रूरत पड़ने पर उत्तर से पहले वेब खोजता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat aktif, model mencari di web bila perlu sebelum menjawab."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, mô hình sẽ tìm kiếm trên web khi cần trước khi trả lời."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด โมเดลจะค้นเว็บเมื่อจำเป็นก่อนตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken model, gerektiğinde yanıtlamadan önce webde arama yapar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, модель при необходимости ищет в интернете перед ответом."
          }
        }
      }
    },
