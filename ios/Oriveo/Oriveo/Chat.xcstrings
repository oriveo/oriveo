    "Or just ask something in the box on the left — the new conversation opens right here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اكتب سؤالك في الحقل على اليمين، وستفتح المحادثة الجديدة هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder stell links einfach eine Frage — die neue Unterhaltung öffnet sich hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or just ask something in the box on the left — the new conversation opens right here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escribe lo que quieras en el campo de la izquierda: la nueva conversación se abrirá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou posez simplement une question dans le champ à gauche : la nouvelle conversation s’ouvrira ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या बाईं ओर के बॉक्स में कुछ भी पूछ लें — नई बातचीत यहीं खुलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau tanyakan apa saja di kotak sebelah kiri — percakapan baru terbuka di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の入力欄に何か聞いてみても大丈夫です。新しい会話はここに開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 입력창에 무엇이든 물어보세요. 새 대화가 여기에 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pergunte algo no campo à esquerda — a nova conversa abre aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или просто спросите что-нибудь в поле слева — новый разговор откроется здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือพิมพ์ถามอะไรก็ได้ในช่องด้านซ้าย บทสนทนาใหม่จะเปิดขึ้นที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da soldaki alana bir şey sor — yeni sohbet burada açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc cứ hỏi gì đó ở khung bên trái — cuộc trò chuyện mới sẽ mở ra ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者直接在左边的输入框里问点什么，新会话会在这里展开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者直接在左邊的輸入框問點什麼，新對話就會在這裡展開。"
          }
        }
      }
    },
    "Oriveo decides how the reply is streamed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد Oriveo طريقة بث الرد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie die Antwort gestreamt wird, legt Oriveo fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo decides how the reply is streamed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo decide cómo se transmite la respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo décide de la façon dont la réponse est diffusée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब किस तरह स्ट्रीम होगा, यह Oriveo तय करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cara balasan dialirkan ditentukan oleh Oriveo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返答のストリーミング方法は Oriveo が決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변을 어떻게 스트리밍할지는 Oriveo가 정해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Oriveo decide como a resposta é transmitida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как передавать ответ потоком, решает Oriveo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo เป็นผู้กำหนดวิธีสตรีมคำตอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtın nasıl akış halinde geleceğine Oriveo karar verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo quyết định cách truyền phát câu trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复怎么流式返回由 Oriveo 决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆的串流方式由 Oriveo 決定。"
          }
        }
      }
    },
    "Oriveo doesn’t have thinking settings for this model yet, so it runs on its own default." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر في Oriveo بعدُ إعدادات التفكير لهذا النموذج، لذا يعمل بإعداده الافتراضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Modell hat Oriveo noch keine Einstellungen zum Nachdenken, daher läuft es mit seinem eigenen Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo doesn’t have thinking settings for this model yet, so it runs on its own default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo aún no tiene ajustes de razonamiento para este modelo, así que usa sus propios valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo n’a pas encore de réglages de réflexion pour ce modèle : il fonctionne donc avec ses propres valeurs par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo में इस मॉडल की सोच सेटिंग्स अभी नहीं हैं, इसलिए यह अपने डिफ़ॉल्ट पर चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo belum punya pengaturan berpikir untuk model ini, jadi model memakai bawaannya sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルの思考設定はまだ Oriveo に登録されていないため、モデル本来のデフォルトで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo에 아직 이 모델의 사고 설정이 없어서 모델 자체 기본값으로 동작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Oriveo ainda não tem configurações de raciocínio para este modelo, então ele usa o próprio padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Oriveo пока нет настроек размышления для этой модели, поэтому она работает со своими значениями по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo ยังไม่มีการตั้งค่าการคิดสำหรับโมเดลนี้ จึงทำงานตามค่าเริ่มต้นของโมเดลเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oriveo'da bu model için henüz düşünme ayarı yok, bu yüzden model kendi varsayılanıyla çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
