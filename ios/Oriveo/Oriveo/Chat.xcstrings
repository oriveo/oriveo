        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские поля требуют официальной схемы для этой модели и транспорта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟิลด์ที่กำหนดเองต้องมีสคีมาฟิลด์อย่างเป็นทางการสำหรับโมเดลและทรานสปอร์ตนี้"
          }
