    "memory_extraction_no_fallback" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا فشل الطلب، فلن يُستخدَم مزوّد آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt die Anfrage fehl, wird kein anderer Anbieter verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the request fails, no other provider will be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la solicitud falla, no se usará otro proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la requête échoue, aucun autre fournisseur ne sera utilisé."
