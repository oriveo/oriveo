    "context_confirm_price_line_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبلغ هذا الطلب نحو %1$@ رمز، متجاوزًا عتبة السعر لدى %2$@ عند %3$@، لذا يُحتسب الطلب كاملًا بسعر السياق الطويل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage hat etwa %1$@ Token und liegt über der Preisschwelle von %3$@ bei %2$@. Daher wird die gesamte Anfrage zum Langkontext-Preis abgerechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request is about %1$@ tokens, past the %3$@ threshold for %2$@, so the whole request is billed at the long-context rate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud tiene unos %1$@ tokens y supera el umbral de precio de %2$@, fijado en %3$@, así que toda la solicitud se cobra al precio de contexto largo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette requête fait environ %1$@ tokens et dépasse le seuil tarifaire fixé à %3$@ pour %2$@ : toute la requête est donc facturée au tarif de contexte long."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह अनुरोध लगभग %1$@ टोकन का है और %2$@ की %3$@ वाली ऊँची दर की रेखा से ऊपर है, इसलिए पूरे अनुरोध का बिल लॉन्ग कॉन्टेक्स्ट की दर से बनेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ini sekitar %1$@ token, melewati ambang harga %2$@ di %3$@, sehingga seluruh permintaan dikenai harga konteks panjang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回のリクエストは約 %1$@ トークンで、%2$@ の割増ライン %3$@ を超えるため、リクエスト全体がロングコンテキスト料金になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 요청은 약 %1$@ 토큰으로 %2$@의 %3$@ 할증 기준선을 넘어서, 요청 전체에 긴 컨텍스트 요금이 적용돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitação tem cerca de %1$@ tokens e passa do patamar de preço de %2$@, que é de %3$@, então a solicitação inteira é cobrada pelo preço de contexto longo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом запросе около %1$@ токенов — это выше ценового порога %2$@ (%3$@), поэтому весь запрос оплачивается по тарифу для длинного контекста."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอนี้ประมาณ %1$@ โทเค็น เกินเกณฑ์ขึ้นราคา %3$@ ของ %2$@ จึงคิดราคาบริบทยาวกับทั้งคำขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu istek yaklaşık %1$@ token ve %2$@ için %3$@ fiyat eşiğini aşıyor; bu yüzden isteğin tamamı uzun bağlam fiyatından ücretlendirilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu lần này khoảng %1$@ token, vượt ngưỡng tăng giá %3$@ của %2$@, nên cả yêu cầu bị tính theo giá ngữ cảnh dài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次约 %1$@ token，超过 %2$@ 的 %3$@ 加价线，整个请求按长上下文价计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這次約 %1$@ token，超過 %2$@ 的 %3$@ 加價門檻，整筆請求按長上下文價格計費。"
          }
        }
      }
    },
