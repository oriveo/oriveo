    "The partial reply has been kept. Regenerate to request a fresh full answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الاحتفاظ بالرد الجزئي. أعد الإنشاء لطلب إجابة كاملة جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
