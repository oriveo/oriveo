    "Enter a number. This setting won’t be sent until it’s fixed; your other settings aren’t affected." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إدخال رقم. لن يُرسل هذا الإعداد حتى يُصحَّح، ولا تتأثر الإعدادات الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine Zahl ein. Bis zur Korrektur wird diese Einstellung nicht gesendet; Ihre übrigen Einstellungen sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a number. This setting won’t be sent until it’s fixed; your other settings aren’t affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un número. Este ajuste no se enviará hasta que lo corrijas; tus otros ajustes no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nombre. Ce réglage ne sera pas envoyé tant qu’il n’est pas corrigé ; vos autres réglages ne sont pas concernés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई संख्या दर्ज करें। ठीक होने तक यह सेटिंग नहीं भेजी जाएगी; आपकी बाकी सेटिंग्स पर कोई असर नहीं पड़ेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan angka. Pengaturan ini tidak akan dikirim sampai diperbaiki; pengaturan lain tidak terpengaruh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数値を入力してください。修正するまでこの設定は送信されませんが、ほかの設定には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자를 입력해 주세요. 고치기 전까지 이 설정은 보내지 않으며, 다른 설정에는 영향이 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um número. Esta configuração não será enviada até ser corrigida; suas outras configurações não são afetadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите число. Пока значение не исправлено, эта настройка не отправляется; на остальные настройки это не влияет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดป้อนตัวเลข การตั้งค่านี้จะไม่ถูกส่งจนกว่าจะแก้ไข และไม่กระทบการตั้งค่าอื่นของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sayı girin. Düzeltilene kadar bu ayar gönderilmez; diğer ayarlarınız etkilenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhập một số. Cài đặt này sẽ không được gửi cho đến khi được sửa; các cài đặt khác không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里要填数字。改好前这一项先不发送，其它设置不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡要填數字。修正前這一項先不傳送，其他設定不受影響。"
          }
        }
