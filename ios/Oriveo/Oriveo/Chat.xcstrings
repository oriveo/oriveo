        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст только что сжат. Использование обновится после вашего следующего сообщения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่งย่อบริบทไป การใช้งานจะอัปเดตหลังจากคุณส่งข้อความถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlam az önce sıkıştırıldı. Kullanım, bir sonraki mesajınızdan sonra güncellenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
