    "memory_inbox_footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الاقتراحات على هذا الجهاز فقط وتُحذف تلقائيًا بعد 30 يومًا، ولا تصبح جزءًا من الذاكرة إلا بعد حفظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge bleiben nur auf diesem Gerät und werden nach 30 Tagen automatisch gelöscht. Ins Gedächtnis kommen sie erst, wenn du sie speicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions stay on this device and are cleared after 30 days. They become memories only when you save them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias se quedan solo en este dispositivo y se borran automáticamente a los 30 días. Solo pasan a tu memoria cuando las guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suggestions restent sur cet appareil et sont effacées automatiquement au bout de 30 jours. Elles ne rejoignent votre mémoire que si vous les enregistrez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव सिर्फ़ इसी डिवाइस पर रहते हैं और 30 दिन बाद अपने आप हट जाते हैं। आप जिन्हें सहेजेंगे, सिर्फ़ वही मेमोरी में जुड़ेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saran hanya disimpan di perangkat ini dan otomatis dihapus setelah 30 hari. Hanya saran yang Anda simpan yang masuk ke memori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提案はこの端末にだけ保存され、30日後に自動で削除されます。保存したものだけがメモリーになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안은 이 기기에만 보관되고 30일 후 자동으로 삭제돼요. 저장한 제안만 메모리에 추가돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sugestões ficam só neste dispositivo e são apagadas automaticamente após 30 dias. Elas só entram na sua memória quando você as salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложения хранятся только на этом устройстве и удаляются через 30 дней. В память попадают только те, что вы сохраните."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการที่แนะนำจะเก็บไว้ในเครื่องนี้เท่านั้นและลบอัตโนมัติเมื่อครบ 30 วัน จะกลายเป็นความจำก็ต่อเมื่อคุณบันทึกแล้วเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öneriler yalnızca bu cihazda tutulur ve 30 gün sonra otomatik olarak silinir. Yalnızca kaydettikleriniz belleğe eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gợi ý chỉ được giữ trên thiết bị này và tự động xóa sau 30 ngày. Chỉ những gợi ý bạn lưu mới được đưa vào bộ nhớ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议只保存在这台设备上，30 天后自动清除；保存后才会成为记忆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建議只會儲存在這台裝置上，30 天後自動清除；儲存後才會成為記憶。"
          }
        }
      }
    },
