          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình dừng ngay khi viết ra bất kỳ chuỗi nào trong số này. Một chuỗi có thể chứa dấu phẩy, khoảng trắng và dấu xuống dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
