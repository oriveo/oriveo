        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks baru saja dipadatkan. Penggunaan diperbarui setelah Anda mengirim pesan berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストを整理したばかりです。次のメッセージを送ると使用量が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트를 방금 정리했어요. 다음 메시지를 보내면 사용량이 업데이트돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O contexto acabou de ser condensado. O uso será atualizado depois da sua próxima mensagem."
