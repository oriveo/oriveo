        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada masalah di isi permintaan tambahan, jadi sakelar ini tidak bisa mengubahnya. Perbaiki di sana dulu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加リクエストボディに問題があるため、このスイッチでは変更できません。先にそちらで修正してください。"
