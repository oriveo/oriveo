    "Keeps the randomness of the output steady around a target, in place of Top K and Top P." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي عشوائية المخرجات ثابتة حول قيمة مستهدفة، بدلًا من Top K وTop P."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Zufälligkeit der Ausgabe stabil um einen Zielwert – anstelle von Top K und Top P."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the randomness of the output steady around a target, in place of Top K and Top P."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene estable la aleatoriedad de la salida en torno a un objetivo, en lugar de Top K y Top P."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient le caractère aléatoire de la sortie autour d’une valeur cible, à la place de Top K et Top P."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आउटपुट की रैंडमनेस को एक लक्ष्य के आसपास स्थिर रखता है; Top K और Top P की जगह इस्तेमाल होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaga tingkat keacakan output tetap stabil di sekitar target, sebagai pengganti Top K dan Top P."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出力のランダムさを目標値の付近に保ちます。Top K と Top P の代わりに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출력의 무작위성을 목표값 근처로 유지해요. Top K와 Top P 대신 쓰여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a aleatoriedade da saída estável em torno de um alvo, no lugar de Top K e Top P."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживает случайность вывода около целевого уровня — вместо Top K и Top P."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รักษาระดับความสุ่มของผลลัพธ์ให้คงที่ใกล้ค่าเป้าหมาย ใช้แทน Top K และ Top P"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top K ve Top P yerine, çıktının rastgeleliğini bir hedef değer etrafında sabit tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ độ ngẫu nhiên của đầu ra ổn định quanh một mức mục tiêu, thay cho Top K và Top P."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动把输出的随机程度稳在一个目标上，代替 Top K 和 Top P。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動將輸出的隨機程度穩定在目標值附近，取代 Top K 與 Top P。"
          }
        }
      }
    },
