    "This model isn’t accepting “%1$@” right now, so it’s back on “%2$@”. The level will return on its own once the model supports it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقبل هذا النموذج «%1$@» حاليًا، لذا أُعيد إلى «%2$@». سيعود هذا المستوى تلقائيًا عندما يدعمه النموذج مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell akzeptiert „%1$@“ derzeit nicht, daher ist wieder „%2$@“ aktiv. Die Stufe kehrt von selbst zurück, sobald das Modell sie wieder unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This model isn’t accepting “%1$@” right now, so it’s back on “%2$@”. The level will return on its own once the model supports it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo no acepta «%1$@» por ahora, así que volvió a «%2$@». El nivel se restablecerá solo cuando el modelo vuelva a admitirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce modèle n’accepte pas « %1$@ » pour le moment, il est donc revenu à « %2$@ ». Le niveau reviendra de lui-même dès que le modèle le prendra de nouveau en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मॉडल अभी “%1$@” स्वीकार नहीं कर रहा, इसलिए इसे “%2$@” पर वापस कर दिया गया है। मॉडल के फिर से सपोर्ट करने पर यह स्तर अपने आप लौट आएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model ini sedang tidak menerima “%1$@”, jadi kembali ke “%2$@”. Tingkat tersebut akan kembali sendiri saat model mendukungnya lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルは現在「%1$@」を受け付けていないため、「%2$@」に戻しました。モデルが再び対応すると、このレベルは自動で元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델이 지금은 ‘%1$@’ 단계를 받지 않아 ‘%2$@’ 단계로 되돌렸어요. 모델이 다시 지원하면 원래 단계로 자동으로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo não está aceitando “%1$@” agora, então voltou para “%2$@”. O nível volta sozinho quando o modelo passar a aceitá-lo de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта модель сейчас не принимает «%1$@», поэтому снова выбран уровень «%2$@». Прежний уровень вернётся сам, как только модель снова начнёт его поддерживать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะนี้โมเดลนี้ไม่รับ “%1$@” จึงกลับไปใช้ “%2$@” ระดับเดิมจะกลับมาเองเมื่อโมเดลรองรับอีกครั้ง"
