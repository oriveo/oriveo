    "This note will be permanently deleted and can't be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف هذه الملاحظة نهائيًا ولا يمكن استعادتها."
