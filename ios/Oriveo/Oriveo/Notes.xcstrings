          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long press a note to restore or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada una nota para restaurarla o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une note pour la restaurer ou la supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट को पुनर्स्थापित या हटाने के लिए उसे देर तक दबाएं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
