    "Use another model once, then save both sources as a note." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم نموذجًا آخر مرة واحدة، ثم احفظ المصدرين في ملاحظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze einmal ein anderes Modell und speichere danach beide Quellen als Notiz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use another model once, then save both sources as a note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa otro modelo una vez y guarda ambas fuentes como una nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un autre modèle une fois, puis enregistrez les deux sources dans une note."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार दूसरा मॉडल उपयोग करें, फिर दोनों स्रोतों को नोट के रूप में सहेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan model lain sekali, lalu simpan kedua sumber sebagai catatan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のモデルを一度使い、両方の出典をノートとして保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 모델을 한 번 사용한 뒤 두 출처를 노트로 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use outro modelo uma vez e salve as duas fontes como nota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один раз используйте другую модель, затем сохраните оба источника как заметку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้โมเดลอื่นหนึ่งครั้ง แล้วบันทึกทั้งสองแหล่งเป็นโน้ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir modeli bir kez kullan, sonra iki kaynağı da not olarak kaydet."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng một mô hình khác một lần, rồi lưu cả hai nguồn thành ghi chú."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一个模型核对一次，再把双来源保存成笔记。"
