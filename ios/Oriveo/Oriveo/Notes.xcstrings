    "The note moves to Trash and can be restored later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note moves to Trash and can be restored later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记会移入回收站，之后仍可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記會移入回收站，之後仍可還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートはゴミ箱に移動し、後で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트는 휴지통으로 이동하며 나중에 복원할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota se moverá a la papelera y podrás restaurarla después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note sera déplacée dans la corbeille et pourra être restaurée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz wird in den Papierkorb verschoben und kann später wiederhergestellt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota vai para a lixeira e poderá ser restaurada depois."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتقل الملاحظة إلى سلة المهملات ويمكن استعادتها لاحقًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट ट्रैश में चला जाएगा और बाद में बहाल किया जा सकेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan dipindahkan ke Sampah dan bisa dipulihkan nanti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметка будет перемещена в корзину, ее можно восстановить позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตจะถูกย้ายไปถังขยะและกู้คืนได้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not çöp kutusuna taşınır ve daha sonra geri yüklenebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú sẽ chuyển vào thùng rác và có thể khôi phục sau."
          }
        }
      }
    },
