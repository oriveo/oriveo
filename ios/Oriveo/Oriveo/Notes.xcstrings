    "It may have been deleted or not synced to this device yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have been deleted or not synced to this device yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被删除，或还没有同步到这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被刪除，或尚未同步到這台裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたか、このデバイスにまだ同期されていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되었거나 아직 이 기기에 동기화되지 않았을 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haberse eliminado o aún no haberse sincronizado en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a peut-être été supprimée ou pas encore synchronisée sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde möglicherweise gelöscht oder noch nicht synchronisiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela pode ter sido excluída ou ainda não sincronizada neste dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما حُذفت أو لم تتم مزامنتها مع هذا الجهاز بعد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हटाया गया हो सकता है या अभी इस डिवाइस पर सिंक नहीं हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin sudah dihapus atau belum tersinkron ke perangkat ini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она могла быть удалена или еще не синхронизирована."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจถูกลบหรือยังไม่ได้ซิงก์มายังอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinmiş ya da bu cihaza henüz eşitlenmemiş olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú có thể đã bị xóa hoặc chưa đồng bộ lên thiết bị này."
          }
        }
      }
    },
