          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートを長押しすると復元または削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 길게 누르면 복원하거나 삭제할 수 있습니다."
          }
