    "This model is currently unavailable from the provider. Switch models or try again later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا النموذج غير متاح حاليًا لدى المزود. بدّل النموذج أو حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
