    "Restore providers, models, and chats from a local encrypted backup.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة المزوّدين والنماذج والمحادثات من نسخة احتياطية محلية مشفرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Anbieter, Modelle und Chats aus einem lokalen, verschlüsselten Backup wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure proveedores, modelos y chats desde una copia de seguridad cifrada local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez les fournisseurs, les modèles et les discussions à partir d'une sauvegarde chiffrée locale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय एन्क्रिप्टेड बैकअप से प्रदाताओं, मॉडलों और चैट को पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan penyedia, model, dan obrolan dari cadangan terenkripsi lokal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの暗号化されたバックアップからプロバイダー、モデル、チャットを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 암호화 백업에서 제공업체, 모델 및 채팅을 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure provedores, modelos e chats a partir de um backup local criptografado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите поставщиков, модели и чаты из локальной зашифрованной резервной копии."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนผู้ให้บริการ โมเดล และการแชทจากการสำรองข้อมูลที่เข้ารหัสในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcıları, modelleri ve sohbetleri yerel şifreli bir yedekten geri yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục nhà cung cấp, mô hình và cuộc trò chuyện từ bản sao lưu được mã hóa cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地加密备份恢复服务商、模型和对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
