    "Start with a quick prompt or ask anything you want to figure out.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسؤال سريع أو اسأل عن أي شيء تريد معرفته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
