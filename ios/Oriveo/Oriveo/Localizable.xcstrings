        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكلفة تقديرية بناءً على الأسعار العامة للنماذج. الفواتير الفعلية تتبع مزود الترحيل لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kosten werden anhand öffentlicher Modellpreise geschätzt. Die tatsächliche Abrechnung erfolgt durch Ihren Relay-Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost is estimated using public model pricing. Actual billing follows your relay provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El coste es una estimación según los precios oficiales del modelo. La facturación real sigue a tu proveedor de relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coût est estimé à partir des prix publics du modèle. La facturation réelle suit votre fournisseur relais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लागत सार्वजनिक मॉडल मूल्य से अनुमानित है। वास्तविक बिलिंग आपके रिले प्रदाता पर आधारित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya diestimasi dari harga model publik. Tagihan sesungguhnya mengikuti penyedia relai Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金はモデルの公開価格で見積もっており、実際の請求はリレー業者に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비용은 공식 모델 가격으로 추정되며 실제 청구는 릴레이 공급자를 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo é estimado com base nos preços públicos do modelo. A cobrança real segue seu provedor de relay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоимость рассчитана по публичным ценам модели. Фактический счёт выставляет ваш relay-провайдер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าใช้จ่ายเป็นการประมาณตามราคาทางการของโมเดล การเรียกเก็บจริงขึ้นอยู่กับผู้ให้บริการรีเลย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maliyet, modelin genel fiyatlarına göre tahminidir. Gerçek faturalandırma relay sağlayıcınıza bağlıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi phí được ước tính theo giá công khai của mô hình. Hoá đơn thực tế dựa vào nhà cung cấp relay của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用按官方模型定价估算，实际计费以中转商账单为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用按官方模型定價估算，實際計費以中轉商帳單為準。"
          }
        }
      }
    },
