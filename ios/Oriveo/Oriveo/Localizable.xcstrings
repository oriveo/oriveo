    "Paste your config.toml content. We'll detect endpoint, model, transport, reasoning, and image capability.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق محتوى config.toml الخاص بك. سنكتشف endpoint، النموذج، transport، الاستدلال، وإمكانية الصور تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen config.toml-Inhalt ein. Wir erkennen Endpoint, Modell, Transport, Reasoning und Bildfunktion automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste your config.toml content. We'll detect endpoint, model, transport, reasoning, and image capability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el contenido de tu config.toml. Detectaremos el endpoint, el modelo, el transport, el reasoning y la capacidad de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le contenu de votre config.toml. Nous détecterons endpoint, modèle, transport, reasoning et capacité d'image."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना config.toml सामग्री पेस्ट करें। हम endpoint, मॉडल, transport, reasoning और इमेज क्षमता का पता लगाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel konten config.toml Anda. Kami akan mendeteksi endpoint, model, transport, reasoning, dan kemampuan gambar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config.toml の内容を貼り付けてください。endpoint、モデル、transport、reasoning、画像対応を自動識別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "config.toml 내용을 붙여넣으세요. endpoint, 모델, transport, reasoning, 이미지 기능을 자동 감지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o conteúdo do seu config.toml. Detectaremos endpoint, modelo, transport, reasoning e capacidade de imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте содержимое config.toml. Мы определим endpoint, модель, transport, reasoning и поддержку изображений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางเนื้อหา config.toml ของคุณ เราจะตรวจหา endpoint, โมเดล, transport, reasoning และความสามารถด้านรูปภาพให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "config.toml içeriğini yapıştırın. endpoint, model, transport, reasoning ve görsel desteğini otomatik algılayacağız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán nội dung config.toml. Chúng tôi sẽ nhận diện endpoint, model, transport, reasoning và khả năng xử lý hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的 config.toml 内容，我们会自动识别 endpoint、模型、协议、推理和图片能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的 config.toml 內容，我們會自動辨識 endpoint、模型、協議、推理與圖片能力。"
          }
        }
      }
    },
