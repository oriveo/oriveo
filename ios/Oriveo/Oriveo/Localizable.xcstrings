        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーがこのメッセージに対するアシスタントの内容を返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공업체가 이 메시지에 대한 어시스턴트 콘텐츠를 반환하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor não retornou conteúdo do assistente para esta mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик не возвратил содержимого помощника для этого сообщения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการไม่ได้ส่งคืนเนื้อหาผู้ช่วยสำหรับข้อความนี้"
          }
        },
        "tr": {
