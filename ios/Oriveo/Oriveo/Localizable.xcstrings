          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりでいいよ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 해도 돼"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pressa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не торопись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องรีบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acele etme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứ thong thả."
          }
        },
        "zh-Hans": {
