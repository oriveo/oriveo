          "stringUnit": {
            "state": "translated",
            "value": "बातचीत शुरू करने के लिए कम से कम एक AI प्रदाता आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memerlukan setidaknya satu penyedia AI untuk memulai percakapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を始めるには AI プロバイダが少なくとも 1 つ必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 시작하려면 AI 제공업체가 최소 하나 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa de pelo menos um provedor de IA para iniciar uma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для начала разговора нужен хотя бы один AI-провайдер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องมีผู้ให้บริการ AI อย่างน้อยหนึ่งรายเพื่อเริ่มการสนทนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbete başlamak için en az bir yapay zekâ sağlayıcısı gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần ít nhất một nhà cung cấp AI để bắt đầu trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一个 AI 供应商才能开始对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要一個 AI 供應商才能開始對話。"
          }
        }
      }
    },
