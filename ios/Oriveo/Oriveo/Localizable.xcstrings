    "Choose a provider first, then enter the API key below to continue.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مزوّدًا أولاً، ثم أدخل مفتاح API أدناه للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zunächst einen Anbieter aus und gib dann unten den API-Schlüssel ein, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elija un proveedor, luego ingrese la clave API a continuación para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d'abord un fournisseur, puis entrez la clé API ci-dessous pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक प्रदाता चुनें, फिर जारी रखने के लिए नीचे API दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih penyedia terlebih dahulu, lalu masukkan API di bawah untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初にプロバイダーを選択し、次に以下の APIキーを入力して続行します。"
