        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активная сессия изменилась во время импорта. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันที่ใช้งานเปลี่ยนไประหว่างการนำเข้า โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma sırasında etkin oturum değişti. Lütfen yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên hoạt động đã thay đổi trong khi nhập. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入过程中当前会话发生了变化。请重试。"
