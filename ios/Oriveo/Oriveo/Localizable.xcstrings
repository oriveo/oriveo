    "This model will call a dedicated image endpoint. Make sure your relay exposes /images/generations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستدعي هذا النموذج نقطة نهاية صور مخصصة. تأكد من أن Relay الخاص بك يكشف عن /images/generations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell ruft einen dedizierten Bild-Endpunkt auf. Stelle sicher, dass dein Relay /images/generations bereitstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo llamará a un endpoint de imagen dedicado. Asegúrate de que tu relé exponga /images/generations."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle appellera un point d'accès image dédié. Vérifie que ton relais expose /images/generations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल एक समर्पित इमेज एंडपॉइंट को कॉल करेगा। सुनिश्चित करें कि आपका रिले /images/generations को उजागर करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini akan memanggil endpoint gambar khusus. Pastikan relay Anda mengekspos /images/generations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは専用の画像エンドポイントを呼び出します。Relay が /images/generations を公開していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 전용 이미지 엔드포인트를 호출합니다. Relay가 /images/generations를 노출하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo chamará um endpoint de imagem dedicado. Certifique-se de que seu relay expõe /images/generations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель будет обращаться к выделенной точке генерации изображений. Убедитесь, что ваш Relay предоставляет /images/generations."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลนี้จะเรียกใช้ endpoint สำหรับรูปภาพโดยเฉพาะ ตรวจสอบให้แน่ใจว่า Relay ของคุณเปิด /images/generations"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model, özel bir görsel uç noktasını çağıracak. Relay'inizin /images/generations sunduğundan emin olun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này sẽ gọi một endpoint tạo ảnh chuyên biệt. Đảm bảo Relay của bạn cung cấp /images/generations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模型将调用专用的图片接口,请确认你的 Relay 暴露了 /images/generations。"
