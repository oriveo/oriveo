    "This relay does not expose /images/generations. For Codex-style relays, switch the transport to OpenAI Responses so that the inline image tool route is used.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكشف هذا الوصل عن /images/generations. لوصلات نمط Codex، بدّل النقل إلى OpenAI Responses لاستخدام مسار أداة الصور المدمجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Relay stellt /images/generations nicht bereit. Für Codex-ähnliche Relays wechsle den Transport zu OpenAI Responses, damit die Inline-Bild-Tool-Route verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay does not expose /images/generations. For Codex-style relays, switch the transport to OpenAI Responses so that the inline image tool route is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay no expone /images/generations. Para relays tipo Codex, cambia el transporte a OpenAI Responses para usar la ruta de la herramienta de imagen inline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce relais n'expose pas /images/generations. Pour les relais de style Codex, passez le transport à OpenAI Responses pour utiliser la route de l'outil d'image intégré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिले /images/generations को एक्सपोज़ नहीं करता। Codex-style रिले के लिए, ट्रांसपोर्ट को OpenAI Responses में बदलें ताकि इनलाइन इमेज टूल रूट उपयोग हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay ini tidak menyediakan /images/generations. Untuk relay bergaya Codex, ubah transport ke OpenAI Responses agar rute tool gambar inline digunakan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Relay は /images/generations を公開していません。Codex 系中継では transport を OpenAI Responses に切り替えてインライン画像ツールを利用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴레이는 /images/generations 엔드포인트를 제공하지 않습니다. Codex 스타일 릴레이라면 전송을 OpenAI Responses로 바꿔 인라인 이미지 도구 경로를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay não expõe /images/generations. Para relays no estilo Codex, mude o transporte para OpenAI Responses para usar a rota de ferramenta de imagem inline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот relay не предоставляет /images/generations. Для relays в стиле Codex переключите transport на OpenAI Responses, чтобы использовать встроенный инструмент изображения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์นี้ไม่เปิดเผย /images/generations สำหรับรีเลย์แบบ Codex ให้เปลี่ยน transport เป็น OpenAI Responses เพื่อใช้เส้นทางเครื่องมือสร้างภาพแบบอินไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu relay /images/generations uç noktasını sunmuyor. Codex tarzı relay'ler için transport'u OpenAI Responses olarak değiştirerek satır içi görüntü aracı yolunu kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay này không cung cấp /images/generations. Với các relay kiểu Codex, hãy đổi transport sang OpenAI Responses để dùng tuyến công cụ ảnh inline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此中转站未暴露 /images/generations 端点。若是 Codex 风格中转，请将传输协议切换到 OpenAI Responses，以走内联图片工具路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此中轉站未暴露 /images/generations 端點。若為 Codex 風格中轉，請將傳輸協定切換到 OpenAI Responses，以走內嵌圖片工具路徑。"
          }
        }
      }
    },
    "This relay has no chat model yet. Add one first so Oriveo can drive image generation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الوصل على نموذج محادثة بعد. أضف واحدًا أولًا حتى يتمكن Oriveo من تشغيل إنشاء الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Relay hat noch kein Chat-Modell. Füge zuerst eines hinzu, damit Oriveo die Bilderzeugung treiben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay has no chat model yet. Add one first so Oriveo can drive image generation."
          }
        },
        "es": {
