    "For security reasons, verify your email with a 6-digit code to continue.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأسباب أمنية، تحقق من بريدك الإلكتروني برمز من 6 أرقام للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige aus Sicherheitsgründen deine E-Mail mit einem 6-stelligen Code, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security reasons, verify your email with a 6-digit code to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, verifica tu correo con un código de 6 dígitos para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour des raisons de sécurité, vérifiez votre e-mail avec un code à 6 chiffres pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा कारणों से, जारी रखने के लिए 6 अंकों के कोड से अपना ईमेल सत्यापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demi keamanan, verifikasi email Anda dengan kode 6 digit untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティのため、6 桁のコードでメールを確認してから続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안을 위해 6자리 코드로 이메일을 인증한 후 계속하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, verifique seu e-mail com um código de 6 dígitos para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности подтвердите почту 6-значным кодом, чтобы продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อความปลอดภัย โปรดยืนยันอีเมลด้วยรหัส 6 หลักเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik nedeniyle devam etmek için e-postanı 6 haneli kodla doğrula."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì lý do bảo mật, hãy xác minh email bằng mã 6 chữ số để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出于安全考虑，请用 6 位验证码验证邮箱后继续。"
          }
        },
        "zh-Hant": {
