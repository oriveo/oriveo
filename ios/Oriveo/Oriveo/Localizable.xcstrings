        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने %@ के वर्तमान संदर्भ के आधार पर एक प्रतिक्रिया का मसौदा तैयार किया है जिसे आप दोहराना जारी रख सकते हैं:\\n\\n- पहले समस्या को तीन सबसे महत्वपूर्ण निर्णयों में विभाजित करें।\\n- एक कार्रवाई योग्य पहले चरण से शुरू करें ताकि आप आगे बढ़ सकें।\\n- यदि आप चाहें, तो मैं इसे अधिक विस्तृत चेकलिस्ट, कॉपी या अगले कोड में बदल सकता हूं।\\n\\nआपका नवीनतम संदेश था: %@"
          }
