    "Incorrect password. API keys were not restored, but you can still import without keys.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة مرور غير صحيحة. لم تتم استعادة مفاتيح واجهة برمجة التطبيقات، ولكن لا يزال بإمكانك الاستيراد بدون مفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsches Passwort. API-Schlüssel wurden nicht wiederhergestellt, Sie können jedoch weiterhin ohne Schlüssel importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña incorrecta. Las claves API no se restauraron, pero aún puedes importarlas sin claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe incorrect. Les clés API n'ont pas été restaurées, mais vous pouvez toujours importer sans clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत पासवर्ड। API को पुनर्स्थापित नहीं किया गया, लेकिन आप अभी भी चाबियों के बिना आयात कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi salah. API tidak dipulihkan, namun Anda masih dapat mengimpor tanpa kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが間違っています。 API キーは復元されませんでしたが、キーなしでもインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 잘못되었습니다. API 키가 복원되지 않았지만 키 없이도 가져올 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha incorreta. As chaves de API não foram restauradas, mas você ainda pode importar sem chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неправильный пароль. API не восстановились, но импортировать без ключей все равно можно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านไม่ถูกต้อง API ไม่ได้รับการกู้คืน แต่คุณยังสามารถนำเข้าได้โดยไม่ต้องใช้คีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış şifre. API geri yüklenmedi ancak yine de anahtarlar olmadan içe aktarabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu không chính xác. API chưa được khôi phục nhưng bạn vẫn có thể nhập mà không cần khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码错误。API 密钥未恢复，但你仍可以不含密钥的方式导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼不正確。 API 金鑰未恢復，但您仍可以在沒有金鑰的情況下匯入。"
          }
        }
      }
    },
    "Incorrect password. Please try again or skip to import without keys.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور غير صحيحة. حاول مرة أخرى أو تخطَّ للاستيراد بدون المفاتيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsches Passwort. Versuche es erneut oder überspringe, um ohne Schlüssel zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect password. Please try again or skip to import without keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña incorrecta. Inténtalo de nuevo u omite para importar sin claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe incorrect. Réessayez ou ignorez pour importer sans les clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत पासवर्ड। फिर से प्रयास करें या कुंजियों के बिना आयात करने के लिए छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi salah. Coba lagi atau lewati untuk mengimpor tanpa kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが正しくありません。もう一度お試しになるか、キーを取り込まずにスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 올바르지 않습니다. 다시 시도하거나 키 없이 가져오려면 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha incorreta. Tente novamente ou pule para importar sem as chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль. Повторите попытку или пропустите, чтобы импортировать без ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านไม่ถูกต้อง โปรดลองอีกครั้งหรือข้ามเพื่อนำเข้าโดยไม่มีคีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola yanlış. Yeniden deneyin veya anahtarlar olmadan içe aktarmak için atlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu không đúng. Hãy thử lại hoặc bỏ qua để nhập mà không có khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不正确。请重试，或跳过以在不导入密钥的情况下继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼不正確。請重試，或略過以在不匯入金鑰的情況下繼續。"
          }
        }
      }
    },
