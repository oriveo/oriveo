    "Pick the type that matches your relay provider's protocol. You can change it later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر النوع الذي يطابق بروتوكول مزود الرحال لديك. يمكنك تغييره لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Typ, der zum Protokoll Ihres Relay-Anbieters passt. Sie können dies später ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el tipo que coincida con el protocolo de tu proveedor de relay. Puedes cambiarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le type correspondant au protocole de votre fournisseur de relais. Vous pouvez changer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह प्रकार चुनें जो आपके relay प्रदाता के प्रोटोकॉल से मेल खाता हो। आप बाद में इसे बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis yang sesuai dengan protokol penyedia relay Anda. Anda dapat mengubahnya nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay プロバイダのプロトコルに合う種類を選んでください。あとから変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay 공급자의 프로토콜에 맞는 유형을 선택하세요. 나중에 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o tipo que corresponde ao protocolo do seu provedor de relay. Você pode mudar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тип, соответствующий протоколу вашего провайдера relay. Это можно изменить позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเภทที่ตรงกับโปรโตคอลของผู้ให้บริการ Relay เปลี่ยนภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay sağlayıcınızın protokolüne uygun türü seçin. Daha sonra değiştirebilirsiniz."
          }
