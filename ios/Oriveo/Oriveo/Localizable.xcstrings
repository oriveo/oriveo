    "You can let it rest.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن ينتظر قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es kurz ruhen lassen."
