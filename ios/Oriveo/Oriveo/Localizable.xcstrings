    "These appear as quick-tap buttons on the Skill's chat page. Users can tap to instantly start a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر كأزرار نقر سريع في صفحة المحادثة. يمكن للمستخدمين النقر لبدء محادثة فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden als Schnelltipp-Buttons auf der Skill-Chatseite angezeigt. Zum sofortigen Gesprächsstart antippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran como botones de toque rápido en la página del Skill. Los usuarios tocan para iniciar la conversación al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichées comme boutons de saisie rapide sur la page du Skill. Les utilisateurs appuient pour démarrer une conversation instantanément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये स्किल के चैट पेज पर क्विक-टैप बटन के रूप में दिखाई देते हैं। उपयोगकर्ता तुरंत बातचीत शुरू करने के लिए टैप कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini muncul sebagai tombol ketuk cepat di halaman obrolan Skill. Pengguna dapat mengetuk untuk memulai percakapan secara instan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキルのチャットページにクイックタップボタンとして表示されます。タップするだけで会話を始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬의 채팅 페이지에 빠른 탭 버튼으로 표시됩니다. 탭하면 바로 대화를 시작할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibidas como botões de toque rápido na página do Skill. Toque para iniciar uma conversa instantaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они отображаются в виде кнопок быстрого нажатия на странице чата навыка. Пользователи могут нажать, чтобы мгновенно начать разговор."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งเหล่านี้จะปรากฏเป็นปุ่มแตะด่วนบนหน้าแชทของทักษะ ผู้ใช้สามารถแตะเพื่อเริ่มการสนทนาได้ทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar Skill'in sohbet sayfasında hızlı dokunma düğmeleri olarak görünür. Kullanıcılar anında bir konuşma başlatmak için dokunabilirler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng xuất hiện dưới dạng các nút nhấn nhanh trên trang trò chuyện của Kỹ năng. Người dùng có thể nhấn để bắt đầu cuộc trò chuyện ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在技能对话页面的快捷按钮，用户点击即可快速开始对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在技能對話頁面的快捷按鈕，使用者點擊即可快速開始對話。"
          }
        }
      }
    },
