    "Your draft and generated content have been preserved. You can continue or resend.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفاظ على المسودة والمحتوى الذي تم إنشاؤه. يمكنك الاستمرار أو إعادة الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Entwurf und deine generierten Inhalte wurden beibehalten. Sie können fortfahren oder erneut senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han conservado el borrador y el contenido generado. Puedes continuar o reenviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre brouillon et votre contenu généré ont été conservés. Vous pouvez continuer ou renvoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ड्राफ्ट और उत्पन्न सामग्री संरक्षित कर ली गई है। आप जारी रख सकते हैं या पुनः भेज सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf dan konten yang Anda buat telah disimpan. Anda dapat melanjutkan atau mengirim ulang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きと生成されたコンテンツは保存されています。続行または再送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안과 생성된 콘텐츠는 보존되었습니다. 계속하거나 다시 보낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu rascunho e conteúdo gerado foram preservados. Você pode continuar ou reenviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш черновик и созданный контент были сохранены. Вы можете продолжить или отправить повторно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาฉบับร่างและเนื้อหาที่สร้างขึ้นของคุณได้รับการเก็บรักษาไว้ คุณสามารถดำเนินการต่อหรือส่งใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslağınız ve oluşturulan içeriğiniz korundu. Devam edebilir veya yeniden gönderebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung nháp và nội dung được tạo của bạn đã được giữ nguyên. Bạn có thể tiếp tục hoặc gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的草稿和生成内容已保留。你可以继续或重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的草稿和產生的內容已被保留。你可以繼續或重新發送。"
          }
        }
      }
    },
