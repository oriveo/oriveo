    "This Skill needs an available AI provider before it can start a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المهارة إلى مزوّد ذكاء اصطناعي متاح قبل بدء محادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Skill benötigt einen verfügbaren KI-Anbieter, bevor eine Unterhaltung gestartet werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Skill needs an available AI provider before it can start a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta habilidad necesita un proveedor de IA disponible antes de iniciar una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette compétence nécessite un fournisseur IA disponible avant de lancer une conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत शुरू करने से पहले इस कौशल के लिए उपलब्ध AI प्रदाता चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill ini memerlukan penyedia AI yang tersedia sebelum memulai percakapan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を開始する前に、利用可能な AI プロバイダーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 시작하려면 먼저 사용 가능한 AI 공급자를 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Skill precisa de um provedor de IA disponível antes de iniciar uma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого навыка нужен доступный AI-провайдер перед началом диалога."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทักษะนี้ต้องมีผู้ให้บริการ AI ที่พร้อมใช้งานก่อนเริ่มการสนทนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Beceri, sohbet başlatmadan önce kullanılabilir bir AI sağlayıcısına ihtiyaç duyar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỹ năng này cần một nhà cung cấp AI khả dụng trước khi bắt đầu trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能需要先有一个可用的 AI 供应商，才能开始对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能需要先有一個可用的 AI 供應商，才能開始對話。"
          }
        }
      }
    },
    "This conversation and all its messages will be permanently deleted.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف هذه المحادثة وجميع رسائلها نهائياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gespräch und alle Nachrichten werden dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación y todos sus mensajes se eliminarán permanentemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation et tous ses messages seront supprimés définitivement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वार्तालाप और इसके सभी संदेश स्थायी रूप से हटा दिए जाएंगे."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan ini dan semua pesan di dalamnya akan dihapus secara permanen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話とすべてのメッセージが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화와 모든 메시지가 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa e todas as suas mensagens serão excluídas permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот разговор и все его сообщения будут удалены без возможности восстановления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนานี้และข้อความทั้งหมดในการสนทนาจะถูกลบอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüşme ve tüm mesajları kalıcı olarak silinecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này và tất cả tin nhắn trong đó sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话及其所有消息将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話及其所有訊息將被永久刪除。"
          }
        }
      }
    },
    "This is scaffolding for the error flow; the real import pipeline will be connected next.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وهذا بمثابة السقالات لتدفق الأخطاء؛ سيتم توصيل خط أنابيب الاستيراد الحقيقي بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Gerüst für den Fehlerfluss; Als nächstes wird die eigentliche Importpipeline angeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es un andamiaje para el flujo de errores; A continuación se conectará el flujo de importación real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’un échafaudage pour le flux d’erreurs ; le véritable pipeline d’importation sera ensuite connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह त्रुटि प्रवाह के लिए मचान है; वास्तविक आयात पाइपलाइन को आगे जोड़ा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah perancah untuk aliran kesalahan; pipa impor sebenarnya akan dihubungkan selanjutnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはエラー フローの足場です。次に実際のインポート パイプラインが接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 오류 흐름을 위한 발판입니다. 실제 가져오기 파이프라인은 다음에 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é uma estrutura para o fluxo de erros; o pipeline de importação real será conectado a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это основа потока ошибок; Реальный импортный трубопровод будет подключен следующим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการนั่งร้านสำหรับโฟลว์ข้อผิดพลาด ไปป์ไลน์นำเข้าจริงจะเชื่อมต่อกันต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, hata akışının iskelesidir; gerçek ithalat boru hattı bundan sonra bağlanacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là giàn giáo cho luồng lỗi; đường ống nhập khẩu thực sự sẽ được kết nối tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是错误流程的脚手架；实际的导入管道将在后续接入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是錯誤流的腳手架；接下來將連接真正的匯入管道。"
          }
        }
      }
    },
    "This model is currently unavailable from the provider. Switch models or try again later.": {
      "extractionState": "manual",
