          "stringUnit": {
            "state": "translated",
            "value": "Search every message requires an official recipe for this connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Siempre» requiere una receta oficial para esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À chaque fois » nécessite une recette officielle pour cette connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"हर बार\" के लिए इस कनेक्शन की आधिकारिक रेसिपी आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Setiap kali\" memerlukan resep resmi untuk koneksi ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「毎回」にはこの接続の公式レシピが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"항상\"을 사용하려면 이 연결의 공식 레시피가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Sempre\" requer uma receita oficial para esta conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Каждый раз» требует официального рецепта для этого подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ทุกครั้ง\" ต้องใช้สูตรอย่างเป็นทางการสำหรับการเชื่อมต่อนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Her seferinde\" bu bağlantı için resmi bir tarif gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Mỗi lần\" cần có công thức chính thức cho kết nối này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「每条消息都搜索」需要此连接的官方配方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「每則訊息都搜尋」需要此連線的官方配方。"
          }
        }
      }
    },
