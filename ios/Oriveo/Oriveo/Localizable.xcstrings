    "One day reached %@, %.0f%% above your median of %@. Check what triggered the spike — long reasoning tasks or large attachments often drive these.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One day reached %@, %.0f%% above your median of %@. Check what triggered the spike — long reasoning tasks or large attachments often drive these."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某一天的花费达到 %1$@，比你的中位数 %3$@ 高出 %2$.0f%%。可以查一下原因——长推理任务或大附件常是元凶。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某一天的花費達到 %1$@，比你的中位數 %3$@ 高出 %2$.0f%%。可以查一下原因——長推理任務或大附件常是元兇。"
          }
        }
      }
    },
