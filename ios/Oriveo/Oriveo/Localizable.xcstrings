    "Add a provider API key to send messages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح API لمزوّد حتى تتمكن من إرسال الرسائل."
          }
        },
        "de": {
          "stringUnit": {
