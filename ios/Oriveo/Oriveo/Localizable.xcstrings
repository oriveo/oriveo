    "Pick what this default model can do. You can adjust this later in the model details.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يمكن لهذا النموذج الافتراضي القيام به. يمكنك تعديل ذلك لاحقًا في تفاصيل النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, was dieses Standardmodell kann. Sie können dies später in den Modelldetails anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige lo que este modelo predeterminado puede hacer. Puedes ajustarlo más tarde en los detalles del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que ce modèle par défaut peut faire. Vous pourrez l'ajuster plus tard dans les détails du modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यह डिफ़ॉल्ट मॉडल क्या कर सकता है। आप बाद में मॉडल विवरण में इसे समायोजित कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang dapat dilakukan oleh model default ini. Anda dapat menyesuaikannya nanti di detail model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデフォルトモデルで使う機能を選びます。後でモデル詳細から調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기본 모델이 할 수 있는 것을 선택하세요. 나중에 모델 세부 정보에서 조정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que este modelo padrão pode fazer. Você pode ajustar isso depois nos detalhes do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что может эта модель по умолчанию. Это можно настроить позже в деталях модели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าโมเดลเริ่มต้นนี้ทำอะไรได้บ้าง ปรับภายหลังได้ในรายละเอียดโมเดล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu varsayılan modelin neler yapabileceğini seçin. Daha sonra model detaylarında ayarlayabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những gì mô hình mặc định này có thể làm. Bạn có thể điều chỉnh sau trong chi tiết mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选默认模型支持的能力，之后可以在模型详情中调整。"
