          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un prompt rápido o pregunta lo que quieras saber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par un prompt rapide ou posez n'importe quelle question."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित संकेत से शुरुआत करें या जो कुछ भी आप जानना चाहते हैं उससे पूछें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
