    "This Skill needs an available AI provider before it can start a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المهارة إلى مزوّد ذكاء اصطناعي متاح قبل بدء محادثة."
          }
        },
        "de": {
          "stringUnit": {
