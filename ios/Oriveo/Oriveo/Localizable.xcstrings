          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此中转尚无聊天模型，请先添加一个，Oriveo 才能驱动图片生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此中轉尚無聊天模型，請先添加一個，Oriveo 才能驅動圖片生成。"
          }
        }
      }
    },
    "This relay only accepts the Codex CLI client. Oriveo has already sent the Codex identity; if it still fails, please switch to another relay or contact its administrator.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل هذا الوصل عميل Codex CLI فقط. أرسل Oriveo بالفعل هوية Codex؛ إذا استمر الفشل فبدّل إلى وصل آخر أو راجع مديره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Relay akzeptiert nur den Codex-CLI-Client. Oriveo hat die Codex-Identität bereits gesendet; falls es trotzdem fehlschlägt, wechsle das Relay oder wende dich an den Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay only accepts the Codex CLI client. Oriveo has already sent the Codex identity; if it still fails, please switch to another relay or contact its administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay solo acepta el cliente Codex CLI. Oriveo ya envió la identidad de Codex; si sigue fallando, cambia de relay o contacta con su administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce relais n'accepte que le client Codex CLI. Oriveo a déjà envoyé l'identité Codex ; s'il échoue toujours, changez de relais ou contactez l'administrateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिले केवल Codex CLI क्लाइंट स्वीकार करता है। Oriveo पहले ही Codex पहचान भेज चुका है; फिर भी विफल हो तो कोई और रिले आज़माएँ या एडमिन से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay ini hanya menerima klien Codex CLI. Oriveo sudah mengirim identitas Codex; jika tetap gagal, pindah ke relay lain atau hubungi administratornya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Relay は Codex CLI クライアントしか受け付けません。Oriveo はすでに Codex の識別情報を送信しました；それでも失敗する場合は別の Relay に切り替えるか管理者に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴레이는 Codex CLI 클라이언트만 허용합니다. Oriveo는 이미 Codex 신원을 보냈으니, 계속 실패하면 다른 릴레이로 바꾸거나 관리자에게 문의하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay só aceita o cliente Codex CLI. O Oriveo já enviou a identidade Codex; se ainda falhar, troque de relay ou fale com o administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это relay принимает только клиент Codex CLI. Oriveo уже отправил идентификатор Codex; если он по-прежнему недоступен, переключитесь на другой relay или свяжитесь с администратором."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์นี้อนุญาตเฉพาะไคลเอนต์ Codex CLI เท่านั้น Oriveo ได้ส่งข้อมูลประจำตัว Codex ไปแล้ว หากยังล้มเหลวให้เปลี่ยนไปใช้รีเลย์อื่นหรือติดต่อผู้ดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu relay yalnızca Codex CLI istemcisini kabul eder. Oriveo zaten Codex kimliğini gönderdi; yine başarısız olursa başka bir relay'e geçin veya yöneticisine başvurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay này chỉ chấp nhận khách Codex CLI. Oriveo đã gửi định danh Codex; nếu vẫn thất bại, hãy chuyển sang relay khác hoặc liên hệ quản trị viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此中转站只接受 Codex CLI 客户端。Oriveo 已以 Codex 身份发起请求；若仍失败，请更换中转站或联系其管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此中轉站只接受 Codex CLI 客戶端。Oriveo 已以 Codex 身份發起請求；若仍失敗，請更換中轉站或聯繫其管理員。"
          }
        }
      }
    },
    "This relay rejected the request even after Oriveo sent the expected client identity. The account may be unauthorized for this service or rate-limited. Please switch to another relay or contact its administrator.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض هذا الوصل الطلب حتى بعد أن أرسل Oriveo هوية العميل المتوقعة. قد يكون الحساب غير مخوّل لهذه الخدمة أو محدود المعدل. يرجى التبديل إلى وصل آخر أو الاتصال بمديره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Relay hat die Anfrage abgelehnt, obwohl Oriveo die erwartete Client-Identität gesendet hat. Das Konto ist möglicherweise nicht autorisiert oder rate-limitiert. Bitte wechsle zu einem anderen Relay oder kontaktiere den Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay rejected the request even after Oriveo sent the expected client identity. The account may be unauthorized for this service or rate-limited. Please switch to another relay or contact its administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay rechazó la solicitud aunque Oriveo envió la identidad de cliente esperada. La cuenta puede no estar autorizada para este servicio o estar limitada. Cambia de relay o contacta con su administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce relais a refusé la requête même après qu'Oriveo a envoyé l'identité de client attendue. Le compte peut ne pas être autorisé pour ce service ou être limité. Changez de relais ou contactez l'administrateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo द्वारा अपेक्षित क्लाइंट पहचान भेजने के बाद भी इस रिले ने अनुरोध अस्वीकार कर दिया। खाता अनधिकृत या दर-सीमित हो सकता है। कृपया कोई अन्य रिले चुनें या व्यवस्थापक से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay ini menolak permintaan meski Oriveo sudah mengirim identitas klien yang diharapkan. Akun mungkin tidak diizinkan atau dibatasi rate. Silakan pilih relay lain atau hubungi admin-nya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo がクライアント情報を送信済みにもかかわらず、この Relay はリクエストを拒否しました。アカウントの権限不足または Rate-limit の可能性があります。別の Relay に切り替えるか、管理者に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo가 예상된 클라이언트 신원을 보냈는데도 이 릴레이가 요청을 거부했습니다. 계정이 인증되지 않았거나 속도 제한일 수 있습니다. 다른 릴레이로 전환하거나 관리자에게 문의하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relay rejeitou a requisição mesmo depois do Oriveo enviar a identidade de cliente esperada. A conta pode não estar autorizada ou estar com limite de taxa. Troque de relay ou fale com o administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это реле отклонило запрос даже после того, как Oriveo отправил ожидаемую идентификацию клиента. Аккаунт может быть не авторизован или лимитирован. Смените реле или свяжитесь с администратором."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเลย์นี้ปฏิเสธคำขอแม้ว่า Oriveo จะส่งข้อมูลระบุตัวตนไคลเอนต์แล้ว บัญชีอาจไม่ได้รับอนุญาตหรือถูกจำกัดอัตรา กรุณาสลับรีเลย์หรือติดต่อผู้ดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo beklenen istemci kimliğini gönderdiği halde bu relay isteği reddetti. Hesap yetkilendirilmemiş veya hız sınırlı olabilir. Başka bir relay'e geçin veya yöneticiyle iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay này vẫn từ chối yêu cầu dù Oriveo đã gửi định danh khách mong muốn. Tài khoản có thể chưa được phép hoặc bị giới hạn tốc độ. Hãy đổi relay khác hoặc liên hệ quản trị viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此中转站在 Oriveo 已发送预期客户端身份后仍拒绝请求。账号可能未授权或被限流。请更换中转站或联系其管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此中轉站在 Oriveo 已發送預期客戶端身份後仍拒絕請求。帳號可能未授權或被限流。請更換中轉站或聯繫其管理員。"
          }
        }
      }
    },
    "This relay style cannot return generated images. Use OpenAI / Codex / Gemini compatible relay if you need image generation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نمط الرحال هذا لا يمكنه إرجاع الصور المنشأة. استخدم رحالًا متوافقًا مع OpenAI / Codex / Gemini إذا كنت تحتاج إلى إنشاء الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Relay-Stil kann keine generierten Bilder zurückgeben. Verwenden Sie OpenAI / Codex / Gemini-kompatibles Relay, wenn Sie Bildgenerierung benötigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de relay no puede devolver imágenes generadas. Usa un relay compatible con OpenAI / Codex / Gemini si necesitas generación de imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce type de relais ne peut pas renvoyer d'images générées. Utilisez un relais compatible OpenAI / Codex / Gemini si vous avez besoin de générer des images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह relay प्रकार जनरेट किए गए चित्र वापस नहीं कर सकता। यदि आपको चित्र जनरेशन चाहिए तो OpenAI / Codex / Gemini संगत relay का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaya relay ini tidak dapat mengembalikan gambar yang dihasilkan. Gunakan relay yang kompatibel dengan OpenAI / Codex / Gemini jika Anda membutuhkan pembuatan gambar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Relay スタイルでは生成画像を返せません。画像生成が必要な場合は OpenAI / Codex / Gemini 互換の Relay を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴레이 방식은 생성된 이미지를 반환할 수 없습니다. 이미지 생성이 필요하면 OpenAI / Codex / Gemini 호환 릴레이를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estilo de relay não pode retornar imagens geradas. Use um relay compatível com OpenAI / Codex / Gemini se você precisar gerar imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот стиль relay не может возвращать сгенерированные изображения. Используйте relay, совместимый с OpenAI / Codex / Gemini, если вам нужна генерация изображений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay สไตล์นี้คืนรูปภาพที่สร้างไม่ได้ หากต้องการสร้างรูปภาพให้ใช้ Relay ที่เข้ากันได้กับ OpenAI / Codex / Gemini"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu relay tarzı oluşturulan resimleri döndüremez. Resim üretimi gerekiyorsa OpenAI / Codex / Gemini uyumlu relay kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểu relay này không thể trả về ảnh được tạo. Hãy dùng relay tương thích OpenAI / Codex / Gemini nếu bạn cần tạo ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该协议不支持图片生成；如需生图请改用 OpenAI / Codex / Gemini 兼容协议的中转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此協定不支援圖片生成；如需產生圖片請改用 OpenAI / Codex / Gemini 相容協定的中轉。"
          }
        }
      }
    },
    "This transport does not support image generation. Switch to OpenAI Responses or Chat Completions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم بروتوكول النقل هذا إنشاء الصور. بدّل إلى OpenAI Responses أو Chat Completions."
