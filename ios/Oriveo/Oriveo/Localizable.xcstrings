    "Subscriptions renew automatically unless canceled at least 24 hours before the period ends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجدد الاشتراكات تلقائيًا ما لم يتم إلغاؤها قبل 24 ساعة على الأقل من نهاية الفترة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless canceled at least 24 hours before the period ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes de que finalice el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode berakhir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは期間終了の24時間前までにキャンセルしない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 기간 종료 최소 24시간 전까지 취소하지 않으면 자동 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas renovam automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически, если не отменены минимум за 24 часа до окончания периода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบบิล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, dönem bitmeden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký tự động gia hạn trừ khi được hủy ít nhất 24 giờ trước khi kỳ hiện tại kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订，除非在周期结束前至少 24 小时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，除非在週期結束前至少 24 小時取消。"
          }
        }
      }
    },
