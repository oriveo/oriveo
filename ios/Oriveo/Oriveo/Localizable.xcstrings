    "We couldn't parse this as TOML or JSON. Double-check the format and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحليل المحتوى كـ TOML أو JSON. يُرجى التحقق من التنسيق والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht als TOML oder JSON geparst werden. Überprüfe das Format und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't parse this as TOML or JSON. Double-check the format and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo analizar como TOML o JSON. Revisa el formato e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'analyser comme TOML ou JSON. Vérifie le format et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे TOML या JSON के रूप में पार्स नहीं किया जा सका। फ़ॉर्मेट जाँचें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memparsing sebagai TOML atau JSON. Periksa format lalu coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TOML または JSON として解析できません。フォーマットを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TOML 또는 JSON으로 분석할 수 없습니다. 형식을 확인 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível analisar como TOML ou JSON. Verifique o formato e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разобрать как TOML или JSON. Проверьте формат и попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแยกวิเคราะห์เป็น TOML หรือ JSON ได้ ตรวจสอบรูปแบบแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TOML veya JSON olarak ayrıştırılamadı. Biçimi kontrol edip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể phân tích thành TOML hoặc JSON. Kiểm tra định dạng và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析为 TOML 或 JSON，请检查格式后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析為 TOML 或 JSON。請檢查格式後再試一次。"
          }
        }
      }
    },
    "We couldn't recognize this as a supported cc-switch import. Paste a Codex, Claude, or Gemini provider config.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التعرف عليه كـ cc-switch مدعوم. الصق إعدادات provider لـ Codex أو Claude أو Gemini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht als unterstützter cc-switch-Import erkannt werden. Füge eine Codex-, Claude- oder Gemini-Provider-Konfiguration ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't recognize this as a supported cc-switch import. Paste a Codex, Claude, or Gemini provider config."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció como una importación de cc-switch compatible. Pega una configuración de proveedor Codex, Claude o Gemini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reconnaître un import cc-switch pris en charge. Collez une configuration de provider Codex, Claude ou Gemini."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे समर्थित cc-switch आयात के रूप में नहीं पहचाना जा सका। Codex, Claude या Gemini provider config पेस्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat dikenali sebagai impor cc-switch yang didukung. Tempel konfigurasi provider Codex, Claude, atau Gemini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされている cc-switch インポートとして認識できません。Codex / Claude / Gemini の provider 設定を貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 cc-switch 가져오기로 인식할 수 없습니다. Codex / Claude / Gemini provider 구성을 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reconhecer como uma importação cc-switch compatível. Cole uma configuração de provedor Codex, Claude ou Gemini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось распознать как поддерживаемый импорт cc-switch. Вставьте конфигурацию provider'а Codex, Claude или Gemini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดจำเป็น cc-switch ที่รองรับไม่ได้ กรุณาวางการตั้งค่า provider ของ Codex / Claude / Gemini"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir cc-switch içe aktarması olarak tanınmadı. Codex, Claude veya Gemini provider yapılandırması yapıştırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhận diện được là import cc-switch được hỗ trợ. Dán cấu hình provider Codex, Claude hoặc Gemini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别为受支持的 cc-switch 配置。请粘贴 Codex、Claude 或 Gemini 的 provider 配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別為支援的 cc-switch 匯入。請貼上 Codex、Claude 或 Gemini 供應商配置。"
          }
        }
      }
    },
    "We couldn't verify that code. Please request a new one and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من هذا الرمز. يرجى طلب رمز جديد والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten diesen Code nicht bestätigen. Fordere einen neuen an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify that code. Please request a new one and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar ese código. Solicita uno nuevo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu vérifier ce code. Demandez-en un nouveau et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम उस कोड को सत्यापित नहीं कर सके। कृपया नया कोड मांगें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat memverifikasi kode itu. Minta kode baru dan coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコードを確認できませんでした。新しいコードを取得してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 코드를 확인하지 못했습니다. 새 코드를 요청한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar esse código. Solicite um novo e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить этот код. Запросите новый и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราไม่สามารถยืนยันรหัสนั้นได้ โปรดขอรหัสใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kodu doğrulayamadık. Yeni bir kod isteyip yeniden dene."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không xác minh được mã đó. Hãy yêu cầu mã mới và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证该验证码，请重新获取后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證該驗證碼，請重新取得後再試。"
          }
        }
      }
    },
    "We couldn't verify the connection. You can retry from the provider details.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من الاتصال. يمكنك إعادة المحاولة من تفاصيل المزوّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung konnte nicht verifiziert werden. Sie können es in den Anbieterdetails erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la conexión. Puedes reintentarlo desde los detalles del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu vérifier la connexion. Vous pouvez réessayer depuis les détails du fournisseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम कनेक्शन सत्यापित नहीं कर सके। आप प्रदाता विवरण से पुनः प्रयास कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat memverifikasi koneksi. Anda dapat mencoba lagi dari detail penyedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認できませんでした。プロバイダーの詳細から再試行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인할 수 없습니다. 공급자 세부 정보에서 다시 시도할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a conexão. Você pode tentar novamente nos detalhes do provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подключение. Вы можете повторить попытку в сведениях о поставщике."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจสอบการเชื่อมต่อได้ คุณสามารถลองใหม่ได้จากรายละเอียดผู้ให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı doğrulanamadı. Sağlayıcı ayrıntılarından yeniden deneyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không thể xác minh kết nối. Bạn có thể thử lại từ chi tiết nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能验证连接，可稍后在供应商详情页重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能驗證連線，可稍後在供應商詳情頁重試。"
          }
        }
      }
    },
    "We found a legacy linking email. Enter the address that received it to finish linking.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجدنا رسالة ربط قديمة. أدخل العنوان الذي استلمها لإكمال الربط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben eine alte Verknüpfungs-E-Mail gefunden. Gib die Adresse ein, die sie erhalten hat, um die Verknüpfung abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found a legacy linking email. Enter the address that received it to finish linking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos un correo de vinculación anterior. Ingresa la dirección que lo recibió para completar la vinculación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé un ancien e-mail d'association. Saisissez l'adresse qui l'a reçu pour terminer l'association."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें एक पुराना लिंकिंग ईमेल मिला। लिंक करना पूरा करने के लिए वह पता दर्ज करें जिसे यह मिला था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menemukan email penautan lama. Masukkan alamat yang menerimanya untuk menyelesaikan penautan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の連携メールが見つかりました。それを受け取ったアドレスを入力して連携を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 연결 이메일을 찾았습니다. 해당 메일을 받은 주소를 입력해 연결을 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos um e-mail de vinculação antigo. Digite o endereço que o recebeu para concluir a vinculação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдено старое письмо для привязки. Введите адрес, на который оно пришло, чтобы завершить привязку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบอีเมลเชื่อมโยงแบบเดิม กรอกที่อยู่ที่ได้รับอีเมลเพื่อเชื่อมโยงให้เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir bağlama e-postası bulduk. Bağlamayı tamamlamak için e-postayı alan adresi gir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi tìm thấy một email liên kết cũ. Nhập địa chỉ đã nhận email để hoàn tất liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到一封旧版关联邮件，请输入收到它的邮箱地址以完成关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到一封舊版連結郵件，請輸入收到它的電子郵件地址以完成連結。"
          }
        }
      }
    },
    "We found your linking email. Enter the address that received it to finish linking.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وجدنا البريد الإلكتروني الخاص بك لربط. أدخل العنوان الذي استلمته لإنهاء الربط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deine verlinkte E-Mail gefunden. Gib die Adresse ein, die es erhalten hat, um die Verknüpfung abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos su correo electrónico de enlace. Ingrese la dirección que lo recibió para finalizar la vinculación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé votre e-mail de lien. Entrez l'adresse qui l'a reçu pour terminer la liaison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें आपका लिंकिंग ईमेल मिल गया. वह पता दर्ज करें जिसने लिंकिंग समाप्त करने के लिए इसे प्राप्त किया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menemukan email tautan Anda. Masukkan alamat penerimanya untuk menyelesaikan penautan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクメールが見つかりました。受信したアドレスを入力してリンクを完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 이메일을 찾았습니다. 받은 주소를 입력하시면 연결이 완료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos seu e-mail de link. Digite o endereço que o recebeu para finalizar a vinculação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли ваш связывающий адрес электронной почты. Введите адрес, на который оно было получено, чтобы завершить привязку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราพบอีเมลเชื่อมโยงของคุณ ป้อนที่อยู่ที่ได้รับเพื่อลิงก์ให้เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı e-postanızı bulduk. Bağlantıyı tamamlamak için mesajı alan adresi girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã tìm thấy email liên kết của bạn. Nhập địa chỉ đã nhận được để hoàn tất liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们找到了你的关联邮件。请输入收到邮件的地址以完成关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們找到了你的連結電子郵件。輸入接收它的位址以完成連結。"
          }
        }
      }
    },
