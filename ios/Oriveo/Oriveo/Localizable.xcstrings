          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pressa, a noite é paciente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спеши, ночь терпелива."
