          "stringUnit": {
            "state": "translated",
            "value": "Contraseña incorrecta. Inténtalo de nuevo u omite para importar sin claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe incorrect. Réessayez ou ignorez pour importer sans les clés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत पासवर्ड। फिर से प्रयास करें या कुंजियों के बिना आयात करने के लिए छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi salah. Coba lagi atau lewati untuk mengimpor tanpa kunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが正しくありません。もう一度お試しになるか、キーを取り込まずにスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호가 올바르지 않습니다. 다시 시도하거나 키 없이 가져오려면 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha incorreta. Tente novamente ou pule para importar sem as chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль. Повторите попытку или пропустите, чтобы импортировать без ключей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านไม่ถูกต้อง โปรดลองอีกครั้งหรือข้ามเพื่อนำเข้าโดยไม่มีคีย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola yanlış. Yeniden deneyin veya anahtarlar olmadan içe aktarmak için atlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
