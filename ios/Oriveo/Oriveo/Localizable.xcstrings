    "The AI returned no usable content. Try again or write manually.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرجع الذكاء الاصطناعي محتوى صالحًا. حاول مجددًا أو اكتب يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat keine verwendbaren Inhalte zurückgegeben. Versuche es erneut oder schreibe manuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no devolvió contenido utilizable. Inténtalo de nuevo o escríbelo manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA n'a renvoyé aucun contenu utilisable. Réessayez ou rédigez manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI से उपयोग योग्य उत्तर नहीं मिला। पुनः प्रयास करें या स्वयं लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tidak mengembalikan konten yang bisa dipakai. Coba lagi atau tulis manual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI が利用可能な内容を返しませんでした。再試行するか手動で書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 가 사용 가능한 응답을 반환하지 않았습니다. 다시 시도하거나 직접 작성해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA não retornou conteúdo utilizável. Tente novamente ou escreva manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ не вернул пригодный ответ. Попробуйте снова или напишите вручную."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ไม่ได้ส่งคืนเนื้อหาที่ใช้ได้ ลองอีกครั้งหรือเขียนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ kullanılabilir içerik döndürmedi. Tekrar deneyin veya elle yazın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI không trả về nội dung khả dụng. Hãy thử lại hoặc tự viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 返回的内容无法使用，请重试或手动编写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 回傳的內容無法使用，請重試或手動編寫。"
          }
        }
      }
    },
    "The API key could not be validated. Check the value or generate a new key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من مفتاح API. تحقق من القيمة أو أنشئ مفتاحًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel konnte nicht validiert werden. Überprüfe den Wert oder erstelle einen neuen Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo validar la clave API. Verifica el valor o genera una nueva clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API n'a pas pu être validée. Vérifiez la valeur ou générez une nouvelle clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API को सत्यापित नहीं किया जा सका। मान जांचें या नई कुंजी बनाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "API tidak dapat divalidasi. Periksa nilainya atau buat kunci baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを検証できませんでした。値を確認するか、新しいキーを生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 검증할 수 없습니다. 값을 확인하거나 새 키를 생성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave da API não pôde ser validada. Verifique o valor ou gere uma nova chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API не удалось проверить. Проверьте значение или сгенерируйте новый ключ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API ไม่สามารถตรวจสอบได้ ตรวจสอบค่าหรือสร้างคีย์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API doğrulanamadı. Değeri kontrol edin veya yeni bir anahtar oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác thực API. Kiểm tra giá trị hoặc tạo khóa mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥验证失败。请检查密钥或生成新密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰驗證失敗。請檢查金鑰或產生新金鑰。"
          }
        }
      }
    },
    "The API key you entered did not pass validation. Check the value or generate a new key.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح مفتاح API الذي أدخلته في التحقق من الصحة. تحقق من القيمة أو قم بإنشاء مفتاح جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der von Ihnen eingegebene API-Schlüssel hat die Validierung nicht bestanden. Überprüfe den Wert oder generieren Sie einen neuen Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave API que ingresó no pasó la validación. Verifique el valor o genere una nueva clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API que vous avez saisie n'a pas été validée. Vérifiez la valeur ou générez une nouvelle clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा दर्ज किया गया API सत्यापन में सफल नहीं हुआ। मान जांचें या नई कुंजी बनाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "API yang Anda masukkan tidak lolos validasi. Periksa nilainya atau buat kunci baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した APIキーは検証に合格しませんでした。値を確認するか、新しいキーを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 API 키가 유효성 검사를 통과하지 못했습니다. 값을 확인하거나 새 키를 생성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API inserida não passou na validação. Verifique o valor ou gere uma nova chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введенный вами API не прошел проверку. Проверьте значение или сгенерируйте новый ключ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API ที่คุณป้อนไม่ผ่านการตรวจสอบ ตรวจสอบค่าหรือสร้างคีย์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğiniz API doğrulamayı geçemedi. Değeri kontrol edin veya yeni bir anahtar oluşturun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "API bạn đã nhập không vượt qua được quá trình xác thực. Kiểm tra giá trị hoặc tạo khóa mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你输入的 API 密钥未通过验证。请检查后重试或重新生成密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你輸入的 API 金鑰未通過驗證。檢查該值或產生新密鑰。"
          }
        }
      }
    },
    "The active session changed while importing. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
