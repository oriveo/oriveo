            "state": "translated",
            "value": "Lass dir Zeit, die Nacht hat Geduld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your time, the night is patient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin prisa: la noche es paciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends ton temps, la nuit est patiente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इत्मीनान से, रात धीरज रखती है।"
