    "Oriveo handles the routing automatically. Just save and use it like any other model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتولى Oriveo التوجيه تلقائيًا. احفظ واستخدمه كأي نموذج آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo übernimmt die Routen-Auswahl automatisch. Einfach speichern und wie jedes andere Modell nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo handles the routing automatically. Just save and use it like any other model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo gestiona la ruta automáticamente. Guarda y úsalo como cualquier otro modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo gère automatiquement le routage. Enregistrez et utilisez-le comme n'importe quel autre modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo रूटिंग स्वचालित रूप से संभालता है। बस सेव करें और इसे किसी अन्य मॉडल की तरह उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo menangani perutean secara otomatis. Cukup simpan dan gunakan seperti model lainnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo がルーティングを自動的に処理します。保存して通常のモデルと同様に使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo가 자동으로 라우팅을 처리합니다. 저장하고 다른 모델처럼 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oriveo cuida do roteamento automaticamente. Basta salvar e usar como qualquer outro modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo сам подбирает маршрут. Просто сохраните и используйте как любую другую модель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo จัดการเส้นทางให้อัตโนมัติ แค่บันทึกแล้วใช้งานเหมือนโมเดลอื่นได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo yönlendirmeyi otomatik halleder. Kaydedin ve diğer modeller gibi kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo tự động xử lý đường dẫn. Chỉ cần lưu và dùng như mọi mô hình khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 会自动选择路径，保存即可像其他模型一样使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 會自動選擇路徑，保存即可像其他模型一樣使用。"
          }
        }
      }
    },
    "Oriveo will pick the correct route for your relay automatically: inline image tool for Codex-style transports, or /images/generations for standard gateways.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيختار Oriveo المسار الصحيح لوصلتك تلقائيًا: أداة الصور المدمجة لنقل نمط Codex أو /images/generations للبوابات القياسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo wählt automatisch die richtige Route für dein Relay: Inline-Bild-Tool bei Codex-artigen Transporten, sonst /images/generations für Standard-Gateways."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo will pick the correct route for your relay automatically: inline image tool for Codex-style transports, or /images/generations for standard gateways."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo elegirá automáticamente la ruta correcta para tu relay: herramienta de imagen inline para transportes tipo Codex o /images/generations para gateways estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo choisira automatiquement la bonne route pour votre relais : outil d'image intégré pour les transports de type Codex, ou /images/generations pour les passerelles standard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo आपके रिले के लिए सही रूट स्वतः चुनेगा: Codex-शैली ट्रांसपोर्ट के लिए इनलाइन इमेज टूल, या मानक गेटवे के लिए /images/generations।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo akan memilih rute yang tepat untuk relay Anda secara otomatis: tool gambar inline untuk transport gaya Codex, atau /images/generations untuk gateway standar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo は Relay に応じて自動でルートを選びます：Codex 系 transport ならインライン画像ツール、それ以外は /images/generations を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo가 릴레이에 맞는 경로를 자동으로 선택합니다: Codex 스타일 전송은 인라인 이미지 도구, 표준 게이트웨이는 /images/generations를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oriveo escolherá a rota correta para o seu relay automaticamente: ferramenta de imagem inline para transportes no estilo Codex ou /images/generations para gateways padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo автоматически выберет правильный маршрут для вашего relay: встроенный инструмент изображений для транспортов в стиле Codex или /images/generations для стандартных шлюзов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo จะเลือกเส้นทางที่ถูกต้องให้รีเลย์ของคุณโดยอัตโนมัติ: เครื่องมือสร้างภาพแบบอินไลน์สำหรับการขนส่งแบบ Codex หรือ /images/generations สำหรับเกตเวย์มาตรฐาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo, relay'iniz için doğru rotayı otomatik seçer: Codex tarzı aktarımlar için satır içi görüntü aracı veya standart ağ geçitleri için /images/generations."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo sẽ tự chọn tuyến phù hợp cho relay của bạn: công cụ ảnh inline cho các transport kiểu Codex, hoặc /images/generations cho cổng tiêu chuẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 会自动为此中转选择合适的路径：Codex 风格走内联图片工具，其他标准网关走 /images/generations。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 會自動為此中轉選擇合適的路徑：Codex 風格走內嵌圖片工具，其他標準網關走 /images/generations。"
          }
        }
      }
    },
    "Oriveo will route image requests through the right API automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقوم Oriveo بتوجيه طلبات الصور عبر API الصحيح تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo leitet Bildanfragen automatisch über die richtige API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo enrutará las solicitudes de imágenes a través de la API correcta automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo achemine automatiquement les demandes d'images via la bonne API."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo चित्र अनुरोधों को सही API के माध्यम से स्वचालित रूप से रूट करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo akan otomatis merutekan permintaan gambar melalui API yang tepat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo が画像リクエストを適切な API へ自動でルーティングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo가 이미지 요청을 자동으로 적절한 API로 라우팅합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oriveo roteará as requisições de imagens pela API correta automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo автоматически направит запросы изображений через нужный API."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo จะเส้นทางคำขอรูปภาพผ่าน API ที่ถูกต้องโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo, resim isteklerini otomatik olarak doğru API üzerinden yönlendirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo sẽ tự động định tuyến yêu cầu ảnh qua API phù hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 会自动通过对应 API 路由图片请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Oriveo 會自動透過對應 API 路由圖片請求。"
          }
        }
      }
    },
