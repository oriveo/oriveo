    "Chat errors use the shared card pattern that always lets the user keep moving.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم أخطاء الدردشة نمط البطاقة المشتركة الذي يسمح دائمًا للمستخدم بمواصلة الحركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Fehler nutzen das Shared-Card-Muster, das es dem Benutzer ermöglicht, immer in Bewegung zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los errores de chat utilizan el patrón de tarjeta compartida que siempre permite al usuario seguir moviéndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les erreurs de chat utilisent le modèle de carte partagée qui permet toujours à l'utilisateur de continuer à bouger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट त्रुटियाँ साझा कार्ड पैटर्न का उपयोग करती हैं जो उपयोगकर्ता को हमेशा चलते रहने देती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan obrolan menggunakan pola kartu bersama yang selalu memungkinkan pengguna terus berpindah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットエラーでは、ユーザーが常に移動し続けることができる共有カードパターンが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 오류는 사용자가 항상 계속 움직일 수 있도록 하는 공유 카드 패턴을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os erros de chat usam o padrão de cartão compartilhado que sempre permite que o usuário continue em movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При ошибках чата используется шаблон общей карточки, который всегда позволяет пользователю продолжать движение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อผิดพลาดในการแชทใช้รูปแบบการ์ดที่ใช้ร่วมกันซึ่งช่วยให้ผู้ใช้เคลื่อนไหวต่อไปได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet hataları, kullanıcının her zaman hareket etmesini sağlayan paylaşılan kart modelini kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
