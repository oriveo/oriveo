    "Capabilities are saved to this model. They don't affect other models or the relay itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ القدرات على هذا النموذج فقط ولا تؤثر على نماذج أخرى أو على المرحل نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fähigkeiten werden für dieses Modell gespeichert und betreffen keine anderen Modelle oder das Relay selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capabilities are saved to this model. They don't affect other models or the relay itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capacidades se guardan en este modelo y no afectan a otros modelos ni al relay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capacités sont enregistrées sur ce modèle et n'affectent pas les autres modèles ni le relais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षमताएँ इस मॉडल में सहेजी जाती हैं और दूसरे मॉडल या रिले पर असर नहीं डालतीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemampuan disimpan pada model ini, tidak memengaruhi model lain atau relai itu sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はモデル自体に保存され、他のモデルや中継本体には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능은 이 모델에 저장되며, 다른 모델이나 릴레이 자체에는 영향을 주지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos são salvos neste modelo e não afetam outros modelos nem o relay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможности сохраняются для этой модели и не влияют на другие модели или сам релей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสามารถจะบันทึกไว้กับโมเดลนี้ ไม่มีผลต่อโมเดลอื่นหรือรีเลย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetenekler bu modele kaydedilir; diğer modelleri veya relay'in kendisini etkilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khả năng được lưu trên chính model này, không ảnh hưởng tới model khác hoặc relay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能力设置保存在该模型上，不影响其他模型，也不影响中转商本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能力設定儲存於此模型本身，不影響其他模型或中轉商。"
          }
        }
      }
    },
