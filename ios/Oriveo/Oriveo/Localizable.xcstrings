    "A 6-digit verification code has been sent. Check your inbox and enter it below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال رمز تحقق من 6 أرقام. تحقق من بريدك الوارد وأدخله أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein 6-stelliger Code wurde gesendet. Prüfe dein Postfach und gib ihn unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 6-digit verification code has been sent. Check your inbox and enter it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió un código de 6 dígitos. Revisa tu bandeja de entrada e ingrésalo abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code à 6 chiffres a été envoyé. Consultez votre boîte de réception et saisissez-le ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 अंकों का सत्यापन कोड भेज दिया गया है। अपना इनबॉक्स देखें और नीचे दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode verifikasi 6 digit telah dikirim. Periksa kotak masuk Anda dan masukkan di bawah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6 桁の確認コードを送信しました。受信トレイを確認し、下に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6자리 인증 코드를 보냈습니다. 받은편지함을 확인하고 아래에 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
