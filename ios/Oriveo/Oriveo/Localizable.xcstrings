        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध सफलतापूर्वक पूरा नहीं हुआ. कृपया अपना नेटवर्क जांचें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
