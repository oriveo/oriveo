    "Use an HTTPS endpoint. Local network and VPN addresses are supported when they use a valid TLS certificate.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم نقطة نهاية HTTPS. عناوين الشبكة المحلية وVPN مدعومة عند استخدام شهادة TLS صالحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen HTTPS-Endpunkt. Adressen im lokalen Netzwerk und VPN werden unterstützt, wenn sie ein gültiges TLS-Zertifikat verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS endpoint. Local network and VPN addresses are supported when they use a valid TLS certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un endpoint HTTPS. Se admiten direcciones de red local y VPN cuando utilizan un certificado TLS válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un point de terminaison HTTPS. Les adresses du réseau local et du VPN sont prises en charge avec un certificat TLS valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS एंडपॉइंट का उपयोग करें। मान्य TLS प्रमाणपत्र वाले लोकल नेटवर्क और VPN पते समर्थित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan endpoint HTTPS. Alamat jaringan lokal dan VPN didukung jika menggunakan sertifikat TLS yang valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPSエンドポイントを使用してください。有効なTLS証明書を使用するローカルネットワークおよびVPNアドレスに対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 엔드포인트를 사용하세요. 유효한 TLS 인증서를 사용하는 로컬 네트워크 및 VPN 주소를 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um endpoint HTTPS. Endereços de rede local e VPN são compatíveis quando usam um certificado TLS válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте конечную точку HTTPS. Адреса локальной сети и VPN поддерживаются при наличии действительного сертификата TLS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปลายทาง HTTPS รองรับที่อยู่เครือข่ายภายในและ VPN เมื่อใช้ใบรับรอง TLS ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir HTTPS uç noktası kullanın. Geçerli bir TLS sertifikası kullanan yerel ağ ve VPN adresleri desteklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng endpoint HTTPS. Địa chỉ mạng cục bộ và VPN được hỗ trợ khi sử dụng chứng chỉ TLS hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS 地址。局域网和 VPN 地址均受支持，但必须使用有效的 TLS 证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 HTTPS 位址。區域網路和 VPN 位址均受支援，但必須使用有效的 TLS 憑證。"
          }
        }
      }
    },
