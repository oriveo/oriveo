    "The selected provider configuration is incomplete, so the request could not be sent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد المزود المحدد غير مكتمل، لذا لم يتمكن من إرسال الطلب."
          }
        },
