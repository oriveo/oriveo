        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 프롬프트로 시작하거나 알고 싶은 것을 물어보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um prompt rápido ou pergunte o que quiser descobrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с быстрой подсказки или спросите все, что хотите выяснить."
