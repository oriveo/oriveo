          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp không trả lại nội dung trợ lý nào cho tin nhắn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商未返回此消息的助手内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商未返回此訊息的助手內容。"
          }
        }
      }
    },
    "The request did not complete successfully. Please check your network and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الطلب بنجاح. يرجى التحقق من الشبكة والمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wurde nicht erfolgreich abgeschlossen. Bitte überprüfe deine Netzwerkverbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud no se completó correctamente. Verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n'a pas abouti. Veuillez vérifier votre réseau et réessayer."
