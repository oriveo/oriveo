        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les préférences web et de raisonnement enregistrées de cette Skill aux nouvelles conversations Skill."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई Skill चैट में इस Skill की सहेजी गई वेब और रीज़निंग प्राथमिकताएँ लागू करें।"
