    "skills.edit.needWhenForAuto" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "املأ «متى تُستخدم» أو أوقف الاستخدام التلقائي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fülle „Wann verwenden“ aus oder schalte die automatische Verwendung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add “When to use”, or turn off automatic use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa «Cuándo usarla» o desactiva el uso automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez « Quand l'utiliser » ou désactivez l'utilisation automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“कब इस्तेमाल करें” भरें या स्वचालित उपयोग बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi “Kapan digunakan” atau matikan penggunaan otomatis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「使うタイミング」を入力するか、自動使用をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘사용 시점’을 입력하거나 자동 사용을 꺼 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencha “Quando usar” ou desative o uso automático."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполните «Когда использовать» или отключите автоматическое применение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอก “ใช้เมื่อใด” หรือปิดการใช้อัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ne zaman kullanılır” alanını doldurun veya otomatik kullanımı kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy điền “Khi nào dùng” hoặc tắt tự động dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开着自动调用时，「何时使用」不能为空"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請填寫「何時使用」，或關閉自動使用。"
          }
        }
      }
    },
