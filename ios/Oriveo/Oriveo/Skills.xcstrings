    "skills.settings.autoToggleFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف لن يختار النموذج المهارات من تلقاء نفسه، ويظل بإمكانك كتابة / لاستخدام إحداها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, wählt das Modell keine Fähigkeiten selbst aus. Mit / kannst du trotzdem eine verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the model won't pick skills on its own. You can still type / to use one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, el modelo no elegirá habilidades por su cuenta. Aún puedes escribir / para usar una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, le modèle ne choisit pas de compétence de lui-même. Vous pouvez toujours taper / pour en utiliser une."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर मॉडल खुद कौशल नहीं चुनेगा। फिर भी / टाइप करके आप कोई कौशल इस्तेमाल कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dimatikan, model tidak akan memilih keterampilan sendiri. Anda tetap bisa mengetik / untuk memakainya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、モデルが自分でスキルを選ぶことはありません。/ を入力すれば手動で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 모델이 스스로 스킬을 고르지 않습니다. /를 입력하면 직접 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado, o modelo não escolhe habilidades sozinho. Você ainda pode digitar / para usar uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, модель не будет сама выбирать навыки. Чтобы применить навык вручную, введите /."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิด โมเดลจะไม่เลือกทักษะเอง แต่คุณยังพิมพ์ / เพื่อเลือกใช้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken model kendi başına beceri seçmez. Yine de / yazarak birini kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt, mô hình sẽ không tự chọn kỹ năng. Bạn vẫn có thể gõ / để dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，模型不会自己挑技能；输入 / 仍可手动使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，模型不會自己挑技能；輸入 / 仍可手動使用。"
          }
        }
      }
    },
