    "Enable %@ in your OpenAI provider to use Knowledge Base.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل %@ في مزود OpenAI لديك لاستخدام قاعدة المعرفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie %@ in Ihrem OpenAI-Anbieter, um die Wissensdatenbank zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable %@ in your OpenAI provider to use Knowledge Base."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa %@ en tu proveedor de OpenAI para usar la base de conocimientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez %@ dans votre fournisseur OpenAI pour utiliser la base de connaissances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowledge Base उपयोग करने के लिए अपने OpenAI प्रदाता में %@ सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan %@ di penyedia OpenAI Anda untuk menggunakan Knowledge Base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowledge Base を使うには、OpenAI プロバイダで %@ を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowledge Base를 사용하려면 OpenAI 제공업체에서 %@를 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
