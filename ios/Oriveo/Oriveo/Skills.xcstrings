            "value": "Die gespeicherten Web- und Reasoning-Einstellungen dieser Skill in neuen Skill-Chats anwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this Skill's saved web and reasoning preferences in new Skill chats."
          }
        },
        "es": {
