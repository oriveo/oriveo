    "skills.edit.whenPlaceholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثال: عندما أطلب تحويل الملاحظات إلى تقرير أسبوعي. ليس للتحديثات اليومية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. Wenn ich Notizen zu einem Wochenbericht zusammenfassen lasse. Nicht für Tagesberichte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. When I ask to turn notes into a weekly report. Not for daily updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ej., Cuando pido convertir notas en un informe semanal. No para resúmenes diarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ex. : Quand je demande de transformer des notes en rapport hebdomadaire. Pas pour les points quotidiens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदाहरण: जब मैं नोट्स को साप्ताहिक रिपोर्ट में बदलने को कहूं। रोज़ाना अपडेट के लिए नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mis. Saat saya minta catatan dijadikan laporan mingguan. Bukan untuk laporan harian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：メモを週報にまとめてほしいと頼んだとき。日報には使わない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: 메모를 주간 보고서로 정리해 달라고 할 때. 일일 보고에는 사용하지 않음."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ex.: Quando eu pedir para transformar anotações em relatório semanal. Não para atualizações diárias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Например: когда я прошу собрать заметки в недельный отчёт. Не для ежедневных сводок."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช่น เมื่อฉันขอให้สรุปโน้ตเป็นรายงานประจำสัปดาห์ ไม่ใช้กับรายงานประจำวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ör. Notlarımı haftalık rapora dönüştürmeni istediğimde. Günlük güncellemeler için değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VD: Khi tôi nhờ gom ghi chú thành báo cáo tuần. Không dùng cho báo cáo ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：让我把零散事项整理成周报时使用；不用于写日报"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：我要把零散事項整理成週報時使用；不用於寫日報"
          }
        }
      }
    },
    "skills.edit.whenTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اذكر ما تفعله المهارة ومتى تُستخدم والصيغة المعتادة لطلبها. أضف «ليس لـ…» لتجنّب الاستخدام الخاطئ. تُميَّز الكلمات الموضوعة بين علامتي تنصيص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib, was sie tut, wann sie greifen soll und wie du normalerweise fragst. Mit „Nicht für …“ vermeidest du Fehltreffer. Wörter in Anführungszeichen werden hervorgehoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say what it does, when to use it, and how you usually ask. Add “Not for …” to avoid wrong matches. Words in quotes are highlighted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di qué hace, cuándo usarla y cómo sueles pedirlo. Agrega «No para…» para evitar usos equivocados. Las palabras entre comillas se resaltan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez ce qu'elle fait, quand l'utiliser et comment vous le demandez d'habitude. Ajoutez « Pas pour … » pour éviter les déclenchements à tort. Les mots entre guillemets sont mis en évidence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताएं कि यह क्या करता है, कब इस्तेमाल हो और आप आमतौर पर कैसे कहते हैं। गलत मिलान से बचने के लिए “… के लिए नहीं” जोड़ें। उद्धरण चिह्नों में लिखे शब्द हाइलाइट होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis apa fungsinya, kapan dipakai, dan bagaimana Anda biasanya memintanya. Tambahkan “Bukan untuk …” agar tidak salah dipakai. Kata dalam tanda kutip akan disorot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何をするか、いつ使うか、ふだんどう頼むかを書いてください。「〜には使わない」と添えると、誤って使われにくくなります。「」で囲んだ語は強調表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 하는지, 언제 쓰는지, 평소 어떻게 요청하는지 적어 주세요. ‘…에는 사용하지 않음’을 덧붙이면 잘못 쓰이는 일을 줄일 수 있습니다. 따옴표로 묶은 단어는 강조 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga o que ela faz, quando usar e como você costuma pedir. Adicione “Não para…” para evitar usos errados. Palavras entre aspas ficam destacadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите, что делает навык, когда его применять и как вы обычно об этом просите. Добавьте «Не для…», чтобы избежать ложных срабатываний. Слова в кавычках подсвечиваются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนให้ชัดว่าทำอะไร ใช้เมื่อไร และปกติคุณพูดว่าอย่างไร เพิ่ม “ไม่ใช้กับ …” เพื่อลดการเรียกใช้ผิด คำในเครื่องหมายคำพูดจะถูกไฮไลต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne yaptığını, ne zaman kullanılacağını ve genelde nasıl istediğinizi yazın. Yanlış eşleşmeleri önlemek için “… için değil” ekleyin. Tırnak içindeki kelimeler vurgulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi rõ kỹ năng làm gì, khi nào dùng và bạn thường hỏi thế nào. Thêm “Không dùng cho …” để tránh dùng nhầm. Từ đặt trong dấu ngoặc kép sẽ được tô sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写清做什么、什么时候用、你通常怎么说；可以加一句「不用于……」减少误用。用「」括起的词会高亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫清楚做什麼、什麼時候用、你通常怎麼說；可以加一句「不用於……」減少誤用。用「」括起的詞會醒目標示。"
          }
        }
      }
    },
    "skills.empty.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ طريقتك المعتادة، فلا حاجة إلى شرحها في كل مرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deine bevorzugte Arbeitsweise, dann musst du sie nicht jedes Mal neu erklären."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the way you like things done, so you don't have to explain it every time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cómo te gusta que se hagan las cosas y no tendrás que explicarlo cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre façon de faire pour ne plus avoir à l'expliquer à chaque fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अक्सर इस्तेमाल होने वाले तरीके सेव करें, ताकि हर बार समझाना न पड़े।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan cara yang sering Anda pakai agar tidak perlu menjelaskannya setiap kali."
          }
        },
        "ja" : {
          "stringUnit" : {
