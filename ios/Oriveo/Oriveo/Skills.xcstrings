        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การตั้งค่าเว็บและการให้เหตุผลที่บันทึกไว้ของ Skill นี้ในแชท Skill ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Skill için kaydedilmiş web ve akıl yürütme tercihlerini yeni Skill sohbetlerinde uygula."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng tùy chọn web và suy luận đã lưu của Skill này trong các cuộc trò chuyện Skill mới."
          }
        },
        "zh-Hans": {
