        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Skill に保存されたネット検索と思考の設定を、新しい Skill の会話に適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Skill에 저장된 인터넷 검색 및 추론 설정을 새 Skill 대화에 적용합니다."
          }
        },
        "pt-BR": {
