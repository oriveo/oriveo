            "state": "translated",
            "value": "मॉडल प्राथमिकताएँ और मेमोरी इंजेक्शन कॉन्फ़िगर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasikan preferensi model dan injeksi memori."
          }
