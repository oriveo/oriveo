        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 환경설정 및 메모리 주입을 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar preferências de modelo e injeção de memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте предпочтения модели и внедрение памяти."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดค่าการกำหนดลักษณะโมเดลและการแทรกหน่วยความจำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tercihlerini ve bellek enjeksiyonunu yapılandırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định cấu hình tùy chọn mô hình và chèn bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置模型偏好和记忆注入等进阶选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置模型偏好和記憶注入等進階選項。"
          }
        }
      }
    },
