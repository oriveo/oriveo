# Every value here is optional. The app runs with none of them set: provider keys are entered
# in the UI and stored in the browser, and everything else defaults to a local setup.

# Origin the app is served from. Used for canonical URLs, the sitemap, and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Version string shown in Settings and written into backup archives.
# Defaults to the value compiled into the build.
NEXT_PUBLIC_APP_VERSION=

# Base URL of the read-only model catalog. Left empty, the app reads the catalog published at
# https://api.oriveoai.com so new models appear without a rebuild. Set this to serve it yourself.
NEXT_PUBLIC_BACKEND_URL=

# Optional error reporting. Without a DSN nothing is sent anywhere.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Number of proxies in front of the app. The chat rate limiter reads the client address this
# many hops from the right of X-Forwarded-For. Leave unset unless you deploy behind a proxy.
TRUSTED_PROXY_HOP_COUNT=

# Server-side twin of NEXT_PUBLIC_BACKEND_URL, read by the chat route handler. Set it when the
# catalog host should not be baked into the browser bundle; NEXT_PUBLIC_BACKEND_URL wins if both
# are set.
BACKEND_URL=

# Set to "true" to draw the Library surfaces. They need a document-source connector, which this
# build does not ship, so leaving it unset is correct: the entry points stay hidden instead of
# leading to a request that cannot succeed.
NEXT_PUBLIC_LIBRARY_ENABLED=

# Set to "1" to build the static export a desktop shell would load from the filesystem. It turns off
# the image optimizer, response headers and the service worker, and resolves the locale in the
# browser rather than from cookies. Leave unset for a normal web build.
ORIVEO_DESKTOP=

# Build output directory for a production build (default `.next`). A development server always
# writes to `.next-dev`, so the two never collide.
NEXT_DIST_DIR=
