# Shared editor defaults. Each toolchain still has the final say; this file only
# stops an editor from guessing wrong in a repository with four of them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,css,json,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[gradlew.bat]
end_of_line = crlf
