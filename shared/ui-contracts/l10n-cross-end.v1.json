  "exemptions": [
    {"scope": "skills", "keys": ["skills.knowledgeRetryUnavailable"], "ends": ["web"], "locales": "*", "reason": "Web keeps picked files only in memory, so retry works only for files added in this editing session; iOS and Android re-read the file from local storage. Different behavior, different copy."},
    {"scope": "skills", "keys": ["skills.knowledgeCtaRetrievalModel"], "ends": ["web"], "locales": "*", "reason": "Web inlines the required model name into this sentence (SkillEditPage withIsolatedModel); iOS and Android show it on a separate 'Required model' row, so the Web sentence carries an extra {model} clause."}
