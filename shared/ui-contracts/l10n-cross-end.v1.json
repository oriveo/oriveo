      "ios": {"sources": [{"table": "Skills"},{"table": "Localizable", "prefixes": ["skill.", "knowledge_cleanup_failed", "knowledge_extract_failed", "knowledge_file_too_large", "knowledge_index_failed", "knowledge_total_size_exceeded", "knowledge_upload_failed", "knowledge_retrieve_failed", "unsupported_file_type", "openai_endpoint_not_official", "knowledge_service_unavailable"]}]},
