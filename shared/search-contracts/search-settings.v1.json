  "testCases": [
    {
      "caseId": "test.passed",
      "input": {
        "outcome": {
          "ok": true,
          "count": 5,
          "latencyMs": 834
        }
      },
      "expect": {
        "state": "passed",
        "count": 5,
        "latencyTenths": 8
      }
    },
    {
      "caseId": "test.passed_zero_results",
      "input": {
        "outcome": {
          "ok": true,
          "count": 0,
          "latencyMs": 1250
        }
      },
      "expect": {
        "state": "passed",
        "count": 0,
        "latencyTenths": 13
      }
    },
    {
      "caseId": "test.passed_rounds_half_up",
      "input": {
        "outcome": {
          "ok": true,
          "count": 3,
          "latencyMs": 50
        }
      },
      "expect": {
        "state": "passed",
        "count": 3,
        "latencyTenths": 1
      }
    },
    {
      "caseId": "test.auth_invalid",
      "input": {
        "outcome": {
          "ok": false,
          "error": {
            "errorClass": "auth_invalid",
            "card": {
              "headline": "key_rejected",
              "primaryAction": "update_key"
            }
          }
        }
      },
      "expect": {
        "state": "failed",
        "errorClass": "auth_invalid",
        "headline": "key_rejected",
        "action": "update_key"
      }
    },
    {
      "caseId": "test.balance_preset",
      "input": {
        "outcome": {
          "ok": false,
          "error": {
            "errorClass": "insufficient_balance",
            "card": {
              "headline": "insufficient_balance",
              "primaryAction": "top_up"
            }
          }
        }
      },
      "expect": {
