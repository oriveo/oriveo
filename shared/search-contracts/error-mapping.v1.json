{
  "schema": "oriveo.search.error-mapping/v1",
  "$comment": "Search error mapping (external search service contract, section 10): generic rules plus entry / protocol specific rules (serviceId refers to an entry of search_catalog_contract.v1.json; protocol=searxng refers to the built-in client protocol). toolMessage is the fixed message key returned to the model; card is the error card headline key and primary action. Expectations come from the reference implementation of classifySearchError.",
  "constants": {
    "classes": {
      "auth_invalid": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "key_rejected",
          "primaryAction": "update_key"
        }
      },
      "insufficient_balance": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "insufficient_balance",
          "primaryAction": "top_up"
        }
      },
      "rate_limited": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "rate_limited",
          "primaryAction": "retry_later"
        }
      },
      "timeout": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "no_response",
          "primaryAction": "retry"
        }
      },
      "network": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "no_response",
          "primaryAction": "retry"
        }
      },
      "upstream_unavailable": {
        "retryOnce": true,
        "toolMessage": "unavailable",
        "card": {
          "headline": "no_response",
          "primaryAction": "retry"
        }
      },
      "upstream_error": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "service_error",
          "primaryAction": "retry"
        }
      },
      "request_rejected": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "service_error",
          "primaryAction": "switch_service"
        }
      },
      "parse_mismatch": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "format_mismatch",
          "primaryAction": "switch_service"
        }
      },
      "searxng_json_disabled": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "searxng_json_disabled",
          "primaryAction": "view_setup_guide"
        }
      },
      "host_changed": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "host_changed",
          "primaryAction": "reconfirm"
        }
      },
      "service_withdrawn": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "service_withdrawn",
          "primaryAction": "switch_service"
        }
      },
      "response_too_large": {
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "service_error",
          "primaryAction": "switch_service"
        }
      }
    },
    "toolMessages": {
      "no_results": "The web search returned no results. Do not search again for this; answer from what you know and say that the search found nothing.",
      "unavailable": "Web search is not available right now. Do not call web_search again in this reply. Answer directly and tell the user you could not search the web.",
      "cap_reached": "The web search limit for this reply has been reached. Do not call web_search again. Answer from the results you already have."
    },
    "retryableStatuses": [
      408,
      502,
      503
    ]
  },
  "cases": [
    {
      "caseId": "err.deepseek_401",
      "input": {
        "serviceId": "deepseek",
        "status": 401,
        "body": {
          "error": {
            "type": "authentication_error"
          }
        }
      },
      "expect": {
        "errorClass": "auth_invalid",
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "key_rejected",
          "primaryAction": "update_key"
        }
      }
    },
    {
      "caseId": "err.deepseek_402_balance",
      "input": {
        "serviceId": "deepseek",
        "status": 402,
        "body": {
          "error": {
            "message": "Insufficient Balance"
          }
        },
        "otherServices": 1
      },
      "expect": {
        "errorClass": "insufficient_balance",
        "retryOnce": false,
        "toolMessage": "unavailable",
        "card": {
          "headline": "insufficient_balance",
          "primaryAction": "top_up",
          "secondaryAction": "switch_to_other_service"
        }
      }
    },
    {
      "caseId": "err.zhipu_429_1113_balance",
      "input": {
