{
  "schema": "oriveo.search.custom-service/v1",
  "$comment": "Custom services: form validation (addressClass comes from the existing local / LAN address classification: public | lan | unresolved), key binding source, manual mapping validation, the \"same as X\" snapshot, SearXNG protocol replay, and behavior when the catalog is unavailable. Expectations come from the reference implementation of the transport.",
  "constants": {
    "protocols": [
      "searxng",
      "same_as",
      "manual"
    ],
    "searxng": {
      "kind": "json_http/v1",
      "method": "GET",
      "auth": {
        "kind": "bearer"
      },
      "query": {
        "field": "q",
        "in": "query",
        "maxChars": 400
      },
      "count": null,
      "static": {
        "in": "query",
        "params": {
          "format": "json"
        }
      },
      "response": {
        "results": "results",
        "title": [
          "title"
        ],
        "url": [
          "url"
        ],
        "snippet": [
          "content"
        ],
        "date": [
          "publishedDate"
        ],
        "html": true
      },
      "errors": [
        {
          "status": 403,
          "class": "searxng_json_disabled"
        }
      ]
    },
    "timeoutSec": 20,
    "webAllowedPorts": [
      80,
      443,
      8080,
      8443
    ]
  },
  "validateCases": [
    {
      "caseId": "form.https_public_ok",
      "input": {
        "name": "我的搜索",
        "address": "https://search.example.com",
        "protocol": "searxng",
        "platform": "ios",
        "addressClass": "public"
      },
      "expect": {
        "ok": true,
        "errors": [],
        "warnings": [],
        "origin": "https://search.example.com",
        "requestPath": "/search"
      }
    },
    {
      "caseId": "form.http_public_rejected_mobile",
      "input": {
        "name": "x",
        "address": "http://search.example.com",
        "protocol": "searxng",
        "platform": "android",
        "addressClass": "public"
      },
      "expect": {
        "ok": false,
        "errors": [
          "http_public_not_allowed"
        ],
        "warnings": [],
        "origin": "http://search.example.com",
        "requestPath": null
      }
    },
    {
