  "bindingCases": [
    {
      "caseId": "bind.path_change_keeps_key",
      "input": {
        "old": "https://a.example/v1/search",
        "next": "https://a.example/v2/search"
      },
      "expect": {
        "oldOrigin": "https://a.example",
        "nextOrigin": "https://a.example",
        "clearsKey": false
      }
    },
    {
      "caseId": "bind.host_change_clears_key",
      "input": {
        "old": "https://a.example/search",
        "next": "https://b.example/search"
      },
      "expect": {
        "oldOrigin": "https://a.example",
        "nextOrigin": "https://b.example",
        "clearsKey": true
      }
    },
    {
      "caseId": "bind.port_change_clears_key",
      "input": {
        "old": "https://a.example/search",
        "next": "https://a.example:8443/search"
      },
      "expect": {
        "oldOrigin": "https://a.example",
        "nextOrigin": "https://a.example:8443",
        "clearsKey": true
      }
    },
    {
      "caseId": "bind.default_port_equivalent",
      "input": {
        "old": "https://a.example/search",
        "next": "https://A.EXAMPLE:443/search"
      },
      "expect": {
        "oldOrigin": "https://a.example",
        "nextOrigin": "https://a.example",
        "clearsKey": false
      }
    },
    {
      "caseId": "bind.scheme_change_clears_key",
      "input": {
        "old": "http://192.168.1.2:8080",
        "next": "https://192.168.1.2:8080"
      },
      "expect": {
        "oldOrigin": "http://192.168.1.2:8080",
        "nextOrigin": "https://192.168.1.2:8080",
        "clearsKey": true
      }
    }
  ],
  "snapshotCases": [
    {
      "caseId": "snapshot.tavily",
      "input": {
        "serviceId": "tavily",
        "regionId": "global"
      },
      "expect": {
        "kind": "json_http/v1",
        "method": "POST",
        "auth": {
          "kind": "bearer"
        },
        "query": {
          "field": "query",
          "in": "body"
        },
        "count": {
          "field": "max_results",
          "in": "body"
        },
        "static": {
          "in": "body",
          "params": {
            "search_depth": "basic"
          }
        },
        "response": {
          "results": "results",
          "title": [
            "title"
          ],
          "url": [
            "url"
          ],
          "snippet": [
            "content"
          ],
          "html": false
        },
        "errors": [
          {
            "status": 432,
            "class": "insufficient_balance"
          },
          {
            "status": 433,
            "class": "insufficient_balance"
          }
        ],
        "snapshotOf": {
          "serviceId": "tavily",
          "region": "global"
        }
      }
    },
    {
