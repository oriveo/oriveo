  "shared": {
    "border": "rgba(255,255,255,0.10)",
    "borderStrong": "rgba(255,255,255,0.18)",
    "hairline": "rgba(255,255,255,0.06)",
    "overlay": "rgba(0,0,0,0.72)",
    "codeText": "#E4E4E7",
    "syntax": "catppuccin-mocha",
    "status": {
      "success": "#6EE7A1",
      "warning": "#FCD34D",
      "error": "#F8978F",
      "info": "#8DB6FF"
    }
  },
  "derived": {
    "primarySubtle": {
      "from": "primary",
      "alpha": 0.15
    },
    "accentSubtle": {
      "from": "accent",
      "alpha": 0.14
    },
    "primaryGlow": {
      "from": "primary",
      "alpha": 0.35
    },
    "focusRing": {
      "from": "primary",
      "alpha": 0.5
    },
    "composerBorder": {
      "from": "primary",
      "alpha": 0.22
    },
    "surfaceOverlay": {
      "from": "bg",
      "alpha": 0.88
    },
    "gradientBrand": {
      "angleDeg": 135,
      "stops": [
        "primary",
        "accent"
      ]
    },
    "aurora": {
      "bottom": {
        "from": "primary",
        "alpha": 0.26
      },
      "bottomLeft": {
        "from": "accent",
        "alpha": 0.18
      },
      "bottomRight": {
        "from": "primary",
        "alpha": 0.16
      },
      "top": {
        "from": "accent",
        "alpha": 0.09
      },
      "scaleBy": "glowK"
    },
    "userBubble": {
      "fill": "gradientBrand",
      "text": "onPrimary",
      "shadow": "primaryGlow"
    }
  },
  "contrastRules": {
    "minTextOnBg": 7,
    "minSecondaryOnSurfaces": 4.5,
    "minOnPrimary": 4.5,
    "minRaisedOverSurfaceDeltaLstar": 3,
    "minPrimaryOnSubtle": 4.5,
    "minStatusOnSurfaces": 4.5,
    "surfaces": [
      "bg",
      "surface",
      "surfaceRaised"
    ],
    "secondaryTokens": [
      "textSecondary",
      "textTertiary",
      "primary",
      "accent"
    ],
    "onPrimaryOver": [
      "primary",
      "accent",
      "primaryHover",
      "primaryActive"
    ],
    "chipSurfaces": [
      "bg",
      "surface"
    ],
    "statusSurfaces": [
      "surface"
    ]
  },
  "resolveCases": [
    {
      "name": "missing_is_default_and_not_pushed",
      "stored": null,
      "renders": "dark",
      "setByUser": false,
      "pushToCloud": false
    },
    {
      "name": "known_id_applies",
      "stored": "dark-ocean",
      "renders": "dark-ocean",
      "setByUser": true,
      "pushToCloud": true
    },
    {
      "name": "explicit_default_is_pushed",
      "stored": "dark",
      "renders": "dark",
      "setByUser": true,
      "pushToCloud": true
    },
    {
      "name": "unknown_id_falls_back_without_write_back",
      "stored": "dark-aurora-future",
      "renders": "dark",
      "setByUser": true,
      "pushToCloud": false,
      "keepStoredValue": true
    },
    {
      "name": "non_string_is_ignored",
      "stored": 42,
      "renders": "dark",
      "setByUser": false,
      "pushToCloud": false
    }
  ],
  "themePageCases": [
    {
      "name": "tap_light",
      "before": {
        "theme": "dark",
        "follow": false,
        "darkPalette": "dark-ocean"
      },
      "tap": "light",
      "after": {
        "theme": "light",
        "darkPalette": "dark-ocean"
      }
    },
    {
      "name": "tap_palette_follow_off",
      "before": {
        "theme": "light",
        "follow": false,
        "darkPalette": "dark"
      },
      "tap": "dark-forest",
      "after": {
        "theme": "dark",
        "darkPalette": "dark-forest"
      }
    },
    {
      "name": "tap_palette_follow_on",
      "before": {
        "theme": "system",
        "follow": true,
        "darkPalette": "dark"
      },
      "tap": "dark-sunset",
      "after": {
        "theme": "system",
        "darkPalette": "dark-sunset"
      }
    },
    {
      "name": "turn_follow_on",
      "before": {
        "theme": "dark",
        "follow": false,
        "darkPalette": "dark-black"
      },
      "toggleFollow": true,
      "after": {
        "theme": "system",
        "darkPalette": "dark-black"
      }
    },
    {
      "name": "turn_follow_off_uses_current_system_appearance",
      "before": {
        "theme": "system",
        "follow": true,
        "darkPalette": "dark-black",
        "systemAppearance": "dark"
      },
      "toggleFollow": false,
      "after": {
        "theme": "dark",
        "darkPalette": "dark-black"
      }
    }
  ]
}
