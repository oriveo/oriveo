        "from": "accent",
        "alpha": 0.09
      },
      "scaleBy": "glowK"
    },
    "userBubble": {
      "$comment": "User message bubble: the gradient is anchored to the visible chat viewport and runs vertically from top to bottom, so each bubble shows only its own slice and the colors flow as it scrolls. Stops are precomputed with OKLCH interpolation (userBubbleStops / custom.derivationCases[].bubble); every client copies them and interpolates between adjacent stops in sRGB. Standalone elements outside the chat list (the preview card mini bubble, palette cards) anchor to their own container. The top inner highlight is a white line of `width` pixels at `alpha`; the drop shadow uses the bottom stop color at `alpha`, with `blur` and a downward offset `y`. Text color is onPrimary.",
      "fill": "gradientBrand",
      "text": "onPrimary",
      "anchor": "viewport",
      "axis": "vertical",
      "stops": 7,
      "dark": {
        "top": "accent",
        "bottom": "primary"
      },
      "light": {
        "top": "gradEnd",
        "bottom": "gradStart"
      },
      "highlight": {
        "color": "#FFFFFF",
        "width": 1,
        "alpha": {
          "dark": 0.22,
          "light": 0.28
        }
      },
      "shadow": {
        "from": "bottom",
        "alpha": 0.16,
        "blur": 14,
        "y": 4
      }
    }
  },
  "contrastRules": {
    "minTextOnBg": 7,
    "minSecondaryOnSurfaces": 4.5,
    "minOnPrimary": 4.5,
    "minRaisedOverSurfaceDeltaLstar": 3,
    "minPrimaryOnSubtle": 4.5,
    "minStatusOnSurfaces": 4.5,
    "surfaces": [
      "bg",
      "surface",
      "surfaceRaised"
    ],
    "secondaryTokens": [
      "textSecondary",
      "textTertiary",
      "primary",
      "accent"
    ],
    "onPrimaryOver": [
      "primary",
      "accent",
      "primaryHover",
      "primaryActive"
    ],
    "chipSurfaces": [
      "bg",
      "surface"
    ],
    "statusSurfaces": [
      "surface"
    ]
  },
