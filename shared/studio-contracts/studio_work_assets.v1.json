{
  "$comment": "Studio work asset writes. Pure decisions replayed by iOS / Android / Web: sniffImportMime (magic bytes of the first <= 64 bytes; extension and declared type ignored), planReferenceImport (format -> input bytes -> decodable size -> pixels -> plan, first hit wins), checkReferenceImportOutput (encoded result), planWorkThumbnail (work wall thumbnail). width / height are the decoded size after EXIF orientation. Resizing keeps the long side at exactly maxLongEdge; the short side is round-half-up(short * maxLongEdge / long) computed in 64-bit integers as (2*short*max + long) div (2*long), at least 1; never upscales. hasAlpha = the platform decoder reports an alpha channel (Web: any decoded pixel with alpha < 255). Reference: scripts/lib/studio-work-assets-reference.mjs.",
  "contractId": "studio_work_assets",
  "version": 1,
  "spec": {
    "import": {
      "acceptedMimes": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/heic",
        "image/heif",
        "image/avif",
        "image/gif"
      ],
      "losslessMimes": [
        "image/png",
        "image/gif"
      ],
      "maxInputBytes": 20971520,
      "maxPixels": 50000000,
      "maxLongEdge": 4096,
      "maxOutputBytes": 20971520,
      "jpegQuality": 0.92,
      "rejectReasons": [
        "unsupported_format",
        "too_large",
        "decode_failed",
        "too_many_pixels"
      ],
      "pipeline": "Every accepted import is decoded (GIF: first frame), oriented by EXIF, resized per plan and re-encoded to plan.mime; the output carries no EXIF / GPS / device metadata. too_large maps to copy key studio.reference.tooLarge."
    },
    "thumbnail": {
      "maxLongEdge": 360,
      "jpegQuality": 0.8,
      "alphaMime": "image/png",
      "opaqueMime": "image/jpeg"
    },
    "storage": {
      "original": "Generated originals are stored byte-for-byte (no resize, no re-encode); the 360px thumbnail is stored in the same asset id's thumbnail slot, so the orphan sweepers need no derived ids.",
      "writeResults": [
        "saved",
        "storage_full",
        "write_failed"
      ],
      "storageFull": "Out-of-space / quota errors only (iOS fileWriteOutOfSpace or ENOSPC, Android ENOSPC, Web QuotaExceededError); any other write error is write_failed.",
      "webPersist": "Before the first original write of a page load, call navigator.storage.persisted() and, when false, navigator.storage.persist() once; missing API or rejection never fails the write."
    }
  },
