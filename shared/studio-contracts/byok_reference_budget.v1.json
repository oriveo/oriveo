{
  "$comment": "BYOK reference image budget before sending to the provider. Pure planning shared by iOS / Android / Web; scripts/studio-contracts-check.mjs recomputes every case with scripts/lib/studio-image-reference.mjs. Inputs are already-typed values (route / editTransport from a validated profile, images already passed request-builder checks), nothing is decoded from the wire. Sizes are encoded request bytes; the platform shrinker (long edge 2048, JPEG 0.9, alpha on white) is simulated by images[].shrunk ({mime, byteCount}, null = undecodable); expect.shrinkCalls lists the slots handed to the shrinker in call order. Test groups, same name on every end: spec, encodedBytes, fit.",
  "contractId": "byok_reference_budget.v1",
  "version": 1,
  "spec": {
    "overheadBytes": 65536,
    "routes": {
      "openai_images": {
        "maxRequestBytes": 50000000,
        "maxImageBytes": 20971520
      },
      "xai_images": {
        "maxRequestBytes": 50000000,
        "maxImageBytes": 20971520
      },
      "openrouter_images": {
        "maxRequestBytes": 50000000,
        "maxImageBytes": null
      },
      "chat_modalities": {
        "maxRequestBytes": 50000000,
        "maxImageBytes": null
      },
      "gemini_generate_content": {
        "maxRequestBytes": 20000000,
        "maxImageBytes": null
      },
      "dashscope_multimodal": {
        "maxRequestBytes": 16777216,
        "maxImageBytes": 10000000
      },
      "minimax_image_generation": null
    },
    "shrink": {
      "maxLongEdge": 2048,
      "jpegQuality": 0.9,
      "mime": "image/jpeg"
    },
    "tooLargeErrorKind": "invalid_param",
    "statuses": [
      "fits",
      "too_large"
    ]
  },
