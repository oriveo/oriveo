{
  "$comment": "tool_call verdict order for official and subscription connections. Client order: first-hand > catalog evidence > rejection memory (connection memory value false AND memory.factsRevision == current factsRevision AND not declarationEditedAfterRecord) > modelFacts (only on catalog miss) > hand-entered official model's local explicit declaration > connection memory true > unknown, fail open; a rejection recorded under another factsRevision, or followed by a user edit of the hand-entered declaration, is void and takes no part; subscription connections use the same order (first-hand layer empty), no exception on any end; a catalog model's empty or expired tool_call evidence is unknown and never falls back to the top-level toolCall. Inputs: factsRevision = current modelFactsRevision (null = none); memory = null or { value, factsRevision (revision when recorded), declarationEditedAfterRecord }; form absent = official. Case hand_entered_model_facts_beat_memory keeps its id for test-name stability; its expectation is that rejection memory beats modelFacts. verdict: true / false / null (unknown). sendsTools = verdict != false (fail open). Each end names its tests TOOL_CALL_ORDER_<id> (Web: it('TOOL-CALL-ORDER-<id> ...')) and calls its production tool-call policy.",
  "v": 1,
  "cases": [
    { "id": "catalog_evidence_supported", "catalog": { "evidence": "supported", "topLevelToolCall": false }, "modelFacts": null, "factsRevision": "r1", "localDeclaration": null, "memory": null, "expect": { "verdict": true, "sendsTools": true } },
    { "id": "catalog_evidence_unsupported", "catalog": { "evidence": "unsupported", "topLevelToolCall": true }, "modelFacts": true, "factsRevision": "r1", "localDeclaration": true, "memory": null, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "catalog_evidence_missing_no_top_level_fallback", "catalog": { "evidence": null, "topLevelToolCall": true }, "modelFacts": false, "factsRevision": "r1", "localDeclaration": false, "memory": null, "expect": { "verdict": null, "sendsTools": true } },
    { "id": "hand_entered_model_facts_beat_local", "catalog": null, "modelFacts": true, "factsRevision": "r1", "localDeclaration": false, "memory": null, "expect": { "verdict": true, "sendsTools": true } },
    { "id": "hand_entered_local_when_no_model_facts", "catalog": null, "modelFacts": null, "factsRevision": "r1", "localDeclaration": false, "memory": { "value": true, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "hand_entered_memory_when_no_declaration", "catalog": null, "modelFacts": null, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "hand_entered_model_facts_beat_memory", "catalog": null, "modelFacts": true, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "hand_entered_nothing_fail_open", "catalog": null, "modelFacts": null, "factsRevision": "r1", "localDeclaration": null, "memory": null, "expect": { "verdict": null, "sendsTools": true } },
    { "id": "hand_entered_rejection_beats_model_facts", "catalog": null, "modelFacts": true, "factsRevision": "r1", "localDeclaration": true, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "hand_entered_rejection_beats_local_declaration", "catalog": null, "modelFacts": null, "factsRevision": "r1", "localDeclaration": true, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "hand_entered_rejection_stale_facts_revision", "catalog": null, "modelFacts": true, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": false, "factsRevision": "r0", "declarationEditedAfterRecord": false }, "expect": { "verdict": true, "sendsTools": true } },
    { "id": "hand_entered_rejection_void_after_declaration_edit", "catalog": null, "modelFacts": null, "factsRevision": "r1", "localDeclaration": true, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": true }, "expect": { "verdict": true, "sendsTools": true } },
    { "id": "hand_entered_memory_true_does_not_beat_model_facts_false", "catalog": null, "modelFacts": false, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": true, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "catalog_evidence_beats_rejection", "catalog": { "evidence": "supported", "topLevelToolCall": false }, "modelFacts": null, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": true, "sendsTools": true } },
    { "id": "catalog_evidence_missing_rejection_applies", "catalog": { "evidence": null, "topLevelToolCall": true }, "modelFacts": true, "factsRevision": "r1", "localDeclaration": true, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } },
    { "id": "subscription_rejection_beats_model_facts", "form": "subscription", "catalog": null, "modelFacts": true, "factsRevision": "r1", "localDeclaration": null, "memory": { "value": false, "factsRevision": "r1", "declarationEditedAfterRecord": false }, "expect": { "verdict": false, "sendsTools": false } }
  ]
}
