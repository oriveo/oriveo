      { "caseId": "new_api_success", "body": "{\"success\":true,\"data\":[{\"id\":\"gpt-4o\"},{\"id\":\"claude-sonnet-4-5\"}]}", "expect": ["gpt-4o", "claude-sonnet-4-5"] },
      { "caseId": "anthropic_page", "body": "{\"data\":[{\"id\":\"gpt-4o\",\"type\":\"model\"},{\"id\":\"claude-sonnet-4-5\",\"type\":\"model\"}],\"has_more\":false,\"first_id\":\"gpt-4o\",\"last_id\":\"claude-sonnet-4-5\"}", "expect": ["gpt-4o", "claude-sonnet-4-5"] }
    ]
  }
