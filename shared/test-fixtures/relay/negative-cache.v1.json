    {"caseId": "user_override_clears_that_kind_only", "action": "userOverride", "kind": "image", "target": {"connectionId": "c1", "modelId": "m1", "transport": "chat"}, "before": [["c1", "m1", "chat", "image"], ["c1", "m1", "chat", "toolCall"]], "after": [["c1", "m1", "chat", "toolCall"]]},
    {"caseId": "redetect_clears_whole_connection", "action": "redetect", "target": {"connectionId": "c1"}, "before": [["c1", "m1", "chat", "image"], ["c1", "m2", "responses", "toolCall"], ["c2", "m1", "chat", "image"]], "after": [["c2", "m1", "chat", "image"]]}
