  "protocolFallbackRules": {"$comment": "A pre-output rejection switches protocol only when it says this path does not serve the request: one of statuses, or a phraseStatuses status whose response body contains one of phrases (case-insensitive substring). The phrase is sub2api's refusal of /v1/messages on a group without messages dispatch (Wei-Shaw/sub2api backend/internal/handler/openai_gateway_handler.go, read at 3a6fd1c9db07). A 403 without the phrase is a key or account problem and never switches. A 2xx response that is a web page instead of a generation response (contentType text/html, the gateway's SPA fallback) is a route-level rejection too. Cases without `body` have an empty body; cases without `contentType` are application/json. The probe step uses the same predicate (probe-orchestration.v1.json probeOutcomeRules.routeRejected). A JSON body may escape slashes as `\\/` (PHP json_encode does by default): unescape `\\/` to `/` before matching; each phrase is registered in one spelling only. Client-gate refusals (clientGateRules) are not route rejections and never switch.", "statuses": [404, 405, 415], "phraseStatuses": [403], "phrases": ["does not allow /v1/messages dispatch"], "htmlSuccessIsRouteRejection": true},
  "protocolFallbackCases": [
    {"caseId": "reachable_404_tries_next_candidate", "current": "responses", "source": "reachable", "candidates": ["responses", "chat"], "status": 404, "outputStarted": false, "alreadySwitched": false, "expectNext": "chat"},
    {"caseId": "following_connection_415_tries_next_candidate", "current": "messages", "source": null, "candidates": ["messages", "chat"], "status": 415, "outputStarted": false, "alreadySwitched": false, "expectNext": "chat"},
    {"caseId": "observed_404_tries_next_candidate", "current": "chat", "source": "observed", "candidates": ["responses", "chat"], "status": 404, "outputStarted": false, "alreadySwitched": false, "expectNext": "responses"},
    {"caseId": "user_source_never_switches", "current": "responses", "source": "user", "candidates": ["responses", "chat"], "status": 404, "outputStarted": false, "alreadySwitched": false, "expectNext": null},
    {"caseId": "only_once_per_message", "current": "chat", "source": "observed", "candidates": ["responses", "chat"], "status": 404, "outputStarted": false, "alreadySwitched": true, "expectNext": null},
    {"caseId": "status_400_does_not_switch", "current": "responses", "source": "reachable", "candidates": ["responses", "chat"], "status": 400, "outputStarted": false, "alreadySwitched": false, "expectNext": null},
    {"caseId": "status_422_does_not_switch", "current": "responses", "source": "reachable", "candidates": ["responses", "chat"], "status": 422, "outputStarted": false, "alreadySwitched": false, "expectNext": null},
    {"caseId": "status_500_does_not_switch", "current": "responses", "source": "reachable", "candidates": ["responses", "chat"], "status": 500, "outputStarted": false, "alreadySwitched": false, "expectNext": null},
    {"caseId": "after_output_does_not_switch", "current": "responses", "source": "reachable", "candidates": ["responses", "chat"], "status": 404, "outputStarted": true, "alreadySwitched": false, "expectNext": null},
    {"caseId": "no_other_candidate_does_not_switch", "current": "chat", "source": null, "candidates": ["chat"], "status": 404, "outputStarted": false, "alreadySwitched": false, "expectNext": null},
    {"caseId": "status_405_tries_next_candidate", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 405, "expectNext": "chat"},
    {"caseId": "status_403_with_route_phrase_tries_next_candidate", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This group does not allow /v1/messages dispatch\"}}", "expectNext": "chat"},
    {"caseId": "status_403_without_route_phrase_does_not_switch", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 403, "body": "{\"error\":{\"message\":\"该令牌无权访问模型 claude-sonnet-4-5\",\"type\":\"new_api_error\"}}", "expectNext": null},
    {"caseId": "status_401_does_not_switch", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 401, "expectNext": null},
    {"caseId": "status_429_does_not_switch", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 429, "expectNext": null},
    {"caseId": "html_page_with_200_tries_next_candidate", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 200, "contentType": "text/html; charset=utf-8", "body": "<!doctype html><html><head><title>Relay</title></head><body><div id=\"root\"></div></body></html>", "expectNext": "chat"},
    {"caseId": "status_403_with_escaped_route_phrase_tries_next_candidate", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This group does not allow \\/v1\\/messages dispatch\"}}", "expectNext": "chat"},
    {"caseId": "status_403_client_gate_does_not_switch", "current": "messages", "source": null, "candidates": ["messages", "chat"], "outputStarted": false, "alreadySwitched": false, "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This API endpoint is only accessible via the official Claude CLI\"}}", "expectNext": null}
  ],
  "clientGateRules": {"$comment": "A pre-output 403 whose body contains one of phrases (case-insensitive substring, after unescaping `\\/`) means the key's group on this connection only serves an official CLI client. It is neither a key problem (key-access.v1.json classifies it `none`) nor a route rejection (it never switches protocol; sub2api answers the same group's Chat and Responses with the same kind of 403). Each end maps it to one relay guidance message (iOS key starts \"This key's group only accepts the official Claude CLI.\"), never to the generic invalid-key message; official providers never get it. Oriveo does not send or imitate any CLI identity. Sources: www.packyapi.ai on Messages, reported 2026-10-12 (message text verbatim, envelope assumed); sub2api ClaudeCodeOnly group (Wei-Shaw/sub2api backend/internal/handler/gateway_handler_chat_completions.go L107-114, read at 3a6fd1c9db07); Chinese relay wording seen by Oriveo Managed upstream checks. Test names: RL2-CLIGATE-<caseId>.", "statuses": [403], "phrases": ["official claude cli", "restricted to claude code clients", "标准 claude code 客户端"]},
  "clientGateCases": [
    {"caseId": "packyapi_official_claude_cli_403", "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This API endpoint is only accessible via the official Claude CLI\"}}", "expect": "client_gated"},
    {"caseId": "sub2api_claude_code_only_group_403", "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This group is restricted to Claude Code clients (/v1/messages only)\"}}", "expect": "client_gated"},
    {"caseId": "chinese_standard_claude_code_client_403", "status": 403, "body": "{\"error\":{\"message\":\"客户端异常，请使用标准 Claude Code 客户端\",\"type\":\"new_api_error\"}}", "expect": "client_gated"},
    {"caseId": "uppercase_phrase_403", "status": 403, "body": "{\"error\":{\"message\":\"ONLY ACCESSIBLE VIA THE OFFICIAL CLAUDE CLI\"}}", "expect": "client_gated"},
    {"caseId": "same_phrase_on_401_is_none", "status": 401, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This API endpoint is only accessible via the official Claude CLI\"}}", "expect": "none"},
    {"caseId": "codex_identity_403_is_none", "status": 403, "body": "{\"error\":{\"message\":\"Only Codex official clients are allowed\"}}", "expect": "none"},
    {"caseId": "token_model_forbidden_403_is_none", "status": 403, "body": "{\"error\":{\"message\":\"该令牌无权访问模型 claude-sonnet-4-5\",\"type\":\"new_api_error\"}}", "expect": "none"},
    {"caseId": "messages_dispatch_403_is_none", "status": 403, "body": "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"This group does not allow \\/v1\\/messages dispatch\"}}", "expect": "none"}
  ],
  "advancedBoardCasesComment": "Relay advanced board (per-model capability rows) must give the same state as the composer entry projection, and a source that explains it. Precedence: user override > live negative-cache rejection (source detected; desktop enum NegativeCache) > tested override > engine declaration > official catalog. Local connections follow the same order. An auto-transport model resolves its effective transport before building the capability identity, so catalog-declared rows keep source catalog. Ends map their own source enums: user / tested / detected / engine / catalog.",
