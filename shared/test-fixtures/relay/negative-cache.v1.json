    {"caseId": "board_tested_loses_to_negative_cache", "connection": "remote", "transport": "openai_chat", "capability": "image", "override": {"value": true, "source": "tested"}, "negCacheRejected": true, "catalogDeclares": false, "expect": {"state": "unsupported", "source": "detected"}},
    {"caseId": "board_user_beats_negative_cache", "connection": "remote", "transport": "openai_chat", "capability": "image", "override": {"value": true, "source": "user"}, "negCacheRejected": true, "catalogDeclares": false, "expect": {"state": "supported", "source": "user"}},
    {"caseId": "board_local_tested_loses_to_negative_cache", "connection": "local", "transport": "openai_chat", "capability": "image", "override": {"value": true, "source": "tested"}, "negCacheRejected": true, "catalogDeclares": false, "expect": {"state": "unsupported", "source": "detected"}},
    {"caseId": "board_auto_transport_keeps_catalog_source", "connection": "remote", "transport": "auto", "capability": "image", "override": null, "negCacheRejected": false, "catalogDeclares": true, "expect": {"state": "supported", "source": "catalog"}}
  ]
