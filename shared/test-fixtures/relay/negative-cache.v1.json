{
  "$comment": "Relay 2.0 upstream rejection loop (upstream rejection handling for Relay connections). Relay form only. A rejection is exactly what capability-test.v1.json classifyCases calls `rejected` (400 / 404 / 415 / 422, or a 2xx JSON body whose top-level `error` is non-empty with no non-null choices / output / content / candidates); `accepted` and `undetermined` (401 / 403 / 408 / 413 / 429 / other 4xx / 5xx / HTML / timeout / network) never write. Only rejections that arrive before any output count; an error frame after output started marks the message failed, keeps text and reasoning, never resends and never writes. Entries are keyed connection x model x transport x kind, persisted locally (never synced), expire ttlSeconds after recordedAt (an entry is a hit while now - recordedAt < ttlSeconds). Times are seconds since an arbitrary epoch. imageRecordCases: an image rejection is recorded only when the request carried an image and the model has no positive vision evidence of any grade (no override true, no engine declaration true, and the model capabilities - inherited from the official catalog or declared - do not include image); never after output started or after this message already switched protocol. Transports use the short names of `transports`.",
  "version": 1,
  "ttlSeconds": 604800,
  "transports": {"chat": "openai_chat_completions", "responses": "openai_responses", "messages": "anthropic_messages", "gemini": "gemini_generate_content"},
  "kinds": ["image", "file", "toolCall"],
  "keyCases": [
    {"caseId": "same_key_within_ttl_hits", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 1000}, "query": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 605799}, "expectHit": true},
    {"caseId": "expires_at_seven_days", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 1000}, "query": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 605800}, "expectHit": false},
    {"caseId": "other_model_same_connection_unaffected", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "toolCall", "at": 1000}, "query": {"connectionId": "c1", "modelId": "m2", "transport": "chat", "kind": "toolCall", "at": 2000}, "expectHit": false},
    {"caseId": "other_transport_unaffected", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "toolCall", "at": 1000}, "query": {"connectionId": "c1", "modelId": "m1", "transport": "responses", "kind": "toolCall", "at": 2000}, "expectHit": false},
    {"caseId": "other_connection_unaffected", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 1000}, "query": {"connectionId": "c2", "modelId": "m1", "transport": "chat", "kind": "image", "at": 2000}, "expectHit": false},
    {"caseId": "other_kind_unaffected", "record": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "image", "at": 1000}, "query": {"connectionId": "c1", "modelId": "m1", "transport": "chat", "kind": "file", "at": 2000}, "expectHit": false}
  ],
