  "presentationCases": [
    {
      "$comment": "Web row of the model options panel for a Relay-form model: only the two rows that do not depend on the web toggle stay here (local engine; protocol undecided). Every other row (toggle, status, sends, truth) is web-probe.v1.json presentationCases: web search is a chat toggle like official providers, the fragment is sent only when the toggle is on, and with no saved fragment the transport template is the effective fragment.",
      "caseId": "local_engine_connection_cannot",
      "engineProfile": "ollama",
      "protocolUndecided": false,
      "effectiveTransport": "openai_chat_completions",
      "fragments": {},
      "expect": {
        "shape": "disclosure",
        "status": "This connection can’t do this"
      }
    },
    {
      "caseId": "protocol_undecided_first",
      "engineProfile": null,
      "protocolUndecided": true,
      "effectiveTransport": "openai_chat_completions",
      "fragments": {
        "openai_chat_completions": {
          "web_search_options": {}
        }
      },
      "expect": {
        "shape": "protocolUndecided"
      }
    }
  ]
