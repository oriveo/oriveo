          "type": "web_search"
        }
      ]
    },
    "kimi_web_search": {
      "tools": [
        {
          "function": {
            "name": "$web_search"
          },
          "type": "builtin_function"
        }
      ]
    },
    "oai_responses_web": {
      "tool_choice": "auto",
      "tools": [
        {
          "type": "web_search"
        }
      ]
    },
    "oai_web_tool": {},
    "or_web": {
      "plugins": [
        {
          "id": "web",
          "max_results": 5
        }
      ]
    },
    "qwen_web": {
      "enable_search": true
    },
    "zhipu_web": {
      "tools": [
        {
          "type": "web_search",
          "web_search": {
            "enable": true,
            "search_engine": "search_pro",
            "search_result": true
          }
        }
      ]
    }
  },
  "profileTransport": {
    "oai_responses_web": "openai_responses",
    "grok_responses_web": "openai_responses",
    "ant_web_tool": "anthropic_messages",
    "gem_web": "gemini_generate_content",
    "gem_web_retrieval": "gemini_generate_content",
    "or_web": "openai_chat_completions",
    "qwen_web": "openai_chat_completions",
    "zhipu_web": "openai_chat_completions",
    "oai_web_tool": "openai_chat_completions",
    "kimi_web_search": "openai_chat_completions"
  },
  "legacyCases": [
    {
      "$comment": "Read-time mapping of the legacy connection fields (only when no stored fragment exists). hasWebSearch must be true. Known profile with non-empty mergeParams (after dropping forbiddenTopLevelKeys; kimi_web_search excluded because it needs a tool loop) → one fragment on profileTransport[profile]. No profile, or a profile missing from the metadata profiles → Responses fragment {tools:[{type: webSearchToolName ?? 'web_search'}]} unless webSearchToolName == 'disabled', plus the Gemini template. Mapping result is never written back.",
      "caseId": "no_flag_no_fragment",
      "stored": {},
      "relayRequested": {},
      "expect": {}
    },
    {
      "caseId": "flag_false_ignores_profile",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": false,
        "webSearchProfile": "ant_web_tool"
      },
      "expect": {}
    },
    {
      "caseId": "flag_without_profile_maps_to_responses_and_gemini",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true
      },
      "expect": {
        "openai_responses": {
          "tools": [
            {
              "type": "web_search"
            }
          ]
        },
        "gemini_generate_content": {
          "tools": [
            {
              "googleSearch": {}
            }
          ]
        }
      }
    },
    {
      "caseId": "flag_without_profile_keeps_preview_tool_name",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchToolName": "web_search_preview"
      },
      "expect": {
        "openai_responses": {
          "tools": [
            {
              "type": "web_search_preview"
            }
          ]
        },
        "gemini_generate_content": {
          "tools": [
            {
              "googleSearch": {}
            }
          ]
        }
      }
    },
    {
      "caseId": "flag_without_profile_tool_disabled_keeps_gemini_only",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchToolName": "disabled"
      },
      "expect": {
        "gemini_generate_content": {
          "tools": [
            {
              "googleSearch": {}
            }
          ]
        }
      }
    },
    {
      "caseId": "anthropic_profile_maps_to_messages",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "ant_web_tool"
      },
      "expect": {
        "anthropic_messages": {
          "tools": [
            {
              "max_uses": 5,
              "name": "web_search",
              "type": "web_search_20250305"
            }
          ]
        }
      }
    },
    {
      "caseId": "openrouter_profile_maps_to_chat_plugins",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "or_web"
      },
      "expect": {
        "openai_chat_completions": {
          "plugins": [
            {
              "id": "web",
              "max_results": 5
            }
          ]
        }
      }
    },
    {
      "caseId": "responses_profile_drops_tool_choice",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "oai_responses_web"
      },
      "expect": {
        "openai_responses": {
          "tools": [
            {
              "type": "web_search"
            }
          ]
        }
      }
    },
    {
      "caseId": "gemini_profile_keeps_its_spelling",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "gem_web"
      },
      "expect": {
        "gemini_generate_content": {
          "tools": [
            {
              "google_search": {}
            }
          ]
        }
      }
    },
    {
      "caseId": "qwen_profile_maps_to_chat",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "qwen_web"
      },
      "expect": {
        "openai_chat_completions": {
          "enable_search": true
        }
      }
    },
    {
      "caseId": "kimi_profile_needs_a_tool_loop_and_is_not_mapped",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "kimi_web_search"
      },
      "expect": {}
    },
    {
      "caseId": "empty_merge_params_profile_is_not_mapped",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "oai_web_tool"
      },
      "expect": {}
    },
    {
      "caseId": "unknown_profile_falls_back_to_the_no_profile_defaults",
      "stored": {},
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "future_web"
      },
      "expect": {
        "openai_responses": {
          "tools": [
            {
              "type": "web_search"
            }
          ]
        },
        "gemini_generate_content": {
          "tools": [
            {
              "googleSearch": {}
            }
          ]
        }
      }
    },
    {
      "caseId": "stored_fragments_win_over_the_legacy_flag",
      "stored": {
        "openai_chat_completions": {
          "plugins": [
            {
              "id": "web"
            }
          ]
        }
      },
      "relayRequested": {
        "hasWebSearch": true,
        "webSearchProfile": "ant_web_tool"
      },
      "expect": {
        "openai_chat_completions": {
          "plugins": [
            {
              "id": "web"
            }
          ]
        }
      }
    }
  ],
  "citationCases": [
