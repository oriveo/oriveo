{
  "$comment": "Relay connection-level web search fragments. One JSON object per wire protocol per connection, stored on this device only (iOS UserDefaults / Android SharedPreferences `relay_web_fragments.v1`, Web localStorage `oriveo.relay-web-fragments.v1`, keyed by connection id). A fragment is sent only when the chat web toggle is on (web-probe.v1.json presentationCases); the effective fragment of a transport is the saved one, else templates[transport]. Earlier versions sent a saved fragment on every chat request of that connection whose effective protocol matches (text / image / tool capability-test items and auxiliary requests never carry it; the web search probe item does, see web-probe.v1.json). effectiveFragments(stored, relayRequested, profiles) = stored when it has at least one entry, otherwise legacyCases mapping (read-time only, never written back). Saving on the web search page clears the two legacy fields.",
  "version": 1,
  "transports": [
    "openai_chat_completions",
    "openai_responses",
    "anthropic_messages",
    "gemini_generate_content"
  ],
  "templates": {
    "openai_responses": {
      "tools": [
        {
          "type": "web_search"
        }
      ]
    },
    "openai_chat_completions": {
      "web_search_options": {}
    },
    "anthropic_messages": {
      "tools": [
        {
          "type": "web_search_20250305",
          "name": "web_search",
          "max_uses": 5
        }
      ]
    },
    "gemini_generate_content": {
      "tools": [
        {
          "googleSearch": {}
        }
      ]
    }
  },
  "limits": {
    "maxBytes": 8192,
    "forbiddenTopLevelKeys": [
      "model",
      "messages",
      "input",
      "contents",
      "system",
      "systemInstruction",
      "system_instruction",
      "instructions",
      "stream",
      "stream_options",
      "previous_response_id",
      "tool_choice",
      "toolConfig",
      "tool_config"
    ],
    "functionToolMarkers": {
      "typeEquals": "function",
      "keys": [
        "functionDeclarations",
        "function_declarations"
      ]
    }
  },
  "validateCases": [
    {
      "$comment": "raw is the editor text. Order of checks: not_json, not_object, empty, too_large (UTF-8 bytes of raw), forbidden_key (first offending key in `limits.forbiddenTopLevelKeys` order), invalid_tools (tools not an array of objects), function_tool. `rawPadTo: N` means raw = '{\"x\":\"' + 'a' repeated N-8 times + '\"}' (exactly N bytes).",
      "caseId": "responses_template_is_valid",
      "raw": "{\"tools\": [{\"type\": \"web_search\"}]}",
      "expect": {
        "ok": true
      }
    },
    {
      "caseId": "messages_template_is_valid",
      "raw": "{\"tools\": [{\"type\": \"web_search_20250305\", \"name\": \"web_search\", \"max_uses\": 5}]}",
      "expect": {
        "ok": true
      }
    },
    {
      "caseId": "chat_template_is_valid",
      "raw": "{\"web_search_options\": {}}",
      "expect": {
        "ok": true
      }
    },
    {
      "caseId": "gemini_template_is_valid",
      "raw": "{\"tools\": [{\"googleSearch\": {}}]}",
      "expect": {
        "ok": true
      }
    },
    {
      "caseId": "broken_json",
      "raw": "{\"tools\":[",
      "expect": {
        "ok": false,
        "error": "not_json"
      }
    },
    {
      "caseId": "array_is_not_an_object",
      "raw": "[]",
      "expect": {
        "ok": false,
        "error": "not_object"
      }
    },
    {
      "caseId": "empty_object",
      "raw": "{}",
      "expect": {
        "ok": false,
        "error": "empty"
      }
    },
    {
      "caseId": "over_8kb",
      "rawPadTo": 8193,
      "expect": {
        "ok": false,
        "error": "too_large"
      }
    },
    {
      "caseId": "exactly_8kb_is_fine",
      "rawPadTo": 8192,
      "expect": {
        "ok": true
      }
    },
    {
      "caseId": "model_key_is_forbidden",
      "raw": "{\"model\":\"x\",\"plugins\":[{\"id\":\"web\"}]}",
      "expect": {
        "ok": false,
        "error": "forbidden_key",
        "key": "model"
      }
    },
    {
      "caseId": "tool_choice_is_forbidden",
      "raw": "{\"tools\":[{\"type\":\"web_search\"}],\"tool_choice\":\"auto\"}",
      "expect": {
        "ok": false,
        "error": "forbidden_key",
        "key": "tool_choice"
      }
    },
    {
      "caseId": "tools_must_be_an_array",
      "raw": "{\"tools\":{\"type\":\"web_search\"}}",
      "expect": {
        "ok": false,
        "error": "invalid_tools"
      }
    },
    {
      "caseId": "tools_entries_must_be_objects",
      "raw": "{\"tools\":[\"web_search\"]}",
      "expect": {
        "ok": false,
        "error": "invalid_tools"
      }
    },
    {
      "caseId": "function_tool_is_rejected",
      "raw": "{\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"f\"}}]}",
      "expect": {
        "ok": false,
        "error": "function_tool"
      }
    },
    {
      "caseId": "gemini_function_declarations_are_rejected",
      "raw": "{\"tools\":[{\"functionDeclarations\":[{\"name\":\"f\"}]}]}",
      "expect": {
        "ok": false,
        "error": "function_tool"
      }
    },
    {
      "caseId": "non_tool_keys_are_fine",
      "raw": "{\"plugins\":[{\"id\":\"web\"}],\"web_search_options\":{\"search_context_size\":\"low\"}}",
      "expect": {
        "ok": true
      }
    }
  ],
  "mergeCases": [
    {
      "$comment": "merge(transport, builderBody, fragment): tools are appended after the builder's tools (Gemini: when the builder body already has a tools entry with functionDeclarations, the fragment's tools are skipped entirely); every other key deep-merges and on a leaf / type conflict the builder value wins. Runs after the protocol builder and before the user's additional request body.",
      "caseId": "responses_appends_after_function_tools",
      "transport": "openai_responses",
      "builderBody": {
        "model": "m",
        "input": [
          {
            "role": "user",
            "content": "hi"
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "lookup",
            "parameters": {}
          }
        ]
      },
      "fragment": {
        "tools": [
          {
            "type": "web_search"
          }
        ]
      },
      "expect": {
        "model": "m",
        "input": [
          {
            "role": "user",
            "content": "hi"
          }
        ],
        "tools": [
          {
            "type": "function",
            "name": "lookup",
            "parameters": {}
          },
          {
            "type": "web_search"
          }
        ]
      }
    },
    {
      "caseId": "responses_without_builder_tools",
      "transport": "openai_responses",
      "builderBody": {
        "model": "m",
        "input": "hi",
        "stream": true
      },
      "fragment": {
        "tools": [
          {
            "type": "web_search"
          }
        ]
      },
      "expect": {
        "model": "m",
        "input": "hi",
        "stream": true,
        "tools": [
          {
            "type": "web_search"
          }
        ]
      }
    },
    {
      "caseId": "messages_template_lands_in_tools",
      "transport": "anthropic_messages",
      "builderBody": {
        "model": "m",
        "messages": [],
        "max_tokens": 8192
      },
      "fragment": {
        "tools": [
          {
            "type": "web_search_20250305",
            "name": "web_search",
            "max_uses": 5
          }
        ]
      },
      "expect": {
        "model": "m",
        "messages": [],
        "max_tokens": 8192,
        "tools": [
          {
            "type": "web_search_20250305",
            "name": "web_search",
            "max_uses": 5
          }
        ]
      }
    },
    {
      "caseId": "gemini_without_function_tools",
      "transport": "gemini_generate_content",
      "builderBody": {
        "contents": []
      },
      "fragment": {
        "tools": [
          {
            "googleSearch": {}
          }
        ]
      },
      "expect": {
        "contents": [],
        "tools": [
          {
            "googleSearch": {}
          }
        ]
      }
    },
    {
      "caseId": "gemini_function_tools_skip_fragment_tools",
      "transport": "gemini_generate_content",
      "builderBody": {
        "contents": [],
        "tools": [
          {
            "functionDeclarations": [
              {
                "name": "f"
              }
            ]
          }
        ]
      },
      "fragment": {
        "tools": [
          {
            "googleSearch": {}
          }
        ],
        "generationConfig": {
          "candidateCount": 1
        }
      },
      "expect": {
        "contents": [],
        "tools": [
          {
            "functionDeclarations": [
              {
                "name": "f"
              }
            ]
          }
        ],
        "generationConfig": {
          "candidateCount": 1
        }
      }
    },
    {
      "caseId": "chat_object_key_is_added",
      "transport": "openai_chat_completions",
      "builderBody": {
        "model": "m",
        "messages": [],
        "stream": true
      },
      "fragment": {
        "web_search_options": {
          "search_context_size": "low"
        }
      },
      "expect": {
        "model": "m",
        "messages": [],
        "stream": true,
        "web_search_options": {
          "search_context_size": "low"
        }
      }
    },
    {
      "caseId": "builder_leaf_wins_on_conflict",
      "transport": "openai_chat_completions",
      "builderBody": {
        "model": "m",
        "messages": [],
        "web_search_options": {
          "search_context_size": "high"
        }
      },
      "fragment": {
        "web_search_options": {
          "search_context_size": "low",
          "user_location": {
            "type": "approximate"
          }
        }
      },
      "expect": {
        "model": "m",
        "messages": [],
        "web_search_options": {
          "search_context_size": "high",
          "user_location": {
            "type": "approximate"
          }
        }
      }
    },
    {
      "caseId": "chat_plugins_are_added",
      "transport": "openai_chat_completions",
      "builderBody": {
        "model": "m",
        "messages": []
      },
      "fragment": {
        "plugins": [
          {
            "id": "web",
            "max_results": 5
          }
        ]
      },
      "expect": {
        "model": "m",
        "messages": [],
        "plugins": [
          {
            "id": "web",
            "max_results": 5
          }
        ]
      }
    }
  ],
  "legacyProfiles": {
    "ant_web_tool": {
      "tools": [
        {
          "max_uses": 5,
          "name": "web_search",
          "type": "web_search_20250305"
        }
      ]
    },
    "gem_web": {
      "tools": [
        {
          "google_search": {}
        }
      ]
    },
    "gem_web_retrieval": {
