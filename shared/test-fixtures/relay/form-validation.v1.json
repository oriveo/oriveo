      "caseId": "cleartext_endpoint_rejected_create",
      "$comment": "An http:// address while the connection claims public HTTPS. The endpoint policy owns this verdict; the form does not keep a second copy of the rule.",
      "mode": "create",
      "draft": {
        "endpoint": "http://relay.example.com/v1",
        "apiKey": "sk-relay-0123456789abcdef",
        "authMode": "bearer",
