            "field": "endpoint",
            "code": "endpoint_rejected",
            "detail": "cleartext_not_allowed"
          }
        ]
      }
    },
    {
      "caseId": "local_http_keyless_edit_allowed",
      "$comment": "A local engine reached over plain http. The edit form used to measure every address against the public-HTTPS rule, which made this address permanently invalid and blocked saving even a rename.",
      "mode": "edit",
