{
  "$comment": "Field layout and validation for the relay connection form, shared across clients. Adding a connection and editing a saved one use the same field order and the same validation function: `form.fields` pins the layout, `cases` pin the verdicts. The four credential states crossed with create and edit are the point of the file - the question \"does this connection need a key?\" used to be answered separately by the edit path, the create path and the status badge, which is how a connection with authentication set to none became impossible to save and impossible to change. `labelEN` is the one label wording every client can assert against: each resolves its own English string and compares it to this value.",
  "version": 1,
  "form": {
    "$comment": "Array order is the top-to-bottom render order, and both the create and the edit form follow it, so the two layouts cannot drift apart. `placeholder` is null when the row has no placeholder or its placeholder is dynamic - the model row shows an id taken from the live catalog. `revalidation` says whether editing the row invalidates the current probe result.",
    "fields": [
      {
        "field": "endpoint",
        "group": "connection",
        "labelEN": "Request URL",
        "placeholder": "https://api.example.com/v1",
        "revalidation": "always"
      },
      {
        "field": "security_mode",
        "group": "connection",
        "labelEN": "Connection security",
        "placeholder": null,
        "revalidation": "always"
      },
      {
        "field": "api_key",
        "group": "connection",
        "labelEN": "API Key",
        "placeholder": "sk-...",
        "revalidation": "always"
      },
      {
        "field": "model_id",
        "group": "connection",
        "labelEN": "Model",
        "placeholder": null,
        "revalidation": "unless_within_discovered_catalog"
      },
      {
        "field": "transport",
        "group": "protocol",
        "labelEN": "Protocol",
        "placeholder": null,
        "revalidation": "always"
      },
      {
        "field": "auth_mode",
        "group": "protocol",
        "labelEN": "Authentication",
        "placeholder": null,
        "revalidation": "always"
      },
      {
        "field": "headers",
        "group": "advanced_http",
        "labelEN": "Custom Headers",
        "placeholder": "X-Internal-Token",
        "revalidation": "always"
      },
      {
        "field": "query_params",
        "group": "advanced_http",
        "labelEN": "Custom Query Params",
        "placeholder": "tenant",
        "revalidation": "always"
      }
    ]
  },
  "credentialMatrix": [
    {
      "state": "never_entered_requires_credential",
      "$comment": "No key has ever been entered and this connection needs one. Creating must be blocked; editing must not be. An empty field in edit mode means \"leave the stored key alone\", and a genuinely missing credential is reported by the connection's own status, not by refusing to save an unrelated field."
    },
    {
      "state": "never_entered_auth_none",
      "$comment": "No key has ever been entered and authentication is set to none. Both modes are valid: a keyless connection must not be pushed towards some other, less capable entry point."
    },
    {
      "state": "stored_only_other_fields_changed",
      "$comment": "A key is already stored and this edit only touches other fields. An empty field in edit mode means \"do not change it\"; create mode has no stored key, so the equivalent is a key typed into the form now."
    },
    {
      "state": "explicit_removal",
      "$comment": "The user removes the key on purpose. Only the key is cleared - the authentication mode is not silently changed along with it, and editing still must not make a credential mandatory."
    }
  ],
  "cases": [
    {
      "caseId": "never_entered_requires_credential_create",
      "matrixState": "never_entered_requires_credential",
      "mode": "create",
      "draft": {
        "endpoint": "https://relay.example.com/v1",
        "apiKey": "",
        "authMode": "bearer",
        "securityMode": "remote_https",
        "transport": "openai_chat_completions",
        "modelId": "",
        "headers": [],
        "queryParams": [],
        "hasSavedCredential": false
      },
      "expect": {
        "valid": false,
        "issues": [
          {
            "field": "api_key",
            "code": "credential_required"
          }
        ]
      }
    },
    {
      "caseId": "never_entered_requires_credential_edit",
      "matrixState": "never_entered_requires_credential",
      "mode": "edit",
