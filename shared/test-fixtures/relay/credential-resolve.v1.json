{
  "$comment": "Relay 2.0 per-model API key entry. Every production read of a connection key goes through one entry: iOS ProviderCredentialResolver.apiKey(provider:modelID:), Android ProviderCredentialResolver.apiKey(provider, modelId), Web resolveProviderAPIKey(provider, modelId). With a single key per connection (today) the entry returns provider.apiKey byte for byte: no trim, no fallback, no dependence on modelId. Test names: CREDENTIAL-RESOLVE-<id>. Multi-key (key-binding.v1.json): `multiKeyCases` resolve through relayKeys + the model's relayKeyID -- bound key's secret; absent / dangling relayKeyID, unknown model or null modelId -> the primary secret (provider.apiKey); a non-relay provider ignores relayKeys. Existing `cases` stay green unchanged.",
  "version": 1,
  "cases": [
    {"id": "single_key_no_model", "provider": {"id": "relay-a", "kind": "relay", "apiKey": "sk-relay-a", "models": ["gpt-4o"]}, "modelId": null, "expect": "sk-relay-a"},
    {"id": "single_key_enabled_model", "provider": {"id": "relay-a", "kind": "relay", "apiKey": "sk-relay-a", "models": ["gpt-4o", "claude-sonnet-4-5"]}, "modelId": "claude-sonnet-4-5", "expect": "sk-relay-a"},
    {"id": "single_key_unknown_model", "provider": {"id": "relay-a", "kind": "relay", "apiKey": "sk-relay-a", "models": ["gpt-4o"]}, "modelId": "not-in-list", "expect": "sk-relay-a"},
    {"id": "single_key_whitespace_preserved", "provider": {"id": "relay-b", "kind": "relay", "apiKey": "  sk-relay-b \n", "models": ["gpt-4o"]}, "modelId": "gpt-4o", "expect": "  sk-relay-b \n"},
    {"id": "empty_key_stays_empty", "provider": {"id": "relay-c", "kind": "relay", "apiKey": "", "models": ["gpt-4o"]}, "modelId": "gpt-4o", "expect": ""},
    {"id": "official_provider_same_key", "provider": {"id": "openai", "kind": "openAI", "apiKey": "sk-official", "models": ["gpt-4o"]}, "modelId": "gpt-4o", "expect": "sk-official"}
  ],
  "sendCase": {
    "id": "SEND-relay_single_key_authorization",
    "$comment": "Production-path proof: build one relay chat request through the production send entry (which now reads the key via the entry) and assert the Authorization header the builder actually produced.",
    "provider": {"id": "relay-a", "kind": "relay", "apiKey": "sk-relay-a", "baseURL": "https://relay.example.com/v1", "models": ["gpt-4o"]},
    "modelId": "gpt-4o",
    "expectAuthorization": "Bearer sk-relay-a"
  },
  "multiKeyCases": [
    {"id": "multi_bound_second_key", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "initial"}, {"id": "claude-sonnet-4-5", "relayKeyID": "k-claude"}]}, "modelId": "claude-sonnet-4-5", "expect": "sk-claude"},
    {"id": "multi_bound_primary", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "initial"}]}, "modelId": "gpt-4o", "expect": "sk-primary"},
    {"id": "multi_no_key_id_uses_primary", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o"}]}, "modelId": "gpt-4o", "expect": "sk-primary"},
    {"id": "multi_dangling_key_id_uses_primary", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "k-deleted"}]}, "modelId": "gpt-4o", "expect": "sk-primary"},
    {"id": "multi_unknown_model_uses_primary", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "k-claude"}]}, "modelId": "not-enabled", "expect": "sk-primary"},
    {"id": "multi_null_model_uses_primary", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "claude-sonnet-4-5", "relayKeyID": "k-claude"}]}, "modelId": null, "expect": "sk-primary"},
    {"id": "multi_primary_slot_secret_ignored", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "apiKey": "stale-copy"}, {"id": "k-claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "initial"}]}, "modelId": "gpt-4o", "expect": "sk-primary"},
    {"id": "multi_bound_secret_not_trimmed", "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "apiKey": ""}, {"id": "k-claude", "apiKey": " sk-claude\n"}], "models": [{"id": "claude-sonnet-4-5", "relayKeyID": "k-claude"}]}, "modelId": "claude-sonnet-4-5", "expect": " sk-claude\n"},
    {"id": "official_provider_ignores_relay_keys", "provider": {"id": "openai", "kind": "openAI", "apiKey": "sk-primary", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "k-claude"}]}, "modelId": "gpt-4o", "expect": "sk-primary"}
  ],
  "multiKeySendCase": {
    "id": "SEND-relay_bound_key_authorization",
    "$comment": "Production-path proof: same connection, a model bound to k-claude; the production send builder's Authorization carries the bound key, while a model bound to the primary carries provider.apiKey.",
    "provider": {"id": "relay-m", "kind": "relay", "apiKey": "sk-primary", "baseURL": "https://relay.example.com/v1", "relayKeys": [{"id": "initial", "name": "OpenAI", "apiKey": ""}, {"id": "k-claude", "name": "Claude", "apiKey": "sk-claude"}], "models": [{"id": "gpt-4o", "relayKeyID": "initial"}, {"id": "claude-sonnet-4-5", "relayKeyID": "k-claude"}]},
    "expect": {"gpt-4o": "Bearer sk-primary", "claude-sonnet-4-5": "Bearer sk-claude"}
  }
}
