        "imageStyle": "vivid",
        "imageCount": 2,
        "imageResponseFormat": "b64_json",
        "webSearchToolName": "web_search",
        "hasWebSearch": true,
        "webSearchProfile": "oai_responses_web",
        "transportKind": "openai_responses",
