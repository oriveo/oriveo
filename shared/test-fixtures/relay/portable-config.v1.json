{
  "$comment": "The allowlist of relay connection settings that may leave the device in a backup export. It has to be an allowlist rather than a copy-everything-then-delete denylist: under a denylist every field added later leaves the device by default, and stays private only if someone remembers to exclude it. `allFields` is the complete settings surface on every client, and each client asserts that its own field enumeration equals it, so adding a field without deciding portable-versus-local turns the suite red.",
  "version": 1,
  "allFields": [
    "transport",
    "authMode",
    "securityMode",
    "modelID",
    "reasoningEffort",
    "serviceTier",
    "stream",
    "disableResponseStorage",
    "headers",
    "queryParams",
    "codexCompatIdentity",
    "customUserAgent",
    "imageSize",
    "imageQuality",
    "imageStyle",
    "imageCount",
    "imageResponseFormat",
    "webSearchToolName",
    "hasWebSearch",
    "webSearchProfile",
    "transportKind",
    "resolvedAPIBaseURL",
    "resolvedAPIBaseURLs",
    "engineProfile",
    "certificateFingerprint"
  ],
  "portableFields": [
    "transport",
    "authMode",
    "securityMode",
    "modelID",
    "reasoningEffort",
    "serviceTier",
    "stream",
    "disableResponseStorage",
    "codexCompatIdentity",
    "imageSize",
    "imageQuality",
    "imageStyle",
    "imageCount",
    "imageResponseFormat",
    "webSearchToolName",
    "hasWebSearch",
    "webSearchProfile",
    "transportKind",
    "resolvedAPIBaseURL",
    "resolvedAPIBaseURLs",
    "engineProfile"
  ],
  "localOnlyFields": [
    {
      "field": "headers",
      "reason": "custom_header_values_may_carry_a_second_credential"
    },
    {
      "field": "queryParams",
      "reason": "query_values_may_carry_a_second_credential"
    },
    {
      "field": "customUserAgent",
      "reason": "already_treated_as_credential_material_on_device_and_raises_fingerprinting_surface"
    },
    {
      "field": "certificateFingerprint",
      "reason": "device_bound_tofu_pin_repaired_by_re_pairing_not_worth_carrying_out"
    }
  ],
