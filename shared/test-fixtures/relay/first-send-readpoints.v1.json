{
  "$comment": "Relay read points when the protocol is not chosen. firstSendCases: every read point that needs a protocol for a relay model - input entry and its evidence identity, the advanced board rows including the catalog source row and 'Auto =', the negative cache key, the tool-call final transport - uses the first-send protocol (no attachments): the model's own protocol, else the connection's chosen protocol, else (connection auto, not a local engine, not an image-generation model) the first candidate of the model's endpoint types or family table, Messages when that first candidate is Messages, otherwise effectiveTransport (auto => chat). effectiveTransport alone is never a read point. fileFallbackCases (send routing, not a read point): a turn whose first send is Messages falls back to effectiveTransport only when the outbound request carries files - judged over the whole history sent this turn, not just the new message, because every earlier attachment goes out again in the body - none of them has usable extracted text, and the per-file attachment plan on the Messages line sends none of them natively (messagesNative = that end's own plan: catalog / file override Off / envelope nativeFile / MIME / size / PDF default); images never trigger it; 'any textless file' is not enough. boardAutoEquals is null only when the user picked the protocol (model or connection, modelProtocolSource 'user'); a model protocol settled by detection is still an automatic result and the board shows 'Auto = <that protocol>'. A rejection is recorded under the protocol the turn actually used (attachment fallback to chat). Web search / thinking 'protocolUndecided' stays as defined by relay/web-fragment.v1.json and is not covered here. Only a missing connection id or model is fail-closed. inputRevisionCases: a relay input key's verdictRevision is the hash of the verdict the facade synthesizes for it (vision from connection evidence: supported => auto_available, unsupported => unavailable + model_capability_absent, else unknown with no reasonCode; file/video => unknown + catalog_silent), with wireFamily from the first-send protocol; never the hash of a missing verdict. Each end names its tests RELAY_FIRST_SEND_<id> (Web: it('RELAY-FIRST-SEND-<id>...')).",
  "v": 1,
  "firstSendCases": [
    { "id": "auto_claude_family_messages", "connectionProtocol": "auto", "modelProtocol": null, "firstCandidate": "messages", "localEngine": false, "expect": { "firstSend": "messages", "inputEntry": "messages", "evidenceIdentity": "messages", "boardCatalogSource": "messages", "boardAutoEquals": "messages", "negativeCacheKey": "messages", "toolFinalTransport": "messages" } },
    { "id": "auto_other_family_chat", "connectionProtocol": "auto", "modelProtocol": null, "firstCandidate": "chat", "localEngine": false, "expect": { "firstSend": "chat", "inputEntry": "chat", "evidenceIdentity": "chat", "boardCatalogSource": "chat", "boardAutoEquals": "chat", "negativeCacheKey": "chat", "toolFinalTransport": "chat" } },
    { "id": "auto_no_candidate_chat", "connectionProtocol": "auto", "modelProtocol": null, "firstCandidate": null, "localEngine": false, "expect": { "firstSend": "chat", "inputEntry": "chat", "evidenceIdentity": "chat", "boardCatalogSource": "chat", "boardAutoEquals": "chat", "negativeCacheKey": "chat", "toolFinalTransport": "chat" } },
    { "id": "model_protocol_wins", "connectionProtocol": "auto", "modelProtocol": "responses", "modelProtocolSource": "user", "firstCandidate": "messages", "localEngine": false, "expect": { "firstSend": "responses", "inputEntry": "responses", "evidenceIdentity": "responses", "boardCatalogSource": "responses", "boardAutoEquals": null, "negativeCacheKey": "responses", "toolFinalTransport": "responses" } },
    { "id": "model_protocol_detected_auto_equals", "connectionProtocol": "auto", "modelProtocol": "responses", "modelProtocolSource": "detected", "firstCandidate": "messages", "localEngine": false, "expect": { "firstSend": "responses", "inputEntry": "responses", "evidenceIdentity": "responses", "boardCatalogSource": "responses", "boardAutoEquals": "responses", "negativeCacheKey": "responses", "toolFinalTransport": "responses" } },
    { "id": "connection_protocol_wins", "connectionProtocol": "chat", "modelProtocol": null, "firstCandidate": "messages", "localEngine": false, "expect": { "firstSend": "chat", "inputEntry": "chat", "evidenceIdentity": "chat", "boardCatalogSource": "chat", "boardAutoEquals": null, "negativeCacheKey": "chat", "toolFinalTransport": "chat" } },
    { "id": "attachment_fallback_records_under_sent", "connectionProtocol": "auto", "modelProtocol": null, "firstCandidate": "messages", "localEngine": false, "turnFellBackToChatForFiles": true, "expect": { "firstSend": "messages", "inputEntry": "messages", "boardAutoEquals": "messages", "turnSentWith": "chat", "rejectionRecordedUnder": "chat" } }
  ],
  "inputRevisionCases": [
    { "id": "relay_vision_supported_chat", "key": "vision_input", "connectionEvidence": "supported", "firstSend": "chat", "canonical": "{\"state\":\"auto_available\",\"wireFamily\":\"openai_chat.image_url\"}", "revision": "02e13cbc" },
    { "id": "relay_vision_unsupported_chat", "key": "vision_input", "connectionEvidence": "unsupported", "firstSend": "chat", "canonical": "{\"reasonCode\":\"model_capability_absent\",\"state\":\"unavailable\",\"wireFamily\":\"openai_chat.image_url\"}", "revision": "e8a05e60" },
    { "id": "relay_vision_unknown_chat", "key": "vision_input", "connectionEvidence": null, "firstSend": "chat", "canonical": "{\"state\":\"unknown\",\"wireFamily\":\"openai_chat.image_url\"}", "revision": "8b3810e5" },
    { "id": "relay_vision_unknown_messages", "key": "vision_input", "connectionEvidence": null, "firstSend": "messages", "canonical": "{\"state\":\"unknown\",\"wireFamily\":\"anthropic.image\"}", "revision": "e1b0b73a" },
    { "id": "relay_file_silent_chat", "key": "file_input", "connectionEvidence": null, "firstSend": "chat", "canonical": "{\"reasonCode\":\"catalog_silent\",\"state\":\"unknown\",\"wireFamily\":\"openai_chat.file\"}", "revision": "bc13b45a" },
    { "id": "relay_video_silent_chat", "key": "video_input", "connectionEvidence": null, "firstSend": "chat", "canonical": "{\"reasonCode\":\"catalog_silent\",\"state\":\"unknown\",\"wireFamily\":\"openai_chat.video_url\"}", "revision": "151bbc1f" }
  ],
  "fileFallbackCases": [
    { "id": "all_files_textless_messages_cannot_native_falls_back", "firstSend": "messages", "effectiveTransport": "chat", "files": [ { "hasExtractedText": false, "messagesNative": false } ], "expect": { "turnSentWith": "chat" } },
    { "id": "file_with_text_stays_on_messages", "firstSend": "messages", "effectiveTransport": "chat", "files": [ { "hasExtractedText": true, "messagesNative": false } ], "expect": { "turnSentWith": "messages" } },
    { "id": "messages_sends_file_natively_stays", "firstSend": "messages", "effectiveTransport": "chat", "files": [ { "hasExtractedText": false, "messagesNative": true } ], "expect": { "turnSentWith": "messages" } },
    { "id": "one_textless_one_with_text_stays", "firstSend": "messages", "effectiveTransport": "chat", "files": [ { "hasExtractedText": false, "messagesNative": false }, { "hasExtractedText": true, "messagesNative": false } ], "expect": { "turnSentWith": "messages" } },
    { "id": "history_textless_file_falls_back", "firstSend": "messages", "effectiveTransport": "chat", "files": [], "historyFiles": [ { "hasExtractedText": false, "messagesNative": false } ], "expect": { "turnSentWith": "chat" } },
    { "id": "images_only_never_fall_back", "firstSend": "messages", "effectiveTransport": "chat", "files": [], "images": 1, "expect": { "turnSentWith": "messages" } }
  ]
}
