{
  "$comment": "Authorization server metadata (RFC 8414) of the kind that supports CIMD. With client_id_metadata_document_supported: true the client SHOULD use CIMD (the https URL of a hosted document serves as the client_id). authorization_response_iss_parameter_supported decides whether a missing iss must be rejected.",
  "status": 200,
  "headers": { "Content-Type": "application/json" },
  "body": {
    "issuer": "https://auth.example.com",
    "authorization_endpoint": "https://auth.example.com/authorize",
    "token_endpoint": "https://auth.example.com/token",
    "registration_endpoint": "https://auth.example.com/register",
    "response_types_supported": ["code"],
    "grant_types_supported": ["authorization_code", "refresh_token"],
    "code_challenge_methods_supported": ["S256"],
    "token_endpoint_auth_methods_supported": ["none"],
    "scopes_supported": ["files:read", "files:write", "offline_access"],
    "client_id_metadata_document_supported": true,
    "authorization_response_iss_parameter_supported": true
  },
  "expect": {
    "registration": "cimd",
    "issuerValid": true,
    "wellKnownTried": ["https://auth.example.com/.well-known/oauth-authorization-server"]
  }
}
