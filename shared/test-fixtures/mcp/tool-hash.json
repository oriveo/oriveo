{
  "$comment": "Tool content hash. canonicalJSON = objects recursively re-ordered by ascending key (arrays keep their order); payload = JSON.stringify({name, description ?? null, inputSchema: canonical(inputSchema), annotations: canonical(annotations ?? {})}); hash = sha256(utf8(payload)). Escaping: only \" \\ and control characters are escaped (< 0x20 as \\u00XX); all other Unicode is emitted as is. If the clients disagree on any of this, their hashes diverge.",
  "version": 1,
  "cases": [
    {
      "caseId": "key_order_irrelevant_equivalent",
      "expectEqual": true,
      "before": {
        "name": "get_weather",
        "description": "Get current weather for a location",
        "inputSchema": {
          "type": "object",
          "properties": { "location": { "type": "string", "description": "City name" } },
          "required": ["location"]
        },
        "annotations": { "readOnlyHint": true }
      },
      "after": {
        "annotations": { "readOnlyHint": true },
        "inputSchema": {
          "required": ["location"],
          "type": "object",
          "properties": { "location": { "description": "City name", "type": "string" } }
        },
        "name": "get_weather",
        "description": "Get current weather for a location"
      },
      "expect": { "hash": "1ed4540882223b2f4105fcf683f79606ff8e2c67b778c60b584a937bd420f6db" }
    },
    {
      "caseId": "description_changed_one_word",
