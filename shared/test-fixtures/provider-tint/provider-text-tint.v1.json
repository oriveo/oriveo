{
  "$schema_version": 1,
  "$comment": "Provider text tint: when a provider brand colour is used as TEXT (ring centre title, provider row name, legend label), use this variant; fills/icons/chart slices keep the raw brand colour. Hue and chroma come from the brand colour; OKLCH lightness steps by rule.step (light: darker, dark: lighter) until contrast >= rule.minContrast against every background of the mode; already-passing colours are returned unchanged. Out-of-gamut: chroma drops by 0.004 until in sRGB (same as theme-contracts fromOklch). Ports may differ by at most 1 per channel (libm rounding). Reference: scripts/provider-text-tint.mjs (--write regenerates).",
  "pillLabel": {
    "$comment": "Text on the near-white provider-hero pill (white 0.96, worst case #F5F5F5) whose colour is derived from a brand colour: final label = providerTextTint(label, isDark=false). The light backgrounds include #F2EEF7 (luminance below #F5F5F5), so a passing label is >= 4.5 on the pill. Ports assert this for every kind in their hero palette and every preset palette primary/ink used for relay.",
    "worstBackground": "#F5F5F5",
    "relaySources": {
      "$comment": "Theme colour each port feeds into the Relay hero pill formula; heroPillLabelMeetsContrast covers exactly these.",
      "ios": "Palette.primary (dark palette primary)",
      "android": "OriveoTheme.colors.primary only (dark palette primary; light-mode ink is not used by the hero)",
      "web": "light: light-brand ink; dark: runtime --o-primary (7 preset dark primaries)"
    }
  },
  "rule": {
    "minContrast": 4.5,
    "step": 0.01,
    "light": [
      "#FFFFFF",
      "#F2EEF7"
    ],
    "dark": [
      "#1C1C1F",
      "#27272A",
      "#30343B"
    ]
  },
