{
  "schema": "oriveo.pricing-v2-estimate/v1",
  "id": "pricing-v2-estimate.v1",
  "description": "Shared fixture for pricingV2 cost estimation: every client must produce the same answer. The estimate function takes pricingV2 + five usage buckets + the request instant at (UTC ISO). Rules: unit other than per_token -> not_applicable; base missing the input or output price -> unavailable (shown as not available, never 0); total input = sum of the four input buckets, and a tier applies only when strictly greater than aboveInputTokens, taking the highest tier crossed; whole_request prices the entire request at that tier, incremental lays the buckets in one line in the order cache read, 5m write, 1h write, uncached and prices each segment, with output priced at the highest crossed tier; a tier missing a key inherits base; when cache prices are missing, read = input x 0.5, 5m write = input x 1.25, 1h write = input x 2 (using that tier input price); timeWindows take the first matching window (evaluated in the window timezone, start inclusive and end exclusive, end <= start crosses midnight with days referring to the start day, 24:00 is the end of the day, windows with an unparseable timezone are skipped, holidayCalendar is ignored); a window multiplier scales all unit prices while absolute prices replace only the keys given; regionSurcharges are ignored. amount is in the major currency unit; comparison tolerance is 1e-9.",
  "cases": [
    {
      "name": "PV2-BASE",
      "note": "All buckets priced at the base and cache rates",
      "pricingV2": {
        "currencyCode": "USD",
        "unit": "per_token",
        "base": {
          "inputPerMToken": 2,
          "outputPerMToken": 8
        },
        "cache": {
          "readPerMToken": 0.5,
          "writes": [
            {
              "ttl": "5m",
              "perMToken": 2.5
            },
            {
              "ttl": "1h",
              "perMToken": 4
            }
          ]
        }
      },
      "usage": {
        "uncachedInputTokens": 1000,
        "cacheReadTokens": 2000,
        "cacheWrite5mTokens": 300,
        "cacheWrite1hTokens": 400,
        "outputTokens": 500
      },
      "at": "2026-10-19T12:00:00Z",
      "expected": {
        "status": "estimated",
        "amount": 0.00935,
        "currencyCode": "USD"
      }
    },
