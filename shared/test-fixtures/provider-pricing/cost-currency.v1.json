  "migrationCases": [
    {
      "id": "existing_row_defaults_usd",
      "before": {
        "estimatedCost": 0.02
      },
      "expectAfter": {
        "estimatedCost": 0.02,
        "nonUsdCost": null
      }
    },
    {
      "id": "dropped_cny_stays_unknown",
      "before": {
        "estimatedCost": 0,
        "costSource": "unknown"
      },
      "expectAfter": {
        "estimatedCost": 0,
        "costSource": "unknown",
        "nonUsdCost": null
      }
    },
    {
      "id": "legacy_currency_column_moved",
      "before": {
        "estimatedCost": 0.0039,
        "estimatedCostCurrency": "CNY",
        "costSource": "estimated"
      },
      "expectAfter": {
        "estimatedCost": 0,
        "costSource": "unknown",
        "nonUsdCost": {
          "currencyCode": "CNY",
          "amount": 0.0039,
          "costSource": "estimated"
        }
      },
      "note": "rows stored in a superseded single-currency shape; USD or empty-currency rows keep estimatedCost and get nonUsdCost null"
    }
  ]
}
