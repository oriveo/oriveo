{
  "$comment": "Per-currency message cost, conversation totals, display and migration. Message shape: estimatedCost always holds only the USD part (may be 0) and costSource describes the USD part ('unknown' when there is no USD part); nullable nonUsdCost {currencyCode (ISO 4217 upper case), amount, costSource} holds the single non-USD part. Amounts are never converted. totalCases: messages are in the message shape; estimatedCost adds into the USD total and nonUsdCost into its currency's total; totals are per currency and never added across currencies; parts are ordered USD first, then other codes ascending; zero-amount currencies are omitted; unrecorded parts are skipped. displayCases: parts are joined by ' + '; one message may render two parts; USD keeps the existing '$' rendering and precision; other currencies use the platform currency formatter with the UI locale and the standard symbol, and each part is rounded by the same digit rule used for USD in that place, evaluated on that part's own amount (cases give the resolved digits per part). migrationCases: the schema adds a nullable nonUsdCost (three fields); existing rows get nonUsdCost null; past messages whose CNY estimate was dropped stay unknown. Tests are named COST_CURRENCY_<id>.",
  "v": 1,
  "totalCases": [
    {
      "id": "mixed_totals_split_by_currency",
      "messages": [
        {
          "estimatedCost": 1,
          "costSource": "estimated",
          "nonUsdCost": null
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 3.5,
            "costSource": "estimated"
          }
        },
        {
          "estimatedCost": 0.2,
          "costSource": "estimated",
          "nonUsdCost": null
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": null
        }
      ],
      "expect": {
        "parts": [
          {
            "currencyCode": "USD",
            "amount": 1.2
          },
          {
            "currencyCode": "CNY",
            "amount": 3.5
          }
        ]
      }
    },
    {
      "id": "cny_only",
      "messages": [
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 2,
            "costSource": "estimated"
          }
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 1.5,
            "costSource": "estimated"
          }
        }
      ],
      "expect": {
        "parts": [
          {
            "currencyCode": "CNY",
            "amount": 3.5
          }
        ]
      }
    },
    {
      "id": "order_usd_then_code_ascending",
      "messages": [
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "EUR",
            "amount": 1,
            "costSource": "estimated"
          }
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 1,
            "costSource": "estimated"
          }
        },
        {
          "estimatedCost": 1,
          "costSource": "estimated",
          "nonUsdCost": null
        }
      ],
      "expect": {
        "parts": [
          {
            "currencyCode": "USD",
            "amount": 1
          },
          {
            "currencyCode": "CNY",
            "amount": 1
          },
          {
            "currencyCode": "EUR",
            "amount": 1
          }
        ]
      }
    },
    {
      "id": "zero_currency_omitted",
      "messages": [
        {
          "estimatedCost": 1.2,
          "costSource": "estimated",
          "nonUsdCost": null
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 0,
            "costSource": "estimated"
          }
        }
      ],
      "expect": {
        "parts": [
          {
            "currencyCode": "USD",
            "amount": 1.2
          }
        ]
      }
    },
    {
      "id": "mixed_message_split_into_both_totals",
      "messages": [
        {
          "estimatedCost": 0.25,
          "costSource": "estimated",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 0.12,
            "costSource": "estimated"
          }
        },
        {
          "estimatedCost": 1,
          "costSource": "estimated",
          "nonUsdCost": null
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 3.5,
            "costSource": "estimated"
          }
        }
      ],
      "expect": {
