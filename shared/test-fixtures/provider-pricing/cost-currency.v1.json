            "amount": 0.000015
          },
          {
            "currencyCode": "CNY",
            "amount": 0.000015
          }
        ]
      },
      "note": "X-G2a: add every message's raw amount first; the epsilon (1e-5) applies only to the sum and to display, never per message"
    },
    {
      "id": "negative_parts_not_added",
      "messages": [
        {
          "estimatedCost": -0.5,
          "costSource": "estimated",
          "nonUsdCost": null
