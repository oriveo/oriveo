        {
          "estimatedCost": 1,
          "costSource": "estimated",
          "nonUsdCost": null
        },
        {
          "estimatedCost": 0,
          "costSource": "unknown",
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": -2,
            "costSource": "estimated"
          }
        }
      ],
      "expect": {
        "parts": [
          {
            "currencyCode": "USD",
            "amount": 1
          }
        ]
      },
      "note": "X-G2a: only amounts > 0 are added; a negative part is ignored"
    },
    {
      "id": "total_equal_to_epsilon_omitted",
      "messages": [
        {
          "estimatedCost": 0.00001,
          "costSource": "estimated",
          "nonUsdCost": null
        }
      ],
      "expect": {
        "parts": []
      },
      "note": "X-G2a: a total is kept only when it is strictly greater than epsilon (1e-5)"
    }
  ],
