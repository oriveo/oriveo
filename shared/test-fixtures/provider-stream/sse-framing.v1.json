{
  "schema": "oriveo.fixture.sse-framing/v1",
  "description": "Server-sent event framing for provider streams. Each case is the raw bytes of a response body, the ways to cut it into chunks, and the events a decoder must hand out whatever the cut. Rules follow the WHATWG EventSource parsing algorithm, with two deliberate differences that existing clients rely on: a stream that ends without a final line end or blank line still yields its last line and its pending event, and a lone value that is the text [DONE] is an ordinary event at this level (the protocol layer above gives it meaning).",
  "bytes": {
    "bytes_base64": "the raw bytes of the response body",
    "escaped": "the same bytes as text with JSON string escapes, for reading only; a decoder is fed bytes_base64"
  },
  "chunking": {
    "whole": "the bytes arrive in one chunk",
    "every-byte": "the bytes arrive one at a time",
    "offsets": "the bytes are cut before each listed offset"
  },
  "frame": {
    "event": "the event name, null when the event carries none",
    "data": "the data lines joined with LF; never trimmed",
    "id": "the last id seen so far, null before the first",
    "retry": "the retry value of this event as an integer, null when it carries none"
  },
  "openai_chat": "For cases that carry chat completion chunks: the text an openai_chat assembler builds from choices[0].delta.content, the finish_reason it saw, and whether it saw the end sentinel.",
  "cases": [
    {
      "id": "lf",
      "rule": "terminator",
      "title": "LF ends a line; a blank line dispatches the event",
      "bytes_base64": "ZGF0YTogeyJjaG9pY2VzIjpbeyJpbmRleCI6MCwiZGVsdGEiOnsiY29udGVudCI6IkhlbGxvIn19XX0KCmRhdGE6IFtET05FXQoK",
      "escaped": "data: {\\\"choices\\\":[{\\\"index\\\":0,\\\"delta\\\":{\\\"content\\\":\\\"Hello\\\"}}]}\\n\\ndata: [DONE]\\n\\n",
      "chunkings": [
        {
          "name": "whole",
          "offsets": []
        },
        {
          "name": "every-byte",
          "every": 1
        }
      ],
      "expect": {
        "frames": [
          {
            "event": null,
            "data": "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"}}]}",
            "id": null,
            "retry": null
          },
          {
            "event": null,
            "data": "[DONE]",
            "id": null,
            "retry": null
          }
        ],
        "comments": 0
      },
      "openai_chat": {
        "text": "Hello",
        "finish_reason": null,
        "done": true
      }
    },
