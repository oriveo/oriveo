            "currencyCode": "CNY",
            "amount": 5,
            "costSource": "upstream"
          }
        },
        {
          "providerId": "usd_issue",
          "costSource": "localEstimate",
          "estimatedCost": 0.02
        },
        {
          "providerId": "usd_issue",
          "costSource": "localEstimate",
          "estimatedCost": 0.02
        },
        {
          "providerId": "usd_connected",
