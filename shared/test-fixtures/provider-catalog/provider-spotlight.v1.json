{
  "$comment": "Providers page spotlight (featured) provider selection; ranking is by this month's billed message count. Candidates = providers with at least one billed message this UTC month in ANY currency. A billed message = delivered assistant message with at least one recorded part: the USD part (top-level costSource upstream or localEstimate AND estimatedCost > COST_EPSILON) or the non-USD part (nonUsdCost.costSource upstream or localEstimate AND nonUsdCost.amount > COST_EPSILON; a CNY-only message carries top-level costSource unknown + estimatedCost 0). A mixed-currency message counts once. Messages with no recorded part (costSource unknown and no nonUsdCost, or zero amounts) are not counted and do not make a provider a candidate. Ranking: billed message count desc (currency-agnostic); tie -> this month's USD amount desc (non-USD amounts are never converted or added); tie -> status connected > syncing > issue (needsKey ranks as issue); tie -> existing stable list order (order of `providers` below). If no provider is a candidate: first provider by status connected > syncing > issue, then list order. Spotlight count per client is listed in spotlightCount. All messages below are inside the current UTC month. Tests are named PROVIDER_SPOTLIGHT_<id>.",
  "version": 1,
  "spotlightCount": {
    "web": 1,
    "android": 1,
    "ios": 1,
    "desktop": 0
  },
  "cases": [
    {
      "id": "cny_only_provider_can_win",
      "note": "A provider billed only in CNY is a candidate and wins on message count; old USD-only ranking would pick usd_a.",
      "providers": [
        {
          "id": "usd_a",
          "kind": "openAI",
          "status": "connected"
        },
        {
          "id": "cny_b",
          "kind": "moonshot",
          "status": "connected"
        }
      ],
      "messages": [
        {
          "providerId": "usd_a",
          "costSource": "upstream",
          "estimatedCost": 0.5
        },
        {
          "providerId": "cny_b",
          "costSource": "unknown",
          "estimatedCost": 0,
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 0.1,
            "costSource": "localEstimate"
          }
        },
        {
          "providerId": "cny_b",
          "costSource": "unknown",
          "estimatedCost": 0,
          "nonUsdCost": {
            "currencyCode": "CNY",
            "amount": 0.1,
            "costSource": "localEstimate"
          }
        }
      ],
      "expect": {
        "spotlightProviderIds": [
          "cny_b"
        ]
      }
    },
    {
      "id": "message_count_beats_usd_amount",
      "note": "More billed messages wins even with a far smaller USD amount.",
      "providers": [
        {
          "id": "expensive",
          "kind": "anthropic",
          "status": "connected"
        },
        {
          "id": "chatty",
          "kind": "openAI",
          "status": "connected"
        }
      ],
      "messages": [
        {
          "providerId": "expensive",
          "costSource": "upstream",
          "estimatedCost": 2
        },
        {
          "providerId": "chatty",
          "costSource": "localEstimate",
          "estimatedCost": 0.01
        },
        {
          "providerId": "chatty",
          "costSource": "localEstimate",
          "estimatedCost": 0.01
        },
        {
          "providerId": "chatty",
          "costSource": "localEstimate",
          "estimatedCost": 0.01
        }
      ],
      "expect": {
        "spotlightProviderIds": [
          "chatty"
        ]
      }
    },
    {
