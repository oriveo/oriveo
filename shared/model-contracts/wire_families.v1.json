{
  "$comment": "Wire families for media input. The Server verdict only says whether a model accepts a medium and through which wireFamily; each client compiles its own ProtocolImplementations table keyed by these ids and reconciles against this file. An unknown wireFamily string means not implemented on that end. families[].implementedBy lists the ends whose compiled table implements the family; each end's reconciliation test asserts its table equals the set of families listing that end. transport_not_implemented is reserved for families whose implementedBy is empty. Part shapes verified against official docs on 2026-10-19 (see sourceRef).",
  "contractId": "wire_families.v1",
  "version": 1,
  "reviewedAt": "2026-10-19",
  "protocols": {
    "openai_chat": { "requiresMaxTokens": false, "defaultMaxOutputTokens": null },
    "openai_responses": { "requiresMaxTokens": false, "defaultMaxOutputTokens": null },
    "anthropic": { "requiresMaxTokens": true, "defaultMaxOutputTokens": 8192 },
    "gemini": { "requiresMaxTokens": false, "defaultMaxOutputTokens": null }
  },
  "families": [
    {
      "id": "openai_chat.image_url",
      "protocol": "openai_chat",
      "capabilityKey": "vision_input",
      "part": { "type": "image_url", "image_url": { "url": "<https URL or data:image/*;base64>" } },
      "sourceRef": [
        "https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create",
        "https://openrouter.ai/docs/guides/overview/multimodal/image-understanding",
        "https://api-docs.deepseek.com/guides/vision",
        "https://www.alibabacloud.com/help/en/model-studio/qwen-api-via-openai-chat-completions"
      ],
      "implementedBy": ["web", "android", "ios", "desktop"]
    },
    {
      "id": "openai_chat.file",
      "protocol": "openai_chat",
      "capabilityKey": "file_input",
      "part": { "type": "file", "file": { "filename": "<name>", "file_data": "<data:application/pdf;base64>" } },
      "note": "OpenAI Chat accepts PDF only; OpenRouter also accepts a public URL in file_data. DeepSeek documents a flat {type:file,file_data,filename} for images only, which is not this family.",
      "sourceRef": [
        "https://developers.openai.com/api/docs/guides/file-inputs",
        "https://openrouter.ai/docs/guides/overview/multimodal/pdfs"
      ],
      "implementedBy": ["web", "android", "ios", "desktop"]
    },
