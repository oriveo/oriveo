{
  "$comment": "Request preference contract v2. This is the live cross-runtime contract: it freezes intent ownership, resolution, safe custom overlays, typed contributions, factual result reporting, continuation bounds, and explicit rejection recovery for production requests.",
  "contractId": "request_preference_contract.v2",
  "version": 2,
  "owners": [
    {
      "id": "web",
      "namespace": "webPatch",
      "responsibility": "web search controls, provider web tools, and web plugins"
    },
    {
      "id": "reasoning",
      "namespace": "reasoningPatch",
      "responsibility": "thinking, reasoning effort, and reasoning budget"
    },
    {
      "id": "generation",
      "namespace": "generationPatch",
      "responsibility": "sampling, output budget, stop, seed, and output contract"
    }
  ],
  "vocabulary": {
    "overrideStates": [
      "inherit",
      "value",
      "omit"
    ],
    "valueModes": [
      "preset",
      "custom"
    ],
    "valuePayloadKinds": [
      "feature_selection",
      "typed_control"
    ],
    "controlAvailability": [
      "auto_available",
      "managed_only",
      "custom_only",
      "unavailable",
      "unknown"
    ],
    "connectionAccess": [
      "managed",
      "byok_developer",
      "relay_developer"
    ],
    "executionKinds": [
      "request_overlay",
      "server_tool",
      "client_tool_loop",
      "endpoint_route",
      "model_route",
      "external_connector",
      "unavailable"
    ],
    "continuationKinds": [
      "none",
      "previous_id",
      "replay_blocks",
      "replay_reasoning",
      "tool_loop"
    ],
    "resultStates": [
      "not_requested",
      "requested",
      "observed",
      "unconfirmed",
      "rejected",
      "recovered"
    ],
    "observationEvidenceKinds": [
      "provider_tool_result",
      "citation",
      "grounding",
      "thinking_block",
      "reasoning_usage"
    ]
  },
  "resolution": {
    "$comment": "This is the only scope precedence list in the v2 contract. Missing and inherit continue downward; omit is terminal; value is terminal, including numeric zero. An owner-level feature selection chooses preset or custom; leaf typed controls may carry scalars, including zero.",
    "scopePriority": [
      "single_send",
      "conversation_connection_model",
      "skill_agent",
      "connection_model",
      "connection",
      "provider_recipe",
      "provider_default"
    ],
    "missingMeans": "inherit",
    "terminalStates": [
      "value",
      "omit"
    ],
    "numericZeroIsExplicitValue": true,
    "sameScopeSameOwnerDuplicate": "reject",
    "crossOwnerCollision": "reject",
    "lastWriteWins": false
  },
  "selectionPolicy": {
    "preset": "Requires an active recipe in the model catalog. A preset whose availability is managed_only is not selectable through a key the user brought themselves.",
    "custom": "Requires BYOK or Relay developer access and an availability state that permits custom fragments.",
    "customOnlyDoesNotImplyPreset": true,
    "presetAndCustomAreMutuallyExclusive": true,
    "unknownOrUnavailableInjectsNothingAutomatically": true
  },
  "safeOverlay": {
    "$comment": "A custom fragment is compiled from lossless JSON input. Duplicate keys must be rejected before object materialization. Every target pointer must be declared by the selected recipe for exactly one owner.",
    "inputType": "json_object_fragment",
    "pointerSyntax": "rfc6901",
    "segmentPattern": "^[A-Za-z_][A-Za-z0-9_]*$",
    "blockedSegmentsRecursive": [
      "__proto__",
      "prototype",
      "constructor"
    ],
    "allowedOperations": [
      "set",
      "omit",
      "upsert_owned_element"
    ],
    "forbiddenChannels": [
      "auth",
      "headers",
      "query",
      "endpoint",
      "base_url",
      "transport_route",
      "model_route",
      "continuation_state"
    ],
    "builderOwnedRootFields": [
      "model",
      "messages",
      "input",
      "contents",
      "prompt",
      "attachments",
      "instructions",
      "system",
      "stream",
      "stream_options",
      "tools",
      "tool_choice",
      "plugins"
    ],
    "typedContributionOnlyRoots": [
      "tools",
      "plugins"
    ],
    "limits": {
      "maxBytes": 65536,
      "maxDepth": 32,
      "maxNodes": 2048,
      "maxOperations": 128
    },
    "unknownPointerPolicy": "reject",
    "crossOwnerPolicy": "reject",
    "duplicatePointerPolicy": "reject",
    "duplicateJsonKeyPolicy": "reject_before_parse_materialization",
    "wholeArrayReplacementPolicy": "reject",
    "wholeArrayDeletionPolicy": "reject"
  },
  "typedContributions": {
    "$comment": "Builder and Agent tools already in the base request are retained. Feature contributions are typed and append-only; generic overlays cannot replace or delete the tools/plugins arrays.",
    "targets": [
      "tools",
      "plugins"
    ],
    "allowedOwnerByTarget": {
      "tools": [
        "web"
      ],
      "plugins": [
        "web"
      ]
    },
    "operations": [
      "append_owned"
    ],
    "identityFields": [
      "type",
      "name"
    ],
    "baseItemsAlwaysRetained": true,
    "duplicateIdentityPolicy": "reject",
    "deleteForeignItemPolicy": "reject",
    "replaceArrayPolicy": "reject"
  },
  "resultFacts": {
    "$comment": "Request construction and response execution are separate facts. requested is recorded only after a feature delta reaches the wire. observed additionally requires recipe-declared response evidence; HTTP success alone is unconfirmed.",
    "requestedRequiresWireDelta": true,
    "observedRequiresRequested": true,
    "observedRequiresEvidence": true,
    "httpSuccessWithoutEvidence": "unconfirmed",
    "singleRejectionScope": [
      "connection",
      "transport",
      "model",
      "recipe_revision"
    ],
    "singleRejectionMayChangeServerGlobalSupport": false
  },
  "continuation": {
    "$comment": "Opaque provider continuation state is never authored by a custom overlay. Each recipe selects one known kind, declares exact replay fields, and sets a finite per-send step bound. tool_loop stores only complete assistant tool_call + tool result message blocks, never orphan results. plugin-style fields are expressed as request_overlay target roots, and fiber is a tool_loop variant, so neither is an independent kind.",
    "unknownKindPolicy": "reject_feature_patch",
    "customOverlayMayWriteState": false,
    "kinds": {
      "none": {
        "maxSteps": 0,
        "requiredStateFields": [],
        "opaqueReplay": false
      },
      "previous_id": {
        "maxSteps": 1,
        "requiredStateFields": [
          "previousResponseId"
        ],
        "opaqueReplay": true
      },
      "replay_blocks": {
        "maxSteps": 8,
        "requiredStateFields": [
          "blocks"
        ],
        "opaqueReplay": true
      },
      "replay_reasoning": {
        "maxSteps": 8,
        "requiredStateFields": [
          "assistantMessages"
        ],
        "opaqueReplay": true
      },
      "tool_loop": {
        "maxSteps": 8,
        "requiredStateFields": [
          "completedMessages"
        ],
        "opaqueReplay": true,
        "toolCallIdsMustBeUnique": true,
        "variants": [
          "default",
          "fiber"
        ],
        "fiberVariantRequiresEncryptedOutputReplay": true
      }
    }
  },
  "retryPolicy": {
    "$comment": "No capability setting may be stripped and retried silently. A deterministic HTTP 400 may offer an explicit user-confirmed resend only when a reviewed structured locator binds the rejection to exact pointers owned by one selected recipe or to the actual custom fragment. The saved preference remains dormant; the resend omits only the located owner for that new send, preserving draft, attachments and generated content.",
    "automaticRetry": false,
    "allowedStatus": 400,
    "allowedErrorClass": "optional_parameter_rejected",
    "requiresLocatedOwner": true,
    "requiresLocatedPointers": true,
    "requiresPreToken": true,
    "requiresStreamNotStarted": true,
    "requiresNoSideEffects": true,
    "requiresStructuredErrorLocator": true,
    "requiresExactRecipeOwnedPointers": true,
    "unreviewedLocatorAction": "surface_error",
    "mutationScope": "explicit_resend_only",
    "savedPreferenceAfterRejection": "retain_dormant",
    "explicitResendAction": "user_confirmed_resend_without_located_setting",
    "preserveOnFailure": [
      "draft",
      "attachments",
      "generated_content",
      "saved_preference"
    ],
    "neverAutomatic": [
      "401",
      "403",
      "422",
      "429",
      "5xx",
      "network",
      "timeout",
      "stream_started",
      "side_effect_started",
      "unlocated_error"
    ]
  },
  "redactedPreview": {
    "source": "compiled_request_delta",
    "mustExclude": [
      "api_key",
      "authorization",
      "prompt",
      "messages",
      "attachments",
      "full_endpoint",
      "response",
      "raw_custom_fragment"
    ],
    "mustNotUseStoredInputAsProof": true
  },
  "fixtureSchemas": {
    "recipeSelectorRequiredFields": [
      "providerKind",
      "transport",
      "capability",
      "executionKind",
      "requestOps",
      "responseParserKind",
      "continuationKind",
      "sourceRefs",
      "reviewedAt"
    ],
    "sourceRefRequiredFields": [
      "kind",
      "url",
      "reviewedAt"
    ],
    "productionProofRequiredFromPhase": "P3"
  },
