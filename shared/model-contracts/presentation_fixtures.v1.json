{
  "$comment": "Golden fixture shared by all three clients for the presentation contract. All three clients are only allowed to implement one shared set of rendering components; the structural elements a given fixture renders on iOS / Web / Android (whether the vendor subtitle appears, the recommended badge, capability badge order, which pricing copy branch is used, whether the reasoning selector appears, the number of group headers, empty/offline banners) must be identical.",
  "contractVersion": 1,
  "leafCases": [
    {
      "id": "openrouter_claude_sonnet_aggregator_with_vendor",
      "$intent": "A model card under an aggregated provider: the vendor subtitle must be shown; the recommended badge; the reasoning selector; priced.",
      "providerKind": "openRouter",
      "model": {
        "canonicalModelId": "anthropic/claude-sonnet-4",
        "displayName": "Anthropic: Claude Sonnet 4",
        "vendorKey": "anthropic",
        "vendorName": "Anthropic",
        "contextLength": 200000,
        "pricing": {
          "promptPerMToken": 3.0,
          "completionPerMToken": 15.0,
          "cachedInputPerMToken": 0.3
        },
        "pricingStatus": "priced",
        "capabilities": [
          "text",
          "image",
          "file",
          "reasoning"
        ],
        "profiles": {
          "reasoning": "openai_responses",
          "webSearch": null,
          "imageGen": null
        },
        "uiHints": {
          "groupKey": "anthropic",
          "groupName": "Anthropic",
