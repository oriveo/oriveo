        "$comment": "text must never be shown as a badge; badgeOrder decides the order of reasoning/image/file.",
        "showsCachedPricing": true,
        "pricingBranch": "priced",
        "showsReasoningPicker": true,
        "showsWebSearchPicker": false,
        "showsImageGenPicker": false
      }
    },
