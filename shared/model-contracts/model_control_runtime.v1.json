        "learnNegative": false,
        "storedPreference": "unchanged"
      }
    },
    {
      "caseId": "connection_delete_tombstones_all_identity_variants",
      "expected": {
        "resurrection": false,
        "readdRequiresExplicitReconfirmation": true
      }
    }
  ]
}
